          "settings": {
            "title": "Processing, Shipping & Returns"
          }
        },
        "faq_QxFK3J": {
          "type": "faq",
          "settings": {
            "question": "How long does it take to process and pre-load my media?",
            "answer": "<p>If you upload files during checkout, our processing times are as follows:</p><ul><li><strong>Pre-edited or single videos:</strong> 48 hours maximum.</li><li><strong>Unedited bulk videos:</strong> 2 to 3 days to process.</li><li><strong>Professional Video Editing Service:</strong> Please allow 1 additional day.</li></ul><p>Once processing is complete, standard dispatch takes 1 business day.</p>"
          }
        },
        "faq_fFmNUm": {
          "type": "faq",
          "settings": {
            "question": "Do you offer UK Next Day Delivery?",
            "answer": "<p>Yes! We offer a Next Day Delivery option for UK orders with the following conditions:</p><ul><li>The cut-off time is <strong>1:00 PM</strong> for blank books (no file attachments) or orders with fewer than 3 files.</li><li>Orders requiring us to pre-load 1 or more files must be placed before <strong>7:00 AM</strong> to qualify.</li></ul><p>Orders that do not meet these specific cut-offs will be processed within our standard timeframes.</p>"
          }
        },
        "faq_mYYE3U": {
          "type": "faq",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we offer worldwide shipping. After processing and our 1-day dispatch window, international delivery typically takes between 2 to 10 days depending on your country and regional customs processing.</p>"
          }
        },
