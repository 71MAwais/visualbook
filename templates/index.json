        "faq_r9JLp7": {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "Standard bespoke orders take 5-7 business days to craft and assemble. Once shipped, delivery typically takes 2-3 days within the UK and US, and 5-10 days internationally."
          }
        },
        "faq_DQ3mRb": {
          "type": "faq",
          "settings": {
            "question": "Can I change the videos after I receive the book?",
            "answer": "Yes. Every Visual Book comes with a secure companion app. You can easily connect to your book via USB or Wi-Fi to update, add, or arrange your gallery at any time."
          }
        },
        "faq_jtR68e": {
          "type": "faq",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "The book features a high-capacity rechargeable battery. It offers up to 4 hours of continuous playback and an incredible 6 months of standby time. A magnetic charging cable is included."
          }
        },
        "faq_FpTzqV": {
          "type": "faq",
          "settings": {
            "question": "Is there a limit to how many videos I can upload?",
            "answer": "The standard Visual Book includes 8GB of internal memory, which comfortably holds about 2-3 hours of high-definition video or thousands of photos."
          }
        }
