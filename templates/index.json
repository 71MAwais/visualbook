    "landing_cinematic_dVzXyi": {
      "type": "Landing-cinematic",
      "blocks": {
        "experience_zfp7T3": {
          "type": "experience",
          "settings": {
            "tag": "ALWAYS & FOREVER",
            "title": "Classic Visual Book",
            "description": "A timeless, heirloom-quality keepsake to celebrate your eternal bond and most cherished moments together.",
            "video_duration": "02:30",
            "cover_image": "shopify://shop_images/5065017721152_ALT01.jpg",
            "tab_1_title": "The Video",
            "tab_2_title": "Features & Specs",
            "tab_2_text": "<p><strong>Display:</strong> Available in 7-inch and 10.1-inch IPS HD Displays<br/><strong>Storage:</strong> 8GB Capacity (Up to 6-Hour Video & Photo Capacity)<br/><strong>Design:</strong> Premium Cream-Beige Soft Linen Cover with Gold Foil Stamp<br/><strong>Smart Tech:</strong> Magnetic/Light/Motion Sensor Power Switch (opens to play)<br/><strong>Extras:</strong> One-Click Video/Photo Switch and Complimentary Pre-Loading</p>",
            "tab_3_title": "The Purpose",
            "tab_3_text": "<p>A physical home for your digital memories. Relive your anniversaries, travels, and the joy of your relationship—ready to be experienced without screens, apps, or distractions.</p>",
            "button_label": "Create Your Book",
            "button_link": "shopify://products/always-forever-book-visual-book",
            "chapter_1_label": "",
