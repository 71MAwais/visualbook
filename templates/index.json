            "video_duration": "02:00",
            "cover_image": "shopify://shop_images/5065017721084_ALT03.jpg",
            "tab_1_title": "The Video",
            "tab_2_title": "Features & Specs",
            "tab_2_text": "<p><strong>Display:</strong> 7.1-inch IPS HD Display<br/><strong>Storage:</strong> 8GB Capacity (Up to 6-Hour Video & Photo Capacity)<br/><strong>Design:</strong> Premium Cream-Beige Soft Linen Cover with Gold Foil Stamp<br/><strong>Smart Tech:</strong> Magnetic/Light/Motion Sensor Power Switch (opens to play)<br/><strong>Extras:</strong> Simple Drag & Drop Setup with a 2500mAh Lithium Battery</p>",
            "tab_3_title": "The Purpose",
            "tab_3_text": "<p>Sometimes words aren't enough. Show them exactly how much they mean to you with a curated video experience wrapped in a luxury, tangible book.</p>",
