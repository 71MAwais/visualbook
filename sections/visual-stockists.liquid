<section class="visual-stockists py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-4xl font-serif text-gray-900">{{ section.settings.title }}</h2>
    <p class="mt-4 text-gray-500 max-w-2xl mx-auto">{{ section.settings.subtitle }}</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
    {% for block in section.blocks %}
      <div class="border-t border-gray-200 pt-6">
        <h3 class="text-xl font-bold text-gray-900 mb-2">{{ block.settings.store_name }}</h3>
        <div class="text-gray-600 mb-4 leading-relaxed">{{ block.settings.address }}</div>
        {% if block.settings.website_link != blank %}
          <a href="{{ block.settings.website_link }}" target="_blank" class="text-sm font-medium uppercase tracking-widest border-b border-black pb-1 hover:text-gray-500 hover:border-gray-500 transition">
            Visit Website
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Visual Stockists",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Our Stockists" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Find The Visual Book in stores near you." }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        { "type": "text", "id": "store_name", "label": "Store Name", "default": "Store Name" },
        { "type": "richtext", "id": "address", "label": "Address", "default": "<p>123 High Street<br>London, UK</p>" },
        { "type": "url", "id": "website_link", "label": "Website Link" }
      ]
    }
  ],
  "presets": [{ "name": "Visual Stockists" }]
}
{% endschema %}