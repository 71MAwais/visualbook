{% style %}
  /* Minimal scoped animation for the staggered fade-in */
  .stockist-card { opacity: 0; transform: translateY(15px); transition: opacity 0.5s ease-out, transform 0.5s ease-out; }
  .stockist-card.card-enter { opacity: 1; transform: translateY(0); }
  .stockist-hide { display: none !important; }
{% endstyle %}

<section class="w-full bg-[#fafafa]" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <header class="px-6 text-center max-w-4xl mx-auto mb-12 md:mb-16">
    {% if section.settings.heading != blank %}
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-[#181615] mb-6 tracking-tight">
        {{ section.settings.heading | escape }}
      </h1>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="text-base md:text-lg text-gray-600 font-sans font-light leading-relaxed">
        {{ section.settings.description }}
      </div>
    {% endif %}
  </header>

  <main class="max-w-7xl mx-auto px-6 w-full">
    
    {% if section.settings.show_filters %}
      <div class="flex justify-center gap-2 md:gap-6 mb-12 border-b border-gray-200 pb-px overflow-x-auto whitespace-nowrap hide-scrollbar">
        <button onclick="filterStockists('all')" id="btn-all" class="stockist-tab-btn active px-4 md:px-6 py-3 font-sans font-medium text-xs md:text-sm uppercase tracking-widest border-b-2 border-[#181615] text-[#181615] hover:text-black transition-all">
          {{ section.settings.filter_all_text | escape }}
        </button>
        <button onclick="filterStockists('physical')" id="btn-physical" class="stockist-tab-btn px-4 md:px-6 py-3 font-sans font-medium text-xs md:text-sm uppercase tracking-widest border-b-2 border-transparent text-gray-400 hover:text-[#181615] transition-all">
          {{ section.settings.filter_physical_text | escape }}
        </button>
        <button onclick="filterStockists('online')" id="btn-online" class="stockist-tab-btn px-4 md:px-6 py-3 font-sans font-medium text-xs md:text-sm uppercase tracking-widest border-b-2 border-transparent text-gray-400 hover:text-[#181615] transition-all">
          {{ section.settings.filter_online_text | escape }}
        </button>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="stockist-container">
      
      {% for block in section.blocks %}
        {% case block.type %}
          
          {% when 'physical' %}
            <div class="stockist-card physical bg-white p-8 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col h-full rounded-xl group" {{ block.shopify_attributes }}>
              <div class="flex items-start justify-between mb-4">
                <span class="text-xs font-sans font-semibold tracking-widest uppercase text-gray-400 group-hover:text-gray-600 transition-colors">{{ block.settings.location_tag | escape }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-gray-400 transition-colors"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <h3 class="text-2xl font-serif text-[#181615] mb-3">{{ block.settings.store_name | escape }}</h3>
              <div class="text-sm font-sans text-gray-500 font-light flex-grow space-y-1.5 mb-8">
                {% if block.settings.address_1 != blank %}<p>{{ block.settings.address_1 | escape }}</p>{% endif %}
                {% if block.settings.address_2 != blank %}<p>{{ block.settings.address_2 | escape }}</p>{% endif %}
              </div>
              {% if block.settings.link_url != blank %}
                <a href="{{ block.settings.link_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-sans font-medium text-[#181615] border-b border-[#181615] pb-1 w-max hover:text-gray-500 hover:border-gray-500 transition-colors">
                  {{ block.settings.link_text | escape }} 
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              {% endif %}
            </div>

          {% when 'online' %}
            <div class="stockist-card online bg-[#181615] text-white p-8 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full rounded-xl group" {{ block.shopify_attributes }}>
              <div class="flex items-start justify-between mb-4">
                <span class="text-xs font-sans font-semibold tracking-widest uppercase text-gray-400 group-hover:text-gray-300 transition-colors">{{ block.settings.location_tag | escape }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-gray-300 transition-colors"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              </div>
              <h3 class="text-2xl font-serif text-white mb-3">{{ block.settings.store_name | escape }}</h3>
              <div class="text-sm font-sans text-gray-300 font-light flex-grow space-y-1.5 mb-8 leading-relaxed">
                <p>{{ block.settings.description | escape }}</p>
              </div>
              {% if block.settings.link_url != blank %}
                <a href="{{ block.settings.link_url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-sans font-medium text-white border-b border-white pb-1 w-max hover:text-gray-300 hover:border-gray-300 transition-colors">
                  {{ block.settings.link_text | escape }} 
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              {% endif %}
            </div>

        {% endcase %}
      {% endfor %}

    </div>
  </main>
</section>

<script>
  // Initial staggered fade in
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.stockist-card');
    cards.forEach((card, index) => {
      setTimeout(() => {
        card.classList.add('card-enter');
      }, 75 * index);
    });
  });

  // Filtering logic
  function filterStockists(type) {
    const cards = document.querySelectorAll('.stockist-card');
    const btns = document.querySelectorAll('.stockist-tab-btn');

    // Update button active states
    btns.forEach(btn => {
      if (btn.id === `btn-${type}`) {
        btn.classList.add('border-[#181615]', 'text-[#181615]');
        btn.classList.remove('border-transparent', 'text-gray-400');
      } else {
        btn.classList.remove('border-[#181615]', 'text-[#181615]');
        btn.classList.add('border-transparent', 'text-gray-400');
      }
    });

    // Animate cards out, filter, then animate back in
    let visibleIndex = 0;
    cards.forEach((card) => {
      card.classList.remove('card-enter');
      
      // Slight delay to allow fade out before hiding
      setTimeout(() => {
        card.classList.add('stockist-hide');
        
        if (type === 'all' || card.classList.contains(type)) {
          card.classList.remove('stockist-hide');
          
          // Force a reflow so the transition re-triggers
          void card.offsetWidth; 
          
          setTimeout(() => {
            card.classList.add('card-enter');
          }, 75 * visibleIndex); 
          visibleIndex++;
        }
      }, 200); // Matches CSS transition time somewhat
    });
  }
</script>

