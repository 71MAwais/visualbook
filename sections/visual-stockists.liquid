<section class="w-full bg-[#fafafa] py-24 px-6">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-2xl md:text-3xl font-serif text-[#1a1a1a] mb-16">{{ section.settings.title }}</h2>
    
    <div class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-80 mix-blend-multiply grayscale hover:grayscale-0 transition duration-500">
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}
          <img src="{{ block.settings.logo | img_url: '300x' }}" alt="{{ block.settings.name }}" class="h-8 md:h-12 object-contain" loading="lazy">
        {% else %}
          <span class="text-2xl font-serif font-bold">{{ block.settings.name }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visual Stockists (Logos)",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Available In-Store At" }
  ],
  "blocks": [
    {
      "type": "stockist",
      "name": "Store Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Store Logo" },
        { "type": "text", "id": "name", "label": "Store Name", "default": "Selfridges & Co" }
      ]
    }
  ],
  "presets": [{ "name": "Visual Stockists (Logos)" }]
}
{% endschema %}