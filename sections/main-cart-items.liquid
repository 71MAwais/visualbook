{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Custom Scrollbar & Utilities */
  .focus-ring:focus-visible { outline: 2px solid #111111; outline-offset: 2px; }
  
  /* Hide number input arrows */
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }

  /* Cart Loading State */
  .cart-page-loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
{%- endstyle -%}

<div id="MainCartContainer" class="max-w-[1400px] mx-auto px-6 lg:px-12 font-sans antialiased section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  
  <div class="text-center mb-12 md:mb-16">
    <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-[#111111] mb-4">{{ 'sections.cart.title' | t }}</h1>
    <a href="{{ routes.all_products_collection_url }}" class="text-[12px] text-stone-500 tracking-[0.15em] uppercase hover:text-[#C5A059] transition-colors underline underline-offset-4 decoration-stone-300">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>

  {%- if cart.item_count == 0 -%}
    <!-- EMPTY STATE -->
    <div class="flex flex-col items-center justify-center py-20 bg-stone-50/50 border border-stone-100 rounded-sm">
      <svg class="w-12 h-12 text-stone-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
      <h2 class="font-serif text-2xl text-[#111111] mb-3">{{ 'sections.cart.empty' | t }}</h2>
      <p class="text-[15px] text-stone-500 font-light mb-8 max-w-md text-center">Let's find the perfect way to preserve your memories. Explore our collection of premium visual books.</p>
      <a href="{{ routes.all_products_collection_url }}" class="focus-ring bg-[#111111] text-white px-10 py-4 text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] hover:shadow-lg transition-all duration-300">
        Shop The Collection
      </a>
    </div>

  {%- else -%}
    <!-- CART WITH ITEMS -->
    <form action="{{ routes.cart_url }}" method="post" id="FullCartForm" class="lg:grid lg:grid-cols-12 lg:gap-12 xl:gap-16 items-start transition-opacity duration-300">
      
      <!-- LEFT COLUMN: CART ITEMS -->
      <div class="lg:col-span-7 xl:col-span-8">
        
        <!-- Desktop Table Header -->
        <div class="hidden md:grid grid-cols-12 gap-4 pb-4 border-b border-stone-200 text-[11px] font-bold tracking-[0.15em] uppercase text-stone-400">
          <div class="col-span-6">{{ 'sections.cart.headings.product' | t }}</div>
          <div class="col-span-3 text-center">{{ 'sections.cart.headings.quantity' | t }}</div>
          <div class="col-span-3 text-right">{{ 'sections.cart.headings.total' | t }}</div>
        </div>

        <!-- Items Loop -->
        <div class="flex flex-col">
          {%- for item in cart.items -%}
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 py-8 border-b border-stone-100 items-center relative group">
              
              <!-- Product Image & Mobile Remove -->
              <div class="col-span-1 md:col-span-6 flex gap-6 items-center">
                <a href="{{ item.url }}" class="focus-ring block shrink-0 w-[100px] md:w-[120px] aspect-[4/5] bg-stone-50 p-2 rounded-sm overflow-hidden">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" class="w-full h-full object-contain mix-blend-multiply transition-transform duration-700 group-hover:scale-105">
                  {% else %}
                    <div class="w-full h-full bg-stone-200"></div>
                  {% endif %}
                </a>

                <div class="flex flex-col justify-center">
                  <a href="{{ item.url }}" class="focus-ring font-serif text-[17px] md:text-[19px] text-[#111111] hover:text-[#C5A059] transition-colors leading-tight mb-2 pr-6 md:pr-0">
                    {{ item.product.title | escape }}
                  </a>
                  
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="text-[12px] uppercase tracking-wider text-stone-500 font-medium mb-2">
                      {%- for option in item.options_with_values -%}
                        {{ option.value }}{% unless forloop.last %} / {% endunless %}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}

                  <div class="text-[14px] text-stone-500">
                    {{ item.original_price | money }}
                  </div>
                </div>

                <!-- Mobile Remove Button (Absolute top right on small screens) -->
                <button type="button" class="md:hidden absolute top-8 right-0 text-stone-400 hover:text-red-500 p-2" onclick="window.fullPageCart.updateQuantity('{{ item.key }}', 0)" aria-label="Remove {{ item.title }}">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>

              <!-- Quantity Selector -->
              <div class="col-span-1 md:col-span-3 flex justify-between md:justify-center items-center mt-4 md:mt-0">
                <span class="md:hidden text-[12px] uppercase tracking-widest font-bold text-stone-400">Quantity</span>
                <div class="flex items-center border border-stone-200 rounded-sm bg-white h-11 w-[110px]">
                  <button type="button" class="focus-ring flex-1 flex items-center justify-center text-stone-500 hover:text-[#111111] transition-colors h-full" onclick="window.fullPageCart.updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                  </button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-10 text-center text-[14px] font-medium text-[#111111] p-0 border-0 bg-transparent focus:ring-0" readonly>
                  <button type="button" class="focus-ring flex-1 flex items-center justify-center text-stone-500 hover:text-[#111111] transition-colors h-full" onclick="window.fullPageCart.updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                  </button>
                </div>
              </div>

              <!-- Total Price & Desktop Remove -->
              <div class="hidden md:flex col-span-3 justify-end items-center gap-6">
                <div class="text-right">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="text-[12px] text-stone-400 block">{{ item.original_line_price | money }}</s>
                    <span class="text-[16px] text-[#111111] font-medium block">{{ item.final_line_price | money }}</span>
                  {%- else -%}
                    <span class="text-[16px] text-[#111111] font-medium block">{{ item.original_line_price | money }}</span>
                  {%- endif -%}
                </div>
                <button type="button" class="focus-ring text-stone-400 hover:text-red-500 transition-colors p-2" onclick="window.fullPageCart.updateQuantity('{{ item.key }}', 0)" aria-label="Remove {{ item.title }}">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>

            </div>
          {%- endfor -%}
        </div>

        <!-- Order Special Instructions -->
        <div class="mt-12 border-t border-stone-200 pt-8">
          <label for="CartSpecialInstructions" class="flex items-center gap-2 text-[13px] font-bold tracking-widest uppercase text-[#111111] mb-4">
            <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            Order Special Instructions
          </label>
          <textarea id="CartSpecialInstructions" name="note" class="w-full max-w-xl border border-stone-200 p-4 text-[14px] focus:outline-none focus:border-[#C5A059] transition-colors resize-none rounded-sm bg-stone-50/30" rows="4" placeholder="How can we make this order special for you? Add gift notes or special requests here...">{{ cart.note }}</textarea>
        </div>

      </div>

      <!-- RIGHT COLUMN: SUMMARY & CHECKOUT -->
      <div class="lg:col-span-5 xl:col-span-4 mt-12 lg:mt-0">
        <div class="bg-stone-50 border border-stone-200/50 p-8 rounded-sm sticky top-28">
          
          <h2 class="font-serif text-2xl text-[#111111] mb-6 border-b border-stone-200 pb-4">Order Summary</h2>
          
          <div class="flex justify-between items-center mb-4">
            <span class="text-[14px] text-stone-500">Subtotal</span>
            <span class="text-[18px] text-[#111111] font-medium">{{ cart.total_price | money }}</span>
          </div>

          <div class="flex justify-between items-center mb-8 pb-6 border-b border-stone-200">
            <span class="text-[14px] text-stone-500">Shipping</span>
            <span class="text-[14px] text-stone-500 italic">Calculated at checkout</span>
          </div>

          <div class="flex justify-between items-end mb-8">
            <span class="text-[14px] text-[#111111] font-bold tracking-wide uppercase">Total</span>
            <span class="font-serif text-3xl text-[#111111] leading-none">{{ cart.total_price | money }}</span>
          </div>

          <button type="submit" name="checkout" class="focus-ring w-full bg-[#111111] text-white py-5 text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] transition-all duration-300 shadow-md hover:shadow-lg flex items-center justify-center gap-2 group mb-6">
            Secure Checkout 
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>

          <!-- Dynamic Express Checkout Buttons (Shopify Pay, Apple Pay, etc.) -->
          {% if additional_checkout_buttons %}
            <div class="additional-checkout-buttons w-full mb-6">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {% endif %}

          <!-- Trust Indicators -->
          <div class="flex flex-col items-center justify-center gap-4 border-t border-stone-200 pt-6 mt-2">
            <div class="flex items-center gap-2 text-[11px] text-stone-500 uppercase tracking-widest font-bold">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Secure 256-bit Checkout
            </div>
            <div class="flex justify-center items-center gap-3 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
                <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#222222"/><path d="M13.2 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/><path d="M22 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/><path d="M30.8 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/></svg>
                <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#EAE8E4"/><circle cx="14" cy="12" r="6" fill="#EA001B"/><circle cx="24" cy="12" r="6" fill="#F7A000" fill-opacity=".8"/></svg>
                <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#1A1F71"/><path d="M22 10.5h-4v3h4v-3zM25.5 10.5h-2.5v3h2.5c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5z" fill="#fff"/><path d="M12 10.5h-2v3h2c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5z" fill="#fff"/></svg>
            </div>
          </div>

        </div>
      </div>
      
    </form>
  {%- endif -%}

</div>

<script>
class FullPageCartManager {
  constructor() {
    this.container = document.getElementById('MainCartContainer');
    this.form = document.getElementById('FullCartForm');
    this.sectionId = this.container?.dataset.sectionId;
  }

  async updateQuantity(lineKey, quantity) {
    if (!this.form) return;
    
    // Add loading state
    this.form.classList.add('cart-page-loading');

    try {
      // 1. Update Shopify Cart
      await fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: lineKey, quantity: quantity })
      });

      // 2. Fetch updated section HTML
      const url = `${window.location.pathname}?section_id=${this.sectionId}`;
      const response = await fetch(url);
      const htmlText = await response.text();
      
      // 3. Parse and replace the content seamlessly
      const newHtml = new DOMParser().parseFromString(htmlText, 'text/html');
      const newContainer = newHtml.getElementById('MainCartContainer');
      
      if (newContainer) {
        this.container.innerHTML = newContainer.innerHTML;
        
        // Re-initialize elements after DOM replacement
        this.form = document.getElementById('FullCartForm');
        
        // Update header cart count bubbles if they exist
        const updatedCartReq = await fetch(window.Shopify.routes.root + 'cart.js');
        const updatedCart = await updatedCartReq.json();
        document.querySelectorAll('.cart-count-bubble, .header__cart-count').forEach(el => {
          el.textContent = updatedCart.item_count;
          el.classList.toggle('hidden', updatedCart.item_count === 0);
        });
      }

    } catch (error) {
      console.error('Cart update failed:', error);
      // Fallback: reload page if AJAX fails
      window.location.reload();
    } finally {
      if(this.form) this.form.classList.remove('cart-page-loading');
    }
  }
}

// Initialize
document.addEventListener('DOMContentLoaded', () => {
  window.fullPageCart = new FullPageCartManager();
});

// Save note on blur automatically so it doesn't get lost
document.addEventListener('blur', function(e) {
  if (e.target && e.target.id === 'CartSpecialInstructions') {
    fetch(window.Shopify.routes.root + 'cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note: e.target.value })
    });
  }
}, true);
</script>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Cart Items & Summary"
    }
  ]
}
{% endschema %}