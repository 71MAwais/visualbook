<style>
  .cart-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(3px);
    z-index: 9998; opacity: 0; visibility: hidden; transition: 0.4s ease;
  }
  .cart-overlay.is-active { opacity: 1; visibility: visible; }

  .cart-drawer-container {
    position: fixed; top: 0; right: 0; height: 100vh; width: 100%; max-width: 420px;
    background-color: white; z-index: 9999; transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex; flex-direction: column; font-family: 'Jost', sans-serif;
  }
  .cart-drawer-container.is-active { transform: translateX(0); }

  .cart-is-loading { opacity: 0.4; pointer-events: none; }
  .cart-scroll::-webkit-scrollbar { width: 4px; }
  .cart-scroll::-webkit-scrollbar-thumb { background: #EAEAEA; border-radius: 4px; }
  .focus-ring:focus-visible { outline: 2px solid #111111; outline-offset: 2px; }
</style>

<div id="CartDrawerOverlay" class="cart-overlay"></div>

<div id="VisualCartDrawer" class="cart-drawer-container shadow-2xl" data-cart-count="{{ cart.item_count }}">
  
  <div class="flex items-center justify-between px-6 py-6 border-b border-stone-100 shrink-0 bg-stone-50/50">
    <div class="flex items-center gap-3 text-[#111111]">
      <div class="w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h2 class="font-serif text-[18px] m-0 leading-none">Added to your bag</h2>
    </div>
    <button type="button" id="CloseCartBtn" class="focus-ring p-1 -mr-1 text-stone-400 hover:text-[#111111] transition-colors" aria-label="Close notification">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <div class="cart-scroll flex-grow overflow-y-auto px-6 py-4 transition-opacity duration-300" id="CartItemsArea">
    {%- if cart.item_count == 0 -%}
      <div class="flex flex-col items-center justify-center h-full text-center py-16">
        <svg class="w-10 h-10 text-stone-200 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <p class="font-serif text-xl text-[#111111] mb-2">Your bag is empty.</p>
        <p class="text-[14px] text-stone-500 font-light mb-8">Let's find the perfect way to preserve your memories.</p>
        <button type="button" class="bg-[#111111] text-white px-8 py-3.5 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] transition-colors inline-block" onclick="window.visualCartNotification.close()">Continue Shopping</button>
      </div>
    {%- else -%}
      <div class="flex flex-col gap-6 pt-2 pb-6">
        {%- for item in cart.items -%}
          <div class="flex gap-5 border-b border-stone-100 pb-6 last:border-0 last:pb-0">
            <a href="{{ item.url }}" class="block shrink-0 w-[85px] h-[105px] bg-stone-50 p-2 rounded-sm relative group overflow-hidden">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105">
              {% else %}
                <div class="w-full h-full bg-stone-200"></div>
              {% endif %}
            </a>
            <div class="flex flex-col flex-grow justify-center py-1">
              <div class="flex justify-between items-start mb-1">
                <a href="{{ item.url }}" class="font-serif text-[15px] text-[#111111] hover:text-[#C5A059] transition-colors leading-tight pr-4">
                  {{ item.product.title | escape }}
                </a>
                <button type="button" class="text-stone-400 hover:text-red-500 transition-colors p-1 -mt-1 -mr-1" onclick="window.visualCartNotification.updateQuantity('{{ item.key }}', 0)" aria-label="Remove">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </div>

              {%- unless item.product.has_only_default_variant -%}
                <p class="text-[11px] uppercase tracking-wider text-stone-500 font-medium mb-1">
                  {%- for option in item.options_with_values -%}
                    {{ option.value }}{% unless forloop.last %} / {% endunless %}
                  {%- endfor -%}
                </p>
              {%- endunless -%}

              <!-- CUSTOM PROPERTIES (SONG LINK) RENDERED HERE -->
              {%- if item.properties != empty -%}
                <div class="mb-3 text-[11px] text-stone-500 font-light bg-stone-50/50 p-2 rounded-sm border border-stone-100">
                  {%- for property in item.properties -%}
                    {%- assign property_first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and property_first_char != '_' -%}
                      <p class="m-0 leading-tight"><strong class="font-medium text-[#111111]">{{ property.first }}:</strong> {{ property.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="flex items-end justify-between mt-auto">
                <div class="flex items-center border border-stone-200 rounded-sm bg-white">
                  <button type="button" class="w-7 h-7 flex items-center justify-center text-stone-500 hover:text-[#111111] transition-colors" onclick="window.visualCartNotification.updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                  </button>
                  <span class="w-6 text-center text-[12px] font-medium text-[#111111]">{{ item.quantity }}</span>
                  <button type="button" class="w-7 h-7 flex items-center justify-center text-stone-500 hover:text-[#111111] transition-colors" onclick="window.visualCartNotification.updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                  </button>
                </div>
                <div class="text-right">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s class="text-[11px] text-stone-400 block">{{ item.original_line_price | money }}</s>
                    <span class="text-[14px] text-[#111111] font-medium block">{{ item.final_line_price | money }}</span>
                  {%- else -%}
                    <span class="text-[14px] text-[#111111] font-medium block">{{ item.original_line_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div id="CartFooterArea" class="px-6 pt-5 pb-8 border-t border-stone-100 bg-white shrink-0 transition-opacity duration-300 {% if cart.item_count == 0 %}hidden{% endif %}">
    <div class="flex justify-between items-end mb-6">
      <div class="flex flex-col">
        <span class="text-[11px] text-stone-500 uppercase tracking-widest font-bold mb-1">Subtotal</span>
        <span class="text-[11px] text-stone-400 font-light">Taxes & shipping calculated at checkout</span>
      </div>
      <span class="font-serif text-2xl text-[#111111] leading-none" id="CartSubtotal">{{ cart.total_price | money }}</span>
    </div>
    
    <div class="flex flex-col gap-3">
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="w-full bg-[#111111] text-white py-4.5 text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] transition-all duration-300 shadow-md flex items-center justify-center gap-2 group">
          Checkout 
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>
      <a href="/cart" class="w-full border border-[#111111] text-[#111111] text-center py-4 text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-stone-50 transition-colors">
        View Cart (<span id="FooterCartCount">{{ cart.item_count }}</span>)
      </a>
      <button type="button" class="mt-2 mx-auto text-[11px] text-stone-500 font-bold tracking-widest uppercase underline underline-offset-4 hover:text-[#111111] transition-colors" onclick="window.visualCartNotification.close()">
        Continue Shopping
      </button>
    </div>
  </div>
</div>

<script>
class VisualCartNotification {
  constructor() {
    this.drawer = document.getElementById('VisualCartDrawer');
    this.overlay = document.getElementById('CartDrawerOverlay');
    this.itemsArea = document.getElementById('CartItemsArea');
    this.footerArea = document.getElementById('CartFooterArea');
    if (!this.drawer) return;
    this.setupEventListeners();
    this.setupGlobalAddToCartInterceptor();
  }

  setupEventListeners() {
    document.getElementById('CloseCartBtn')?.addEventListener('click', () => this.close());
    this.overlay?.addEventListener('click', () => this.close());
  }

  setupGlobalAddToCartInterceptor() {
    window.addEventListener('submit', async (e) => {
      const action = e.target.getAttribute('action');
      if (action && action.includes('/cart/add')) {
        e.preventDefault();
        e.stopPropagation(); 
        
        const submitBtn = e.target.querySelector('button[type="submit"], input[type="submit"]');
        const originalHtml = submitBtn ? submitBtn.innerHTML : '';
        
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin mx-auto"></div>';
        }

        try {
          const formData = new FormData(e.target);
          await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });
          
          await this.refreshCart();
          this.open();

        } catch (error) {
          console.error('Error adding to cart:', error);
          alert('Failed to add item. Please try again.');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
            submitBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
            setTimeout(() => {
                submitBtn.classList.remove('bg-emerald-600', 'border-emerald-600');
            }, 2500);
          }
        }
      }
    }, true); 
  }

  open() {
    this.drawer.classList.add('is-active');
    this.overlay.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  close() {
    this.drawer.classList.remove('is-active');
    this.overlay.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  async updateQuantity(lineKey, quantity) {
    this.itemsArea.classList.add('cart-is-loading');
    try {
      await fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: lineKey, quantity: quantity })
      });
      await this.refreshCart();
    } catch (error) {
      console.error('Update failed:', error);
    } finally {
      this.itemsArea.classList.remove('cart-is-loading');
    }
  }

  async refreshCart() {
    try {
      const sectionUrl = `${window.Shopify.routes.root}?sections=cart-drawer`;
      const response = await fetch(sectionUrl);
      const json = await response.json();
      const newHtml = new DOMParser().parseFromString(json['cart-drawer'], 'text/html');
      const newItemsArea = newHtml.getElementById('CartItemsArea');
      const newFooterArea = newHtml.getElementById('CartFooterArea');
      const newDrawerWrapper = newHtml.getElementById('VisualCartDrawer');
      
      if (newItemsArea) this.itemsArea.innerHTML = newItemsArea.innerHTML;
      if (newFooterArea) this.footerArea.innerHTML = newFooterArea.innerHTML;
      
      if (newDrawerWrapper) {
          const newCount = newDrawerWrapper.dataset.cartCount;
          if (parseInt(newCount) === 0) {
            this.footerArea.classList.add('hidden');
          } else {
            this.footerArea.classList.remove('hidden');
          }
          document.querySelectorAll('.cart-count-bubble, .header__cart-count').forEach(el => {
            el.textContent = newCount;
            el.classList.toggle('hidden', parseInt(newCount) === 0);
          });
          const footerCountEl = document.getElementById('FooterCartCount');
          if (footerCountEl) footerCountEl.textContent = newCount;
      }
    } catch(err) {
      console.error('Refresh failed:', err);
    }
  }
}

document.addEventListener('DOMContentLoaded', () => {
  window.visualCartNotification = new VisualCartNotification();
});
</script>

{% schema %}
{
  "name": "Cart Notification",
  "settings": [],
  "presets": [
    {
      "name": "Cart Notification"
    }
  ]
}
{% endschema %}