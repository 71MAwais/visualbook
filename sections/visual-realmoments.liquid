{% comment %} sections/visual-realmoments.liquid {% endcomment %}

<style>
    /* Section Fonts */
    #real-moments-{{ section.id }} {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    #real-moments-{{ section.id }} .font-serif {
        font-family: 'Playfair Display', serif;
    }

    /* Showcase Center Focus Effects */
    .moment-card {
        transition: all 500ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.3;
        transform: scale(0.85);
        will-change: transform, opacity;
    }
    .moment-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
        box-shadow: 0 20px 50px -10px rgba(0,0,0,0.5);
    }
    
    /* Scroll Track Behaviors */
    #moments-track {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
    }
    #moments-track.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }

    /* Hide standard scrollbar */
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<section id="real-moments-{{ section.id }}" class="w-full bg-[#050505] py-8 md:py-12 flex flex-col items-center select-none overflow-hidden">

    <div class="w-full text-center pb-6 md:pb-8 px-5 flex-shrink-0 z-10">
        <p class="font-script text-[#B8906B] text-[24px] md:text-[28px] mb-1 md:mb-2 leading-none">{{ section.settings.subtitle }}</p>
        <h2 class="font-serif text-[32px] md:text-[42px] text-white tracking-tight leading-[1.1]">{{ section.settings.title }}</h2>
    </div>

    <div class="w-full relative group/carousel max-w-[1600px] mx-auto flex items-center">
        
        <div class="absolute top-0 left-0 w-[15vw] md:w-[20vw] h-full bg-gradient-to-r from-[#050505] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-[15vw] md:w-[20vw] h-full bg-gradient-to-l from-[#050505] to-transparent z-10 pointer-events-none"></div>
        
        <button aria-label="Previous Moment" id="moments-prev" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/10 flex items-center justify-center text-white/70 hover:bg-[#B8906B] hover:text-white hover:border-[#B8906B] transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 md:opacity-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button aria-label="Next Moment" id="moments-next" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/10 flex items-center justify-center text-white/70 hover:bg-[#B8906B] hover:text-white hover:border-[#B8906B] transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 md:opacity-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="moments-track" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full cursor-grab items-center py-8 relative">
            <div id="moments-start-spacer" class="shrink-0"></div>
            
            <div id="moments-card-container" class="flex gap-4 md:gap-6 items-center shrink-0">
                
                {% capture moment_cards %}
                    {% for block in section.blocks %}
                        <div class="moment-card flex-shrink-0 w-[65vw] sm:w-[240px] md:w-[280px] lg:w-[300px] aspect-[4/5] bg-[#111] snap-center relative overflow-hidden rounded-[4px] cursor-pointer group" data-real-index="{{ forloop.index0 }}">
                            
                            {% if block.settings.video != blank %}
                                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105' }}
                            {% elsif block.settings.image != blank %}
                                <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.handle | escape }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105" loading="lazy">
                            {% else %}
                                <div class="absolute inset-0 bg-[#111] flex items-center justify-center text-white/20 text-[10px] uppercase tracking-widest font-sans">No Media</div>
                            {% endif %}
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/10 flex items-center justify-center group-hover:bg-black/30 transition-colors duration-500">
                                <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/40 backdrop-blur-sm flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition-all duration-300 transform scale-95 group-hover:scale-100">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                </div>
                            </div>
                            
                            {% if block.settings.handle != blank %}
                                <div class="absolute bottom-5 left-5 text-white text-[12px] font-sans font-semibold tracking-widest uppercase z-10 drop-shadow-md">
                                    {{ block.settings.handle }}
                                </div>
                            {% endif %}
                            
                        </div>
                    {% else %}
                        {% for i in (1..4) %}
                            <div class="moment-card flex-shrink-0 w-[65vw] sm:w-[240px] md:w-[280px] lg:w-[300px] aspect-[4/5] bg-[#111] snap-center relative overflow-hidden rounded-[4px] cursor-pointer group" data-real-index="{{ forloop.index0 }}">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/10 flex items-center justify-center">
                                    <div class="w-12 h-12 rounded-full border border-white/40 backdrop-blur-sm flex items-center justify-center text-white">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    </div>
                                </div>
                                <div class="absolute bottom-5 left-5 text-white/50 text-[11px] font-sans tracking-widest uppercase font-semibold z-10">
                                    @your_handle
                                </div>
                            </div>
                        {% endfor %}
                    {% endfor %}
                {% endcapture %}

                {{ moment_cards }}
                {{ moment_cards }}
                {{ moment_cards }}
                {{ moment_cards }}
                {{ moment_cards }}

            </div>
            <div id="moments-end-spacer" class="shrink-0"></div>
        </div>
    </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('moments-track');
    const container = document.getElementById('moments-card-container');
    const prevBtn = document.getElementById('moments-prev');
    const nextBtn = document.getElementById('moments-next');
    
    if (!track || !container) return;

    const cards = Array.from(container.querySelectorAll('.moment-card'));
    if (cards.length === 0) return;

    // Calculate Spacer widths to perfectly center the first/last elements
    function adjustSpacers() {
        const cardWidth = cards[0].offsetWidth;
        const trackWidth = track.clientWidth;
        const space = (trackWidth / 2) - (cardWidth / 2);
        document.getElementById('moments-start-spacer').style.width = `${space}px`;
        document.getElementById('moments-end-spacer').style.width = `${space}px`;
    }

    // Scroll to specific card
    function scrollToCard(index, smooth = true) {
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (track.clientWidth / 2);
        
        track.style.scrollBehavior = smooth ? 'smooth' : 'auto';
        track.scrollLeft = scrollPos;
    }

    // Force cloned videos to play (iOS/Safari requirement for cloned DOM nodes)
    cards.forEach(card => {
        const video = card.querySelector('video');
        if (video) video.play();
    });

    // Initialize Infinite Loop Position
    let totalUniqueCards = {{ section.blocks.size }};
    if(totalUniqueCards === 0) totalUniqueCards = 4; 
    
    // Start cleanly in the middle of our clones
    let currentIndex = totalUniqueCards * 2; 

    // Update active classes on scroll
    let scrollTimeout;
    function handleScroll() {
        const trackCenter = track.scrollLeft + (track.clientWidth / 2);
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(trackCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
            }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));
        currentIndex = closestIndex;

        // Infinite Loop Safe-Jump Logic
        // If we scroll too close to the edges, jump back to the center segment silently
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex <= totalUniqueCards || closestIndex >= cards.length - totalUniqueCards) {
                const safeIndex = (closestIndex % totalUniqueCards) + (totalUniqueCards * 2);
                scrollToCard(safeIndex, false);
            }
        }, 150);
    }

    // Button Events
    if (prevBtn) prevBtn.addEventListener('click', () => scrollToCard(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => scrollToCard(currentIndex + 1));

    // Mouse Drag to Scroll
    let isDown = false, startX, scrollLeft;
    track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', () => { isDown = false; track.classList.remove('dragging'); });
    track.addEventListener('mouseup', () => { isDown = false; track.classList.remove('dragging'); });
    track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        track.scrollLeft = scrollLeft - (x - startX) * 2;
    });

    // Init
    track.addEventListener('scroll', handleScroll);
    window.addEventListener('resize', () => {
        adjustSpacers();
        scrollToCard(currentIndex, false);
    });

    // Run setup
    adjustSpacers();
    setTimeout(() => {
        scrollToCard(currentIndex, false);
        handleScroll();
    }, 100);
});
</script>

{% schema %}
{
  "name": "Real Moments",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Community" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Real Moments" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Social Moment",
      "settings": [
        { "type": "video", "id": "video", "label": "Video File (Optional)" },
        { "type": "image_picker", "id": "image", "label": "Image/Thumbnail (Optional)" },
        { "type": "text", "id": "handle", "label": "Social Handle", "default": "@the_visual_book" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real Moments",
      "blocks": [
        { "type": "moment", "settings": { "handle": "@sarah_weddings" } },
        { "type": "moment", "settings": { "handle": "@the_miller_family" } },
        { "type": "moment", "settings": { "handle": "@emma.gifting" } },
        { "type": "moment", "settings": { "handle": "@joshua_memories" } }
      ]
    }
  ]
}
{% endschema %}