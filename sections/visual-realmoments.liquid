{% comment %} sections/visual-realmoments.liquid {% endcomment %}

<style>
    #real-moments-{{ section.id }} { font-family: 'Plus Jakarta Sans', sans-serif; }
    #real-moments-{{ section.id }} .font-serif { font-family: 'Playfair Display', serif; }

    /* Showcase Center Focus Effects */
    .moment-card {
        transition: all 600ms cubic-bezier(0.22, 1, 0.36, 1);
        transform-origin: center center;
        opacity: 0.3;
        transform: scale(0.85);
        will-change: transform, opacity;
    }
    .moment-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
        box-shadow: 0 20px 50px -15px rgba(0,0,0,0.6);
    }
    
    /* Play/Pause Button Logic */
    .play-pause-indicator {
        transition: all 0.3s ease;
        opacity: 1;
    }
    .active-card.is-playing .play-pause-indicator {
        opacity: 0;
        transform: scale(0.8);
    }
    .active-card.is-playing:hover .play-pause-indicator {
        opacity: 1;
        transform: scale(1);
    }

    /* Scroll Track Behaviors */
    #moments-track {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        touch-action: pan-y; 
    }
    #moments-track.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }

    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .moment-arrow {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
    }
    .moment-arrow:hover {
        background: #B8906B;
        border-color: #B8906B;
        color: white;
        transform: translateY(-50%) scale(1.1);
    }
</style>

<section id="real-moments-{{ section.id }}" class="w-full bg-[#050505] py-10 md:py-16 flex flex-col items-center select-none overflow-hidden">

    <div class="w-full text-center pb-8 md:pb-12 px-5 flex-shrink-0 z-10">
        <p class="font-script text-[#B8906B] text-[24px] md:text-[30px] mb-2 leading-none">{{ section.settings.subtitle }}</p>
        <h2 class="font-serif text-[36px] md:text-[52px] text-white tracking-tight leading-[1.1]">{{ section.settings.title }}</h2>
    </div>

    <div class="w-full relative group/carousel max-w-[1800px] mx-auto flex items-center px-4 md:px-12">
        
        <button aria-label="Previous" id="moments-prev" class="moment-arrow absolute left-4 md:left-12 top-1/2 -translate-y-1/2 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center text-white/70">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        
        <button aria-label="Next" id="moments-next" class="moment-arrow absolute right-4 md:right-12 top-1/2 -translate-y-1/2 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center text-white/70">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="moments-track" class="flex overflow-x-auto hide-scrollbar w-full cursor-grab items-center py-10 relative">
            <div id="moments-start-spacer" class="shrink-0"></div>
            
            <div id="moments-card-container" class="flex gap-4 md:gap-8 items-center shrink-0">
                
                {% capture moment_cards %}
                    {% for block in section.blocks %}
                        <div class="moment-card flex-shrink-0 w-[75vw] sm:w-[280px] md:w-[320px] lg:w-[350px] aspect-[4/5] bg-[#111] snap-center relative overflow-hidden rounded-[4px] cursor-pointer group" data-index="{{ forloop.index0 }}">
                            
                            {% if block.settings.video != blank %}
                                <video preload="none" loop muted playsinline class="absolute inset-0 w-full h-full object-cover">
                                    {% for source in block.settings.video.sources %}
                                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                                    {% endfor %}
                                </video>
                            {% elsif block.settings.image != blank %}
                                <img src="{{ block.settings.image | img_url: '1000x' }}" alt="{{ block.settings.handle }}" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
                            {% endif %}
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-70"></div>
                            
                            <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
                                <div class="play-pause-indicator w-14 h-14 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
                                    <svg class="play-svg w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    <svg class="pause-svg w-6 h-6 hidden" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                                </div>
                            </div>

                            {% if block.settings.handle != blank %}
                                <div class="absolute bottom-6 left-6 text-white text-[13px] font-sans font-bold tracking-widest uppercase z-10">
                                    {{ block.settings.handle }}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endcapture %}

                {{ moment_cards }}
                {{ moment_cards }}
                {{ moment_cards }}
            </div>

            <div id="moments-end-spacer" class="shrink-0"></div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('real-moments-{{ section.id }}');
    const track = document.getElementById('moments-track');
    const container = document.getElementById('moments-card-container');
    const prevBtn = document.getElementById('moments-prev');
    const nextBtn = document.getElementById('moments-next');
    
    if (!track || !container) return;

    const cards = Array.from(container.querySelectorAll('.moment-card'));
    const totalUnique = {{ section.blocks.size }};
    if (totalUnique === 0) return;

    function adjustSpacers() {
        const cardWidth = cards[0].offsetWidth;
        const space = (track.clientWidth / 2) - (cardWidth / 2);
        document.getElementById('moments-start-spacer').style.minWidth = `${space}px`;
        document.getElementById('moments-end-spacer').style.minWidth = `${space}px`;
    }

    function scrollToCard(index, smooth = true) {
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        track.style.scrollBehavior = smooth ? 'smooth' : 'auto';
        track.scrollLeft = cardCenter - (track.clientWidth / 2);
    }

    let currentIndex = totalUnique;
    let isJumping = false;
    let isVisible = false;

    function handleScroll() {
        if (isJumping) return;
        const trackCenter = track.scrollLeft + (track.clientWidth / 2);
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const diff = Math.abs(trackCenter - (card.offsetLeft + card.offsetWidth / 2));
            if (diff < minDiff) { minDiff = diff; closestIndex = i; }
        });

        cards.forEach((card, i) => {
            const isActive = i === closestIndex;
            card.classList.toggle('active-card', isActive);
            const video = card.querySelector('video');
            const playSvg = card.querySelector('.play-svg');
            const pauseSvg = card.querySelector('.pause-svg');

            if (video) {
                if (isActive && isVisible) {
                    if (!card.classList.contains('manual-pause')) {
                        video.play().catch(() => {});
                        card.classList.add('is-playing');
                        playSvg.classList.add('hidden');
                        pauseSvg.classList.remove('hidden');
                    }
                } else {
                    video.pause();
                    card.classList.remove('is-playing');
                    playSvg.classList.remove('hidden');
                    pauseSvg.classList.add('hidden');
                }
            }
        });

        currentIndex = closestIndex;

        if (closestIndex < totalUnique / 2 || closestIndex > cards.length - (totalUnique / 2) - 1) {
            isJumping = true;
            const targetIndex = (closestIndex % totalUnique) + totalUnique;
            setTimeout(() => {
                track.style.scrollSnapType = 'none';
                scrollToCard(targetIndex, false);
                track.style.scrollSnapType = 'x mandatory';
                isJumping = false;
            }, 50);
        }
    }

    cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
            if (!card.classList.contains('active-card')) {
                card.classList.remove('manual-pause');
                scrollToCard(idx);
                return;
            }
            const video = card.querySelector('video');
            if (!video) return;
            const playSvg = card.querySelector('.play-svg');
            const pauseSvg = card.querySelector('.pause-svg');

            if (video.paused) {
                video.play();
                card.classList.add('is-playing');
                card.classList.remove('manual-pause');
                playSvg.classList.add('hidden');
                pauseSvg.classList.remove('hidden');
            } else {
                video.pause();
                card.classList.remove('is-playing');
                card.classList.add('manual-pause');
                playSvg.classList.remove('hidden');
                pauseSvg.classList.add('hidden');
            }
        });
    });

    const obs = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
        handleScroll();
    }, { threshold: 0.2 });
    obs.observe(section);

    track.addEventListener('scroll', handleScroll);
    prevBtn.addEventListener('click', () => scrollToCard(currentIndex - 1));
    nextBtn.addEventListener('click', () => scrollToCard(currentIndex + 1));

    window.addEventListener('resize', adjustSpacers);
    adjustSpacers();
    setTimeout(() => scrollToCard(currentIndex, false), 100);
});
</script>

{% schema %}
{
  "name": "Real Moments",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Community" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Real Moments" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Social Moment",
      "settings": [
        { "type": "video", "id": "video", "label": "Video File" },
        { "type": "image_picker", "id": "image", "label": "Fallback Image" },
        { "type": "text", "id": "handle", "label": "Social Handle", "default": "@the_visual_book" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real Moments"
    }
  ]
}
{% endschema %}