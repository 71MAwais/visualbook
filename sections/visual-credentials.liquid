{% comment %} sections/visual-credentials.liquid {% endcomment %}

<section class="py-16 md:py-24 bg-white" id="credentials-{{ section.id }}">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8 text-center">
        
        {% if section.settings.subtitle != blank %}
            <p class="font-script text-[#B8906B] text-2xl md:text-3xl mb-2">{{ section.settings.subtitle }}</p>
        {% endif %}
        
        {% if section.settings.title != blank %}
            <h2 class="font-serif text-3xl md:text-5xl font-light tracking-tight mb-14 text-black">{{ section.settings.title }}</h2>
        {% endif %}
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {% for block in section.blocks %}
                <div class="p-8 md:p-12 border border-black/5 rounded-sm shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] transition-all duration-500 bg-white" {{ block.shopify_attributes }}>
                    
                    <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-[#B8906B]/10 flex items-center justify-center">
                        {% if block.settings.icon != blank %}
                            <i data-lucide="{{ block.settings.icon }}" class="w-8 h-8 text-[#B8906B] stroke-[1.5]"></i>
                        {% else %}
                            <i data-lucide="award" class="w-8 h-8 text-[#B8906B] stroke-[1.5]"></i>
                        {% endif %}
                    </div>
                    
                    <h3 class="font-serif text-2xl mb-2 text-black">{{ block.settings.title }}</h3>
                    <p class="text-[10px] uppercase tracking-[0.2em] text-[#B8906B] font-semibold mb-4">{{ block.settings.subtitle }}</p>
                    <p class="text-sm text-black/50 leading-relaxed max-w-sm mx-auto">{{ block.settings.text }}</p>
                    
                </div>
            {% endfor %}
        </div>
        
    </div>
</section>

<script>
    document.addEventListener('shopify:section:load', function() {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });
</script>

{% schema %}
{
  "name": "Credentials",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Recognised Excellence" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Award Winning & Exclusive" }
  ],
  "blocks": [
    {
      "type": "credential",
      "name": "Credential Card",
      "limit": 4,
      "settings": [
        { 
          "type": "text", 
          "id": "icon", 
          "label": "Lucide Icon Name", 
          "default": "award",
          "info": "Find icon names at lucide.dev/icons (e.g. 'award', 'shield-check', 'star')"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "2023 Winner" },
        { "type": "text", "id": "subtitle", "label": "Badge Text", "default": "Best Luxury Wedding Memory Preservation" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Recognised by the Luxury Wedding Awards for our unparalleled commitment to preserving life's most precious moments with artisan craftsmanship." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Credentials",
      "blocks": [
        { 
          "type": "credential",
          "settings": {
            "icon": "award",
            "title": "2023 Winner",
            "subtitle": "Best Luxury Wedding Memory Preservation",
            "text": "Recognised by the Luxury Wedding Awards for our unparalleled commitment to preserving life's most precious moments with artisan craftsmanship."
          }
        },
        { 
          "type": "credential",
          "settings": {
            "icon": "shield-check",
            "title": "Intellectual Property",
            "subtitle": "UK IPO Certified — Registered Design",
            "text": "Our unique Visual Book design is registered and protected under the UK Intellectual Property Office, guaranteeing the authenticity and originality of every piece."
          }
        }
      ]
    }
  ]
}
{% endschema %}