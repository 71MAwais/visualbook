{% comment %} sections/visual-reviews.liquid {% endcomment %}

<style>
    /* Section Fonts */
    #visual-reviews-{{ section.id }} {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    #visual-reviews-{{ section.id }} .font-serif {
        font-family: 'Playfair Display', serif;
    }

    /* Showcase Center Focus Effects */
    .review-card {
        transition: all 500ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.35;
        transform: scale(0.85);
        will-change: transform, opacity;
    }
    .review-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
        border-color: #e5e5e5;
    }
    
    /* Scroll Track Behaviors */
    #reviews-track {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
    }
    #reviews-track.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }

    /* Hide standard scrollbar */
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Restrict text height so cards remain short and uniform */
    .line-clamp-4 {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>

<section id="visual-reviews-{{ section.id }}" class="w-full bg-[#FAFAFA] py-8 md:py-12 flex flex-col items-center select-none overflow-hidden border-y border-stone-100/50">

    <div class="w-full text-center pb-6 px-5 flex-shrink-0 z-10">
        <p class="font-script text-[#B8906B] text-[24px] md:text-[28px] mb-1 md:mb-2 leading-none">{{ section.settings.subtitle }}</p>
        <h2 class="font-serif text-[32px] md:text-[40px] text-stone-950 tracking-tight leading-[1.1]">{{ section.settings.title }}</h2>
        
        {% if section.settings.show_rating %}
        <div class="flex items-center justify-center gap-1 mt-3">
            {% for i in (1..5) %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#F5C04F" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {% endfor %}
            <span class="ml-2 text-[12px] text-stone-500 font-semibold">{{ section.settings.rating_text }}</span>
        </div>
        {% endif %}
    </div>

    <div class="w-full relative group/carousel max-w-[1600px] mx-auto flex items-center">
        
        <div class="absolute top-0 left-0 w-[10vw] md:w-[20vw] h-full bg-gradient-to-r from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-[10vw] md:w-[20vw] h-full bg-gradient-to-l from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        
        <button aria-label="Previous Review" id="review-prev" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white shadow-md border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 md:opacity-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button aria-label="Next Review" id="review-next" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white shadow-md border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all duration-300 opacity-0 group-hover/carousel:opacity-100 md:opacity-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="reviews-track" class="flex overflow-x-auto hide-scrollbar w-full cursor-grab items-stretch py-6 relative">
            <div id="review-start-spacer" class="shrink-0"></div>
            
            <div id="review-card-container" class="flex gap-4 md:gap-6 items-stretch shrink-0 h-full">
                
                {% capture review_cards %}
                    {% for block in section.blocks %}
                        <div class="review-card flex-shrink-0 w-[75vw] sm:w-[300px] md:w-[340px] snap-center flex flex-col justify-between bg-white border border-stone-200 p-6 rounded-[6px]" data-real-index="{{ forloop.index0 }}">
                            
                            <div>
                                <div class="flex items-center gap-1 mb-3">
                                    {% for i in (1..5) %}
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="{% if i <= block.settings.stars %}#F5C04F{% else %}#E5E5E5{% endif %}" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    {% endfor %}
                                </div>
                                <h4 class="text-[16px] font-bold text-stone-950 mb-2 leading-tight">{{ block.settings.title }}</h4>
                                <p class="text-[14px] text-stone-500 font-normal leading-relaxed line-clamp-4">{{ block.settings.text }}</p>
                            </div>
                            
                            <div class="mt-5 pt-4 border-t border-stone-100 flex items-center justify-between">
                                <div class="flex flex-col">
                                    <span class="text-[13px] font-bold text-stone-950 tracking-wide">{{ block.settings.author }}</span>
                                    {% if block.settings.verified %}
                                        <span class="text-[10px] font-medium text-stone-400 mt-0.5 uppercase tracking-widest">Verified Buyer</span>
                                    {% endif %}
                                </div>
                                {% if block.settings.verified %}
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="#16a34a" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                                {% endif %}
                            </div>
                            
                        </div>
                    {% else %}
                        {% for i in (1..3) %}
                            <div class="review-card flex-shrink-0 w-[75vw] sm:w-[300px] md:w-[340px] snap-center flex flex-col justify-between bg-white border border-stone-200 p-6 rounded-[6px]" data-real-index="{{ forloop.index0 }}">
                                <div>
                                    <div class="flex items-center gap-1 mb-3">
                                        {% for j in (1..5) %}<svg width="16" height="16" viewBox="0 0 24 24" fill="#F5C04F" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endfor %}
                                    </div>
                                    <h4 class="text-[16px] font-bold text-stone-950 mb-2 leading-tight">Beautifully Crafted</h4>
                                    <p class="text-[14px] text-stone-500 font-normal leading-relaxed line-clamp-4">Add a review in the Shopify customizer.</p>
                                </div>
                                <div class="mt-5 pt-4 border-t border-stone-100 flex justify-between items-center">
                                    <div class="flex flex-col">
                                        <span class="text-[13px] font-bold text-stone-950 tracking-wide">Customer Name</span>
                                        <span class="text-[10px] font-medium text-stone-400 mt-0.5 uppercase tracking-widest">Verified Buyer</span>
                                    </div>
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="#16a34a" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                                </div>
                            </div>
                        {% endfor %}
                    {% endfor %}
                {% endcapture %}

                {{ review_cards }}
                {{ review_cards }}
                {{ review_cards }}
                {{ review_cards }}
                {{ review_cards }}

            </div>
            <div id="review-end-spacer" class="shrink-0"></div>
        </div>
    </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('reviews-track');
    const container = document.getElementById('review-card-container');
    const prevBtn = document.getElementById('review-prev');
    const nextBtn = document.getElementById('review-next');
    
    if (!track || !container) return;

    const cards = Array.from(container.querySelectorAll('.review-card'));
    if (cards.length === 0) return;

    function adjustSpacers() {
        if(cards.length === 0) return;
        const cardWidth = cards[0].offsetWidth;
        const trackWidth = track.clientWidth;
        const space = (trackWidth / 2) - (cardWidth / 2);
        document.getElementById('review-start-spacer').style.width = `${space}px`;
        document.getElementById('review-end-spacer').style.width = `${space}px`;
    }

    function scrollToCard(index, smooth = true) {
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (track.clientWidth / 2);
        
        track.style.scrollBehavior = smooth ? 'smooth' : 'auto';
        track.scrollLeft = scrollPos;
    }

    let totalUniqueCards = {{ section.blocks.size }};
    if(totalUniqueCards === 0) totalUniqueCards = 3; 
    let currentIndex = totalUniqueCards * 2; 

    let scrollTimeout;
    let isJumping = false;

    function handleScroll() {
        if (isJumping) return;
        
        const trackCenter = track.scrollLeft + (track.clientWidth / 2);
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(trackCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
            }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));
        currentIndex = closestIndex;

        // INFINITE LOOP FIX: Temporarily disable snap to prevent browser fighting JS
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex <= totalUniqueCards || closestIndex >= cards.length - totalUniqueCards - 1) {
                isJumping = true;
                const safeIndex = (closestIndex % totalUniqueCards) + (totalUniqueCards * 2);
                
                track.style.scrollBehavior = 'auto';
                track.style.scrollSnapType = 'none'; // Critical fix
                
                const cardCenter = cards[safeIndex].offsetLeft + (cards[safeIndex].offsetWidth / 2);
                track.scrollLeft = cardCenter - (track.clientWidth / 2);
                
                cards.forEach(c => c.classList.remove('active-card'));
                cards[safeIndex].classList.add('active-card');
                
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        track.style.scrollSnapType = 'x mandatory';
                        track.style.scrollBehavior = 'smooth';
                        isJumping = false;
                    });
                });
            }
        }, 150);
    }

    if (prevBtn) prevBtn.addEventListener('click', () => scrollToCard(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => scrollToCard(currentIndex + 1));

    let isDown = false, startX, scrollLeft;
    track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', () => { isDown = false; track.classList.remove('dragging'); });
    track.addEventListener('mouseup', () => { isDown = false; track.classList.remove('dragging'); });
    track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        track.scrollLeft = scrollLeft - (x - startX) * 2;
    });

    track.addEventListener('scroll', handleScroll);
    window.addEventListener('resize', () => {
        adjustSpacers();
        scrollToCard(currentIndex, false);
    });

    adjustSpacers();
    setTimeout(() => {
        scrollToCard(currentIndex, false);
        handleScroll();
    }, 100);
});
</script>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Testimonials" },
    { "type": "text", "id": "title", "label": "Heading", "default": "From our Customers" },
    { "type": "checkbox", "id": "show_rating", "label": "Show Aggregate Rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating Text", "default": "4.9 / 5 — 2,400+ Reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Manual Review Card",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Star Rating", "default": 5 },
        { "type": "text", "id": "title", "label": "Review Title", "default": "Absolutely Beautiful" },
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "The craftsmanship is unmatched. It truly feels like a modern heirloom for our family." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Sarah M." },
        { "type": "checkbox", "id": "verified", "label": "Show Verified Badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}