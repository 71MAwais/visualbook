{% comment %}
  Section: main-page.liquid
  Description: Centered title, reduced spacing, editable padding/width, and optimized for rich text and images.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Optimized styling for Shopify's default rich text editor (Text & Images) */
  .page-content-wrapper {
    word-break: break-word;
  }
  .page-content-wrapper img {
    max-width: 100%;
    height: auto;
    border-radius: 8px; /* Soft edges for images */
    margin: 2rem auto;
    display: block;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05); /* Slight shadow for embedded pictures */
  }
  .page-content-wrapper iframe {
    max-width: 100%;
    border-radius: 8px;
    margin: 2rem auto;
    display: block;
  }
  .page-content-wrapper p {
    margin-bottom: 1.25rem;
  }
  .page-content-wrapper p:last-child {
    margin-bottom: 0;
  }
  .page-content-wrapper h2, 
  .page-content-wrapper h3, 
  .page-content-wrapper h4 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #111111;
    font-family: serif;
    font-weight: 500;
  }
  .page-content-wrapper h2 { font-size: 1.75rem; }
  .page-content-wrapper h3 { font-size: 1.5rem; }
  
  .page-content-wrapper ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .page-content-wrapper ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .page-content-wrapper a {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: #111111;
    transition: color 0.2s ease;
  }
  .page-content-wrapper a:hover {
    color: #555555;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding bg-[#FCFCFC] antialiased">
  <div class="mx-auto px-[15px] md:px-8" style="max-width: {{ section.settings.content_width }}px;">
    
    {%- if section.settings.show_title -%}
      <h1 class="text-3xl md:text-4xl font-serif font-medium text-center text-stone-900 mb-5 md:mb-8 leading-tight">
        {{ page.title | escape }}
      </h1>
    {%- endif -%}

    <div class="page-content-wrapper visual-prose text-[15px] md:text-[16px] text-stone-700 leading-relaxed font-light">
      {{ page.content }}
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Show Page Title"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Maximum Width",
      "info": "Narrow is usually best for reading blocks of text.",
      "options": [
        {
          "value": "680",
          "label": "Narrow (Optimized for Reading)"
        },
        {
          "value": "800",
          "label": "Medium"
        },
        {
          "value": "1000",
          "label": "Wide (Better for large images)"
        }
      ],
      "default": "800"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ]
}
{% endschema %}