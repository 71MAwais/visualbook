{%- if product -%}
<style>
    /* Section Fonts */
    #visual-reviews-{{ section.id }} {
        font-family: var(--font-sans, 'Inter', sans-serif);
    }
    #visual-reviews-{{ section.id }} .font-serif {
        font-family: var(--font-display, 'Cormorant Garamond', serif);
    }

    /* Refined Card Design (From Store-wide Design) */
    .review-card {
        transition: all 500ms ease;
        transform-origin: center center;
        opacity: 0.4;
        transform: scale(0.9);
        cursor: pointer;
        will-change: transform, opacity;
    }
    .review-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
    }
    
    /* Native Scroll Track Behaviors */
    #reviews-track {
        -webkit-user-select: none;
        user-select: none;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }
    #reviews-track.dragging {
        cursor: grabbing;
        scroll-snap-type: none !important; 
    }
    
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .line-clamp-4 {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }

    /* Static Grid Override Styles */
    .static-mode {
        overflow: visible !important;
        justify-content: center !important;
        touch-action: auto !important;
        cursor: default !important;
        scroll-snap-type: none !important;
    }
    .static-mode-container {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: center !important;
        width: 100% !important;
    }
    .static-mode-container .review-card {
        cursor: default !important;
    }

    /* Navigation Arrows */
    .review-arrow {
        transform: translate3d(0, -50%, 0);
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: all 0.3s ease;
    }
    @media (hover: hover) and (pointer: fine) {
        .review-arrow:hover {
            color: #0c0a09;
            background-color: #ffffff;
            transform: translate3d(0, -50%, 0) scale(1.05);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
    }
    .review-arrow:active {
        transform: translate3d(0, -50%, 0) scale(0.95);
    }
</style>

{%- comment -%} 
  DYNAMIC RATING EXTRACTION FOR PRODUCT
{%- endcomment -%}
{%- assign jm_badge = product.metafields.judgeme.badge -%}
{%- assign rating_val = jm_badge | split: "data-average-rating='" | last | split: "'" | first | default: '5.0' -%}
{%- assign review_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | default: '0' -%}

{%- comment -%} Fallback if app hasn't synced yet {%- endcomment -%}
{%- if review_count == '0' or review_count == blank or review_count == '0.0' -%}
  {%- assign rating_val = "5.0" -%}
  {%- assign review_count = section.settings.fallback_review_count | default: "0" -%}
{%- endif -%}

<section id="visual-reviews-{{ section.id }}" class="w-full bg-[#FAFAFA] py-16 md:py-24 flex flex-col items-center select-none overflow-hidden">

    {%- comment -%} CUSTOM UI: HEADER & SUMMARY (Using Store-wide Style) {%- endcomment -%}
    <div class="w-full text-center pb-10 px-5 flex-shrink-0 z-10">
        <p class="text-[#181615] text-[14px] md:text-[16px] font-semibold uppercase tracking-[0.2em] mb-3">{{ section.settings.subtitle }}</p>
        <h2 class="font-serif text-[36px] md:text-[48px] text-stone-900 tracking-tight leading-tight">{{ section.settings.title }}</h2>
        
        {% if section.settings.show_rating %}
        <div class="flex flex-col items-center justify-center gap-4 mt-6">
            <div class="flex items-center gap-1.5">
                {%- assign rating_floor = rating_val | floor -%}
                {% for i in (1..5) %}
                    {% if i <= rating_floor %}
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="#F59E0B" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {% else %}
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="#E5E5E5" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {% endif %}
                {% endfor %}
                <span class="ml-2 text-[15px] text-stone-700 font-medium">{{ rating_val }} / 5 — Based on {{ review_count }} Reviews</span>
            </div>

            <button type="button" id="open-judgeme-modal-btn" class="mt-2 inline-flex items-center justify-center text-[12px] font-bold uppercase tracking-[0.15em] text-stone-900 border border-stone-900 px-6 py-3 rounded-full hover:bg-stone-900 hover:text-white transition-all duration-300 cursor-pointer">
                Write a Review
            </button>
        </div>
        {% endif %}
    </div>

    {%- comment -%} CUSTOM UI: TRACK {%- endcomment -%}
    <div class="w-full relative group/carousel max-w-[1800px] mx-auto flex items-center">
        
        <div class="absolute top-0 left-0 w-[15vw] md:w-[25vw] h-full bg-gradient-to-r from-[#FAFAFA] to-transparent z-10 pointer-events-none transition-opacity duration-300" id="gradient-left"></div>
        <div class="absolute top-0 right-0 w-[15vw] md:w-[25vw] h-full bg-gradient-to-l from-[#FAFAFA] to-transparent z-10 pointer-events-none transition-opacity duration-300" id="gradient-right"></div>
        
        <button aria-label="Previous Review" id="review-prev" class="review-arrow absolute left-4 md:left-10 top-1/2 z-20 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white shadow-lg border border-stone-100 flex items-center justify-center text-stone-600 cursor-pointer transition-opacity duration-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button aria-label="Next Review" id="review-next" class="review-arrow absolute right-4 md:right-10 top-1/2 z-20 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white shadow-lg border border-stone-100 flex items-center justify-center text-stone-600 cursor-pointer transition-opacity duration-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="reviews-track" class="flex overflow-x-auto hide-scrollbar w-full cursor-grab items-center py-10 relative transition-all duration-300">
            <div id="start-spacer" class="shrink-0 w-[50vw]"></div>
            <div id="review-card-container" class="flex gap-6 md:gap-8 items-stretch shrink-0 h-full transition-all duration-300"></div>
            <div id="end-spacer" class="shrink-0 w-[50vw]"></div>
        </div>
    </div>

</section>

{%- comment -%} 
  SECURE LAYER HIGHEST INDEX MODAL PORTAL WINDOW MOUNT
{%- endcomment -%}
<div id="judgeme-modal-wrapper" class="fixed inset-0 flex flex-col items-center justify-center bg-stone-900/80 backdrop-blur-md px-4 py-10 transition-all duration-300 opacity-0 pointer-events-none" style="z-index: -1;" role="dialog" aria-modal="true">
    
    <div id="judgeme-modal-content" class="bg-white rounded-2xl shadow-2xl w-full max-w-5xl max-h-[90vh] overflow-y-auto p-8 md:p-12 relative transform scale-95 transition-transform duration-300 custom-scrollbar">
        
        <button id="close-judgeme-modal-btn" type="button" aria-label="Close review modal" class="focus-ring absolute top-6 right-6 p-2 text-stone-400 hover:text-stone-900 hover:bg-stone-100 rounded-full transition-colors bg-white cursor-pointer" style="z-index: 2147483647;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="w-full mt-4" id="jdgm-widget-mount">
             <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
               {{ product.metafields.judgeme.widget }}
             </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

    const modalWrapper = document.getElementById('judgeme-modal-wrapper');
    if (modalWrapper && document.body) {
        document.body.appendChild(modalWrapper);
    }

    const cardContainer = document.getElementById('review-card-container');
    const scrollContainer = document.getElementById('reviews-track');
    const fullModal = document.getElementById('judgeme-modal-wrapper');
    const modalContent = document.getElementById('judgeme-modal-content');
    const openModalBtn = document.getElementById('open-judgeme-modal-btn');
    const closeModalBtn = document.getElementById('close-judgeme-modal-btn');
    
    const prevBtn = document.getElementById('review-prev');
    const nextBtn = document.getElementById('review-next');
    const startSpacer = document.getElementById('start-spacer');
    const endSpacer = document.getElementById('end-spacer');
    const gradLeft = document.getElementById('gradient-left');
    const gradRight = document.getElementById('gradient-right');

    let originalReviewCardsHtml = [];
    let isCarouselEnabled = false;
    let totalOriginal = 0;
    
    let isJumping = false;
    let isTouching = false; 
    let scrollTimeout = null;
    let autoScrollTimer = null;
    let isInteracting = false;
    let isDown = false;
    let startX, scrollLeft;
    
    const AUTO_SCROLL_DELAY = {{ section.settings.autoplay_speed | default: 3 }} * 1000;

    // Open/Close Modal Controller Architecture
    function openReviewModal() {
        if (!fullModal || !modalContent) return;
        fullModal.classList.remove('opacity-0', 'pointer-events-none');
        fullModal.classList.add('opacity-100', 'pointer-events-auto');
        fullModal.style.zIndex = '2147483647'; 
        
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');

        let tries = 0;
        const reviewInterval = setInterval(() => {
            const writeReviewBtn = fullModal.querySelector('.jdgm-write-rev-link');
            
            if (writeReviewBtn) {
                clearInterval(reviewInterval);
                if (!writeReviewBtn.classList.contains('jdgm-opened')) {
                    writeReviewBtn.click();
                }
            }
            
            tries++;
            if (tries > 20) clearInterval(reviewInterval);
        }, 200);
    }

    function closeReviewModal() {
        if (!fullModal || !modalContent) return;
        fullModal.classList.add('opacity-0', 'pointer-events-none');
        fullModal.classList.remove('opacity-100', 'pointer-events-auto');
        
        modalContent.classList.add('scale-95');
        modalContent.classList.remove('scale-100');

        setTimeout(() => {
            fullModal.style.zIndex = '-1';
        }, 300);
    }

    if(openModalBtn) openModalBtn.addEventListener('click', openReviewModal);
    if(closeModalBtn) closeModalBtn.addEventListener('click', closeReviewModal);
    if(fullModal) fullModal.addEventListener('click', (e) => { if(e.target === fullModal) closeReviewModal(); });

    // ============================================
    // DOM PARSING & RESPONSIVE RENDER LOGIC
    // ============================================
    function extractJudgeMeReviews(reviewsNodeList) {
        originalReviewCardsHtml = [];
        if (reviewsNodeList && reviewsNodeList.length > 0) {
            const reviewsArray = Array.from(reviewsNodeList).slice(0, 15);
            reviewsArray.forEach(rev => {
                const author = rev.querySelector('.jdgm-rev__author')?.innerText.trim() || 'Verified Buyer';
                const title = rev.querySelector('.jdgm-rev__title')?.innerText.trim() || '';
                const body = rev.querySelector('.jdgm-rev__body')?.innerText.trim() || '';
                const ratingEl = rev.querySelector('.jdgm-rev__rating');
               
                const ratingScore = ratingEl ? parseInt(ratingEl.getAttribute('data-score')) || 5 : 5;
                const isVerified = !!rev.querySelector('.jdgm-rev__buyer-badge');

                let starsHtml = '';
                for(let i=1; i<=5; i++) {
                    let fill = i <= ratingScore ? '#F59E0B' : '#E5E5E5';
                    starsHtml += `<svg width="20" height="20" viewBox="0 0 24 24" fill="${fill}" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
                }

                const verifiedHtml = isVerified ? `<svg width="24" height="24" viewBox="0 0 24 24" fill="#16a34a" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>` : '';
                const verifiedText = isVerified ? `<span class="text-[11px] font-bold text-green-700 mt-1 uppercase tracking-widest">Verified Buyer</span>` : '';

                const cardHtml = `
                    <div class="review-card flex-shrink-0 w-[85vw] sm:w-[340px] md:w-[380px] snap-center flex flex-col justify-between bg-white border border-stone-200 shadow-sm rounded-3xl p-8 md:p-10">
                        <div>
                            <div class="flex items-center gap-1 mb-5">
                                ${starsHtml}
                            </div>
                            ${title ? `<h3 class="text-[18px] font-bold text-stone-900 mb-3 leading-snug">${title}</h3>` : ''}
                            <p class="text-[15px] text-stone-600 font-normal leading-relaxed line-clamp-4">"${body}"</p>
                        </div>
                        <div class="mt-8 pt-6 border-t border-stone-100 flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="text-[15px] font-bold text-stone-900 tracking-wide">${author}</span>
                                ${verifiedText}
                            </div>
                            ${verifiedHtml}
                        </div>
                    </div>
                 `;
                originalReviewCardsHtml.push(cardHtml);
            });
        }
        
        renderUI();
    }

    function renderUI() {
        if (!cardContainer || !scrollContainer) return;
        let count = originalReviewCardsHtml.length;
        let w = window.innerWidth;
        let isStatic = false;

        if (count === 0) {
            isCarouselEnabled = false;
            scrollContainer.classList.add('static-mode');
            cardContainer.classList.add('static-mode-container');
            if (prevBtn) prevBtn.style.display = 'none';
            if (nextBtn) nextBtn.style.display = 'none';
            if (startSpacer) startSpacer.style.display = 'none';
            if (endSpacer) endSpacer.style.display = 'none';
            if (gradLeft) gradLeft.style.display = 'none';
            if (gradRight) gradRight.style.display = 'none';
            cardContainer.innerHTML = `
                <div class="review-card active-card static-card flex-shrink-0 w-[85vw] sm:w-[340px] md:w-[380px] snap-center flex flex-col justify-center items-center text-center bg-white border border-stone-200 shadow-sm p-10 rounded-3xl">
                    <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mb-5">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#181615" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </div>
                    <h3 class="text-[18px] font-bold text-stone-950 mb-2">No reviews yet</h3>
                    <p class="text-[15px] text-stone-500 font-medium mb-8">Be the first to share your experience with us.</p>
                    <button type="button" onclick="document.getElementById('open-judgeme-modal-btn')?.click()" class="bg-stone-900 text-white text-[12px] font-bold uppercase tracking-[0.15em] py-3.5 px-8 hover:bg-stone-800 transition-colors cursor-pointer rounded-full">Write a Review</button>
                </div>
            `;
            return;
        }

        // Breakpoint parameters to switch layouts layout configurations dynamically
        if (w >= 1024 && count <= 3) isStatic = true;
        else if (w >= 768 && w < 1024 && count <= 2) isStatic = true;
        else if (w < 768 && count <= 1) isStatic = true;

        if (isStatic) {
            isCarouselEnabled = false;
            clearTimeout(autoScrollTimer);
            scrollContainer.classList.add('static-mode');
            cardContainer.classList.add('static-mode-container');
            if (prevBtn) prevBtn.style.display = 'none';
            if (nextBtn) nextBtn.style.display = 'none';
            if (startSpacer) startSpacer.style.display = 'none';
            if (endSpacer) endSpacer.style.display = 'none';
            if (gradLeft) gradLeft.style.display = 'none';
            if (gradRight) gradRight.style.display = 'none';

            cardContainer.innerHTML = originalReviewCardsHtml.join('');
            Array.from(cardContainer.children).forEach(c => {
                c.classList.add('active-card', 'static-card');
                c.style.opacity = '1';
                c.style.transform = 'scale(1)';
            });
        } else {
            isCarouselEnabled = true;
            scrollContainer.classList.remove('static-mode');
            cardContainer.classList.remove('static-mode-container');
            if (prevBtn) prevBtn.style.display = 'flex';
            if (nextBtn) nextBtn.style.display = 'flex';
            if (startSpacer) startSpacer.style.display = 'block';
            if (endSpacer) endSpacer.style.display = 'block';
            if (gradLeft) gradLeft.style.display = 'block';
            if (gradRight) gradRight.style.display = 'block';

            buildCarouselDOM();
        }
    }

    // Instantly catch review element mutations using a high performance MutationObserver
    function initFastReviewExtraction() {
        const widgetMount = document.getElementById('jdgm-widget-mount');
        if (!widgetMount) return;

        let initialReviews = widgetMount.querySelectorAll('.jdgm-rev');
        if (initialReviews.length > 0) {
            extractJudgeMeReviews(initialReviews);
            return;
        }

        const reviewCount = parseInt('{{ review_count }}') || 0;
        if (reviewCount === 0) {
            extractJudgeMeReviews([]);
            return;
        }

        const observer = new MutationObserver((mutations, obs) => {
            const rawReviews = widgetMount.querySelectorAll('.jdgm-rev');
            if (rawReviews.length > 0) {
                obs.disconnect();
                extractJudgeMeReviews(rawReviews);
            }
        });
        observer.observe(widgetMount, { childList: true, subtree: true });

        setTimeout(() => {
            const rawReviews = widgetMount.querySelectorAll('.jdgm-rev');
            if (rawReviews.length === 0) {
                observer.disconnect();
                extractJudgeMeReviews([]);
            }
        }, 5000);
    }
    
    initFastReviewExtraction();

    window.addEventListener('resize', () => {
        if (originalReviewCardsHtml.length > 0) {
            let count = originalReviewCardsHtml.length;
            let w = window.innerWidth;
            let shouldBeStatic = (w >= 1024 && count <= 3) || (w >= 768 && w < 1024 && count <= 2) || (w < 768 && count <= 1);
             
            if (shouldBeStatic && isCarouselEnabled) {
                renderUI();
            } else if (!shouldBeStatic && !isCarouselEnabled) {
                renderUI();
            } else if (isCarouselEnabled) {
                adjustSpacers();
                const activeCard = document.querySelector('.review-card.active-card');
                if (activeCard) jumpToIndexSilently(parseInt(activeCard.dataset.index));
            }
        }
    });

    // ============================================
    // CAROUSEL BUILD & EVENT LOGIC
    // ============================================
    function queueNextAutoScroll() {
        if (!isCarouselEnabled) return;
        clearTimeout(autoScrollTimer);
        if (isInteracting || isJumping || isDown || isTouching || AUTO_SCROLL_DELAY === 0) return;
        autoScrollTimer = setTimeout(() => {
            if (isInteracting || isJumping || isDown || isTouching || !isCarouselEnabled) return;
            const active = document.querySelector('.review-card.active-card:not(.static-card)');
            if (active) {
                scrollToCard(parseInt(active.dataset.index) + 1);
            }
        }, AUTO_SCROLL_DELAY);
    }

    function buildCarouselDOM() {
        cardContainer.innerHTML = '';
        totalOriginal = originalReviewCardsHtml.length;
        for (let i = 0; i < 3; i++) {
            originalReviewCardsHtml.forEach((html, idx) => {
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const clone = tempDiv.firstElementChild;
                
                clone.dataset.index = (i * totalOriginal) + idx;
                clone.dataset.realIndex = idx;
                clone.addEventListener('click', () => {
                    if (!isCarouselEnabled) return;
                    scrollToCard(parseInt(clone.dataset.index));
                    queueNextAutoScroll();
                });
                cardContainer.appendChild(clone);
            });
        }

        adjustSpacers();
        
        isJumping = true;
        scrollContainer.style.scrollSnapType = 'none';
        const cards = Array.from(cardContainer.children);
        if (cards[totalOriginal]) {
            const initialPos = cards[totalOriginal].offsetLeft + (cards[totalOriginal].offsetWidth / 2) - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = initialPos;
            cards[totalOriginal].classList.add('active-card');
            
            requestAnimationFrame(() => {
                if (isCarouselEnabled) scrollContainer.style.scrollSnapType = 'x mandatory';
                isJumping = false;
                queueNextAutoScroll();
            });
        }
    }

    function adjustSpacers() {
        if (!isCarouselEnabled) return;
        const firstCard = cardContainer.children[0];
        if (!firstCard) return;

        const cardWidth = firstCard.offsetWidth || 380;
        const containerWidth = scrollContainer.clientWidth;
        const space = (containerWidth / 2) - (cardWidth / 2);

        if(startSpacer) startSpacer.style.width = `${space}px`;
        if(endSpacer) endSpacer.style.width = `${space}px`;
    }

    function scrollToCard(index) {
        if (!isCarouselEnabled) return;
        const cards = Array.from(cardContainer.children);
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
        scrollContainer.scrollTo({ left: scrollPos, behavior: 'smooth' });
    }

    function jumpToIndexSilently(index) {
        if (!isCarouselEnabled) return;
        isJumping = true;
        scrollContainer.style.scrollSnapType = 'none'; 
        
        const cards = Array.from(cardContainer.children);
        cards.forEach(c => c.style.transition = 'none');
        if (cards[index]) {
            const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
            const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = scrollPos;
            
            cards.forEach(c => c.classList.remove('active-card'));
            cards[index].classList.add('active-card');
        }
        
        void scrollContainer.offsetWidth;
        requestAnimationFrame(() => {
            cards.forEach(c => c.style.transition = '');
            if (isCarouselEnabled) scrollContainer.style.scrollSnapType = 'x mandatory';
            
            setTimeout(() => { 
                isJumping = false; 
                queueNextAutoScroll();
             }, 50);
        });
    }

    function handleScroll() {
        if (!isCarouselEnabled || isJumping || totalOriginal === 0) return;
        const cards = Array.from(cardContainer.children);
        const containerCenter = scrollContainer.scrollLeft + (scrollContainer.clientWidth / 2);
        
        let minDiff = Infinity;
        let closestIndex = 0;
        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(containerCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
             }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (isTouching || isDown || !isCarouselEnabled) return;

            if (closestIndex < totalOriginal || closestIndex >= totalOriginal * 2) {
                const safeIndex = (closestIndex % totalOriginal) + totalOriginal;
                jumpToIndexSilently(safeIndex);
            } else {
                 queueNextAutoScroll(); 
            }
        }, 250);
    }

    if (scrollContainer) {
        scrollContainer.addEventListener('mouseenter', () => { if (!isCarouselEnabled) return; isInteracting = true; clearTimeout(autoScrollTimer); });
        scrollContainer.addEventListener('mouseleave', () => { if (!isCarouselEnabled) return; isInteracting = false; if (!isDown && !isTouching) queueNextAutoScroll(); });
        scrollContainer.addEventListener('touchstart', () => { 
            if (!isCarouselEnabled) return;
            isTouching = true; 
            isInteracting = true;
            clearTimeout(autoScrollTimer); 
        }, { passive: true });
        scrollContainer.addEventListener('touchend', () => { 
            if (!isCarouselEnabled) return;
            isTouching = false; 
            isInteracting = false;
            handleScroll(); 
        }, { passive: true });
        scrollContainer.addEventListener('touchcancel', () => { 
            if (!isCarouselEnabled) return;
            isTouching = false; 
            isInteracting = false;
        }, { passive: true });
        scrollContainer.addEventListener('scroll', handleScroll, { passive: true });

        scrollContainer.addEventListener('mousedown', (e) => {
            if (!isCarouselEnabled) return;
            isDown = true;
            isInteracting = true;
            clearTimeout(autoScrollTimer);
            scrollContainer.classList.add('dragging');
            startX = e.pageX - scrollContainer.offsetLeft;
             scrollLeft = scrollContainer.scrollLeft;
        });
        scrollContainer.addEventListener('mouseleave', () => { 
            if(isDown && isCarouselEnabled) {
                isDown = false; 
                isInteracting = false;
                scrollContainer.classList.remove('dragging'); 
                handleScroll(); 
            }
        });
        scrollContainer.addEventListener('mouseup', () => { 
            if(isDown && isCarouselEnabled) {
                isDown = false; 
                isInteracting = false;
                scrollContainer.classList.remove('dragging'); 
                handleScroll(); 
            }
        });
        scrollContainer.addEventListener('mousemove', (e) => {
            if (!isDown || !isCarouselEnabled) return;
            e.preventDefault();
            const x = e.pageX - scrollContainer.offsetLeft;
            const walk = (x - startX) * 2;
            scrollContainer.scrollLeft = scrollLeft - walk;
        });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => {
        if (!isCarouselEnabled) return;
        clearTimeout(autoScrollTimer);
        const active = document.querySelector('.review-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
        if (!isCarouselEnabled) return;
        clearTimeout(autoScrollTimer);
        const active = document.querySelector('.review-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) + 1);
    });
});
</script>
{%- endif -%}

