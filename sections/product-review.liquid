    { "type": "text", "id": "title", "label": "Heading", "default": "From our Customers" },
    { "type": "checkbox", "id": "show_rating", "label": "Show Aggregate Rating", "default": true },
    { "type": "text", "id": "fallback_review_count", "label": "Fallback Review Count", "default": "0", "info": "Shows if product has 0 reviews yet." },
    { 
      "type": "range", 
      "id": "autoplay_speed", 
      "min": 0, 
      "max": 10, 
      "step": 1, 
      "unit": "sec", 
      "label": "Auto-scroll Delay (0 to disable)", 
      "default": 3 
    }
  ],
  "presets": [
    {
      "name": "Product Reviews Section"
    }
  ]
}
