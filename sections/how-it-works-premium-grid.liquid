        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Connect To Your Computer"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "To setup your Classic Visual Book, connect it to your computer using the included USB cable."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "header",
          "content": "Optional Inner Button (e.g., Converter)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works - Premium Grid",
      "blocks": [
        { "type": "step", "settings": { "title": "Connect To Your Computer" } },
        { "type": "step", "settings": { "title": "Effortless Media Management" } },
        { "type": "step", "settings": { "title": "Gift-Ready Book" } },
        { "type": "step", "settings": { "title": "Video Compatibility" } }
      ]
    }
  ]
}
