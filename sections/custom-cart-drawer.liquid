<style>
  /* Base Cart Drawer Styles */
  .custom-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100vh;
    width: 100%;
    max-w-[420px]; /* Max width on larger screens */
    background-color: white;
    z-index: 9999;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    font-family: 'Jost', sans-serif;
  }

  .custom-cart-drawer.is-open {
    transform: translateX(0);
  }

  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .cart-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Custom Scrollbar for Cart Items */
  .cart-items-container::-webkit-scrollbar {
    width: 4px;
  }
  .cart-items-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .cart-items-container::-webkit-scrollbar-thumb {
    background: #EAEAEA;
    border-radius: 4px;
  }

  /* Loading State */
  .cart-is-loading .cart-items-container {
    opacity: 0.5;
    pointer-events: none;
  }
  
  .cart-spinner {
    display: none;
    width: 20px;
    height: 20px;
    border: 2px solid #f3f3f3;
    border-top: 2px solid #111111;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .cart-is-loading .cart-spinner {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  /* Focus utilities */
  .focus-ring:focus-visible { outline: 2px solid #111111; outline-offset: 2px; }
</style>

<!-- Overlay -->
<div id="CartDrawerOverlay" class="cart-drawer-overlay"></div>

<!-- Drawer Container -->
<div id="CartDrawer" class="custom-cart-drawer sm:w-[420px] shadow-2xl flex flex-col" aria-modal="true" role="dialog" tabindex="-1">
  
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-stone-100 shrink-0">
    <h2 class="font-serif text-[22px] text-[#111111] tracking-wide m-0">Your Bag <span class="cart-count-bubble text-sm text-stone-400 font-sans ml-1 font-light" data-cart-count>({{ cart.item_count }})</span></h2>
    <button type="button" class="close-cart-btn focus-ring p-2 -mr-2 text-stone-400 hover:text-[#111111] transition-colors" aria-label="Close cart">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar (Optional/Fake Logic for Demo) -->
  <div class="px-6 py-4 bg-stone-50 border-b border-stone-100 shrink-0 text-center">
      <p class="text-[11px] uppercase tracking-widest text-[#111111] font-bold mb-2">You are eligible for free shipping!</p>
      <div class="w-full bg-stone-200 h-1 rounded-full overflow-hidden">
          <div class="bg-[#C5A059] h-full w-full rounded-full"></div>
      </div>
  </div>

  <!-- Cart Items Area -->
  <div class="cart-items-container flex-grow overflow-y-auto px-6 py-2 relative">
    <div class="cart-spinner z-50"></div>
    
    <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="h-full flex flex-col">
      
      {%- if cart.item_count == 0 -%}
        <!-- Empty State -->
        <div class="empty-cart-message flex flex-col items-center justify-center h-full text-center py-20">
          <svg class="w-12 h-12 text-stone-200 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          <p class="font-serif text-xl text-[#111111] mb-2">Your bag is empty.</p>
          <p class="text-sm text-stone-500 font-light mb-8">Ready to preserve your memories?</p>
          <a href="/collections/all" class="close-cart-btn focus-ring bg-[#111111] text-white px-8 py-3.5 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] transition-colors">Shop the collection</a>
        </div>
      {%- else -%}
        
        <!-- Items Wrapper -->
        <div class="cart-items-wrapper pt-4 flex flex-col gap-6" data-cart-items>
          {%- for item in cart.items -%}
            <div class="cart-item flex gap-5 pb-6 border-b border-stone-100 last:border-0" data-key="{{ item.key }}">
              
              <!-- Product Image -->
              <a href="{{ item.url }}" class="cart-item-image focus-ring block shrink-0 w-[90px] h-[110px] bg-stone-50 p-2 flex items-center justify-center rounded-sm">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}"
                       alt="{{ item.image.alt | escape }}"
                       loading="lazy"
                       class="w-full h-full object-contain mix-blend-multiply drop-shadow-md">
                {% else %}
                  <div class="w-full h-full bg-stone-200"></div>
                {% endif %}
              </a>

              <!-- Product Details -->
              <div class="cart-item-details flex flex-col flex-grow justify-center py-1">
                <div class="flex justify-between items-start mb-1">
                  <a href="{{ item.url }}" class="cart-item-title focus-ring font-serif text-[15px] text-[#111111] hover:text-[#C5A059] transition-colors leading-tight pr-4">
                    {{ item.product.title | escape }}
                  </a>
                  <button type="button" class="cart-remove-btn focus-ring text-stone-400 hover:text-red-500 transition-colors p-1 -mt-1 -mr-1" data-key="{{ item.key }}" aria-label="Remove {{ item.title }}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </div>

                <!-- Variants / Properties (if any) -->
                {%- unless item.product.has_only_default_variant -%}
                  <p class="text-[12px] text-stone-500 font-light mb-2">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}

                <!-- Price & Quantity -->
                <div class="flex items-end justify-between mt-auto pt-2">
                  
                  <!-- Quantity Selector -->
                  <div class="cart-quantity-selector flex items-center border border-stone-200 rounded-sm">
                    <button type="button" class="qty-btn minus focus-ring w-8 h-8 flex items-center justify-center text-stone-500 hover:text-[#111111] hover:bg-stone-50 transition-colors" data-action="minus" aria-label="Decrease quantity">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                    </button>
                    <input class="qty-input focus-ring w-8 h-8 text-center text-[13px] font-medium text-[#111111] p-0 border-0 bg-transparent appearance-none" 
                           type="number" 
                           name="updates[]" 
                           value="{{ item.quantity }}" 
                           min="0" 
                           aria-label="Quantity for {{ item.title }}" 
                           data-key="{{ item.key }}">
                    <button type="button" class="qty-btn plus focus-ring w-8 h-8 flex items-center justify-center text-stone-500 hover:text-[#111111] hover:bg-stone-50 transition-colors" data-action="plus" aria-label="Increase quantity">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </button>
                  </div>

                  <!-- Price -->
                  <div class="cart-item-price text-right">
                    {%- if item.original_line_price != item.final_line_price -%}
                      <s class="text-[11px] text-stone-400 block">{{ item.original_line_price | money }}</s>
                      <span class="text-[15px] text-[#111111] font-medium block">{{ item.final_line_price | money }}</span>
                    {%- else -%}
                      <span class="text-[15px] text-[#111111] font-medium block">{{ item.original_line_price | money }}</span>
                    {%- endif -%}
                  </div>

                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </form>
  </div>

  <!-- Footer Area (Only show if cart has items) -->
  <div class="cart-drawer-footer px-6 pt-5 pb-8 border-t border-stone-100 bg-white shrink-0 {% if cart.item_count == 0 %}hidden{% endif %}" data-cart-footer>
    
    <div class="flex justify-between items-center mb-4">
      <span class="text-[13px] text-stone-500 uppercase tracking-wider font-bold">Subtotal</span>
      <span class="font-serif text-xl text-[#111111]" data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>
    
    <p class="text-[11px] text-stone-500 font-light mb-6 text-center">Shipping, taxes, and discount codes calculated at checkout.</p>
    
    <form action="{{ routes.cart_url }}" method="post" id="CartDrawerCheckoutForm">
      <button type="submit" name="checkout" class="focus-ring w-full bg-[#111111] text-white py-4.5 text-[12px] font-bold tracking-[0.2em] uppercase hover:bg-[#C5A059] transition-all duration-300 shadow-lg flex items-center justify-center gap-2 group">
        Checkout 
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </button>
    </form>
    
    <!-- Trust Badges -->
    <div class="flex justify-center items-center gap-4 mt-6 opacity-60 grayscale">
        <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#222222"/><path d="M13.2 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/><path d="M22 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/><path d="M30.8 14.8l-1.5-1.5c-1-1-1.6-1.5-2.6-1.5-1.3 0-2.3 1-2.3 2.3 0 1.2 1 2.3 2.3 2.3 1 0 1.6-.5 2.6-1.5l1.5-1.5z" fill="#fff"/></svg>
        <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#EAE8E4"/><circle cx="14" cy="12" r="6" fill="#EA001B"/><circle cx="24" cy="12" r="6" fill="#F7A000" fill-opacity=".8"/></svg>
        <svg class="h-5" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#1A1F71"/><path d="M22 10.5h-4v3h4v-3zM25.5 10.5h-2.5v3h2.5c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5z" fill="#fff"/><path d="M12 10.5h-2v3h2c.8 0 1.5-.7 1.5-1.5s-.7-1.5-1.5-1.5z" fill="#fff"/></svg>
    </div>
  </div>
</div>

<script>
class CustomCartDrawer {
  constructor() {
    this.drawer = document.getElementById('CartDrawer');
    this.overlay = document.getElementById('CartDrawerOverlay');
    this.form = document.getElementById('CartDrawerForm');
    this.container = this.drawer.querySelector('.cart-items-container');
    
    this.bindEvents();
  }

  bindEvents() {
    // Close Drawer Events
    const closeBtns = document.querySelectorAll('.close-cart-btn');
    closeBtns.forEach(btn => btn.addEventListener('click', () => this.close()));
    this.overlay.addEventListener('click', () => this.close());

    // Listen for custom open event (triggered by header cart icon or quick add buttons)
    document.addEventListener('cart:open', () => this.open());
    
    // Bind AJAX actions inside the cart
    this.bindCartActions();
  }

  bindCartActions() {
    if(!this.form) return;

    // Quantity Buttons (+/-)
    const qtyBtns = this.form.querySelectorAll('.qty-btn');
    qtyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const input = btn.parentElement.querySelector('.qty-input');
        const action = btn.dataset.action;
        let currentQty = parseInt(input.value);

        if (action === 'plus') {
          currentQty += 1;
        } else if (action === 'minus' && currentQty > 0) {
          currentQty -= 1;
        }
        
        input.value = currentQty;
        this.updateItem(input.dataset.key, currentQty);
      });
    });

    // Quantity Input Manual Change
    const qtyInputs = this.form.querySelectorAll('.qty-input');
    qtyInputs.forEach(input => {
      input.addEventListener('change', () => {
        this.updateItem(input.dataset.key, input.value);
      });
    });

    // Remove Buttons
    const removeBtns = this.form.querySelectorAll('.cart-remove-btn');
    removeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        this.updateItem(btn.dataset.key, 0);
      });
    });
  }

  open() {
    this.drawer.classList.add('is-open');
    this.overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
    
    // Accessibility focus trap logic could go here
  }

  close() {
    this.drawer.classList.remove('is-open');
    this.overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  async updateItem(line, quantity) {
    this.drawer.classList.add('cart-is-loading');

    try {
      // 1. Update Cart via Shopify AJAX API
      const response = await fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: line,
          quantity: quantity
        })
      });

      const newCartState = await response.json();

      // 2. Fetch the Section HTML to re-render the drawer UI
      // We append ?sections=custom-cart-drawer to the cart URL to just get this section's HTML back
      const sectionResponse = await fetch(`${window.Shopify.routes.root}cart?sections=custom-cart-drawer`);
      const sectionsData = await sectionResponse.json();
      
      // Parse the returned HTML
      const newDrawerHtml = new DOMParser().parseFromString(sectionsData['custom-cart-drawer'], 'text/html');
      
      // 3. Swap out the old content with the new content
      const oldInnerContent = this.drawer.innerHTML;
      const newInnerContent = newDrawerHtml.getElementById('CartDrawer').innerHTML;
      this.drawer.innerHTML = newInnerContent;

      // 4. Update Header Bubble Cart Count globally (if it exists on the page)
      document.querySelectorAll('.cart-count-bubble').forEach(el => {
        el.textContent = `(${newCartState.item_count})`;
        // Hide/show logic depending on your theme setup
        if(newCartState.item_count === 0) {
            el.classList.add('hidden');
        } else {
            el.classList.remove('hidden');
        }
      });

      // 5. Re-bind events since we replaced the DOM elements
      this.form = document.getElementById('CartDrawerForm');
      this.bindCartActions();
      const closeBtns = document.querySelectorAll('.close-cart-btn');
      closeBtns.forEach(btn => btn.addEventListener('click', () => this.close()));

    } catch (error) {
      console.error('Error updating cart:', error);
      alert('There was an error updating your cart. Please try again.');
    } finally {
      this.drawer.classList.remove('cart-is-loading');
    }
  }
}

// Initialize the drawer
document.addEventListener('DOMContentLoaded', () => {
  window.customCartDrawer = new CustomCartDrawer();
  
  // Attach event to header cart icon to open drawer
  // Find your theme's header cart button and add this class: js-cart-drawer-trigger
  const headerCartLinks = document.querySelectorAll('.js-cart-drawer-trigger, a[href="/cart"]');
  headerCartLinks.forEach(link => {
      link.addEventListener('click', (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent('cart:open'));
      });
  });
});
</script>

{% schema %}
{
  "name": "Custom Cart Drawer",
  "settings": [],
  "presets": [
    {
      "name": "Custom Cart Drawer"
    }
  ]
}
{% endschema %}