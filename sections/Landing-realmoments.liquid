{% comment %} sections/visual-realmoments.liquid {% endcomment %}

<style>
    #real-moments-{{ section.id }} { font-family: 'Plus Jakarta Sans', sans-serif; }
    #real-moments-{{ section.id }} .font-serif { font-family: 'Playfair Display', serif; }

    /* Showcase Center Focus Effects */
    .moment-card {
        transition: all 500ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.35;
        transform: scale(0.85);
        will-change: transform, opacity;
    }
    .moment-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
        box-shadow: 0 20px 50px -15px rgba(0,0,0,0.6);
    }
    
    /* Play/Pause Button Logic */
    .play-pause-indicator {
        transition: all 0.3s ease;
        opacity: 1;
    }
    .active-card.is-playing .play-pause-indicator {
        opacity: 0;
        transform: scale(0.8);
    }
    .active-card.is-playing:hover .play-pause-indicator {
        opacity: 1;
        transform: scale(1);
    }

    /* EXACT Scroll Track Behaviors */
    #moments-track {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }
    #moments-track.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }

    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Rock-Solid Navigation Arrows */
    .moment-arrow {
        transform: translate3d(0, -50%, 0);
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: transform 0.2s ease, background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }
    @media (hover: hover) and (pointer: fine) {
        .moment-arrow:hover {
            background: #B8906B;
            border-color: #B8906B;
            color: white;
            transform: translate3d(0, -50%, 0) scale(1.05);
        }
    }
    .moment-arrow:active {
        transform: translate3d(0, -50%, 0) scale(0.95);
    }
</style>

<section id="real-moments-{{ section.id }}" class="w-full bg-[#050505] py-6 md:py-10 flex flex-col items-center select-none overflow-hidden" aria-labelledby="moments-title">

    <div class="w-full text-center pb-4 md:pb-8 px-5 flex-shrink-0 z-10">
        <p class="font-script text-[#B8906B] text-[24px] md:text-[30px] mb-1.5 leading-none">{{ section.settings.subtitle }}</p>
        <h2 id="moments-title" class="font-serif text-[36px] md:text-[52px] text-white tracking-tight leading-[1.1]">{{ section.settings.title }}</h2>
    </div>

    <div class="w-full relative group/carousel max-w-[1800px] mx-auto flex items-center px-4 md:px-12">
        
        <button aria-label="Previous" id="moments-prev" class="moment-arrow absolute left-4 md:left-12 top-1/2 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center text-white/70">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        
        <button aria-label="Next" id="moments-next" class="moment-arrow absolute right-4 md:right-12 top-1/2 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center text-white/70">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="moments-track" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full cursor-grab items-center py-6 relative">
            <div id="moments-start-spacer" class="shrink-0 w-[50vw]"></div>
            <div id="moments-card-container" class="flex gap-4 md:gap-8 items-center shrink-0"></div>
            <div id="moments-end-spacer" class="shrink-0 w-[50vw]"></div>
        </div>
    </div>
</section>

{%- comment -%} 🚀 TEMPLATE: Fast Loading Native Video {%- endcomment -%}
<template id="moments-data">
    {% for block in section.blocks %}
        <div class="moment-card flex-shrink-0 w-[75vw] sm:w-[280px] md:w-[320px] lg:w-[350px] aspect-[4/5] bg-[#111] snap-center relative overflow-hidden rounded-[4px] cursor-pointer group">
            
            {% if block.settings.video != blank %}
                
                {% if block.settings.video.preview_image %}
                    <img src="{{ block.settings.video.preview_image | image_url: width: 600, format: 'webp' }}" class="moment-thumb absolute inset-0 w-full h-full object-cover transition-opacity duration-500 z-10 pointer-events-none opacity-80" loading="lazy" alt="{{ block.settings.title | escape }}">
                {% endif %}

                <video preload="none" loop muted playsinline webkit-playsinline class="moment-video absolute inset-0 w-full h-full object-cover z-0">
                    {% for source in block.settings.video.sources %}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                </video>

            {% elsif block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600, format: 'webp' }}" alt="{{ block.settings.handle }}" class="absolute inset-0 w-full h-full object-cover z-0 opacity-80" loading="lazy">
            {% endif %}
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-70 pointer-events-none z-10"></div>
            
            <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
                <div class="play-pause-indicator w-14 h-14 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
                    <svg class="play-svg w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <svg class="pause-svg w-6 h-6 hidden" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
                </div>
            </div>

            {% if block.settings.handle != blank %}
                <div class="absolute bottom-6 left-6 text-white text-[13px] font-sans font-bold tracking-widest uppercase z-20 pointer-events-none drop-shadow-md">
                    {{ block.settings.handle }}
                </div>
            {% endif %}
        </div>
    {% else %}
        {% for i in (1..3) %}
            <div class="moment-card flex-shrink-0 w-[75vw] sm:w-[280px] md:w-[320px] lg:w-[350px] aspect-[4/5] bg-[#111] snap-center relative overflow-hidden rounded-[4px] cursor-pointer">
                 <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
                    <div class="play-pause-indicator w-14 h-14 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
                        <svg class="play-svg w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                </div>
                <div class="absolute bottom-6 left-6 text-white text-[13px] font-sans font-bold tracking-widest uppercase z-10 pointer-events-none">
                    @add_content
                </div>
            </div>
        {% endfor %}
    {% endfor %}
</template>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('real-moments-{{ section.id }}');
    if (!section) return;

    const track = document.getElementById('moments-track');
    const container = document.getElementById('moments-card-container');
    const prevBtn = document.getElementById('moments-prev');
    const nextBtn = document.getElementById('moments-next');
    const template = document.getElementById('moments-data');
    const dataCards = Array.from(template.content.children);
    
    let totalUnique = dataCards.length;
    let isJumping = false;
    let isVisible = false;
    let areVideosLoaded = false;
    let scrollTimeout = null;
    let lastActiveIndex = -1;
    let lastVisibleState = false; 
    let isDown = false;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let isDraggingCard = false;
    
    if (totalUnique === 0) return;

    // 3x JS Cloning Setup
    for (let i = 0; i < 3; i++) {
        dataCards.forEach((cardTemplate, idx) => {
            const clone = cardTemplate.cloneNode(true);
            clone.dataset.index = (i * totalUnique) + idx;
            clone.dataset.realIndex = idx;
            container.appendChild(clone);
        });
    }

    const cards = Array.from(container.children);

    // Centralized UI Updater (Prevents DOM desyncs)
    function setVideoUI(card, state) {
        const playSvg = card.querySelector('.play-svg');
        const pauseSvg = card.querySelector('.pause-svg');
        if (state === 'playing') {
            card.classList.add('is-playing');
            if(playSvg) playSvg.classList.add('hidden');
            if(pauseSvg) pauseSvg.classList.remove('hidden');
        } else {
            card.classList.remove('is-playing');
            if(playSvg) playSvg.classList.remove('hidden');
            if(pauseSvg) pauseSvg.classList.add('hidden');
        }
    }

    // Initialize Event Listeners on Videos
    cards.forEach((card) => {
        const video = card.querySelector('video');
        const thumb = card.querySelector('.moment-thumb');

        if (video && thumb) {
            video.addEventListener('playing', () => {
                thumb.style.opacity = '0';
            });
        }
    });

    function adjustSpacers() {
        if (!cards.length) return;
        const cardWidth = cards?.offsetWidth || 320;
        const space = (track.clientWidth / 2) - (cardWidth / 2);
        document.getElementById('moments-start-spacer').style.width = `${space}px`;
        document.getElementById('moments-end-spacer').style.width = `${space}px`;
    }

    function scrollToCard(index) {
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (track.clientWidth / 2);
        track.scrollTo({ left: scrollPos, behavior: 'smooth' });
    }

    function jumpToIndexSilently(index) {
        isJumping = true;
        track.style.scrollBehavior = 'auto';
        track.style.scrollSnapType = 'none';

        if (cards[index]) {
            const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
            const scrollPos = cardCenter - (track.clientWidth / 2);
            track.scrollLeft = scrollPos;
            
            cards.forEach(c => c.classList.remove('active-card'));
            cards[index].classList.add('active-card');
        }
        
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                track.style.scrollSnapType = 'x mandatory';
                track.style.scrollBehavior = 'smooth';
                isJumping = false;
            });
        });
    }

    function updateVideoStates(activeIndex) {
        if (!areVideosLoaded) return; 

        if (activeIndex === lastActiveIndex && isVisible === lastVisibleState) return;
        lastActiveIndex = activeIndex;
        lastVisibleState = isVisible;

        cards.forEach((card, i) => {
            const isActive = i === activeIndex;
            const video = card.querySelector('video');
            const thumb = card.querySelector('.moment-thumb');

            if (video) {
                if (isActive && isVisible) {
                    if (!card.classList.contains('manual-pause')) {
                        const playPromise = video.play();
                        if (playPromise !== undefined) {
                            playPromise.then(() => {
                                setVideoUI(card, 'playing');
                            }).catch(() => {
                                setVideoUI(card, 'paused');
                            });
                        }
                    }
                } else {
                    if (!video.paused) {
                        video.pause();
                        video.currentTime = 0; 
                    }
                    setVideoUI(card, 'paused');
                    card.classList.remove('manual-pause'); 
                    if (thumb) thumb.style.opacity = '0.8'; 
                }
            }
        });
    }

    function handleScroll() {
        if (isJumping || totalUnique === 0) return;
        
        const trackCenter = track.scrollLeft + (track.clientWidth / 2);
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(trackCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
            }
        });

        cards.forEach((card, i) => {
            const isClosest = (i === closestIndex);
            card.classList.toggle('active-card', isClosest);
            
            if (!isClosest) {
                card.classList.remove('manual-pause'); 
                const video = card.querySelector('video');
                if (video && !video.paused) {
                    video.pause();
                    video.currentTime = 0;
                }
                setVideoUI(card, 'paused');
                const thumb = card.querySelector('.moment-thumb');
                if (thumb) thumb.style.opacity = '0.8';
            }
        });

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex < totalUnique || closestIndex >= totalUnique * 2) {
                const safeIndex = (closestIndex % totalUnique) + totalUnique;
                jumpToIndexSilently(safeIndex);
                updateVideoStates(safeIndex);
            } else {
                updateVideoStates(closestIndex);
            }
        }, 150); 
    }

    // 🚀 NEW: Rock-Solid Click & Tap Handler
    cards.forEach((card, idx) => {
        // 1. Log exact touch/mouse start position
        card.addEventListener('pointerdown', (e) => {
            pointerStartX = e.clientX;
            pointerStartY = e.clientY;
            isDraggingCard = false;
        });

        // 2. If moved more than 5px, it's a drag, not a click
        card.addEventListener('pointermove', (e) => {
            if (Math.abs(e.clientX - pointerStartX) > 5 || Math.abs(e.clientY - pointerStartY) > 5) {
                isDraggingCard = true;
            }
        });

        // 3. Process the click
        card.addEventListener('click', (e) => {
            if (isDraggingCard) return; // Prevent accidental pauses while swiping

            if (!card.classList.contains('active-card')) {
                card.classList.remove('manual-pause');
                scrollToCard(idx);
                return;
            }
            
            const video = card.querySelector('video');
            if (!video || !areVideosLoaded) return;

            if (video.paused) {
                const playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.then(() => {
                        setVideoUI(card, 'playing');
                        card.classList.remove('manual-pause');
                    }).catch(()=>{});
                }
            } else {
                video.pause();
                setVideoUI(card, 'paused');
                card.classList.add('manual-pause');
            }
        });
    });

    // Arrow Controls
    if (prevBtn) {
        prevBtn.addEventListener('click', () => {
            const active = track.querySelector('.moment-card.active-card');
            if (active) scrollToCard(parseInt(active.dataset.index) - 1);
        });
    }
    if (nextBtn) {
        nextBtn.addEventListener('click', () => {
            const active = track.querySelector('.moment-card.active-card');
            if (active) scrollToCard(parseInt(active.dataset.index) + 1);
        });
    }

    // Desktop Drag to scroll visual state
    let startX, scrollLeft;
    track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', () => { if(isDown) { isDown = false; track.classList.remove('dragging'); handleScroll(); }});
    track.addEventListener('mouseup', () => { if(isDown) { isDown = false; track.classList.remove('dragging'); handleScroll(); }});
    track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 2;
        track.scrollLeft = scrollLeft - walk;
    });

    // 🚀 NATIVE LAZY LOAD OBSERVER
    const lazyObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting && !areVideosLoaded) {
                areVideosLoaded = true;

                const allVideos = section.querySelectorAll('video');

                allVideos.forEach((vid) => {
                    vid.preload = "metadata";
                    vid.load();
                });

                const active = track.querySelector('.moment-card.active-card');
                if (active) {
                    updateVideoStates(parseInt(active.dataset.index));
                }
            }
        });
    }, {
        rootMargin: '200px 0px',
        threshold: 0
    });

    if (section) lazyObserver.observe(section);

    // Auto Pause Observer
    const visibilityObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            isVisible = entry.isIntersecting;

            const active = track.querySelector('.moment-card.active-card');
            if (active) {
                updateVideoStates(parseInt(active.dataset.index));
            }
        });
    }, {
        threshold: 0.1
    });

    if (section) visibilityObserver.observe(section);

    track.addEventListener('scroll', handleScroll, { passive: true });
    
    window.addEventListener('resize', () => {
        adjustSpacers();
        const active = track.querySelector('.moment-card.active-card');
        if (active) jumpToIndexSilently(parseInt(active.dataset.index));
    });

    // Initialize layout
    adjustSpacers();
    jumpToIndexSilently(totalUnique); 
    
    setTimeout(() => {
        const active = track.querySelector('.moment-card.active-card');
        if (active) {
            updateVideoStates(parseInt(active.dataset.index));
        }
    }, 250);
});
</script>

{% schema %}
{
  "name": "Real Moments",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Community" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Real Moments" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Social Moment",
      "settings": [
        { "type": "video", "id": "video", "label": "Video File" },
        { "type": "image_picker", "id": "image", "label": "Fallback Image" },
        { "type": "text", "id": "handle", "label": "Social Handle", "default": "@the_visual_book" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real Moments"
    }
  ]
}
{% endschema %}