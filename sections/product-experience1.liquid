{% comment %} sections/product-experience.liquid {% endcomment %}

{%- assign accent_color = section.settings.accent_color | default: '#B8906B' -%}

<style>
    #feature-grid-{{ section.id }} {
        font-family: var(--font-sans, 'Inter', sans-serif);
        background-color: {{ section.settings.bg_color | default: '#FAFAFA' }};
        --accent-color: {{ accent_color }};
    }
    
    #feature-grid-{{ section.id }} .font-serif {
        font-family: var(--font-display, 'Cormorant Garamond', serif);
    }

    .premium-feature-card {
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 12px;
        padding: 2.5rem 2rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        height: 100%;
    }

    .premium-feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 35px -10px rgba(0,0,0,0.05);
        border-color: var(--accent-color);
    }

    .feature-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #fdfbf9;
        color: var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        transition: transform 0.4s ease, background-color 0.4s ease;
    }

    .premium-feature-card:hover .feature-icon-wrapper {
        transform: scale(1.1);
        background: var(--accent-color);
        color: #ffffff;
    }
</style>

<section id="feature-grid-{{ section.id }}" class="w-full py-16 md:py-24 px-5">
    
    {% comment %} SECTION HEADER {% endcomment %}
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16">
        {% if section.settings.subtitle != blank %}
            <p class="font-serif italic text-[18px] md:text-[22px] mb-3" style="color: var(--accent-color);">
                {{ section.settings.subtitle | escape }}
            </p>
        {% endif %}
        
        {% if section.settings.heading != blank %}
            <h2 class="font-serif text-[32px] md:text-[42px] lg:text-[48px] text-[#111] leading-tight mb-4">
                {{ section.settings.heading | escape }}
            </h2>
        {% endif %}
        
        {% if section.settings.subheading != blank %}
            <p class="font-sans text-[15px] md:text-[17px] text-gray-500 leading-relaxed max-w-2xl mx-auto">
                {{ section.settings.subheading | escape }}
            </p>
        {% endif %}
    </div>

    {% comment %} THE GRID {% endcomment %}
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {% for block in section.blocks %}
            <div class="premium-feature-card" {{ block.shopify_attributes }}>
                
                {% comment %} ICON LOGIC {% endcomment %}
                <div class="feature-icon-wrapper">
                    {% case block.settings.icon %}
                        {% when 'play' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" /></svg>
                        {% when 'screen' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125z" /></svg>
                        {% when 'volume' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" /></svg>
                        {% when 'battery' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5h6.75V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-7.5a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 8.25v7.5A2.25 2.25 0 003.75 18z" /></svg>
                        {% when 'book' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
                        {% when 'upload' %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                        {% else %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    {% endcase %}
                </div>

                <h3 class="font-serif text-[22px] text-gray-900 leading-tight mb-3">
                    {{ block.settings.title | escape }}
                </h3>
                
                <p class="text-gray-500 font-sans text-[14.5px] leading-relaxed m-0">
                    {{ block.settings.description | escape }}
                </p>

            </div>
        {% endfor %}
    </div>

</section>

{% schema %}
{
  "name": "Feature Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#B8906B"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Technology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Visualbook Experience"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the seamless technology behind your most cherished memories."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "play", "label": "Play Button" },
            { "value": "screen", "label": "Display/Screen" },
            { "value": "volume", "label": "Sound/Volume" },
            { "value": "battery", "label": "Battery" },
            { "value": "upload", "label": "Upload/Transfer" },
            { "value": "book", "label": "Book/Craftsmanship" },
            { "value": "check", "label": "Checkmark (Default)" }
          ],
          "default": "play"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Instant Playback"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Open the cover and the video begins automatically. No loading screens, no apps, just your memories."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Feature Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "play",
            "title": "Instant Playback",
            "description": "Our built-in magnetic sensor detects the exact moment the cover is lifted. The book simply knows when you're ready to watch."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "screen",
            "title": "Stunning Display",
            "description": "Relive your memories in stunning clarity. Our premium IPS screen ensures your videos are bright and perfectly viewable from any angle."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "volume",
            "title": "Immersive Audio",
            "description": "The internal speaker is specially calibrated for clear voices and rich background music, ensuring the audio is just as emotional as the video."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "book",
            "title": "Premium Craftsmanship",
            "description": "Wrapped in high-quality, tactile linen, the Visualbook feels substantial and luxurious in your hands. A true modern heirloom."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "upload",
            "title": "Effortless Uploads",
            "description": "Use the included USB-C cable to connect to any Mac or PC. Drag and drop your files just like a standard USB flash drive."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "battery",
            "title": "Built for Forever",
            "description": "The built-in rechargeable battery provides hours of continuous playback, while offline storage keeps your memories completely private."
          }
        }
      ]
    }
  ]
}
{% endschema %}