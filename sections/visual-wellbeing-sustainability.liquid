{% comment %} sections/page-wellbeing-sustainability.liquid {% endcomment %}

{%- assign accent_color = section.settings.accent_color | default: '#B8906B' -%}

<style>
    #wellbeing-page-{{ section.id }} {
        font-family: var(--font-sans, 'Inter', sans-serif);
        background-color: {{ section.settings.bg_color | default: '#FAFAFA' }};
        --accent-color: {{ accent_color }};
    }
    #wellbeing-page-{{ section.id }} .font-serif {
        font-family: var(--font-display, 'Cormorant Garamond', serif);
    }
    .cert-card {
        background: #ffffff;
        border: 1px solid #eaeaea;
        border-radius: 12px;
        padding: 2rem;
        height: 100%;
    }
    .founder-box {
        border-left: 3px solid var(--accent-color);
        background-color: #ffffff;
    }
</style>

<div id="wellbeing-page-{{ section.id }}" class="w-full py-16 md:py-24 text-stone-900 select-none">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
        
        {% comment %} PAGE HEADER {% endcomment %}
        <header class="text-center mb-12 md:mb-20">
            <p class="font-serif italic text-[16px] md:text-[20px] mb-3" style="color: var(--accent-color);">
                Our Commitments
            </p>
            <h1 class="font-serif text-[36px] md:text-[48px] lg:text-[56px] text-[#111] leading-tight max-w-3xl mx-auto">
                {{ section.settings.title | default: "Ensuring the Wellbeing of All Those Involved in the Visual Book" }}
            </h1>
        </header>

        {% comment %} CORE PHILOSOPHY {% endcomment %}
        <article class="prose max-w-3xl mx-auto mb-16 md:mb-24">
            <p class="font-sans text-[16px] md:text-[18px] text-stone-600 leading-relaxed mb-6">
                At the Visual Book, our top priority is the wellbeing of all those involved in the creation of our product, from our employees and suppliers in the UK to our manufacturers overseas. We adhere to a strict supplier code of conduct to ensure that all those involved in the production of the Visual Book are treated fairly and with respect.
            </p>
            <p class="font-sans text-[16px] md:text-[18px] text-stone-600 leading-relaxed">
                Additionally, we take the safety and environmental impact of our product seriously. Our manufacturing standards strictly reflect our underlying corporate philosophy: prioritizing health, compliance, and global accountability.
            </p>
        </article>

        {% comment %} CERTIFICATIONS GRID {% endcomment %}
        <section class="mb-16 md:mb-24">
            <div class="text-center mb-10">
                <h2 class="font-serif text-[28px] md:text-[36px] text-[#111] tracking-tight">Compliance & Global Standards</h2>
                <div class="w-12 h-[1px] mx-auto mt-3" style="background-color: var(--accent-color);"></div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                <div class="cert-card">
                    <span class="inline-block text-[11px] font-bold tracking-widest uppercase mb-2" style="color: var(--accent-color);">Certified</span>
                    <h3 class="font-serif text-[22px] text-stone-900 mb-3">RoHS Certification</h3>
                    <p class="font-sans text-[14.5px] text-stone-500 leading-relaxed m-0">
                        The Visual Book is certified with the RoHS (Restriction of Hazardous Substances) mark, indicating full compliance with European Union regulations on the restriction and use of specific hazardous substances in electrical and electronic equipment.
                    </p>
                </div>

                <div class="cert-card">
                    <span class="inline-block text-[11px] font-bold tracking-widest uppercase mb-2" style="color: var(--accent-color);">Conformity</span>
                    <h3 class="font-serif text-[22px] text-stone-900 mb-3">CE Marking</h3>
                    <p class="font-sans text-[14.5px] text-stone-500 leading-relaxed m-0">
                        The CE (Conformité Européene) marking indicates that our products meet strict safety, health, and environmental protection requirements established by the European Union—ensuring consumer safety and public health thresholds are met.
                    </p>
                </div>

                <div class="cert-card">
                    <span class="inline-block text-[11px] font-bold tracking-widest uppercase mb-2" style="color: var(--accent-color);">Assessment</span>
                    <h3 class="font-serif text-[22px] text-stone-900 mb-3">UKCA Marking</h3>
                    <p class="font-sans text-[14.5px] text-stone-500 leading-relaxed m-0">
                        As a required conformity assessment mark for goods entering Great Britain, the UKCA marking proves that the Visual Book aligns perfectly with corresponding British standards for health, technical protection, and absolute environmental safety.
                    </p>
                </div>

                <div class="cert-card">
                    <span class="inline-block text-[11px] font-bold tracking-widest uppercase mb-2" style="color: var(--accent-color);">Responsible Disposal</span>
                    <h3 class="font-serif text-[22px] text-stone-900 mb-3">WEEE Directive</h3>
                    <p class="font-sans text-[14.5px] text-stone-500 leading-relaxed m-0">
                        Our books and packaging include the crossed-out bin symbol. Part of the WEEE directive, this specifies that the hardware should not be mixed with standard household waste, but instead channeled safely into proper electronics recycling streams.
                    </p>
                </div>
            </div>
        </section>

        {% comment %} SUSTAINABILITY COMMITMENT {% endcomment %}
        <section class="max-w-3xl mx-auto mb-16 md:mb-24 text-center bg-white border border-stone-200 rounded-2xl p-8 md:p-12">
            <h2 class="font-serif text-[28px] md:text-[36px] text-[#111] tracking-tight mb-4">Sustainable Development</h2>
            <p class="font-sans text-[15px] md:text-[16px] text-stone-600 leading-relaxed m-0">
                At the Visual Book, we are committed to following sustainable development goals and reducing our environmental impact. We strive to minimize waste through the intelligent design of our packaging, which functions deliberately to double as a reusable storage box. We carefully audit and select materials alongside suppliers who prioritize eco-conscious workflows.
            </p>
        </section>

        {% comment %} FOUNDER'S NOTE {% endcomment %}
        <section class="max-w-3xl mx-auto founder-box p-6 md:p-10 rounded-r-2xl shadow-sm border border-stone-100">
            <span class="inline-block text-[11px] font-bold tracking-widest uppercase mb-3" style="color: var(--accent-color);">A Note From Our Founder</span>
            <h2 class="font-serif text-[26px] md:text-[32px] text-[#111] leading-tight mb-4">A Personal Connection to Sustainability</h2>
            
            <div class="font-sans text-[15px] text-stone-600 space-y-4 leading-relaxed">
                <p>
                    As the founder of the Visual Book, I have a deep, personal connection to sustainability and local development. I studied International Development for my Master's degree, focusing specifically on critical frameworks such as Energy, Climate Change and Development, Environmental Economics, and Participatory Interventions in Development.
                </p>
                <p>
                    Growing up in Nigeria—a developing region experiencing profound structural, economic, and ecological transitions—I have seen firsthand how valuable sustainable accountability truly is. This worldview naturally guides our trajectory, ensuring that the Visual Book grows responsibly as a transparent and ethical company.
                </p>
            </div>
        </section>

    </div>
</div>

{% schema %}
{
  "name": "Wellbeing & Sustainability",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#B8906B"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Page Heading",
      "default": "Ensuring the Wellbeing of All Those Involved in the Visual Book"
    }
  ]
}
{% endschema %}