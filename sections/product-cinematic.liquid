<div class="mb-10 text-center px-4 sm:px-6 lg:px-8 max-w-[1200px] mx-auto mt-6 md:mt-8">
    <h2 class="text-3xl md:text-4xl font-serif text-brand mb-4">{{ section.settings.heading }}</h2>
    <p class="text-stone-500 max-w-2xl mx-auto font-light">{{ section.settings.subheading }}</p>
</div>

<section id="cinematic-showcase-container" class="w-full relative" style="height: {{ section.blocks.size | times: 100 }}vh;">
    
    <div class="sticky top-0 w-full h-[100dvh] bg-black overflow-hidden z-30">
        <div id="story-slider-track" class="w-full flex flex-col transition-transform duration-1000 ease-[cubic-bezier(0.25,1,0.5,1)] will-change-transform">
            
            {% for block in section.blocks %}
            <div class="story-slide w-full h-[100dvh] relative shrink-0" {{ block.shopify_attributes }}>
                
                {% if block.settings.video_url != blank %}
                    <video loop muted playsinline class="w-full h-full object-cover opacity-50 story-video">
                        <source src="{{ block.settings.video_url }}" type="video/mp4">
                    </video>
                {% elsif block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.title }}" class="w-full h-full object-cover opacity-60" loading="lazy">
                {% else %}
                    <div class="w-full h-full bg-stone-900 opacity-60"></div>
                {% endif %}

                <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
                <div class="absolute inset-0 flex flex-col justify-center px-8 md:px-20 max-w-3xl">
                    <span class="text-[#C5A059] tracking-[0.2em] uppercase text-xs font-semibold mb-3 drop-shadow-md">{{ block.settings.badge }}</span>
                    <h3 class="text-4xl md:text-5xl font-serif text-white mb-4 drop-shadow-lg">{{ block.settings.title }}</h3>
                    <p class="text-stone-200 text-lg md:text-xl font-light max-w-2xl drop-shadow-md">{{ block.settings.subtitle }}</p>
                </div>
            </div>
            {% endfor %}

        </div>

        <div class="absolute right-5 md:right-8 top-1/2 -translate-y-1/2 flex flex-col gap-3 z-40 items-center">
            {% for block in section.blocks %}
                <button class="story-line w-1 md:w-1.5 {% if forloop.first %}h-16 bg-white shadow-[0_0_10px_rgba(255,255,255,0.3)]{% else %}h-8 bg-white/30 hover:bg-white/60{% endif %} rounded-full transition-all duration-500 focus:outline-none" aria-label="Go to slide {{ forloop.index }}"></button>
            {% endfor %}
        </div>
        
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/80 flex flex-col items-center gap-1.5 animate-bounce pointer-events-none z-40">
            <span class="text-[9px] uppercase tracking-[0.2em] font-medium drop-shadow-md">Scroll</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-md"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const showcaseContainer = document.getElementById('cinematic-showcase-container');
        const sliderTrack = document.getElementById('story-slider-track');
        const storyLines = document.querySelectorAll('.story-line');
        const videos = document.querySelectorAll('.story-video');

        if (showcaseContainer && sliderTrack) {
            let currentActiveIndex = 0;
            const totalSlides = {{ section.blocks.size | default: 1 }};

            window.addEventListener('scroll', () => {
                const rect = showcaseContainer.getBoundingClientRect();
                const sectionTop = rect.top;
                const scrollableDistance = rect.height - window.innerHeight;

                if (sectionTop <= window.innerHeight && sectionTop >= -(scrollableDistance + window.innerHeight)) {
                    let rawProgress = Math.abs(sectionTop) / scrollableDistance;
                    if (sectionTop > 0) rawProgress = 0; 
                    let progress = Math.min(1, Math.max(0, rawProgress));
                    
                    let activeIndex = Math.min(totalSlides - 1, Math.floor(progress * totalSlides));

                    if (activeIndex !== currentActiveIndex) {
                        currentActiveIndex = activeIndex;
                        const translatePercent = activeIndex * (100 / totalSlides);
                        sliderTrack.style.transform = `translateY(-${translatePercent}%)`;

                        storyLines.forEach((line, index) => {
                            if (index === activeIndex) {
                                line.className = "story-line w-1 md:w-1.5 h-16 rounded-full bg-white transition-all duration-500 shadow-[0_0_10px_rgba(255,255,255,0.3)]";
                            } else {
                                line.className = "story-line w-1 md:w-1.5 h-8 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-500";
                            }
                        });

                        videos.forEach((vid, idx) => {
                            if (idx === activeIndex) { vid.play().catch(() => {}); } 
                            else { vid.pause(); }
                        });
                    }
                }
            }, { passive: true });

            storyLines.forEach((line, index) => {
                line.addEventListener('click', () => {
                    const scrollableDistance = showcaseContainer.offsetHeight - window.innerHeight;
                    const chunk = scrollableDistance / totalSlides;
                    const targetScrollY = showcaseContainer.offsetTop + (chunk * index) + 10;
                    window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
                });
            });
            window.dispatchEvent(new Event('scroll'));
        }
    });
</script>

{% schema %}
{
  "name": "Visual Cinematic",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience the Magic"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover how our classic visual book transforms your digital memories into a tangible experience."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Cinematic Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Direct Video Link (Optional)",
          "info": "Link to an .mp4 file. Will override the image if provided."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Small Top Badge",
          "default": "The Experience"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Main Heading",
          "default": "Your Memories, Brought to Life."
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Description Text",
          "default": "A seamless blend of a classic coffee-table book and modern technology."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visual Cinematic Experience",
      "category": "Visual Book Custom",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}