{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

<style>
  .instruction-tabs-section {
    margin: 60px auto;
    max-width: 1200px;
    padding: 0 20px;
  }
  .instruction-tabs-container {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .tab-headers {
    display: flex;
    justify-content: center;
    gap: 15px;
    border-bottom: 2px solid #e8e8e1;
    padding-bottom: 0;
    flex-wrap: wrap;
  }
  .tab-button {
    background: none;
    border: none;
    padding: 12px 24px;
    font-size: 1.6rem;
    font-family: var(--font-heading-family);
    cursor: pointer;
    color: rgba(var(--color-foreground), 0.6);
    border-bottom: 3px solid transparent;
    transition: all 0.3s ease;
    margin-bottom: -2px; /* overlaps the border */
  }
  .tab-button.active {
    color: rgb(var(--color-foreground));
    border-bottom: 3px solid rgb(var(--color-foreground));
    font-weight: bold;
  }
  .tab-button:hover {
    color: rgb(var(--color-foreground));
  }
  .tab-panel {
    display: none;
    animation: fadeIn 0.4s ease-in-out;
  }
  .tab-panel.active {
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: center;
  }
  
  /* Desktop Layout: Side by Side */
  @media (min-width: 768px) {
    .tab-panel.active {
      flex-direction: row; 
      align-items: center;
    }
  }
  
  .tab-media {
    flex: 1;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .tab-media video, .tab-media img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .tab-text {
    flex: 1;
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground));
    padding: 20px;
  }
  .tab-text h3 {
    margin-top: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="instruction-tabs-section page-width">
  {% if section.settings.heading != blank %}
    <h2 class="h2 text-center" style="margin-bottom: 30px;">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="instruction-tabs-container">
    <div class="tab-headers">
      {% for block in section.blocks %}
        <button 
          class="tab-button {% if forloop.first %}active{% endif %}" 
          data-target="tab-{{ block.id }}" 
          {{ block.shopify_attributes }}>
          {{ block.settings.title }}
        </button>
      {% endfor %}
    </div>

    <div class="tab-contents">
      {% for block in section.blocks %}
        <div id="tab-{{ block.id }}" class="tab-panel {% if forloop.first %}active{% endif %}">
          
          <div class="tab-media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, class: 'tab-video' }}
            {% elsif block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 800 }}" 
                alt="{{ block.settings.title | escape }}" 
                loading="lazy" 
                width="800" 
                height="auto" 
                class="tab-image">
            {% else %}
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>

          {% if block.settings.text != blank %}
            <div class="tab-text">
              <h3>{{ block.settings.title }}</h3>
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all tab buttons and panels within this section
    const sectionContainer = document.querySelector('.instruction-tabs-section');
    if (!sectionContainer) return;

    const buttons = sectionContainer.querySelectorAll('.tab-button');
    const panels = sectionContainer.querySelectorAll('.tab-panel');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        // 1. Remove active state from all buttons and panels
        buttons.forEach(btn => btn.classList.remove('active'));
        panels.forEach(panel => panel.classList.remove('active'));

        // 2. Add active state to the clicked button
        button.classList.add('active');

        // 3. Find and show the corresponding panel
        const targetId = button.getAttribute('data-target');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Instructions Tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to setup your visualbook"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Instruction Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Step 1"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (Overrides Image)",
          "info": "Upload an MP4 video showing this step."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Instructions Text",
          "default": "<p>Explain how to perform this action simply and clearly.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Instructions Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Unbox & Play",
            "text": "<p>See how the product opens and starts up instantly.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Button Controls",
            "text": "<p>Learn how to control playback and volume using the internal buttons.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Upload Data",
            "text": "<p>Connect via the included cable to easily drag and drop your media files.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}