{% comment %} sections/visual-founder.liquid {% endcomment %}
<style>
    .luxury-transition { transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
</style>

<section id="story-{{ section.id }}" class="py-16 md:py-24 bg-[#FAFAFA] overflow-hidden">
    <div class="max-w-[1600px] mx-auto px-5 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            
            <div class="relative" id="founderImages-{{ section.id }}">
                
                <div class="overflow-hidden rounded-sm shadow-2xl relative w-full aspect-[3/4] bg-[#111]">
                    {% if section.settings.main_image != blank %}
                        <img id="founder-main-img-{{ section.id }}" src="{{ section.settings.main_image | img_url: '1000x' }}" alt="{{ section.settings.founder_name | escape }}" class="w-full h-full grayscale hover:grayscale-0 luxury-transition object-cover absolute inset-0">
                    {% else %}
                        <div id="founder-main-img-{{ section.id }}" class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-400 font-sans text-xs tracking-widest uppercase absolute inset-0">Main Portrait</div>
                    {% endif %}
                </div>

                <div class="absolute -bottom-8 -right-4 md:right-8 w-32 md:w-44 overflow-hidden rounded-sm shadow-xl border-4 border-[#FAFAFA] aspect-[3/4] bg-white z-10" style="transform:rotate(4deg)">
                    <div id="founder-sub-img-{{ section.id }}" class="w-full h-full relative">
                        {% if section.settings.sub_image != blank %}
                            <img src="{{ section.settings.sub_image | img_url: '600x' }}" alt="Childhood memory" class="w-full h-full object-cover sepia hover:sepia-0 luxury-transition absolute inset-0">
                        {% else %}
                            <div class="w-full h-full bg-gray-300 flex items-center justify-center text-gray-500 font-sans text-[8px] tracking-widest uppercase absolute inset-0 text-center px-2">Memory Photo</div>
                        {% endif %}
                    </div>
                </div>

            </div>

            <div>
                <p class="font-script text-[#B8906B] text-2xl md:text-3xl mb-2">{{ section.settings.subtitle }}</p>
                <h2 class="font-serif text-3xl md:text-5xl font-light tracking-tight mb-8 text-black">{{ section.settings.title | newline_to_br }}</h2>
                
                <div class="space-y-5 text-sm text-black/60 leading-[1.8] font-sans">
                    {{ section.settings.story_html }}
                </div>
                
                <div class="mt-10">
                    <p class="font-script text-2xl text-[#B8906B]">{{ section.settings.founder_name }}</p>
                    <p class="text-[10px] uppercase tracking-[0.2em] text-black/40 font-medium mt-1">{{ section.settings.founder_title }}</p>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Founder Image Parallax Logic ported from main.js
    const fMain = document.getElementById('founder-main-img-{{ section.id }}');
    const fSub = document.getElementById('founder-sub-img-{{ section.id }}');
    
    if (fMain) {
        const fSection = fMain.closest('section');
        
        const applyParallax = () => {
            if (fSection) {
                const rect = fSection.getBoundingClientRect();
                // Check if section is in viewport
                if(rect.top < window.innerHeight && rect.bottom > 0) {
                    const progress = 1 - (rect.bottom / (window.innerHeight + rect.height));
                    // Subtle vertical shift based on scroll progress
                    fMain.style.transform = `translateY(${-5 + (progress * 10)}%)`; 
                    if(fSub) {
                        fSub.style.transform = `translateY(${10 - (progress * 25)}%)`; 
                    }
                }
            }
        };

        window.addEventListener('scroll', applyParallax, { passive: true });
        applyParallax(); // Initial call
    }
});
</script>

{% schema %}
{
  "name": "Founder Story",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "main_image", "label": "Main Portrait Image" },
    { "type": "image_picker", "id": "sub_image", "label": "Secondary Overlay Image" },
    
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Our Story" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Born from Loss,\nDesigned for Forever" },
    { 
      "type": "richtext", 
      "id": "story_html", 
      "label": "Story Text", 
      "default": "<p>I grew up in Lagos, Nigeria — a place bursting with colour, sound, and story. But my own story had a gap. I lost my father when I was just three years old. No letters. No recordings. Just a handful of faded photographs I would hold up to the light, trying to memorise the shape of a man I could barely remember.</p><p>That ache — the longing for something tangible to hold onto — never left me. It became the seed of The Visual Book. I wanted to create something that didn't just store memories, but honoured them. Something you could touch, open, and feel the weight of a moment that might otherwise slip away.</p><p>Every Visual Book is crafted with that same urgency: the belief that the people and moments we love deserve more than a cloud folder. They deserve permanence. They deserve beauty. They deserve to be held.</p>" 
    },
    
    { "type": "header", "content": "Signature" },
    { "type": "text", "id": "founder_name", "label": "Founder Name", "default": "Adanna Okafor" },
    { "type": "text", "id": "founder_title", "label": "Founder Title", "default": "Founder & CEO" }
  ],
  "presets": [
    { "name": "Founder Story" }
  ]
}
{% endschema %}