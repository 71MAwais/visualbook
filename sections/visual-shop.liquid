<script>
document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('shop-scroll');
    const cardContainer = document.getElementById('card-container');
    const progressBar = document.getElementById('shop-progress');
    const progressBarContainer = progressBar?.parentElement;
    const currentEl = document.getElementById('card-current');
    const totalEl = document.getElementById('card-total');
    const prevBtn = document.getElementById('shop-prev-btn');
    const nextBtn = document.getElementById('shop-next-btn');
    const tabBtns = document.querySelectorAll('.tab-btn');
    
    const data1 = Array.from(document.getElementById('shop-data-1').children);
    const data2 = Array.from(document.getElementById('shop-data-2').children);
    
    let totalOriginal = 0;
    let isJumping = false;
    let scrollTimeout = null;
    
    function renderTab(tabIndex) {
        const originalCards = tabIndex === 1 ? data1 : data2;
        totalOriginal = originalCards.length;
        cardContainer.innerHTML = '';
        
        if (totalOriginal === 0) {
            cardContainer.innerHTML = '<div class="w-full text-center py-10 px-8 text-gray-400 font-sans tracking-widest uppercase text-[10px]">Please select a collection in the customizer.</div>';
            if (totalEl) totalEl.textContent = '00';
            return;
        }
        
        if (totalEl) totalEl.textContent = String(totalOriginal).padStart(2, '0');
        
        // Loop 3 times to recreate infinite scrolling logic
        for (let i = 0; i < 3; i++) {
            originalCards.forEach((cardTemplate, idx) => {
                const clone = cardTemplate.cloneNode(true);
                clone.dataset.index = (i * totalOriginal) + idx;
                clone.dataset.realIndex = idx;
                
                // Allow tapping card body to center it, but ignore clicks on links/buttons
                clone.addEventListener('click', (e) => {
                    if (e.target.closest('a') || e.target.closest('button')) return;
                    scrollToCard(parseInt(clone.dataset.index));
                });
                cardContainer.appendChild(clone);
            });
        }
        
        adjustSpacers();
        requestAnimationFrame(() => {
            jumpToIndexSilently(totalOriginal); // Start in the middle of the loop
        });
    }

    function adjustSpacers() {
        if (!cardContainer.children.length) return;
        const cardWidth = cardContainer.children[0].offsetWidth || 260;
        const containerWidth = scrollContainer.clientWidth;
        const space = (containerWidth / 2) - (cardWidth / 2);
        document.getElementById('start-spacer').style.width = `${space}px`;
        document.getElementById('end-spacer').style.width = `${space}px`;
    }

    window.addEventListener('resize', () => {
        adjustSpacers();
        const activeCard = document.querySelector('.product-card.active-card');
        if (activeCard) {
            jumpToIndexSilently(parseInt(activeCard.dataset.index));
        }
    });

    function scrollToCard(index) {
        const cards = Array.from(cardContainer.children);
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
        scrollContainer.scrollTo({ left: scrollPos, behavior: 'smooth' });
    }

    function jumpToIndexSilently(index) {
        isJumping = true;
        scrollContainer.style.scrollBehavior = 'auto';
        const cards = Array.from(cardContainer.children);
        if (cards[index]) {
            const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
            const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = scrollPos;
            
            cards.forEach(c => c.classList.remove('active-card'));
            cards[index].classList.add('active-card');
            updateUI(parseInt(cards[index].dataset.realIndex));
        }
        requestAnimationFrame(() => {
            scrollContainer.style.scrollBehavior = 'smooth';
            isJumping = false;
        });
    }

    function updateUI(realIndex) {
        if (currentEl) currentEl.textContent = String(realIndex + 1).padStart(2, '0');
        if (progressBar && totalOriginal > 0) {
            const progressPercent = ((realIndex + 1) / totalOriginal) * 100;
            const progressWidth = 100 / totalOriginal;
            progressBar.style.width = `${progressWidth}%`;
            progressBar.style.transform = `translateX(${realIndex * 100}%)`;
            if (progressBarContainer) progressBarContainer.setAttribute('aria-valuenow', progressPercent);
        }
    }

    function handleScroll() {
        if (isJumping || totalOriginal === 0) return;
        const cards = Array.from(cardContainer.children);
        const containerCenter = scrollContainer.scrollLeft + (scrollContainer.clientWidth / 2);
        
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(containerCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
            }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));
        updateUI(parseInt(cards[closestIndex].dataset.realIndex));

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex < totalOriginal || closestIndex >= totalOriginal * 2) {
                const safeIndex = (closestIndex % totalOriginal) + totalOriginal;
                jumpToIndexSilently(safeIndex);
            }
        }, 100);
    }

    scrollContainer.addEventListener('scroll', handleScroll, { passive: true });

    if (prevBtn) prevBtn.addEventListener('click', () => {
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) + 1);
    });

    // Tab Logic
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(t => {
                t.classList.remove('active', 'text-black', 'font-bold');
                t.classList.add('text-gray-400');
                t.setAttribute('aria-selected', 'false');
                t.querySelector('.tab-active-line').classList.replace('scale-x-100', 'scale-x-0');
            });
            btn.classList.add('active', 'text-black', 'font-bold');
            btn.classList.remove('text-gray-400');
            btn.setAttribute('aria-selected', 'true');
            btn.querySelector('.tab-active-line').classList.replace('scale-x-0', 'scale-x-100');
            
            renderTab(parseInt(btn.dataset.tab));
        });
    });

    // Drag to scroll
    let isDown = false, startX, scrollLeft;
    scrollContainer.addEventListener('mousedown', (e) => {
        // Prevent drag if clicking on buttons or links
        if (e.target.closest('button') || e.target.closest('a')) return;
        isDown = true;
        scrollContainer.classList.add('dragging');
        startX = e.pageX - scrollContainer.offsetLeft;
        scrollLeft = scrollContainer.scrollLeft;
    });
    scrollContainer.addEventListener('mouseleave', () => { if(isDown) { isDown = false; scrollContainer.classList.remove('dragging'); handleScroll(); }});
    scrollContainer.addEventListener('mouseup', () => { if(isDown) { isDown = false; scrollContainer.classList.remove('dragging'); handleScroll(); }});
    scrollContainer.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - scrollContainer.offsetLeft;
        const walk = (x - startX) * 2;
        scrollContainer.scrollLeft = scrollLeft - walk;
    });

    // Toast Function globally attached
    window.showToast = function(productName) {
        const toast = document.getElementById('toast');
        const msg = document.getElementById('toast-message');
        if(toast && msg) {
            msg.textContent = `${productName} added to cart`;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
    };

    // Initialize first tab
    renderTab(1);
});
</script>

{% schema %}
{
  "name": "Shop Carousel",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Curated Essentials" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop the Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Timeless pieces crafted with intention, designed to elevate everyday moments." },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 Label", "default": "Video Book" },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 Label", "default": "Audio Cards" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" }
  ],
  "presets": [{ "name": "Shop Carousel" }]
}
{% endschema %}