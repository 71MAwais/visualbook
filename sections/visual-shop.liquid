{% comment %} sections/visual-shop.liquid {% endcomment %}
<style>
    /* Carousel Center Focus Effects */
    .product-card {
        transition: all 500ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.5;
        transform: scale(0.9);
    }
    .product-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
    }
    /* Image Hover Zoom */
    .product-card .img-wrapper img {
        transition: transform 1000ms cubic-bezier(0.25, 1, 0.5, 1);
    }
    .product-card.active-card:hover .img-wrapper img {
        transform: scale(1.05);
    }
    /* Quick Add Button & Overlay (Desktop Only) */
    @media (hover: hover) {
        .product-card .overlay {
            opacity: 0;
            transition: opacity 400ms ease;
        }
        .product-card.active-card:hover .overlay {
            opacity: 1;
        }
        .product-card .quick-add-btn {
            opacity: 0;
            transform: translateY(15px);
            transition: all 400ms cubic-bezier(0.25, 1, 0.5, 1);
        }
        .product-card.active-card:hover .quick-add-btn {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* Scrolling behaviors */
    #shop-scroll {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
    }
    #shop-scroll.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }
    .toast {
        transform: translateY(100px);
        opacity: 0;
        transition: all 400ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .toast.show {
        transform: translateY(0);
        opacity: 1;
    }
    /* Side Arrow Active State */
    .shop-arrow:active {
        transform: translateY(-50%) scale(0.95);
    }
    
    /* SEO Optimization */
    .sr-only-seo {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }
</style>

<div id="toast" class="toast fixed left-1/2 -translate-x-1/2 z-50 bg-[#050505] text-white px-6 py-3.5 rounded-full shadow-2xl flex items-center gap-3 text-sm font-medium pointer-events-none bottom-[calc(1.5rem+env(safe-area-inset-bottom))]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B8906B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <span id="toast-message" aria-live="polite">Added to cart</span>
</div>

<section id="shop" class="w-full bg-[#FAFAFA] py-5 md:py-6 flex flex-col items-center select-none overflow-x-hidden border-t border-gray-100" aria-labelledby="shop-title">

    {%- comment -%} NATIVE DOM RENDER FOR SEO CRAWLERS {%- endcomment -%}
    <div class="sr-only-seo">
        <h2>{{ section.settings.title }}</h2>
        <ul>
            {% for product in section.settings.collection_1.products %}
                <li><a href="{{ product.url }}">{{ product.title }} - {{ product.price | money }}</a></li>
            {% endfor %}
            {% for product in section.settings.collection_2.products %}
                <li><a href="{{ product.url }}">{{ product.title }} - {{ product.price | money }}</a></li>
            {% endfor %}
        </ul>
    </div>

    <div class="w-full text-center pb-2 md:pb-3 px-5 flex-shrink-0 z-10">
        <p class="text-[10px] sm:text-[11px] font-sans font-semibold tracking-[0.3em] uppercase text-[#B8906B] mb-1.5">{{ section.settings.subtitle }}</p>
        <h2 id="shop-title" class="font-serif text-[30px] md:text-[38px] lg:text-[44px] text-stone-950 tracking-tight leading-[1.05]">{{ section.settings.title }}</h2>
        <p class="mt-1.5 text-stone-500 text-xs md:text-[14px] font-light max-w-lg mx-auto leading-relaxed">{{ section.settings.text }}</p>
    </div>

    <div class="w-full max-w-2xl px-5 pb-3 flex-shrink-0 z-10 mx-auto">
        <div class="flex flex-nowrap justify-center items-center w-full gap-5 md:gap-10 border-b border-gray-200 relative" role="tablist" id="shop-tabs">
            <button role="tab" aria-selected="true" class="tab-btn active pb-1.5 md:pb-2 text-[10px] sm:text-[11px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-black font-bold focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950" data-tab="1">
                {{ section.settings.tab_1_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-black transform scale-x-100 origin-left transition-transform duration-500"></div>
            </button>
            <button role="tab" aria-selected="false" class="tab-btn pb-1.5 md:pb-2 text-[10px] sm:text-[11px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-gray-400 hover:text-gray-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950" data-tab="2">
                {{ section.settings.tab_2_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-black transform scale-x-0 origin-left transition-transform duration-500"></div>
            </button>
        </div>
    </div>

    <div class="w-full flex-1 min-h-0 relative transition-opacity duration-300 ease-out flex flex-col group/carousel" id="shop-content">
        <div class="absolute top-0 left-0 w-[10vw] md:w-[15vw] h-full bg-gradient-to-r from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-[10vw] md:w-[15vw] h-full bg-gradient-to-l from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        
        <button aria-label="Previous Product" id="shop-prev-btn" class="shop-arrow absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 hover:bg-white transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button aria-label="Next Product" id="shop-next-btn" class="shop-arrow absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/80 backdrop-blur-sm shadow-md border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 hover:bg-white transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="shop-scroll" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full cursor-grab items-center py-2 relative">
            <div id="start-spacer" class="shrink-0 w-[50vw]"></div>
            <div id="card-container" class="flex gap-4 items-center shrink-0"></div>
            <div id="end-spacer" class="shrink-0 w-[50vw]"></div>
        </div>
    </div>

    <div class="w-full flex-shrink-0 pt-3 px-5 md:px-10 z-10 pb-[calc(1rem+env(safe-area-inset-bottom))]">
        <div class="max-w-[1000px] mx-auto flex items-center justify-between w-full pointer-events-auto">
            
            <div class="flex items-start shrink-0 w-14 md:w-16" aria-hidden="true">
                <span id="card-current" class="font-serif text-[26px] md:text-[32px] text-black font-medium leading-none tracking-wide">01</span>
                <div class="flex flex-col ml-1 mt-0.5 md:mt-1">
                    <span class="text-[9px] md:text-[11px] text-gray-400 font-sans tracking-widest leading-none">/</span>
                    <span id="card-total" class="text-[9px] md:text-[11px] text-gray-400 font-sans tracking-widest leading-none mt-1 ml-0.5">00</span>
                </div>
            </div>

            <div class="flex-1 mx-4 md:mx-6 h-[1.5px] bg-gray-200 relative overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="shop-progress" class="absolute top-0 left-0 h-full bg-[#B8906B] transition-all duration-500 ease-out" style="width: 0%; left: 0%;"></div>
            </div>

            <div class="flex shrink-0 w-14 md:w-16"></div>
            
        </div>
    </div>
</section>

<div id="shop-data-1" class="hidden">
    {% for product in section.settings.collection_1.products %}
        <article class="product-card flex-shrink-0 w-[65vw] sm:w-[220px] md:w-[240px] lg:w-[260px] snap-center cursor-pointer flex flex-col items-center">
            <div class="relative group w-full">
                <a href="{{ product.url }}" tabindex="-1" class="block w-full outline-none">
                    <div class="img-wrapper w-full aspect-[4/5] rounded-[2px] overflow-hidden bg-[#F0F0F0] shadow-sm border border-stone-100/50">
                        <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover mix-blend-multiply" draggable="false" loading="lazy">
                    </div>
                </a>
                
                {% for tag in product.tags %}
                    {% if tag contains 'badge:' %}
                        <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-sm shadow-sm border border-black/5">
                            <span class="text-[8px] font-sans tracking-[0.2em] uppercase font-bold text-black">{{ tag | remove: 'badge:' }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
                
                <div class="overlay hidden lg:flex absolute inset-0 bg-black/5 rounded-[2px] items-end justify-center pb-5 pointer-events-none transition-colors">
                    <form method="post" action="/cart/add" class="pointer-events-auto w-full flex justify-center" onsubmit="event.preventDefault(); showToast('{{ product.title | escape | replace: "'", "\'" }}'); this.submit();">
                        <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                        <button type="submit" class="quick-add-btn bg-white/95 backdrop-blur-md border border-gray-200 text-black text-[9px] font-sans tracking-[0.2em] uppercase font-bold px-6 py-2.5 shadow-lg hover:bg-black hover:text-white hover:border-black transition-all duration-300">Quick Add</button>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center px-2 w-full flex flex-col items-center">
                <a href="{{ product.url }}" class="hover:opacity-70 transition-opacity w-full outline-none focus-visible:ring-2 focus-visible:ring-stone-950 focus-visible:ring-offset-2">
                    <h3 class="font-serif text-[18px] md:text-[20px] font-medium text-black tracking-tight leading-tight line-clamp-1" title="{{ product.title }}">{{ product.title }}</h3>
                </a>
                <p class="mt-1.5 text-[#B8906B] text-[13px] md:text-[14px] font-medium font-sans">{{ product.price | money }}</p>
                
                <form method="post" action="/cart/add" class="lg:hidden w-full mt-3 px-4" onsubmit="event.preventDefault(); showToast('{{ product.title | escape | replace: "'", "\'" }}'); this.submit();">
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                    <button type="submit" class="w-full border border-black/10 text-black text-[9px] font-sans uppercase tracking-[0.2em] font-bold py-2.5 rounded-sm hover:bg-[#B8906B] hover:text-white hover:border-[#B8906B] transition-colors shadow-sm">Quick Add</button>
                </form>
            </div>
        </article>
    {% endfor %}
</div>

