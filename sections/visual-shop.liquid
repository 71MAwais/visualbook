{% comment %} sections/visual-shop.liquid {% endcomment %}
<style>
    /* Carousel Center Focus Effects */
    .product-card {
        transition: all 500ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.5;
        transform: scale(0.9);
    }
    .product-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
    }
    /* Image Hover Zoom */
    .product-card .img-wrapper img {
        transition: transform 1000ms cubic-bezier(0.25, 1, 0.5, 1);
    }
    .product-card.active-card:hover .img-wrapper img {
        transform: scale(1.05);
    }
    /* Quick Add Button & Overlay */
    .product-card .overlay {
        opacity: 0;
        transition: opacity 400ms ease;
    }
    .product-card.active-card:hover .overlay {
        opacity: 1;
    }
    .product-card .quick-add-btn {
        opacity: 0;
        transform: translateY(15px);
        transition: all 400ms cubic-bezier(0.25, 1, 0.5, 1);
    }
    .product-card.active-card:hover .quick-add-btn {
        opacity: 1;
        transform: translateY(0);
    }
    /* Scrolling behaviors */
    #shop-scroll {
        -webkit-user-select: none;
        user-select: none;
        scroll-behavior: smooth;
    }
    #shop-scroll.dragging {
        cursor: grabbing;
        scroll-behavior: auto !important; 
        scroll-snap-type: none !important; 
    }
    .toast {
        transform: translateY(100px);
        opacity: 0;
        transition: all 400ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .toast.show {
        transform: translateY(0);
        opacity: 1;
    }
</style>

<div id="toast" class="toast fixed left-1/2 -translate-x-1/2 z-50 bg-[#050505] text-white px-6 py-3.5 rounded-full shadow-2xl flex items-center gap-3 text-sm font-medium pointer-events-none bottom-[calc(1.5rem+env(safe-area-inset-bottom))]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B8906B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <span id="toast-message">Added to cart</span>
</div>

<section id="shop" class="w-full bg-[#FAFAFA] py-6 md:py-8 flex flex-col items-center select-none overflow-x-hidden border-t border-gray-100">

    <div class="w-full text-center pb-3 md:pb-4 px-6 flex-shrink-0 z-10">
        <p class="text-[10px] sm:text-[11px] font-sans font-semibold tracking-[0.3em] uppercase text-[#B8906B] mb-2">{{ section.settings.subtitle }}</p>
        <h2 id="shop-title" class="font-serif text-[36px] md:text-[48px] lg:text-[56px] text-black tracking-tight leading-[1.05]">{{ section.settings.title }}</h2>
        <p class="mt-2 text-black/50 text-sm md:text-base font-light max-w-lg mx-auto leading-relaxed">{{ section.settings.text }}</p>
    </div>

    <div class="w-full max-w-3xl px-6 pb-3 md:pb-5 flex-shrink-0 z-10 mx-auto">
        <div class="flex flex-nowrap justify-center items-center w-full gap-4 md:gap-8 border-b border-gray-200 relative" role="tablist" id="shop-tabs">
            <button role="tab" class="tab-btn active pb-1.5 md:pb-2 text-[10px] sm:text-[11px] md:text-[12px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-black font-bold" data-tab="1">
                {{ section.settings.tab_1_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[2px] bg-black transform scale-x-100 origin-left transition-transform duration-500"></div>
            </button>
            <button role="tab" class="tab-btn pb-1.5 md:pb-2 text-[10px] sm:text-[11px] md:text-[12px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-gray-400 hover:text-gray-600" data-tab="2">
                {{ section.settings.tab_2_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[2px] bg-black transform scale-x-0 origin-left transition-transform duration-500"></div>
            </button>
        </div>
    </div>

    <div class="w-full flex-1 min-h-0 relative transition-opacity duration-300 ease-out flex flex-col group/carousel" id="shop-content">
        <div class="absolute top-0 left-0 w-[10vw] md:w-[15vw] h-full bg-gradient-to-r from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-[10vw] md:w-[15vw] h-full bg-gradient-to-l from-[#FAFAFA] to-transparent z-10 pointer-events-none"></div>
        
        <div id="shop-scroll" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full cursor-grab items-center py-2 relative">
            <div id="start-spacer" class="shrink-0 w-[50vw]"></div>
            <div id="card-container" class="flex gap-4 md:gap-6 items-center shrink-0"></div>
            <div id="end-spacer" class="shrink-0 w-[50vw]"></div>
        </div>
    </div>

    <div class="w-full flex-shrink-0 pt-4 md:pt-6 px-6 md:px-12 z-10 pb-[calc(1.25rem+env(safe-area-inset-bottom))] md:pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
        <div class="max-w-[1100px] mx-auto flex items-center justify-between w-full pointer-events-auto">
            
            <div class="flex items-start shrink-0 w-16">
                <span id="card-current" class="font-serif text-[28px] md:text-[34px] text-black font-medium leading-none tracking-wide">01</span>
                <div class="flex flex-col ml-1.5 mt-0.5 md:mt-1">
                    <span class="text-[10px] md:text-[12px] text-gray-400 font-sans tracking-widest leading-none">/</span>
                    <span id="card-total" class="text-[10px] md:text-[12px] text-gray-400 font-sans tracking-widest leading-none mt-1 ml-0.5">00</span>
                </div>
            </div>

            <div class="flex-1 mx-4 md:mx-8 h-[1px] bg-gray-200 relative overflow-hidden" aria-hidden="true">
                <div id="shop-progress" class="absolute top-0 left-0 h-full bg-[#B8906B] transition-all duration-500 ease-out" style="width: 0%; left: 0%;"></div>
            </div>

            <div class="flex gap-3 shrink-0">
                <button aria-label="Previous Product" id="shop-prev-btn" class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:text-black hover:border-black transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button aria-label="Next Product" id="shop-next-btn" class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:text-black hover:border-black transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
            
        </div>
    </div>
</section>

<div id="shop-data-1" class="hidden">
    {% for product in section.settings.collection_1.products %}
        <div class="product-card flex-shrink-0 w-[70vw] sm:w-[260px] md:w-[280px] lg:w-[300px] snap-center cursor-pointer">
            <div class="relative group w-full">
                <div class="img-wrapper w-full aspect-[4/5] rounded-[2px] overflow-hidden bg-[#F0F0F0] shadow-md">
                    <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover mix-blend-multiply" draggable="false" loading="lazy">
                </div>
                {% for tag in product.tags %}
                    {% if tag contains 'badge:' %}
                        <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-sm shadow-sm border border-black/5">
                            <span class="text-[9px] font-sans tracking-[0.2em] uppercase font-bold text-black">{{ tag | remove: 'badge:' }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
                <div class="overlay absolute inset-0 bg-black/5 rounded-[2px] flex items-end justify-center pb-6 pointer-events-none transition-colors">
                    <form method="post" action="/cart/add" class="pointer-events-auto w-full flex justify-center" onsubmit="event.preventDefault(); showToast('{{ product.title | escape | replace: "'", "\'" }}'); this.submit();">
                        <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                        <button type="submit" class="quick-add-btn pointer-events-auto bg-white/95 backdrop-blur-md border border-gray-200 text-black text-[10px] font-sans tracking-[0.2em] uppercase font-bold px-8 py-3.5 shadow-xl hover:bg-black hover:text-white hover:border-black transition-all duration-300">Quick Add</button>
                    </form>
                </div>
            </div>
            <div class="mt-5 text-center px-2">
                <span class="text-[8px] text-gray-400 uppercase tracking-[0.25em] block mb-2">{{ section.settings.tab_1_label }}</span>
                <a href="{{ product.url }}"><h3 class="font-serif text-[22px] md:text-[26px] font-medium text-black tracking-tight leading-tight">{{ product.title }}</h3></a>
                <p class="mt-2 text-gray-500 text-xs md:text-sm font-sans italic">{{ product.price | money }}</p>
            </div>
        </div>
    {% endfor %}
</div>

<div id="shop-data-2" class="hidden">
    {% for product in section.settings.collection_2.products %}
        <div class="product-card flex-shrink-0 w-[70vw] sm:w-[260px] md:w-[280px] lg:w-[300px] snap-center cursor-pointer">
            <div class="relative group w-full">
                <div class="img-wrapper w-full aspect-[4/5] rounded-[2px] overflow-hidden bg-[#F0F0F0] shadow-md">
                    <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover mix-blend-multiply" draggable="false" loading="lazy">
                </div>
                {% for tag in product.tags %}
                    {% if tag contains 'badge:' %}
                        <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-sm shadow-sm border border-black/5">
                            <span class="text-[9px] font-sans tracking-[0.2em] uppercase font-bold text-black">{{ tag | remove: 'badge:' }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
                <div class="overlay absolute inset-0 bg-black/5 rounded-[2px] flex items-end justify-center pb-6 pointer-events-none transition-colors">
                    <form method="post" action="/cart/add" class="pointer-events-auto w-full flex justify-center" onsubmit="event.preventDefault(); showToast('{{ product.title | escape | replace: "'", "\'" }}'); this.submit();">
                        <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                        <button type="submit" class="quick-add-btn pointer-events-auto bg-white/95 backdrop-blur-md border border-gray-200 text-black text-[10px] font-sans tracking-[0.2em] uppercase font-bold px-8 py-3.5 shadow-xl hover:bg-black hover:text-white hover:border-black transition-all duration-300">Quick Add</button>
                    </form>
                </div>
            </div>
            <div class="mt-5 text-center px-2">
                <span class="text-[8px] text-gray-400 uppercase tracking-[0.25em] block mb-2">{{ section.settings.tab_2_label }}</span>
                <a href="{{ product.url }}"><h3 class="font-serif text-[22px] md:text-[26px] font-medium text-black tracking-tight leading-tight">{{ product.title }}</h3></a>
                <p class="mt-2 text-gray-500 text-xs md:text-sm font-sans italic">{{ product.price | money }}</p>
            </div>
        </div>
    {% endfor %}
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('shop-scroll');
    const cardContainer = document.getElementById('card-container');
    const progressBar = document.getElementById('shop-progress');
    const currentEl = document.getElementById('card-current');
    const totalEl = document.getElementById('card-total');
    const prevBtn = document.getElementById('shop-prev-btn');
    const nextBtn = document.getElementById('shop-next-btn');
    const tabBtns = document.querySelectorAll('.tab-btn');
    
    // Fetch raw templates from hidden divs
    const data1 = Array.from(document.getElementById('shop-data-1').children);
    const data2 = Array.from(document.getElementById('shop-data-2').children);
    
    let totalOriginal = 0;
    let isJumping = false;
    let scrollTimeout = null;
    
    function renderTab(tabIndex) {
        const originalCards = tabIndex === 1 ? data1 : data2;
        totalOriginal = originalCards.length;
        cardContainer.innerHTML = '';
        
        if (totalOriginal === 0) {
            cardContainer.innerHTML = '<div class="w-full text-center py-20 px-8 text-gray-400 font-sans tracking-widest uppercase text-xs">Please select a collection in the customizer.</div>';
            if (totalEl) totalEl.textContent = '00';
            return;
        }
        
        if (totalEl) totalEl.textContent = String(totalOriginal).padStart(2, '0');
        
        // Loop 3 times to recreate infinite scrolling logic
        for (let i = 0; i < 3; i++) {
            originalCards.forEach((cardTemplate, idx) => {
                const clone = cardTemplate.cloneNode(true);
                clone.dataset.index = (i * totalOriginal) + idx;
                clone.dataset.realIndex = idx;
                clone.addEventListener('click', () => scrollToCard(parseInt(clone.dataset.index)));
                cardContainer.appendChild(clone);
            });
        }
        
        adjustSpacers();
        requestAnimationFrame(() => {
            jumpToIndexSilently(totalOriginal); // Start in the middle of the loop
        });
    }

    function adjustSpacers() {
        if (!cardContainer.children.length) return;
        const cardWidth = cardContainer.children[0].offsetWidth || 280;
        const containerWidth = scrollContainer.clientWidth;
        const space = (containerWidth / 2) - (cardWidth / 2);
        document.getElementById('start-spacer').style.width = `${space}px`;
        document.getElementById('end-spacer').style.width = `${space}px`;
    }

    window.addEventListener('resize', () => {
        adjustSpacers();
        const activeCard = document.querySelector('.product-card.active-card');
        if (activeCard) {
            jumpToIndexSilently(parseInt(activeCard.dataset.index));
        }
    });

    function scrollToCard(index) {
        const cards = Array.from(cardContainer.children);
        if (!cards[index]) return;
        const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
        const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
        scrollContainer.scrollTo({ left: scrollPos, behavior: 'smooth' });
    }

    function jumpToIndexSilently(index) {
        isJumping = true;
        scrollContainer.style.scrollBehavior = 'auto';
        const cards = Array.from(cardContainer.children);
        if (cards[index]) {
            const cardCenter = cards[index].offsetLeft + (cards[index].offsetWidth / 2);
            const scrollPos = cardCenter - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = scrollPos;
            
            cards.forEach(c => c.classList.remove('active-card'));
            cards[index].classList.add('active-card');
            updateUI(parseInt(cards[index].dataset.realIndex));
        }
        requestAnimationFrame(() => {
            scrollContainer.style.scrollBehavior = 'smooth';
            isJumping = false;
        });
    }

    function updateUI(realIndex) {
        if (currentEl) currentEl.textContent = String(realIndex + 1).padStart(2, '0');
        if (progressBar && totalOriginal > 0) {
            const progressWidth = 100 / totalOriginal;
            progressBar.style.width = `${progressWidth}%`;
            progressBar.style.left = `${realIndex * progressWidth}%`;
        }
    }

    function handleScroll() {
        if (isJumping || totalOriginal === 0) return;
        const cards = Array.from(cardContainer.children);
        const containerCenter = scrollContainer.scrollLeft + (scrollContainer.clientWidth / 2);
        
        let minDiff = Infinity;
        let closestIndex = 0;

        cards.forEach((card, i) => {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const diff = Math.abs(containerCenter - cardCenter);
            if (diff < minDiff) {
                minDiff = diff;
                closestIndex = i;
            }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));
        updateUI(parseInt(cards[closestIndex].dataset.realIndex));

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex < totalOriginal || closestIndex >= totalOriginal * 2) {
                const safeIndex = (closestIndex % totalOriginal) + totalOriginal;
                jumpToIndexSilently(safeIndex);
            }
        }, 100);
    }

    scrollContainer.addEventListener('scroll', handleScroll);

    if (prevBtn) prevBtn.addEventListener('click', () => {
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) + 1);
    });

    // Tab Logic
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(t => {
                t.classList.remove('active', 'text-black', 'font-bold');
                t.classList.add('text-gray-400');
                t.querySelector('.tab-active-line').classList.replace('scale-x-100', 'scale-x-0');
            });
            btn.classList.add('active', 'text-black', 'font-bold');
            btn.classList.remove('text-gray-400');
            btn.querySelector('.tab-active-line').classList.replace('scale-x-0', 'scale-x-100');
            
            renderTab(parseInt(btn.dataset.tab));
        });
    });

    // Drag to scroll
    let isDown = false, startX, scrollLeft;
    scrollContainer.addEventListener('mousedown', (e) => {
        isDown = true;
        scrollContainer.classList.add('dragging');
        startX = e.pageX - scrollContainer.offsetLeft;
        scrollLeft = scrollContainer.scrollLeft;
    });
    scrollContainer.addEventListener('mouseleave', () => { isDown = false; scrollContainer.classList.remove('dragging'); handleScroll(); });
    scrollContainer.addEventListener('mouseup', () => { isDown = false; scrollContainer.classList.remove('dragging'); handleScroll(); });
    scrollContainer.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - scrollContainer.offsetLeft;
        const walk = (x - startX) * 2;
        scrollContainer.scrollLeft = scrollLeft - walk;
    });

    // Toast Function globally attached
    window.showToast = function(productName) {
        const toast = document.getElementById('toast');
        const msg = document.getElementById('toast-message');
        if(toast && msg) {
            msg.textContent = `${productName} added to cart`;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
    };

    // Initialize first tab
    renderTab(1);
});
</script>

{% schema %}
{
  "name": "Shop Carousel",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Curated Essentials" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop the Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Timeless pieces crafted with intention, designed to elevate everyday moments." },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 Label", "default": "Video Book" },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 Label", "default": "Audio Cards" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" }
  ],
  "presets": [{ "name": "Shop Carousel" }]
}
{% endschema %}