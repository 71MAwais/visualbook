{% comment %} sections/visual-header.liquid {% endcomment %}

<header id="main-header" class="w-full fixed top-0 left-0 z-50 bg-white/95 backdrop-blur-sm text-black border-b border-gray-100 transition-all duration-300">
    
    <div class="hidden lg:flex max-w-[1600px] mx-auto px-6 lg:px-12 py-4 items-center justify-between">
        
        <div class="flex-1 flex justify-start">
            <a href="{{ routes.root_url }}" class="flex flex-col items-start group focus:outline-none" aria-label="Home">
                <h1 class="text-[16px] font-logo font-medium tracking-[0.15em] leading-tight uppercase text-black group-hover:opacity-60 transition-opacity">{{ section.settings.logo_text }}</h1>
                <span class="text-[8px] tracking-[0.3em] font-medium uppercase text-gray-500 leading-none mt-1">{{ section.settings.city_text }}</span>
            </a>
        </div>

        <div class="flex-[2] flex items-center justify-center z-50">
            <nav class="flex items-center gap-8 text-[11px] tracking-[0.15em] text-black font-medium uppercase" role="navigation">
                {% for link in linklists[section.settings.menu].links %}
                    {% if link.links != blank %}
                        <div class="relative group py-4">
                            <a href="{{ link.url }}" class="flex items-center gap-1.5 hover:text-gray-500 transition-colors focus:outline-none {% if link.active %}border-b border-black pb-0.5{% endif %}">
                                {{ link.title }}
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
                            </a>
                            
                            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-1 w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 transform translate-y-2 group-hover:translate-y-0">
                                <div class="bg-white border border-gray-100 shadow-xl p-5 flex flex-col gap-4 rounded-sm">
                                    {% for child_link in link.links %}
                                        <div class="flex flex-col gap-2">
                                            <a href="{{ child_link.url }}" class="text-[10px] font-bold tracking-widest text-black hover:text-gray-500 transition-colors">{{ child_link.title }}</a>
                                            {% if child_link.links != blank %}
                                                <div class="flex flex-col gap-2 pl-2 border-l border-gray-100 ml-1 mt-1">
                                                    {% for grandchild_link in child_link.links %}
                                                        <a href="{{ grandchild_link.url }}" class="text-[11px] text-gray-500 hover:text-black transition-colors capitalize">{{ grandchild_link.title }}</a>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ link.url }}" class="py-4 hover:text-gray-500 transition-colors focus:outline-none {% if link.active %}border-b border-black pb-0.5{% endif %}">
                            {{ link.title }}
                        </a>
                    {% endif %}
                {% endfor %}
            </nav>
        </div>

        <div class="flex-1 flex items-center justify-end gap-6 text-[12px] text-black">
            <div class="hidden xl:flex items-center gap-1 cursor-pointer hover:text-gray-500 transition-colors font-medium">
                <span>{{ cart.currency.iso_code }} {{ cart.currency.symbol }}</span>
            </div>
            
            <div class="flex items-center gap-5">
                <a href="{{ routes.search_url }}" class="hover:opacity-50 transition-opacity" aria-label="Search">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </a>
                <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hover:opacity-50 transition-opacity" aria-label="Account">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </a>
                <a href="{{ routes.cart_url }}" class="hover:opacity-50 transition-opacity relative" aria-label="Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    {% if cart.item_count > 0 %}
                        <span class="absolute -top-1.5 -right-1.5 bg-black text-white text-[8px] font-bold w-[14px] h-[14px] rounded-full flex items-center justify-center">{{ cart.item_count }}</span>
                    {% endif %}
                </a>
            </div>
        </div>
    </div>

    <div class="flex lg:hidden items-center justify-between px-5 py-4" id="mobile-header-container">
        <div class="flex-1 flex items-center">
            <button id="mobile-menu-btn" aria-label="Open Mobile Menu" class="flex flex-col gap-[5px] p-2 -ml-2 hover:opacity-60 transition-opacity">
                <span class="w-6 h-[1.5px] bg-black"></span>
                <span class="w-6 h-[1.5px] bg-black"></span>
                <span class="w-6 h-[1.5px] bg-black"></span>
            </button>
        </div>
        <div class="flex-[2] flex flex-col items-center text-center">
            <a href="{{ routes.root_url }}">
                <h1 class="text-[15px] font-logo font-medium tracking-[0.1em] text-black leading-tight uppercase">{{ section.settings.logo_text }}</h1>
                <span class="text-[7px] tracking-[0.3em] font-medium uppercase text-gray-500 leading-none mt-1">{{ section.settings.city_text }}</span>
            </a>
        </div>
        <div class="flex-1 flex items-center justify-end gap-4 text-black">
            <a href="{{ routes.cart_url }}" class="hover:opacity-60 transition-opacity relative" aria-label="Cart">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                {% if cart.item_count > 0 %}<span class="absolute -top-2 -right-2 bg-black text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center">{{ cart.item_count }}</span>{% endif %}
            </a>
        </div>
    </div>
</header>

<div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-[60] hidden opacity-0 transition-opacity duration-500 cursor-pointer" aria-hidden="true"></div>

<div id="mobile-sidebar" class="fixed top-0 left-0 w-[85vw] max-w-[360px] h-full bg-white z-[70] transform -translate-x-full transition-transform duration-[500ms] ease-out shadow-2xl flex flex-col overflow-hidden" aria-modal="true" role="dialog">
    <div class="p-6 flex justify-between items-center border-b border-black/5 shrink-0">
        <div class="flex flex-col">
            <h2 class="text-[13px] font-logo font-medium tracking-[0.15em] text-black leading-tight uppercase">{{ section.settings.logo_text }}</h2>
        </div>
        <button id="close-sidebar-btn" aria-label="Close Mobile Menu" class="p-2 -mr-2 hover:opacity-60 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>
    
    <div class="relative flex-1 w-full h-full overflow-hidden">
        <div id="panel-root" class="nav-panel absolute top-0 left-0 w-full h-full bg-white transition-transform duration-[500ms] ease-out translate-x-0 overflow-y-auto pb-20">
            <nav class="flex flex-col p-8 gap-8 text-[14px] tracking-[0.15em] text-black font-normal uppercase">
                {% for link in linklists[section.settings.menu].links %}
                    {% if link.links != blank %}
                        <button class="drill-btn flex items-center justify-between w-full hover:opacity-50 transition-opacity group" data-target="panel-l2-{{ forloop.index }}">
                            {{ link.title }}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    {% else %}
                        <a href="{{ link.url }}" class="hover:opacity-50 transition-opacity">{{ link.title }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
        </div>

        {% for link in linklists[section.settings.menu].links %}
            {% if link.links != blank %}
                {% assign l2_index = forloop.index %}
                <div id="panel-l2-{{ l2_index }}" class="nav-panel absolute top-0 left-0 w-full h-full bg-white transition-transform duration-[500ms] ease-out translate-x-full overflow-y-auto pb-20 z-10">
                    <div class="p-8 flex flex-col h-full">
                        <button class="back-btn flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] font-medium text-gray-400 hover:text-black transition-colors mb-10 w-full group" data-target="panel-root">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform duration-300 group-hover:-translate-x-1"><path d="m15 18-6-6 6-6"/></svg>
                            Back
                        </button>
                        
                        <a href="{{ link.url }}" class="text-[18px] font-logo uppercase tracking-widest text-black mb-8 block hover:opacity-50 transition-opacity">{{ link.title }}</a>
                        
                        <nav class="flex flex-col gap-6 text-[13px] tracking-[0.05em] text-gray-600 font-light">
                            {% for child_link in link.links %}
                                {% if child_link.links != blank %}
                                    <button class="drill-btn flex items-center justify-between w-full hover:text-black transition-colors group" data-target="panel-l3-{{ l2_index }}-{{ forloop.index }}">
                                        {{ child_link.title }}
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
                                    </button>
                                {% else %}
                                    <a href="{{ child_link.url }}" class="hover:text-black transition-colors">{{ child_link.title }}</a>
                                {% endif %}
                            {% endfor %}
                        </nav>
                    </div>
                </div>

                {% for child_link in link.links %}
                    {% if child_link.links != blank %}
                        <div id="panel-l3-{{ l2_index }}-{{ forloop.index }}" class="nav-panel absolute top-0 left-0 w-full h-full bg-white transition-transform duration-[500ms] ease-out translate-x-full overflow-y-auto pb-20 z-20">
                            <div class="p-8 flex flex-col h-full">
                                <button class="back-btn flex items-center gap-3 text-[10px] uppercase tracking-[0.2em] font-medium text-gray-400 hover:text-black transition-colors mb-10 w-full group" data-target="panel-l2-{{ l2_index }}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="transition-transform duration-300 group-hover:-translate-x-1"><path d="m15 18-6-6 6-6"/></svg>
                                    Back
                                </button>
                                
                                <a href="{{ child_link.url }}" class="text-[18px] font-logo uppercase tracking-widest text-black mb-8 block hover:opacity-50 transition-opacity">{{ child_link.title }}</a>
                                
                                <nav class="flex flex-col gap-6 text-[13px] tracking-[0.05em] text-gray-600 font-light">
                                    {% for grandchild_link in child_link.links %}
                                        <a href="{{ grandchild_link.url }}" class="hover:text-black transition-colors">{{ grandchild_link.title }}</a>
                                    {% endfor %}
                                </nav>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mainHeader = document.getElementById('main-header');

        // Optional: Add a very subtle shadow on scroll for desktop to keep it clean
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                mainHeader.classList.add('shadow-sm');
            } else {
                mainHeader.classList.remove('shadow-sm');
            }
        });

        // Mobile Menu Scripts
        const mobileSidebar = document.getElementById('mobile-sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        const allPanels = document.querySelectorAll('.nav-panel');

        function openSidebar() {
            sidebarOverlay.classList.remove('hidden');
            setTimeout(() => {
                sidebarOverlay.classList.remove('opacity-0');
                mobileSidebar.classList.remove('-translate-x-full');
            }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            sidebarOverlay.classList.add('opacity-0');
            mobileSidebar.classList.add('-translate-x-full');
            setTimeout(() => {
                sidebarOverlay.classList.add('hidden');
                resetPanels(); 
            }, 500); 
            document.body.style.overflow = ''; 
        }

        document.getElementById('mobile-menu-btn')?.addEventListener('click', openSidebar);
        document.getElementById('close-sidebar-btn')?.addEventListener('click', closeSidebar);
        sidebarOverlay?.addEventListener('click', closeSidebar);

        function resetPanels() {
            allPanels.forEach(p => {
                p.classList.remove('translate-x-0', '-translate-x-full');
                p.id === 'panel-root' ? p.classList.add('translate-x-0') : p.classList.add('translate-x-full');
            });
        }

        document.querySelectorAll('.drill-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = document.getElementById(btn.getAttribute('data-target'));
                const current = btn.closest('.nav-panel');
                current.classList.replace('translate-x-0', '-translate-x-full');
                target.classList.replace('translate-x-full', 'translate-x-0');
            });
        });

        document.querySelectorAll('.back-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = document.getElementById(btn.getAttribute('data-target'));
                const current = btn.closest('.nav-panel');
                current.classList.replace('translate-x-0', 'translate-x-full');
                target.classList.replace('-translate-x-full', 'translate-x-0');
            });
        });
    });
</script>

{% schema %}
{
  "name": "Visual Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Brand Name", "default": "THE VISUAL BOOK" },
    { "type": "text", "id": "city_text", "label": "Sub-heading", "default": "LONDON" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ],
  "presets": [{ "name": "Visual Header" }]
}
{% endschema %}