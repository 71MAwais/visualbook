        {% elsif product.id == second_lowest_id_2 and second_lowest_qty_2 < 10 %}
            {% assign is_low_stock = true %}
        {% endif %}

        <div class="shop-product-card group flex flex-col lg:flex-row lg:col-span-3 bg-stone-50 border border-stone-200/50 rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-500" data-category="tab-2-products" style="display:none;">
