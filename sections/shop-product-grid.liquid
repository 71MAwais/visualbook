<style>
    /* Accessibility Focus Utility */
    .focus-ring { outline: none; }
    .focus-ring:focus-visible { outline: 2px solid #1c1917; outline-offset: 2px; }
    
    /* Hide scrollbar for tabs on mobile if they overflow */
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Subtle float animation for featured product */
    @keyframes subtleLift {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
        100% { transform: translateY(0px); }
    }
    .hover-lift:hover {
        animation: subtleLift 3s ease-in-out infinite;
    }
</style>

<section id="shop-grid-{{ section.id }}" class="bg-white pt-12 md:pt-16 pb-0 font-sans antialiased overflow-hidden">

  <!-- Tabs Navigation -->
  <div class="flex justify-center mb-12 md:mb-16 border-b border-stone-200 w-full max-w-[600px] mx-auto overflow-x-auto hide-scrollbar" role="tablist">
    <button 
      role="tab"
      aria-selected="true"
      class="shop-tab-btn focus-ring pb-4 px-6 md:px-10 text-[11px] md:text-[13px] tracking-[0.15em] uppercase transition-all duration-300 relative text-[#111111] font-bold whitespace-nowrap"
      data-target="tab-1-products"
    >
      {{ section.settings.tab_1_label | default: "Video Books" }}
      <span class="tab-indicator absolute bottom-0 left-0 w-full h-[2px] bg-[#111111]"></span>
    </button>
    <button 
      role="tab"
      aria-selected="false"
      class="shop-tab-btn focus-ring pb-4 px-6 md:px-10 text-[11px] md:text-[13px] tracking-[0.15em] uppercase transition-all duration-300 relative text-stone-400 hover:text-stone-700 font-medium whitespace-nowrap"
      data-target="tab-2-products"
    >
      {{ section.settings.tab_2_label | default: "Audio Cards" }}
      <span class="tab-indicator absolute bottom-0 left-0 w-full h-[2px] bg-[#111111] hidden"></span>
    </button>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      
      {% assign collection_1 = section.settings.collection_1 %}
      {% for product in collection_1.products limit: section.settings.max_products %}
        
        {%- comment -%} Determine if this is the featured first product {%- endcomment -%}
        {% assign is_featured = false %}
        {% if forloop.first %}
          {% assign is_featured = true %}
        {% endif %}

        <div class="shop-product-card group flex flex-col {% if is_featured %}lg:flex-row lg:col-span-3 bg-stone-50 border border-stone-200/50 rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-500{% else %}items-center{% endif %}" data-category="tab-1-products">
          
          <!-- Image Container -->
          <a href="{{ product.url }}" class="focus-ring relative w-full {% if is_featured %}lg:w-[55%] aspect-square md:aspect-[16/10] bg-stone-100{% else %}aspect-[4/5] bg-stone-50 mb-6 rounded-sm{% endif %} flex items-center justify-center p-8 md:p-14 overflow-hidden transition-all duration-500 hover:bg-stone-100/80">
            
            <!-- Badges -->
            <div class="absolute top-5 left-5 z-20 flex flex-col gap-2 items-start">
              {% if is_featured %}
                <span class="bg-[#111111] text-white text-[10px] tracking-[0.15em] uppercase px-3 py-1.5 font-bold shadow-md">#1 Bestseller</span>
              {% elsif forloop.index == 2 %}
                <span class="bg-white/95 text-red-600 border border-red-100 text-[10px] tracking-wider uppercase px-3 py-1 font-bold shadow-sm flex items-center gap-1.5 rounded-full">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  Low Stock
                </span>
              {% endif %}
            </div>

            <!-- Image -->
            <div class="relative w-full h-full flex items-center justify-center transition-transform duration-700 ease-out {% if is_featured %}hover-lift{% else %}group-hover:-translate-y-2{% endif %}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag: 
                    class: 'max-w-full max-h-full object-contain shadow-2xl shadow-stone-300/60 transition-shadow duration-500 group-hover:shadow-stone-400/70 relative z-10',
                    widths: '400, 600, 800',
                    sizes: '(max-width: 768px) 100vw, 50vw',
                    loading: 'lazy',
                    alt: product.title | escape
                }}
              {% else %}
                <div class="w-full h-full bg-stone-200 flex items-center justify-center text-stone-400">No Image</div>
              {% endif %}
            </div>
          </a>

          <!-- Product Details -->
          <div class="w-full {% if is_featured %}lg:w-[45%] p-8 lg:p-14 flex flex-col justify-center items-center lg:items-start text-center lg:text-left{% else %}px-4 flex flex-col items-center text-center{% endif %}">
            
            <div class="flex space-x-1 mb-3" aria-label="5 out of 5 stars">
              {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[#C5A059]"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {% endfor %}
              {% if is_featured %}<span class="text-[12px] text-stone-400 ml-2">(2,145)</span>{% endif %}
            </div>
            
            <h3 class="font-serif text-[#111111] {% if is_featured %}text-2xl md:text-3xl mb-3{% else %}text-[15px] md:text-base mb-2 uppercase tracking-wide{% endif %} leading-tight">
              <a href="{{ product.url }}" class="focus-ring hover:text-[#C5A059] transition-colors">{{ product.title }}</a>
            </h3>

            {% if is_featured %}
              <p class="text-stone-500 text-[14px] md:text-[15px] font-light leading-relaxed mb-6 max-w-md">
                 Our signature design. The perfect blank canvas for weddings, anniversaries, and life's most elegant milestones. Includes a stunning HD display to bring memories to life.
              </p>
            {% endif %}
            
            <div class="flex items-center gap-4 mb-8">
              <p class="{% if is_featured %}text-xl md:text-2xl{% else %}text-[14px] md:text-[15px]{% endif %} text-[#111111] font-medium">{{ product.price | money }}</p>
              {% if is_featured %}
                 <span class="text-[11px] text-emerald-600 font-bold tracking-wider uppercase bg-emerald-50 px-2 py-1 rounded-sm flex items-center gap-1">
                   <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Ships Fast
                 </span>
              {% endif %}
            </div>
            
            <!-- High Contrast CTA Form -->
            <product-form class="w-full">
                <form method="post" action="/cart/add" class="w-full flex {% if is_featured %}justify-center lg:justify-start{% else %}justify-center{% endif %}" data-type="add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" name="add" class="quick-add-btn focus-ring w-full {% if is_featured %}md:w-[80%] lg:w-full max-w-[320px]{% else %}md:w-[90%] max-w-[280px]{% endif %} px-6 py-4 text-[11px] md:text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 flex items-center justify-center bg-[#111111] text-white hover:bg-[#C5A059] hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" {% if product.available == false %}disabled{% endif %}>
                    <span class="btn-text flex items-center gap-2">
                        {% if product.available %}
                            Add To Cart <svg class="w-4 h-4 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        {% else %}
                            Sold Out
                        {% endif %}
                    </span>
                    <span class="added-state hidden items-center">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 mr-2 text-white"><path d="M20 6 9 17l-5-5"/></svg>
                        Added to Cart
                    </span>
                    <div class="loading-spinner hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                </button>
                </form>
            </product-form>

            {% if is_featured %}
              <div class="mt-6 flex gap-6 text-[10px] text-stone-400 uppercase tracking-widest font-bold">
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg> 1 Year Warranty</span>
                  <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg> 30-Day Returns</span>
              </div>
            {% endif %}

          </div>
        </div>
      {% else %}
        {% for i in (1..3) %}
          <div class="shop-product-card group flex flex-col items-center" data-category="tab-1-products">
            <div class="relative w-full aspect-[4/5] bg-stone-50 mb-8 flex items-center justify-center p-6 sm:p-10">
              <p class="text-stone-400 text-sm font-light">Select a Collection in Customizer</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}

      <!-- Tab 2 Products -->
      {% assign collection_2 = section.settings.collection_2 %}
      {% for product in collection_2.products limit: section.settings.max_products %}
        <div class="shop-product-card group flex flex-col items-center" data-category="tab-2-products" style="display:none;">
          
          <a href="{{ product.url }}" class="focus-ring relative w-full aspect-[4/5] bg-stone-50 mb-6 rounded-sm flex items-center justify-center p-8 md:p-14 overflow-hidden transition-all duration-500 hover:bg-stone-100/80">
            <div class="relative w-full h-full flex items-center justify-center transition-transform duration-700 ease-out group-hover:-translate-y-2">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag: 
                    class: 'max-w-full max-h-full object-contain shadow-2xl shadow-stone-300/60 transition-shadow duration-500 group-hover:shadow-stone-400/70 relative z-10',
                    widths: '400, 600, 800',
                    sizes: '(max-width: 768px) 100vw, 33vw',
                    loading: 'lazy',
                    alt: product.title | escape
                }}
              {% else %}
                <div class="w-full h-full bg-stone-200 flex items-center justify-center text-stone-400">No Image</div>
              {% endif %}
            </div>
          </a>

          <div class="text-center w-full px-4 flex flex-col items-center">
            <div class="flex justify-center space-x-1 mb-3" aria-label="5 out of 5 stars">
              {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[#C5A059]"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {% endfor %}
            </div>
            
            <h3 class="text-[15px] md:text-base font-serif text-[#111111] mb-2 uppercase tracking-wide leading-tight">
              <a href="{{ product.url }}" class="focus-ring hover:text-[#C5A059] transition-colors">{{ product.title }}</a>
            </h3>
            
            <p class="text-[14px] md:text-[15px] text-[#111111] mb-8 font-medium">{{ product.price | money }}</p>
            
            <product-form class="w-full">
                <form method="post" action="/cart/add" class="w-full flex justify-center" data-type="add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" name="add" class="quick-add-btn focus-ring w-full md:w-[90%] max-w-[280px] px-6 py-4 text-[11px] md:text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 flex items-center justify-center bg-[#111111] text-white hover:bg-[#C5A059] hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" {% if product.available == false %}disabled{% endif %}>
                    <span class="btn-text">{% if product.available %}Add To Cart{% else %}Sold Out{% endif %}</span>
                    <span class="added-state hidden items-center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 mr-2"><path d="M20 6 9 17l-5-5"/></svg>
                    Added
                    </span>
                    <div class="loading-spinner hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                </button>
                </form>
            </product-form>
          </div>
        </div>
      {% endfor %}

    </div>
  </div>

  <!-- Emotional Hook Banner -->
  <div class="bg-[#111111] text-white py-20 lg:py-24 mt-10 relative overflow-hidden border-t border-stone-800">
      <div class="absolute left-0 top-0 w-1/2 h-full bg-[#C5A059]/10 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
          <h2 class="font-serif text-3xl md:text-5xl lg:text-6xl mb-6 tracking-wide leading-tight">
              Give the gift of <br class="md:hidden" /><i class="text-[#C5A059]">happy tears.</i>
          </h2>
          <p class="text-stone-400 text-[15px] md:text-[17px] font-light mb-12 max-w-2xl mx-auto leading-relaxed">
              In a world of endless scrolling, give them something to hold. The Visual Book brings your digital memories into the physical world instantly. No setup, no internet, just pure emotion.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
              <div class="flex items-center justify-center gap-4 bg-white/5 border border-white/10 rounded-sm py-5 px-6 backdrop-blur-sm">
                  <svg class="w-7 h-7 text-[#C5A059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                  <div class="text-left">
                      <p class="text-[10px] uppercase tracking-widest text-stone-500 font-bold mb-0.5">Step 1</p>
                      <p class="text-sm font-medium tracking-wide">Plug & Upload</p>
                  </div>
              </div>
              <div class="flex items-center justify-center gap-4 bg-white/5 border border-white/10 rounded-sm py-5 px-6 backdrop-blur-sm">
                  <svg class="w-7 h-7 text-[#C5A059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                  <div class="text-left">
                      <p class="text-[10px] uppercase tracking-widest text-stone-500 font-bold mb-0.5">Step 2</p>
                      <p class="text-sm font-medium tracking-wide">Open Cover</p>
                  </div>
              </div>
              <div class="flex items-center justify-center gap-4 bg-white/5 border border-white/10 rounded-sm py-5 px-6 backdrop-blur-sm">
                  <svg class="w-7 h-7 text-[#C5A059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <div class="text-left">
                      <p class="text-[10px] uppercase tracking-widest text-stone-500 font-bold mb-0.5">Step 3</p>
                      <p class="text-sm font-medium tracking-wide">Instant Magic</p>
                  </div>
              </div>
          </div>
      </div>
  </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  
  // --- Tab Switching Logic ---
  const tabs = document.querySelectorAll('.shop-tab-btn');
  const products = document.querySelectorAll('.shop-product-card');

  function filterProducts(category) {
    products.forEach(product => {
      if (product.dataset.category === category) {
        product.style.display = 'flex';
        // Small animation trigger
        product.style.opacity = '0';
        product.style.transform = 'translateY(15px)';
        setTimeout(() => {
            product.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            product.style.opacity = '1';
            product.style.transform = 'translateY(0)';
        }, 20);
      } else {
        product.style.display = 'none';
      }
    });
  }

  // Initial Filter
  filterProducts('tab-1-products');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Reset all tabs
      tabs.forEach(t => {
        t.classList.remove('text-[#111111]', 'font-bold');
        t.classList.add('text-stone-400', 'font-medium');
        t.setAttribute('aria-selected', 'false');
        t.querySelector('.tab-indicator').classList.add('hidden');
      });

      // Set active tab
      tab.classList.add('text-[#111111]', 'font-bold');
      tab.classList.remove('text-stone-400', 'font-medium');
      tab.setAttribute('aria-selected', 'true');
      tab.querySelector('.tab-indicator').classList.remove('hidden');

      // Filter products
      filterProducts(tab.dataset.target);
    });
    
    // Keyboard navigation for tabs
    tab.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            tab.click();
        }
    });
  });

  // --- AJAX Quick Add Logic ---
  const addForms = document.querySelectorAll('form[data-type="add-to-cart-form"]');
  
  addForms.forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const submitBtn = this.querySelector('.quick-add-btn');
      const originalText = submitBtn.querySelector('.btn-text');
      const addedText = submitBtn.querySelector('.added-state');
      const spinner = submitBtn.querySelector('.loading-spinner');
      
      // Prevent double clicks
      if(submitBtn.disabled) return;
      submitBtn.disabled = true;

      // Loading visual state
      originalText.classList.add('hidden');
      spinner.classList.remove('hidden');

      const formData = new FormData(this);
      
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(res => res.json())
      .then(data => {
        // Success visual state
        spinner.classList.add('hidden');
        addedText.classList.remove('hidden');
        addedText.style.display = 'flex';
        
        // Turn button green/success temporarily
        submitBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
        submitBtn.classList.remove('bg-[#111111]', 'hover:bg-[#C5A059]');

        // Reset after 2.5s
        setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.classList.remove('bg-emerald-600', 'border-emerald-600');
          submitBtn.classList.add('bg-[#111111]', 'hover:bg-[#C5A059]');
          originalText.classList.remove('hidden');
          addedText.classList.add('hidden');
          addedText.style.display = 'none';
        }, 2500);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        // Revert on error
        submitBtn.disabled = false;
        spinner.classList.add('hidden');
        originalText.classList.remove('hidden');
      });
    });
  });
});
</script>

{% schema %}
{
  "name": "Shop Grid (No Header)",
  "settings": [
    {
      "type": "header",
      "content": "Tab 1 Settings"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 Name",
      "default": "Video Books"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "header",
      "content": "Tab 2 Settings"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 Name",
      "default": "Audio Cards"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products per tab",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Shop Grid (No Header)"
    }
  ]
}
{% endschema %}