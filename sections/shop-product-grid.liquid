                   <img src="{{ section.settings.award_icon | img_url: '160x' }}" class="w-full h-full object-contain" alt="Award Logo" loading="lazy">
               </div>
            {% endif %}
            <div class="relative w-full h-full flex items-center justify-center transition-transform duration-700 ease-out hover-lift">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag: class: 'max-w-full max-h-full object-contain shadow-2xl shadow-stone-300/60 transition-shadow duration-500 group-hover:shadow-stone-400/70 relative z-10', loading: 'lazy', alt: product.title | escape }}
              {% endif %}
            </div>
