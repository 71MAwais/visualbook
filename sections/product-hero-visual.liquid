{% comment %}
  Section: visual-product-hero.liquid
  Description: Custom Tailwind product section with square responsive gallery, CUSTOM DYNAMIC JUDGE.ME STARS, AJAX cart animation, fixed rich text, native UploadKit widget, and editable interactive modals.
{% endcomment %}

{% unless section.settings.hide_section %}
<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e5e5e5; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #d4d4d4; }

    .snap-container { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
    .snap-slide { scroll-snap-align: center; scroll-snap-stop: always; }
    
    .no-select { user-select: none; -webkit-user-select: none; -webkit-user-drag: none; }
    
    /* Layout & Squeeze Fixes */
    .product-form { width: 100%; max-width: 100%; }
    .product-form form { width: 100%; }
    .product-form__submit { 
        width: 100% !important; 
        max-width: 100% !important;
        min-width: 0 !important; 
        position: relative !important; 
    }
    #ProductSection-{{ section.id }} { overflow-x: hidden; }

    .shopify-payment-button__button--unbranded { display: none !important; }
    .shopify-payment-button__button { width: 100% !important; border-radius: 8px !important; height: 60px !important; font-size: 15px !important; font-weight: 600 !important; font-family: inherit !important; transition: all 0.2s ease !important; }
    
    @media (min-width: 640px) {
        .shopify-payment-button__button { height: 54px !important; font-size: 14px !important; }
    }

    .focus-ring { outline: none; }
    .focus-ring:focus-visible { outline: 2px solid #1c1917; outline-offset: 2px; }

    /* Custom Rich Text Formatting for Tabs & Accordions (Forced override of Tailwind Resets) */
    .visual-prose ul { list-style-type: disc !important; padding-left: 1.5rem !important; margin-top: 0.75rem !important; margin-bottom: 0.75rem !important; color: #555555; }
    .visual-prose ol { list-style-type: decimal !important; padding-left: 1.5rem !important; margin-top: 0.75rem !important; margin-bottom: 0.75rem !important; color: #555555; }
    .visual-prose li { display: list-item !important; margin-bottom: 0.35rem !important; }
    .visual-prose p { margin-bottom: 0.75rem !important; }
    .visual-prose p:last-child { margin-bottom: 0 !important; }
    .visual-prose strong, .visual-prose b { font-weight: 600 !important; color: #1a1a1a !important; }

    /* Bulletproof Button CSS against 3rd party apps */
    .product-form__submit > *:not(.btn-text) {
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
    }
    .product-form__submit.loading .btn-text { opacity: 0 !important; visibility: hidden !important; }
</style>

<script id="VisualMoneyFormat" type="application/json">
  {{ shop.money_format | json }}
</script>
<script id="VisualProductVariants" type="application/json">
  {{ product.variants | json }}
</script>

<main class="max-w-[1200px] mx-auto px-[15px] md:px-8 pt-4 pb-16 md:pt-10 md:pb-20 font-sans text-stone-800 bg-[#FCFCFC] antialiased selection:bg-stone-200" id="ProductSection-{{ section.id }}">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 lg:items-start">
        
        {%- comment -%} GALLERY COLUMN (FORCED SQUARE) {%- endcomment -%}
        <div class="lg:col-span-6 flex flex-col gap-3 lg:sticky lg:top-6 lg:h-[calc(100vh-3rem)] z-10" aria-label="Product Media Gallery" role="region">
            
            <div class="relative w-full aspect-square group rounded-xl overflow-hidden border border-stone-100 bg-stone-50 shadow-sm">
                <div id="main-image-carousel" class="snap-container flex w-full h-full overflow-x-auto hide-scrollbar scroll-smooth" aria-live="polite">
                    {% for media in product.media %}
                    <div class="snap-slide w-full h-full shrink-0 relative carousel-slide" data-index="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }} of {{ product.media.size }}">
                        {%- assign image_class = "absolute inset-0 w-full h-full object-cover object-center pointer-events-none no-select" -%}
                        {% if forloop.first %}
                            {{ media | image_url: width: 1200 | image_tag: class: image_class, widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw', preload: true, fetchpriority: 'high', alt: media.alt | default: product.title | escape }}
                        {% else %}
                            {{ media | image_url: width: 1200 | image_tag: class: image_class, widths: '400, 600, 800, 1000, 1200', sizes: '(max-width: 768px) 100vw, 50vw', loading: 'lazy', alt: media.alt | default: product.title | escape }}
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            
                <button id="prev-btn" aria-label="Previous image" type="button" class="focus-ring absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm border border-stone-200/50 text-stone-800 rounded-full flex items-center justify-center shadow-md opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:bg-white hover:scale-105 z-10">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
 
                <button id="next-btn" aria-label="Next image" type="button" class="focus-ring absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm border border-stone-200/50 text-stone-800 rounded-full flex items-center justify-center shadow-md opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:bg-white hover:scale-105 z-10">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>

            <div class="w-full px-1 py-1" aria-hidden="true">
                <div class="w-full bg-stone-200 h-1 rounded-full overflow-hidden relative">
                    <div id="slider-progress" class="absolute top-0 left-0 h-full bg-stone-900 rounded-full transition-all duration-300 ease-out" style="width: {% if product.media.size > 0 %}{{ 100.0 | divided_by: product.media.size }}%{% else %}100%{% endif %}; transform: translateX(0%);"></div>
                </div>
            </div>

            <div class="relative w-full group/thumbs shrink-0">
                <button id="thumb-prev" type="button" aria-label="Scroll thumbnails left" class="focus-ring absolute left-0 top-1/2 -translate-y-1/2 -ml-3 w-8 h-8 bg-white border border-stone-200 rounded-full shadow-md z-10 hidden items-center justify-center text-stone-600 hover:text-stone-900 md:group-hover/thumbs:flex transition-colors">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>

                <div class="flex gap-2.5 overflow-x-auto hide-scrollbar w-full shrink-0 pb-2 pt-1 cursor-grab active:cursor-grabbing scroll-smooth no-select" id="thumbnails-container" role="tablist" aria-label="Product Thumbnails">
                    {% for media in product.media %}
                    <button role="tab" type="button" aria-label="Select image {{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="main-image-carousel" class="focus-ring thumbnail-btn relative rounded-lg overflow-hidden aspect-square flex-shrink-0 w-[70px] md:w-20 transition-all duration-200 {% if forloop.first %}ring-2 ring-stone-900 ring-offset-2 opacity-100{% else %}ring-1 ring-stone-200 hover:ring-stone-400 ring-offset-2 opacity-60 hover:opacity-100{% endif %} bg-stone-100 cursor-pointer" data-index="{{ forloop.index0 }}">
                        {{ media.preview_image | image_url: width: 200 | image_tag: class: 'w-full h-full object-cover pointer-events-none select-none', widths: '100, 200', sizes: '(max-width: 768px) 70px, 80px', loading: 'lazy', alt: media.alt | default: 'Thumbnail' | escape }}
                    </button>
                    {% endfor %}
                </div>

                <button id="thumb-next" type="button" aria-label="Scroll thumbnails right" class="focus-ring absolute right-0 top-1/2 -translate-y-1/2 -mr-3 w-8 h-8 bg-white border border-stone-200 rounded-full shadow-md z-10 hidden items-center justify-center text-stone-600 hover:text-stone-900 md:group-hover/thumbs:flex transition-colors">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>

        {%- comment -%} DETAILS COLUMN {%- endcomment -%}
        <div class="lg:col-span-6 mt-6 lg:mt-0 relative z-20 lg:pl-4 xl:pl-6 pb-20 lg:pb-0">
            
            {%- comment -%} DYNAMIC JUDGE.ME EXTRACTION {%- endcomment -%}
            {%- assign jm_badge = product.metafields.judgeme.badge -%}
            {%- assign rating_val = jm_badge | split: "data-average-rating='" | last | split: "'" | first | default: '5.0' -%}
            {%- assign review_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | default: '0' -%}
            
            {%- if review_count == '0' or review_count == blank or review_count == '0.0' -%}
              {%- assign rating_val = "5.0" -%}
              {%- assign review_count = section.settings.fallback_review_count | default: "128" -%}
            {%- endif -%}

            <div class="flex items-center gap-2 mb-4 w-fit group cursor-pointer" onclick="document.querySelector('.js-open-judgeme-modal-btn')?.click() || document.getElementById('open-judgeme-modal-btn')?.click()">
                <div class="flex items-center gap-1">
                    {%- assign rating_floor = rating_val | floor -%}
                    {%- for i in (1..5) -%}
                        {%- if i <= rating_floor -%}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="#F59E0B" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {%- else -%}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="#E5E5E5" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {%- endif -%}
                    {%- endfor -%}
                </div>
                <span class="text-[13px] font-semibold text-stone-600 border-b border-transparent group-hover:border-stone-400 transition-colors">
                    {{ rating_val }} / 5 ({{ review_count }} Reviews)
                </span>
            </div>

            <h1 class="text-3xl md:text-4xl font-serif font-medium text-stone-900 mb-3 leading-[1.15]">
                {{ product.title }}
            </h1>
            
            <p class="text-2xl font-medium text-stone-900 mb-6 price-display" aria-live="polite" data-base-price="{{ product.selected_or_first_available_variant.price }}">
                {{ product.selected_or_first_available_variant.price | money }}
            </p>

            <div class="mb-6 w-full relative group">
                <div id="desc-scroll-box" tabindex="0" aria-label="Product Description" class="focus-ring max-h-[140px] overflow-y-auto pr-4 pb-6 custom-scrollbar overscroll-contain rounded-md text-[14.5px] text-stone-700 leading-relaxed font-light relative z-10 visual-prose">
                    {{ product.description }}
                </div>
                <div id="desc-fade" class="absolute bottom-0 left-0 w-full h-8 bg-gradient-to-t from-[#FCFCFC] to-transparent pointer-events-none transition-opacity duration-300 z-20" aria-hidden="true"></div>
            </div>

            <div class="mb-8" id="product-tabs">
                <div class="flex border-b border-stone-200 mb-4 relative overflow-x-auto hide-scrollbar whitespace-nowrap" role="tablist" aria-label="Product Details Tabs">
                    <button type="button" role="tab" aria-selected="true" aria-controls="tabpanel-features" id="tab-features-btn" class="focus-ring tab-btn pb-3 mr-8 text-[13px] font-bold border-b-2 border-stone-900 text-stone-900 transition-colors cursor-pointer" data-tab="features">{{ section.settings.tab_1_title | default: 'Features' }}</button>
                    <button type="button" role="tab" aria-selected="false" aria-controls="tabpanel-design" id="tab-design-btn" class="focus-ring tab-btn pb-3 mr-8 text-[13px] font-medium border-b-2 border-transparent text-stone-500 hover:text-stone-900 transition-colors cursor-pointer" data-tab="design">{{ section.settings.tab_2_title | default: 'Design & Build' }}</button>
                    <button type="button" role="tab" aria-selected="false" aria-controls="tabpanel-technical" id="tab-technical-btn" class="focus-ring tab-btn pb-3 pr-4 text-[13px] font-medium border-b-2 border-transparent text-stone-500 hover:text-stone-900 transition-colors cursor-pointer" data-tab="technical">{{ section.settings.tab_3_title | default: 'Technical' }}</button>
                </div>
                
                <div class="tab-content visual-prose text-[13.5px] text-stone-700 leading-relaxed font-light" id="tabpanel-features" role="tabpanel" tabindex="0">{{ section.settings.features_text }}</div>
                <div class="tab-content hidden visual-prose text-[13.5px] text-stone-700 leading-relaxed font-light" id="tabpanel-design" role="tabpanel" tabindex="0">{{ section.settings.design_text }}</div>
                <div class="tab-content hidden visual-prose text-[13.5px] text-stone-700 leading-relaxed font-light" id="tabpanel-technical" role="tabpanel" tabindex="0">{{ section.settings.tech_text }}</div>
            </div>

            <div class="h-px w-full bg-stone-200 mb-6" aria-hidden="true"></div>

            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            
            <product-form class="product-form block w-full relative z-30 mt-6" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form', enctype: 'multipart/form-data' -%}
                
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">

                {%- comment -%} VARIANTS {%- endcomment -%}
                {% if section.settings.show_variants %}
                  {% unless product.has_only_default_variant %}
                  <div class="mb-6">
                      {% for option in product.options_with_values %}
                      <fieldset class="mb-5 border-none p-0 m-0">
                          <legend class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest mb-3 w-full">{{ option.name }}</legend>
                          <div class="flex flex-wrap gap-3" role="radiogroup" aria-label="{{ option.name }}">
                              {% for value in option.values %}
                              <button type="button" role="radio" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}" class="focus-ring size-btn flex-1 py-3.5 px-4 rounded-lg border text-[13px] font-medium transition-all tracking-wide touch-manipulation cursor-pointer {% if option.selected_value == value %}border-stone-900 bg-stone-900 text-white shadow-md{% else %}border-stone-300 bg-white text-stone-800 hover:border-stone-500{% endif %}" data-option-position="option{{ option.position }}" data-value="{{ value | escape }}">
                                  {{ value }}
                              </button>
                              {% endfor %}
                          </div>
                      </fieldset>
                      {% endfor %}
                  </div>
                  {% endunless %}
                {% endif %}

                {%- comment -%} NATIVE UPLOADKIT WIDGET {%- endcomment -%}
                {%- if section.settings.show_media_upload -%}
                <div class="mb-6 mt-6 relative z-40">
                    <div class="uploadkit" data-uploadkit-product-json="{{ product | json | escape }}" data-uploadkit-collections-json="{{ product.collections | json | escape }}"></div>
                </div>
                {%- endif -%}

                {%- comment -%} CONDITIONAL BOOK TITLE & DATE {%- endcomment -%}
                {%- assign show_custom_fields = false -%}
                {%- if section.settings.enable_custom_fields -%}
                  {%- if section.settings.target_product == blank or section.settings.target_product.handle == product.handle -%}
                    {%- assign show_custom_fields = true -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if show_custom_fields -%}
                <div class="mb-6 relative z-40">
                    <div class="flex justify-between items-end mb-2">
                        <label for="book-title" class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest">
                            {{ section.settings.book_title_label | default: 'Book Title' }} <span class="text-[#c4b09e]">*</span> 
                            <span class="text-stone-500 font-normal normal-case tracking-normal">{{ section.settings.book_title_sub | default: '(3 words max)' }}</span>
                        </label>
                        <span id="book-title-counter" class="text-[10px] text-stone-500 font-medium">0/30</span>
                    </div>
                    <input type="text" name="properties[Book Title]" id="book-title" maxlength="30" class="focus-ring w-full border border-stone-300 rounded-lg p-3.5 text-[14px] text-stone-700 placeholder-stone-500 bg-white shadow-sm" placeholder="{{ section.settings.book_title_placeholder | default: 'e.g. Our Wedding Day' }}" required>
                    <p id="book-title-error" class="hidden text-red-500 text-xs mt-1 font-medium">Maximum 3 words allowed.</p>
                </div>

                <div class="mb-6 relative z-40">
                    <div class="flex justify-between items-end mb-2">
                        <label for="book-date" class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest">
                            {{ section.settings.date_label | default: 'Date' }} <span class="text-stone-500 font-normal normal-case tracking-normal">(Optional)</span>
                        </label>
                        <span id="book-date-counter" class="text-[10px] text-stone-500 font-medium">0/14</span>
                    </div>
                    <input type="text" name="properties[Date]" id="book-date" maxlength="14" class="focus-ring w-full border border-stone-300 rounded-lg p-3.5 text-[14px] text-stone-700 placeholder-stone-500 bg-white shadow-sm" placeholder="{{ section.settings.date_placeholder | default: 'e.g. 12.10.2024' }}">
                </div>
                {%- endif -%}

                {%- comment -%} BACKGROUND SONG {%- endcomment -%}
                {% if section.settings.show_bg_song %}
                <div class="mb-6 relative z-40">
                    <label for="bg-song" class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest mb-2">{{ section.settings.song_label | default: 'Background Song' }} <span class="text-stone-500 font-normal normal-case tracking-normal">(Optional)</span></label>
                    <input type="text" name="properties[Background Song]" id="bg-song" class="focus-ring w-full border border-stone-300 rounded-lg p-3.5 text-[14px] text-stone-700 placeholder-stone-500 bg-white shadow-sm" placeholder="{{ section.settings.song_placeholder | default: 'e.g. Perfect by Ed Sheeran' }}">
                </div>
                {% endif %}

                <div class="mb-4 relative z-50">
                    <div class="flex flex-col sm:flex-row gap-3 w-full items-stretch">
                        
                        <div class="flex items-center border border-stone-300 rounded-lg w-full sm:flex-none sm:w-[130px] h-[60px] sm:h-[54px] bg-white overflow-hidden shadow-sm">
                            <button type="button" name="minus" aria-label="Decrease quantity" class="flex-1 sm:w-12 h-full text-stone-600 hover:text-stone-900 hover:bg-stone-50 text-xl focus:outline-none touch-manipulation cursor-pointer border-r border-stone-100 transition-colors">-</button>
                            <input type="number" name="quantity" id="quantity-input" aria-label="Quantity" value="1" min="1" class="qty-input w-12 text-center font-semibold text-stone-900 text-[15px] border-none focus:ring-0 p-0 m-0 bg-transparent" style="-moz-appearance: textfield;">
                            <button type="button" name="plus" aria-label="Increase quantity" class="flex-1 sm:w-12 h-full text-stone-600 hover:text-stone-900 hover:bg-stone-50 text-xl focus:outline-none touch-manipulation cursor-pointer border-l border-stone-100 transition-colors">+</button>
                        </div>
                        
                        <button id="ProductSubmitButton-{{ section.id }}" type="submit" name="add" class="product-form__submit textboxAddToCartBtn w-full sm:flex-1 min-w-0 bg-[#111111] text-white rounded-lg min-h-[60px] sm:h-[54px] px-4 font-bold uppercase text-[14px] sm:text-[13px] hover:bg-stone-800 transition-colors flex items-center justify-center text-center relative shadow-sm touch-manipulation cursor-pointer overflow-hidden leading-tight" {% if product.selected_or_first_available_variant.available == false %}disabled aria-disabled="true"{% endif %}>
                            
                            <span class="btn-text inline-flex flex-wrap justify-center gap-1 items-center pointer-events-none transition-all duration-200 max-w-full">
                                {%- if product.selected_or_first_available_variant.available -%}
                                    <span class="add-text">{{ section.settings.add_to_cart_text | default: 'Add to Cart' }}</span> <span aria-hidden="true">—</span> <span class="price-display">{{ product.selected_or_first_available_variant.price | money }}</span>
                                {%- else -%}
                                    <span class="add-text">Sold Out</span>
                                {%- endif -%}
                            </span>

                            <div class="loading__spinner hidden absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-5 h-5 text-white pointer-events-none flex items-center justify-center">
                                <svg aria-hidden="true" focusable="false" role="presentation" class="spinner animate-spin w-full h-full" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30" stroke="currentColor"></circle>
                                </svg>
                            </div>

                        </button>
                    </div>
                </div>

                {%- if section.settings.show_dynamic_checkout -%}
                <div class="mb-6 mt-4 relative z-40">
                    {{ form | payment_button }}
                </div>
                {%- endif -%}

              {%- endform -%}
            </product-form>

            {%- comment -%} EDITABLE MODAL BUTTONS {%- endcomment -%}
            <div class="flex flex-col gap-3 mb-8 mt-6 relative z-30">
                <button type="button" id="live-support-btn" class="focus-ring w-full bg-white border border-stone-200 text-stone-800 h-[54px] rounded-lg hover:bg-stone-50 hover:border-stone-300 transition-all duration-200 flex items-center justify-center gap-2.5 font-medium text-[14px] shadow-sm cursor-pointer">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-600" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path><path d="M9 12h.01"></path><path d="M12 12h.01"></path><path d="M15 12h.01"></path></svg>
                    {{ section.settings.support_btn_text | default: 'Contact Live Support for Help' }}
                </button>

                <div class="grid grid-cols-2 border border-stone-200 rounded-lg divide-x divide-stone-200 bg-white shadow-sm">
                    <button type="button" class="focus-ring award-btn py-4 flex items-center justify-center gap-2.5 hover:bg-stone-50 transition-colors group rounded-l-lg cursor-pointer">
                        <span class="text-[14px] text-stone-800 font-medium">{{ section.settings.award_btn_text | default: 'Our Awards' }}</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-600 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </button>
                    <button type="button" id="cashback-btn" class="focus-ring py-4 flex items-center justify-center gap-2.5 hover:bg-stone-50 transition-colors group rounded-r-lg cursor-pointer">
                        <span class="text-[14px] text-stone-800 font-medium">{{ section.settings.cashback_btn_text | default: 'Get $7 Cashback' }}</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-600 group-hover:text-stone-900 transition-colors" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
                    </button>
                </div>
            </div>

            <div class="divide-y divide-stone-200 border-t border-stone-200 mt-4 relative z-30" id="accordion-container">
                {% for block in section.blocks %}
                {% if block.type == 'accordion' %}
                <div class="accordion-item" {{ block.shopify_attributes }}>
                    <button type="button" aria-expanded="false" aria-controls="accordion-content-{{ block.id }}" class="focus-ring accordion-btn flex justify-between items-center w-full py-4 text-left font-semibold text-[13px] text-stone-900 uppercase tracking-widest group touch-manipulation cursor-pointer rounded-sm">
                        <span>{{ block.settings.title }}</span>
                        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-stone-100 group-hover:bg-stone-200 transition-colors" aria-hidden="true">
                            <svg class="chevron-icon w-3.5 h-3.5 text-stone-600 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </span>
                    </button>
                    <div id="accordion-content-{{ block.id }}" role="region" aria-labelledby="accordion-btn-{{ block.id }}" class="accordion-content visual-prose text-[13.5px] text-stone-700 leading-relaxed overflow-hidden transition-all duration-300 max-h-0 opacity-0 font-light">
                        <div class="pb-5 pr-4">{{ block.settings.content }}</div>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            
        </div>
    </div>
</main>

