<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Add to Cart Button Fix */
    .product-form__submit { width: 100% !important; max-width: 100% !important; }

    /* Dawn Payment Button Fixes */
    .shopify-payment-button__button--unbranded { display: none !important; }
    .shopify-payment-button__button { width: 100% !important; border-radius: 8px !important; height: 54px !important; font-size: 14px !important; font-weight: 600 !important; font-family: inherit !important; }
</style>

<script id="VisualMoneyFormat" type="application/json">
  {{ shop.money_format | json }}
</script>
<script id="VisualProductVariants" type="application/json">
  {{ product.variants | json }}
</script>

<main class="max-w-[1200px] mx-auto px-[15px] md:px-8 pt-6 pb-16 md:pt-10 md:pb-20" id="ProductSection-{{ section.id }}">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 lg:items-start">
        
        <div class="lg:col-span-6 flex flex-col gap-3 lg:sticky lg:top-10 z-10">
            <div class="w-full relative bg-stone-50 rounded-xl overflow-hidden border border-stone-100 aspect-square md:aspect-[4/3] flex items-center justify-center group">
                {% assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}
                <img id="main-image" src="{{ featured_media | image_url: width: 1200 }}" alt="{{ featured_media.alt | escape }}" class="w-full h-full object-cover transition-opacity duration-300" draggable="false" />
                
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                     <button type="button" class="w-16 h-16 bg-white/30 backdrop-blur-md border border-white/40 rounded-full flex items-center justify-center shadow-xl hover:scale-110 transition-transform duration-300 pointer-events-auto cursor-pointer">
                         <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" class="text-white ml-1 drop-shadow-md"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                     </button>
                </div>
            </div>

            <div class="flex gap-2.5 overflow-x-auto hide-scrollbar w-full shrink-0 pb-2 pt-1 cursor-grab" id="thumbnails-container">
                {% for media in product.media %}
                <button type="button" class="thumbnail-btn relative rounded-lg overflow-hidden aspect-square flex-shrink-0 w-[75px] md:w-20 transition-all duration-200 {% if forloop.first %}ring-2 ring-stone-900 ring-offset-2 opacity-100{% else %}ring-1 ring-stone-200 hover:ring-stone-400 ring-offset-2 opacity-60 hover:opacity-100{% endif %} bg-stone-100 focus:outline-none cursor-pointer" data-src="{{ media | image_url: width: 1200 }}" data-index="{{ forloop.index0 }}">
                    <img src="{{ media.preview_image | image_url: width: 200 }}" alt="{{ media.alt | escape }}" class="w-full h-full object-cover pointer-events-none select-none" />
                </button>
                {% endfor %}
            </div>
        </div>

        <div class="lg:col-span-6 mt-6 lg:mt-0 relative z-20">
            
            <div class="flex items-center space-x-2.5 mb-3">
                <div class="flex space-x-[1px] text-amber-400">
                    {% for i in (1..5) %}<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endfor %}
                </div>
                <span class="text-[13px] font-medium text-stone-500">{{ section.settings.review_text | default: "4.9 (128 Reviews)" }}</span>
            </div>

            <h1 class="text-3xl md:text-4xl font-serif font-medium text-stone-900 mb-3 leading-[1.15]">{{ product.title }}</h1>
            <p class="text-2xl font-medium text-stone-900 mb-6 price-display">{{ product.price | money }}</p>

            <div class="mb-6 w-full">
                <p class="text-[14.5px] text-stone-600 leading-relaxed font-light">{{ product.description | strip_html | truncatewords: 40 }}</p>
            </div>

            <div class="mb-8" id="product-tabs">
                <div class="flex border-b border-stone-200 mb-4 relative overflow-x-auto hide-scrollbar whitespace-nowrap">
                    <button type="button" class="tab-btn pb-3 mr-8 text-[13px] font-bold border-b-2 border-stone-900 text-stone-900 transition-colors focus:outline-none cursor-pointer" data-tab="features">Features</button>
                    <button type="button" class="tab-btn pb-3 mr-8 text-[13px] font-medium border-b-2 border-transparent text-stone-500 hover:text-stone-900 transition-colors focus:outline-none cursor-pointer" data-tab="design">Design & Build</button>
                    <button type="button" class="tab-btn pb-3 pr-4 text-[13px] font-medium border-b-2 border-transparent text-stone-500 hover:text-stone-900 transition-colors focus:outline-none cursor-pointer" data-tab="technical">Technical</button>
                </div>
                <div class="tab-content text-[13.5px] text-stone-600 leading-relaxed font-light" id="tab-features">{{ section.settings.features_text }}</div>
                <div class="tab-content hidden text-[13.5px] text-stone-600 leading-relaxed font-light" id="tab-design">{{ section.settings.design_text }}</div>
                <div class="tab-content hidden text-[13.5px] text-stone-600 leading-relaxed font-light" id="tab-technical">{{ section.settings.tech_text }}</div>
            </div>

            <div class="h-px w-full bg-stone-200 mb-6"></div>

            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            
            <product-form class="product-form block w-full relative z-30" data-section-id="{{ section.id }}">
              <div class="product-form__error-message-wrapper text-red-600 text-[13px] font-medium mb-4 bg-red-50 p-3 rounded-md hidden" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>
              
              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form', enctype: 'multipart/form-data' -%}
                
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">

                {% unless product.has_only_default_variant %}
                <div class="mb-6">
                    {% for option in product.options_with_values %}
                    <div class="mb-5">
                        <div class="flex justify-between items-center mb-3">
                            <span class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest">{{ option.name }}</span>
                        </div>
                        <div class="flex flex-wrap gap-3">
                            {% for value in option.values %}
                            <button type="button" class="size-btn flex-1 py-3.5 px-4 rounded-lg border text-[13px] font-medium transition-all tracking-wide focus:outline-none touch-manipulation cursor-pointer {% if option.selected_value == value %}border-stone-900 bg-stone-900 text-white shadow-md{% else %}border-stone-300 bg-white text-stone-800 hover:border-stone-500{% endif %}" data-option-position="option{{ option.position }}" data-value="{{ value | escape }}">
                                {{ value }}
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endunless %}

                <div class="mb-6 mt-6 relative z-40">
                    <label class="w-full relative group border border-dashed border-stone-300 bg-stone-50 hover:bg-stone-100 hover:border-stone-500 text-stone-700 transition-all rounded-xl py-5 px-4 text-center flex flex-col items-center justify-center gap-1.5 cursor-pointer focus:outline-none">
                        <svg class="w-6 h-6 text-stone-400 group-hover:text-stone-700 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <span class="text-[13.5px] font-semibold tracking-wide text-stone-800">Upload Photos & Videos <span class="text-stone-400 font-normal">(Optional)</span></span>
                        <span class="text-[12px] text-stone-500 font-light">We'll pre-load them for you</span>
                        <input type="file" name="properties[Media Upload]" class="hidden" multiple accept="image/*,video/*">
                    </label>
                </div>

                <div class="mb-6 relative z-40">
                    <label for="bg-song" class="block text-[12px] font-bold text-stone-900 uppercase tracking-widest mb-2">Background Song <span class="text-stone-400 font-normal normal-case tracking-normal">(Optional)</span></label>
                    <input type="text" id="bg-song" name="properties[Background Song]" class="w-full border border-stone-300 rounded-lg p-3.5 text-[14px] text-stone-700 placeholder-stone-400 focus:outline-none focus:ring-1 focus:ring-stone-900 bg-white shadow-sm" placeholder="e.g. Perfect by Ed Sheeran">
                </div>

                <div class="mb-4 relative z-50">
                    <div class="flex flex-col sm:flex-row gap-3">
                        <div class="flex items-center border border-stone-300 rounded-lg w-full sm:w-[130px] h-[54px] bg-white focus-within:ring-1 focus-within:ring-stone-900 shadow-sm">
                            <button type="button" name="minus" class="w-12 h-full text-stone-500 hover:text-stone-900 text-xl focus:outline-none touch-manipulation cursor-pointer">-</button>
                            <input type="number" name="quantity" value="1" min="1" class="qty-input w-full text-center font-semibold text-stone-900 text-[15px] border-none focus:ring-0 p-0 m-0 bg-transparent pointer-events-none" style="-moz-appearance: textfield;">
                            <button type="button" name="plus" class="w-12 h-full text-stone-500 hover:text-stone-900 text-xl focus:outline-none touch-manipulation cursor-pointer">+</button>
                        </div>
                        
                        <button type="submit" name="add" class="product-form__submit button button--primary flex-1 bg-[#111111] text-white rounded-lg h-[54px] font-bold tracking-widest uppercase text-[13px] hover:bg-stone-800 transition-colors focus:outline-none flex items-center justify-center relative w-full shadow-sm touch-manipulation cursor-pointer" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                            <span class="btn-text inline-flex gap-2 items-center pointer-events-none">
                                {%- if product.selected_or_first_available_variant.available -%}
                                    Add to Cart — <span class="price-display">{{ product.price | money }}</span>
                                {%- else -%}
                                    Sold Out
                                {%- endif -%}
                            </span>
                            <div class="loading-overlay__spinner hidden absolute inset-0 bg-[#111111] flex items-center justify-center rounded-lg pointer-events-none">
                                <svg aria-hidden="true" focusable="false" class="spinner w-6 h-6 text-white animate-spin" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30" stroke="currentColor"></circle></svg>
                            </div>
                        </button>
                    </div>
                </div>

                <div class="mb-6 mt-4 relative z-40">
                    {{ form | payment_button }}
                </div>

              {%- endform -%}
            </product-form>

            <div class="divide-y divide-stone-200 border-t border-stone-200 mt-4 relative z-30" id="accordion-container">
                {% for block in section.blocks %}
                <div class="accordion-item" {{ block.shopify_attributes }}>
                    <button type="button" class="accordion-btn flex justify-between items-center w-full py-4 text-left font-semibold text-[13px] text-stone-900 uppercase tracking-widest group focus:outline-none touch-manipulation cursor-pointer">
                        <span>{{ block.settings.title }}</span>
                        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-stone-100 group-hover:bg-stone-200 transition-colors">
                            <svg class="chevron-icon w-3.5 h-3.5 text-stone-600 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                        </span>
                    </button>
                    <div class="accordion-content text-[13.5px] text-stone-600 leading-relaxed overflow-hidden transition-all duration-300 max-h-0 opacity-0 font-light">
                        <div class="pb-5 pr-4">{{ block.settings.content }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
            
        </div>
    </div>
</main>

<div id="sticky-cart-bar" class="fixed bottom-4 left-4 right-4 md:bottom-8 md:left-1/2 md:right-auto md:-translate-x-1/2 md:w-[750px] bg-white/95 backdrop-blur-xl border border-stone-200 p-4 sm:p-5 rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.15)] z-[999] transition-all duration-500 translate-y-[150%] opacity-0 pointer-events-none group">
    <div class="flex items-center justify-between gap-4 md:gap-6 px-1 pointer-events-auto">
        <div class="hidden md:flex items-center gap-4">
            <img src="{{ featured_media | image_url: width: 150 }}" alt="Thumbnail" class="w-14 h-14 rounded-lg object-cover shadow-sm sticky-thumbnail">
            <div class="pr-2">
                <div class="font-bold text-[15px] text-stone-900 leading-tight mb-1">{{ product.title }}</div>
                <div class="text-[13px] font-medium text-stone-500">HD Video Memory</div>
            </div>
        </div>
        <div class="flex items-center justify-between w-full md:w-auto gap-4">
            <div class="md:hidden flex flex-col w-1/2">
                <div class="font-bold text-[14px] text-stone-900 truncate">{{ product.title }}</div>
                <div class="font-bold text-stone-900 text-[14px] price-display">{{ product.price | money }}</div>
            </div>
            <div class="hidden md:block font-bold text-stone-900 text-[18px] price-display">{{ product.price | money }}</div>
            
            <button type="button" onclick="document.querySelector('#{{ product_form_id }} button[name=\'add\']').click()" class="w-1/2 md:w-[240px] px-2 md:px-6 bg-[#111111] hover:bg-stone-800 text-white h-[54px] rounded-xl font-bold tracking-widest uppercase text-[12px] md:text-[14px] transition-all shadow-md active:scale-95 touch-manipulation cursor-pointer">
                Add to Cart
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    
    // 1. Safely Parse Liquid Data
    const rawMoneyFormat = document.getElementById('VisualMoneyFormat').textContent.trim();
    const fallbackMoney = "$" + ["{", "{", "amount", "}", "}"].join("");
    let shopMoneyFormat = (rawMoneyFormat && rawMoneyFormat !== 'null') ? JSON.parse(rawMoneyFormat) : fallbackMoney;
    
    const rawVariants = document.getElementById('VisualProductVariants').textContent.trim();
    const productVariants = (rawVariants && rawVariants !== 'null') ? JSON.parse(rawVariants) : [];
    
    const formatMoney = (cents) => {
        return shopMoneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, (cents/100).toFixed(2));
    };

    const variantIdInputs = document.querySelectorAll('.product-variant-id');
    const priceDisplays = document.querySelectorAll('.price-display');
    const optionButtons = document.querySelectorAll('.size-btn');
    const qtyInputs = document.querySelectorAll('.qty-input');
    
    let currentOptions = {
        {% for option in product.options_with_values %}
        "option{{ option.position }}": "{{ option.selected_value | escape }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
    };

    function updateVariantUI() {
        const matchedVariant = productVariants.find(v => {
            return (!v.option1 || v.option1 === currentOptions.option1) &&
                   (!v.option2 || v.option2 === currentOptions.option2) &&
                   (!v.option3 || v.option3 === currentOptions.option3);
        });

        if (matchedVariant) {
            // Push changes back to Shopify natively
            variantIdInputs.forEach(input => input.value = matchedVariant.id);
            variantIdInputs[0].dispatchEvent(new Event('change', { bubbles: true }));
            window.history.replaceState({ }, '', `${window.location.pathname}?variant=${matchedVariant.id}`);

            // Prices
            const qty = parseInt(qtyInputs[0].value) || 1;
            priceDisplays.forEach(el => el.textContent = formatMoney(matchedVariant.price * qty));

            // Button status update
            document.querySelectorAll('.product-form__submit').forEach(btn => {
                const textSpan = btn.querySelector('.btn-text');
                if (matchedVariant.available) {
                    btn.removeAttribute('disabled');
                    textSpan.innerHTML = `Add to Cart &mdash; <span class="price-display">${formatMoney(matchedVariant.price * qty)}</span>`;
                } else {
                    btn.setAttribute('disabled', 'disabled');
                    textSpan.textContent = 'Sold Out';
                }
            });

            // Fast Image Syncing if Variant Image exists
            if (matchedVariant.featured_media && matchedVariant.featured_media.preview_image) {
                const targetUrl = matchedVariant.featured_media.preview_image.src;
                
                // Find matching thumbnail and click it
                const targetThumb = Array.from(document.querySelectorAll('.thumbnail-btn')).find(btn => {
                    const img = btn.querySelector('img');
                    return img && img.src.includes(targetUrl.split('?')[0]);
                });
                
                if (targetThumb) targetThumb.click();
            }
        }
    }

    // Handle Variant Button Clicks
    optionButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const pos = this.dataset.optionPosition;
            currentOptions[pos] = this.dataset.value;

            document.querySelectorAll(`.size-btn[data-option-position="${pos}"]`).forEach(b => {
                if(b === this) {
                    b.classList.remove('border-stone-300', 'bg-white', 'text-stone-800', 'hover:border-stone-500');
                    b.classList.add('border-stone-900', 'bg-stone-900', 'text-white', 'shadow-md');
                } else {
                    b.classList.remove('border-stone-900', 'bg-stone-900', 'text-white', 'shadow-md');
                    b.classList.add('border-stone-300', 'bg-white', 'text-stone-800', 'hover:border-stone-500');
                }
            });
            updateVariantUI();
        });
    });

    // Handle Quantity Clicks
    document.querySelectorAll('button[name="plus"], button[name="minus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            let val = parseInt(qtyInputs[0].value) || 1;
            if (e.target.name === 'plus') val++;
            if (e.target.name === 'minus' && val > 1) val--;
            qtyInputs.forEach(inp => inp.value = val);
            updateVariantUI();
        });
    });

    // 3. Simple Image Gallery Logic
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const mainImg = document.getElementById('main-image');

    function setImg(index) {
        if(!mainImg || !thumbnails.length) return;
        mainImg.style.opacity = 0.5;
        setTimeout(() => {
            mainImg.src = thumbnails[index].dataset.src;
            mainImg.style.opacity = 1;
            thumbnails.forEach((t, i) => {
                t.classList.toggle('ring-stone-900', i === index);
                t.classList.toggle('opacity-100', i === index);
                t.classList.toggle('ring-stone-200', i !== index);
                t.classList.toggle('opacity-60', i !== index);
                if (i === index) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            });
        }, 150);
    }

    thumbnails.forEach((t, i) => {
        t.addEventListener('click', () => setImg(i));
    });

    // 4. Product Tabs
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => {
                b.classList.remove('border-stone-900', 'text-stone-900', 'font-bold');
                b.classList.add('border-transparent', 'text-stone-500', 'font-medium');
            });
            btn.classList.add('border-stone-900', 'text-stone-900', 'font-bold');
            btn.classList.remove('border-transparent', 'text-stone-500', 'font-medium');
            
            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById(`tab-${btn.dataset.tab}`).classList.remove('hidden');
        });
    });

    // 5. Accordions
    document.querySelectorAll('.accordion-item').forEach(item => {
        const btn = item.querySelector('.accordion-btn');
        const content = item.querySelector('.accordion-content');
        const icon = item.querySelector('.chevron-icon');
        btn.addEventListener('click', () => {
            const isOpen = content.classList.contains('max-h-40');
            document.querySelectorAll('.accordion-content').forEach(c => {
                c.classList.remove('max-h-40', 'opacity-100');
                c.classList.add('max-h-0', 'opacity-0');
            });
            document.querySelectorAll('.chevron-icon').forEach(i => i.style.transform = 'rotate(0deg)');
            if(!isOpen) {
                content.classList.remove('max-h-0', 'opacity-0');
                content.classList.add('max-h-40', 'opacity-100');
                icon.style.transform = 'rotate(180deg)';
            }
        });
    });
    
    // 6. Floating Sticky Cart Bar
    const stickyBar = document.getElementById('sticky-cart-bar');
    if(stickyBar) {
        window.addEventListener('scroll', () => {
            if (window.scrollY > 800) {
                stickyBar.classList.remove('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
                stickyBar.classList.add('translate-y-0', 'opacity-100');
            } else {
                stickyBar.classList.remove('translate-y-0', 'opacity-100');
                stickyBar.classList.add('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
            }
        }, { passive: true });
    }

});
</script>

{% schema %}
{
  "name": "Visual Product Hero",
  "settings": [
    { "type": "text", "id": "review_text", "label": "Review Text", "default": "4.9 (128 Reviews)" },
    { "type": "richtext", "id": "features_text", "label": "Features Tab", "default": "<p>Up to 6-Hour Video Capacity.</p>" },
    { "type": "richtext", "id": "design_text", "label": "Design Tab", "default": "<p>Premium linen cover.</p>" },
    { "type": "richtext", "id": "tech_text", "label": "Tech Tab", "default": "<p>7 or 10.1 inch IPS Display.</p>" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "GIFTING THE BOOK?" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Our books arrive in a luxury gift box.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visual Product Hero",
      "category": "Visual Book Custom",
      "blocks": [
        { "type": "accordion" },
        { "type": "accordion" },
        { "type": "accordion" }
      ]
    }
  ]
}
{% endschema %}