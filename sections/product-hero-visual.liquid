<script>
document.addEventListener('DOMContentLoaded', () => {

    // === Z-INDEX FIX: Teleport Modals to Body ===
    const modalsContainer = document.getElementById('all-modals-container');
    if (modalsContainer && document.body) {
        document.body.appendChild(modalsContainer);
    }
    // ===========================================
    
    // --- 1. Shopify Variant & Pricing Logic ---
    const rawMoneyFormat = document.getElementById('VisualMoneyFormat').textContent.trim();
    const fallbackMoney = "$" + ["{", "{", "amount", "}", "}"].join("");
    let shopMoneyFormat = (rawMoneyFormat && rawMoneyFormat !== 'null') ? JSON.parse(rawMoneyFormat) : fallbackMoney;
    
    const rawVariants = document.getElementById('VisualProductVariants').textContent.trim();
    const productVariants = (rawVariants && rawVariants !== 'null') ? JSON.parse(rawVariants) : [];

    const formatMoney = (cents) => {
        if (typeof cents === 'string') cents = cents.replace('.', '');
        let value = '';
        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatString = shopMoneyFormat.match(placeholderRegex);

        switch (formatString[1]) {
            case 'amount': value = (cents / 100).toFixed(2); break;
            case 'amount_no_decimals': value = (cents / 100).toFixed(0); break;
            case 'amount_with_comma_separator': value = (cents / 100).toFixed(2).replace('.', ','); break;
            case 'amount_no_decimals_with_comma_separator': value = (cents / 100).toFixed(0).replace('.', ','); break;
            default: value = (cents / 100).toFixed(2); break;
        }
        return shopMoneyFormat.replace(placeholderRegex, value);
    };

    const variantIdInputs = document.querySelectorAll('.product-variant-id');
    const priceDisplays = document.querySelectorAll('.price-display');
    const optionButtons = document.querySelectorAll('.size-btn');
    const qtyInputs = document.querySelectorAll('.qty-input');
    
    let currentOptions = {
        {% for option in product.options_with_values %}
        "option{{ option.position }}": "{{ option.selected_value | escape }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
    };

    function updateVariantUI() {
        const matchedVariant = productVariants.find(v => {
            return (!v.option1 || v.option1 === currentOptions.option1) &&
                   (!v.option2 || v.option2 === currentOptions.option2) &&
                   (!v.option3 || v.option3 === currentOptions.option3);
        });

        if (matchedVariant) {
            variantIdInputs.forEach(input => input.value = matchedVariant.id);
            if(variantIdInputs[0]) variantIdInputs[0].dispatchEvent(new Event('change', { bubbles: true }));
            window.history.replaceState({ }, '', `${window.location.pathname}?variant=${matchedVariant.id}`);

            const qty = parseInt(qtyInputs[0].value) || 1;
            const formattedPrice = formatMoney(matchedVariant.price * qty);
            
            priceDisplays.forEach(el => el.textContent = formattedPrice);

            const mainSubmitBtn = document.querySelector('.product-form__submit');
            if(mainSubmitBtn) {
                const textSpan = mainSubmitBtn.querySelector('.btn-text');
                if (matchedVariant.available) {
                    mainSubmitBtn.removeAttribute('disabled');
                    mainSubmitBtn.removeAttribute('aria-disabled');
                    textSpan.innerHTML = `Add to Cart <span aria-hidden="true">—</span> <span class="price-display">${formattedPrice}</span>`;
                } else {
                    mainSubmitBtn.setAttribute('disabled', 'disabled');
                    mainSubmitBtn.setAttribute('aria-disabled', 'true');
                    textSpan.textContent = 'Sold Out';
                }
            }

            // Sync Image to Variant Image
            if (matchedVariant.featured_media && matchedVariant.featured_media.preview_image) {
                const targetUrl = matchedVariant.featured_media.preview_image.src.split('?')[0];
                const targetThumbIndex = Array.from(document.querySelectorAll('.thumbnail-btn')).findIndex(btn => {
                    const img = btn.querySelector('img');
                    return img && img.src.includes(targetUrl);
                });
                
                if (targetThumbIndex !== -1) {
                    const carousel = document.getElementById('main-image-carousel');
                    const width = carousel.offsetWidth;
                    carousel.scrollTo({ left: width * targetThumbIndex, behavior: 'smooth' });
                }
            }
        }
    }

    optionButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const pos = this.dataset.optionPosition;
            currentOptions[pos] = this.dataset.value;

            document.querySelectorAll(`.size-btn[data-option-position="${pos}"]`).forEach(b => {
                if(b === this) {
                    b.classList.remove('border-stone-300', 'bg-white', 'text-stone-800', 'hover:border-stone-500');
                    b.classList.add('border-stone-900', 'bg-stone-900', 'text-white', 'shadow-md');
                    b.setAttribute('aria-checked', 'true');
                } else {
                    b.classList.remove('border-stone-900', 'bg-stone-900', 'text-white', 'shadow-md');
                    b.classList.add('border-stone-300', 'bg-white', 'text-stone-800', 'hover:border-stone-500');
                    b.setAttribute('aria-checked', 'false');
                }
            });
            updateVariantUI();
        });
        
        btn.addEventListener('keydown', function(e) {
             if (e.key === ' ' || e.key === 'Enter') {
                 e.preventDefault();
                 this.click();
             }
        });
    });

    document.querySelectorAll('button[name="plus"], button[name="minus"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            let val = parseInt(qtyInputs[0].value) || 1;
            if (btn.getAttribute('name') === 'plus' && val < 10) val++; 
            if (btn.getAttribute('name') === 'minus' && val > 1) val--;
            qtyInputs.forEach(inp => inp.value = val);
            updateVariantUI();
        });
    });

    const labelUpload = document.querySelector('label[for="media-upload"]');
    const fileInput = document.getElementById('media-upload');
    const uploadStatus = document.getElementById('upload-status');
    
    if(labelUpload && fileInput) {
        labelUpload.addEventListener('keydown', (e) => {
             if (e.key === ' ' || e.key === 'Enter') {
                 e.preventDefault();
                 fileInput.click();
             }
        });
        fileInput.addEventListener('change', function() {
            if(this.files && this.files.length > 0) {
                uploadStatus.textContent = `${this.files.length} file(s) selected`;
                uploadStatus.classList.add('text-stone-900', 'font-medium');
            } else {
                uploadStatus.textContent = `We'll pre-load them for you`;
                uploadStatus.classList.remove('text-stone-900', 'font-medium');
            }
        });
    }

    // --- 1.5 Custom Fields Logic (Title & Date) ---
    const titleInput = document.getElementById('book-title');
    const titleCounter = document.getElementById('book-title-counter');
    const titleError = document.getElementById('book-title-error');

    if(titleInput && titleCounter) {
        titleInput.addEventListener('input', function(e) {
            let val = this.value;
            let words = val.trim().split(/\s+/).filter(w => w.length > 0);
            
            if (words.length > 3) {
                let allowedWords = words.slice(0, 3).join(" ");
                if (val.endsWith(' ')) allowedWords += ' '; 
                this.value = allowedWords;
                titleError?.classList.remove('hidden');
            } else {
                titleError?.classList.add('hidden');
            }
            titleCounter.textContent = `${this.value.length}/30`;
        });
    }

    const dateInput = document.getElementById('book-date');
    const dateCounter = document.getElementById('book-date-counter');
    if(dateInput && dateCounter) {
        dateInput.addEventListener('input', function() {
            dateCounter.textContent = `${this.value.length}/14`;
        });
    }

    // --- 2. AJAX Add to Cart & Animation ---
    const mainForm = document.querySelector('form[data-type="add-to-cart-form"]');
    if (mainForm) {
        mainForm.addEventListener('submit', function(e) {
            
            if (e.submitter && e.submitter.name !== 'add') {
                return; 
            }

            if (fileInput && fileInput.files.length > 0) {
                const btn = this.querySelector('.product-form__submit');
                const textSpan = btn?.querySelector('.btn-text');
                if(textSpan) textSpan.textContent = 'Uploading & Adding...';
                if(btn) btn.style.pointerEvents = 'none'; 
                return; 
            }

            e.preventDefault(); 

            const btn = this.querySelector('.product-form__submit');
            if(!btn || btn.disabled) return;

            const textSpan = btn.querySelector('.btn-text');
            const originalText = textSpan ? textSpan.innerHTML : '';

            if(textSpan) {
                textSpan.style.transform = 'translateY(100%)';
                textSpan.style.opacity = '0';
                setTimeout(() => {
                    textSpan.textContent = 'Adding...';
                    textSpan.style.transform = 'translateY(-100%)';
                    setTimeout(() => { textSpan.style.transform = 'translateY(0)'; textSpan.style.opacity = '1'; }, 50);
                }, 150);
            }

            const rootUrl = window.Shopify?.routes?.root || '/';
            const formData = new FormData(mainForm);
            
            fetch(rootUrl + 'cart/add.js', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                setTimeout(() => {
                    if(textSpan) {
                        textSpan.style.transform = 'translateY(100%)';
                        textSpan.style.opacity = '0';
                        btn.classList.replace('bg-[#111111]', 'bg-green-600');
                        btn.classList.replace('hover:bg-stone-800', 'hover:bg-green-700');

                        setTimeout(() => {
                            textSpan.textContent = 'Added to Cart ✓';
                            textSpan.style.transform = 'translateY(-100%)';
                            setTimeout(() => { textSpan.style.transform = 'translateY(0)'; textSpan.style.opacity = '1'; }, 50);
                        }, 150);

                        setTimeout(() => {
                            textSpan.style.transform = 'translateY(100%)';
                            textSpan.style.opacity = '0';
                            setTimeout(() => {
                                textSpan.innerHTML = originalText;
                                btn.classList.replace('bg-green-600', 'bg-[#111111]');
                                btn.classList.replace('hover:bg-green-700', 'hover:bg-stone-800');
                                textSpan.style.transform = 'translateY(-100%)';
                                setTimeout(() => { textSpan.style.transform = 'translateY(0)'; textSpan.style.opacity = '1'; }, 50);
                            }, 150);
                        }, 2500);
                    }
                }, 800);
            })
            .catch((error) => {
                console.error('Error adding to cart:', error);
                if(textSpan) {
                    textSpan.style.transform = 'translateY(100%)';
                    textSpan.style.opacity = '0';
                    setTimeout(() => {
                        textSpan.innerHTML = originalText;
                        textSpan.style.transform = 'translateY(-100%)';
                        setTimeout(() => { textSpan.style.transform = 'translateY(0)'; textSpan.style.opacity = '1'; }, 50);
                    }, 150);
                }
            });
        });
    }

    // --- 3. Description Box Fade Logic ---
    const descScrollBox = document.getElementById('desc-scroll-box');
    const descFade = document.getElementById('desc-fade');
    let isTicking = false;
    
    if (descScrollBox && descFade) {
        const checkScroll = () => {
            if (!isTicking) {
                window.requestAnimationFrame(() => {
                    if (descScrollBox.scrollHeight - descScrollBox.scrollTop <= descScrollBox.clientHeight + 2) {
                        descFade.style.opacity = '0';
                    } else {
                        descFade.style.opacity = '1';
                    }
                    isTicking = false;
                });
                isTicking = true;
            }
        };
        checkScroll();
        descScrollBox.addEventListener('scroll', checkScroll, { passive: true });
    }

    // --- 4. Native CSS Scroll Carousel & Observer ---
    const carousel = document.getElementById('main-image-carousel');
    const slides = document.querySelectorAll('.carousel-slide');
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const sliderProgress = document.getElementById('slider-progress');
    let currentIndex = 0;
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                currentIndex = parseInt(entry.target.getAttribute('data-index'));
                updateThumbnailState(currentIndex);
            }
        });
    }, { root: carousel, threshold: 0.6 });
    
    slides.forEach(slide => observer.observe(slide));

    function updateThumbnailState(index) {
        if(sliderProgress) {
            sliderProgress.style.transform = `translateX(${index * 100}%)`;
        }

        thumbnails.forEach((t, i) => {
            t.classList.toggle('ring-stone-900', i === index);
            t.classList.toggle('opacity-100', i === index);
            t.classList.toggle('ring-stone-200', i !== index);
            t.classList.toggle('opacity-60', i !== index);
            t.setAttribute('aria-selected', i === index ? 'true' : 'false');
            if (i === index) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
    }

    document.getElementById('next-btn')?.addEventListener('click', () => {
        const width = carousel.offsetWidth;
        carousel.scrollBy({ left: width, behavior: 'smooth' });
    });
    
    document.getElementById('prev-btn')?.addEventListener('click', () => {
        const width = carousel.offsetWidth;
        carousel.scrollBy({ left: -width, behavior: 'smooth' });
    });
    
    thumbnails.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
            const width = carousel.offsetWidth;
            carousel.scrollTo({ left: width * index, behavior: 'smooth' });
        });
        thumb.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                const width = carousel.offsetWidth;
                carousel.scrollTo({ left: width * index, behavior: 'smooth' });
            }
        });
    });

    // --- 5. Thumbnail Container Mouse Drag ---
    const thumbContainer = document.getElementById('thumbnails-container');
    let isDownThumb = false;
    let startXThumb;
    let scrollLeftThumb;

    if(thumbContainer) {
        thumbContainer.addEventListener('mousedown', (e) => {
            isDownThumb = true;
            thumbContainer.classList.add('active:cursor-grabbing');
            startXThumb = e.pageX - thumbContainer.offsetLeft;
            scrollLeftThumb = thumbContainer.scrollLeft;
        });
        thumbContainer.addEventListener('mouseleave', () => {
            isDownThumb = false;
            thumbContainer.classList.remove('active:cursor-grabbing');
        });
        thumbContainer.addEventListener('mouseup', () => {
            isDownThumb = false;
            thumbContainer.classList.remove('active:cursor-grabbing');
        });
        thumbContainer.addEventListener('mousemove', (e) => {
            if (!isDownThumb) return;
            e.preventDefault();
            const x = e.pageX - thumbContainer.offsetLeft;
            const walk = (x - startXThumb) * 2;
            thumbContainer.scrollLeft = scrollLeftThumb - walk;
        });
    }

    document.getElementById('thumb-next')?.addEventListener('click', () => { thumbContainer?.scrollBy({ left: 150, behavior: 'smooth' }); });
    document.getElementById('thumb-prev')?.addEventListener('click', () => { thumbContainer?.scrollBy({ left: -150, behavior: 'smooth' }); });

    // --- 6. Tab Selection ---
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => {
                b.classList.remove('border-stone-900', 'text-stone-900', 'font-bold');
                b.classList.add('border-transparent', 'text-stone-500', 'font-medium');
                b.setAttribute('aria-selected', 'false');
            });
            
            btn.classList.add('border-stone-900', 'text-stone-900', 'font-bold');
            btn.classList.remove('border-transparent', 'text-stone-500', 'font-medium');
            btn.setAttribute('aria-selected', 'true');

            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById(`tabpanel-${btn.getAttribute('data-tab')}`).classList.remove('hidden');
        });
        
        btn.addEventListener('keydown', (e) => {
            let index = Array.from(tabBtns).indexOf(e.target);
            if (e.key === 'ArrowRight') {
                e.preventDefault();
                tabBtns[(index + 1) % tabBtns.length].focus();
                tabBtns[(index + 1) % tabBtns.length].click();
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                tabBtns[(index - 1 + tabBtns.length) % tabBtns.length].focus();
                tabBtns[(index - 1 + tabBtns.length) % tabBtns.length].click();
            }
        });
    });

    // --- 7. Accordions ---
    document.querySelectorAll('.accordion-item').forEach(item => {
        const btn = item.querySelector('.accordion-btn');
        const content = item.querySelector('.accordion-content');
        const icon = item.querySelector('.chevron-icon');

        btn.addEventListener('click', () => {
            const isOpen = content.classList.contains('max-h-40');
            document.querySelectorAll('.accordion-content').forEach(c => {
                c.classList.remove('max-h-40', 'opacity-100');
                c.classList.add('max-h-0', 'opacity-0');
            });
            document.querySelectorAll('.chevron-icon').forEach(i => i.style.transform = 'rotate(0deg)');
            document.querySelectorAll('.accordion-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
            
            if (!isOpen) {
                content.classList.remove('max-h-0', 'opacity-0');
                content.classList.add('max-h-40', 'opacity-100');
                icon.style.transform = 'rotate(180deg)';
                btn.setAttribute('aria-expanded', 'true');
            }
        });
    });

    // --- 8. Accessible Modal Logic ---
    let lastActiveElement = null;
    
    function openModalEl(modalEl, contentEl, triggerEl) {
        lastActiveElement = triggerEl || document.activeElement;
        modalEl.classList.remove('hidden');
        modalEl.classList.add('flex');
        
        const focusableElements = modalEl.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const firstFocusable = focusableElements[0];
        const lastFocusable = focusableElements[focusableElements.length - 1];
        
        modalEl.addEventListener('keydown', function(e) {
            let isTabPressed = e.key === 'Tab';
            if (!isTabPressed) { return; }
            if (e.shiftKey) { 
                if (document.activeElement === firstFocusable) {
                    lastFocusable.focus();
                    e.preventDefault();
                }
            } else { 
                if (document.activeElement === lastFocusable) {
                    firstFocusable.focus();
                    e.preventDefault();
                }
            }
        });
        
        setTimeout(() => {
            modalEl.classList.remove('opacity-0');
            contentEl.classList.remove('scale-95', 'opacity-0');
            if(firstFocusable) firstFocusable.focus();
        }, 10);
    }

    function closeModalEl(modalEl, contentEl) {
        modalEl.classList.add('opacity-0');
        contentEl.classList.add('scale-95', 'opacity-0');
        
        setTimeout(() => {
            modalEl.classList.add('hidden');
            modalEl.classList.remove('flex');
            if (lastActiveElement) lastActiveElement.focus();
        }, 300);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            ['support-modal', 'award-modal', 'discount-modal'].forEach(id => {
                const modal = document.getElementById(id);
                if (modal && !modal.classList.contains('hidden')) {
                    closeModalEl(modal, document.getElementById(id + '-content'));
                }
            });
        }
    });

    const supportModal = document.getElementById('support-modal');
    const supportContent = document.getElementById('support-modal-content');
    const supportTrigger = document.getElementById('live-support-btn');
    if(supportTrigger) supportTrigger.addEventListener('click', function() { openModalEl(supportModal, supportContent, this); });
    document.getElementById('close-modal-btn')?.addEventListener('click', () => closeModalEl(supportModal, supportContent));
    supportModal?.addEventListener('click', (e) => { if(e.target === supportModal) closeModalEl(supportModal, supportContent); });

    const awardBtns = document.querySelectorAll('.award-btn');
    const awardModal = document.getElementById('award-modal');
    const awardContent = document.getElementById('award-modal-content');
    awardBtns.forEach(btn => btn.addEventListener('click', function() { openModalEl(awardModal, awardContent, this); }));
    document.getElementById('close-award-modal-btn')?.addEventListener('click', () => closeModalEl(awardModal, awardContent));
    awardModal?.addEventListener('click', (e) => { if(e.target === awardModal) closeModalEl(awardModal, awardContent); });

    const discountBtn = document.getElementById('discount-btn');
    const discountModal = document.getElementById('discount-modal');
    const discountContent = document.getElementById('discount-modal-content');
    if(discountBtn) discountBtn.addEventListener('click', function() { openModalEl(discountModal, discountContent, this); });
    document.getElementById('close-discount-modal-btn')?.addEventListener('click', () => closeModalEl(discountModal, discountContent));
    discountModal?.addEventListener('click', (e) => { if(e.target === discountModal) closeModalEl(discountModal, discountContent); });
    
});
</script>

{% endunless %}

