<section class="w-full bg-[#fafafa] py-32 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#737373] mb-4">{{ section.settings.subheading }}</p>
      <h2 class="text-4xl md:text-5xl font-serif text-[#181615]">{{ section.settings.title }}</h2>
    </div>
    
    <div class="space-y-0">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <h3 class="text-[11px] font-bold uppercase tracking-widest text-[#181615] mt-14 mb-2 pb-2 border-b border-[#e5e5e5]" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </h3>
          
        {% elsif block.type == 'faq' %}
          <details class="group border-b border-[#e5e5e5] [&_summary::-webkit-details-marker]:hidden" {{ block.shopify_attributes }}>
            <summary class="flex justify-between items-center cursor-pointer list-none py-6 text-base md:text-lg font-medium text-[#181615] hover:text-[#B8A892] transition duration-300">
              <span>{{ block.settings.question }}</span>
              <span class="relative h-4 w-4 flex-shrink-0 text-[#737373]">
                <svg class="absolute inset-0 h-4 w-4 opacity-100 group-open:opacity-0 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <svg class="absolute inset-0 h-4 w-4 opacity-0 group-open:opacity-100 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
              </span>
            </summary>
            <div class="text-[#737373] font-light pb-8 leading-relaxed pr-8 text-sm md:text-base">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_contact %}
      <div class="text-center mt-32 pt-10 border-t border-[#e5e5e5]">
        <h3 class="text-2xl md:text-3xl font-serif text-[#181615] mb-6">{{ section.settings.contact_heading }}</h3>
        <p class="text-[#737373] font-light text-sm md:text-base max-w-lg mx-auto mb-10 leading-relaxed">
          {{ section.settings.contact_text }}
        </p>
        {% if section.settings.contact_link != blank and section.settings.contact_button_text != blank %}
          <a href="{{ section.settings.contact_link }}" class="inline-block bg-[#181615] text-white text-[11px] font-semibold uppercase tracking-[0.2em] py-4 px-10 hover:bg-[#B8A892] transition duration-300">
            {{ section.settings.contact_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Visual FAQ",
  "settings": [
    { 
      "type": "text", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "Support" 
    },
    { 
      "type": "text", 
      "id": "title", 
      "label": "Heading", 
      "default": "Frequently Asked Questions" 
    },
    {
      "type": "header",
      "content": "Contact / Assistance Block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show Assistance Block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact Client Services"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact Text",
      "default": "Our dedicated Client Advisors are available to assist you by phone, email, or live chat. We invite you to contact us with any questions regarding your Visual Book, bespoke orders, or general inquiries."
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Header",
      "settings": [
        { 
          "type": "text", 
          "id": "title", 
          "label": "Category Name", 
          "default": "Category Title" 
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { 
          "type": "text", 
          "id": "question", 
          "label": "Question", 
          "default": "Enter your question here" 
        },
        { 
          "type": "richtext", 
          "id": "answer", 
          "label": "Answer", 
          "default": "<p>Enter the detailed answer to the question here.</p>" 
        }
      ]
    }
  ],
  "presets": [
    { 
      "name": "Visual FAQ",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "About Our Products"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What exactly is The Visual Book?",
            "answer": "<p>The Visual Book is a luxury memory preservation book featuring a built-in high-definition screen designed to play your personal videos and audio. Crafted with eco-friendly leather and linen, it seamlessly bridges the gap between digital media and physical photo albums.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if I don't upload a video during checkout?",
            "answer": "<p>That is completely fine! We will send you a blank video book along with an easy-to-use cable. You can easily plug it into your computer and load your own videos and background songs at home.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Processing & Editing"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does it take to process my media?",
            "answer": "<p>Unedited bulk videos take 2 to 3 days to process. Pre-edited or single videos take 48 hours maximum. If you require our professional video editing services, please allow 1 additional day.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Shipping & Delivery"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>After a standard 1-day dispatch period, delivery takes between 2 to 10 days depending on your country and region. We ship worldwide!</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer Next Day Delivery in the UK?",
            "answer": "<p>Yes! Our UK Next Day Delivery cut-off time is 1:00 PM for orders with no file attachments or fewer than 3 files. If your order contains 1 or more files to be pre-loaded, it must be placed before 7:00 AM to qualify.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Orders & Support"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I change or cancel my order after placing it?",
            "answer": "<p>We process orders very quickly to ensure prompt delivery. If you need to make a change or cancel your order, you can cancel it provided that our team has not yet started working on it. Once processing has begun, we are unable to modify or cancel it.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact customer support?",
            "answer": "<p><strong>WhatsApp Fast Line:</strong> For the fastest response to urgent inquiries, message us at 07459553149.<br><br><strong>Email:</strong> You can email us anytime at info@thevisualbook.com.<br><br><strong>Live Chat:</strong> Simply click the chat bubble in the bottom right corner of your screen during business hours.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}