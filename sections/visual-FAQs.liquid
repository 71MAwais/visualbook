<section class="w-full bg-[#fafafa] py-32 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#737373] mb-4">{{ section.settings.subheading }}</p>
      <h2 class="text-4xl md:text-5xl font-serif text-[#181615]">{{ section.settings.title }}</h2>
    </div>
    
    <div class="space-y-0">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <h3 class="text-[11px] font-bold uppercase tracking-widest text-[#181615] mt-14 mb-2 pb-2 border-b border-[#e5e5e5]" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </h3>
          
        {% elsif block.type == 'faq' %}
          <details class="group border-b border-[#e5e5e5] [&_summary::-webkit-details-marker]:hidden" {{ block.shopify_attributes }}>
            <summary class="flex justify-between items-center cursor-pointer list-none py-6 text-base md:text-lg font-medium text-[#181615] hover:text-[#B8A892] transition duration-300">
              <span>{{ block.settings.question }}</span>
              <span class="relative h-4 w-4 flex-shrink-0 text-[#737373]">
                <svg class="absolute inset-0 h-4 w-4 opacity-100 group-open:opacity-0 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <svg class="absolute inset-0 h-4 w-4 opacity-0 group-open:opacity-100 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
              </span>
            </summary>
            <div class="text-[#737373] font-light pb-8 leading-relaxed pr-8 text-sm md:text-base">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_contact %}
      <div class="text-center mt-32 pt-10 border-t border-[#e5e5e5]">
        <h3 class="text-2xl md:text-3xl font-serif text-[#181615] mb-6">{{ section.settings.contact_heading }}</h3>
        <p class="text-[#737373] font-light text-sm md:text-base max-w-lg mx-auto mb-10 leading-relaxed">
          {{ section.settings.contact_text }}
        </p>
        {% if section.settings.contact_link != blank and section.settings.contact_button_text != blank %}
          <a href="{{ section.settings.contact_link }}" class="inline-block bg-[#181615] text-white text-[11px] font-semibold uppercase tracking-[0.2em] py-4 px-10 hover:bg-[#B8A892] transition duration-300">
            {{ section.settings.contact_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Visual FAQ",
  "settings": [
    { 
      "type": "text", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "Support" 
    },
    { 
      "type": "text", 
      "id": "title", 
      "label": "Heading", 
      "default": "Frequently Asked Questions" 
    },
    {
      "type": "header",
      "content": "Contact / Assistance Block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show Assistance Block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact Client Services"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact Text",
      "default": "Our dedicated Client Advisors are available to assist you by phone, email, or live chat. We invite you to contact us with any questions regarding your Visual Book, bespoke orders, or general inquiries."
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Header",
      "settings": [
        { 
          "type": "text", 
          "id": "title", 
          "label": "Category Name", 
          "default": "Category Title" 
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { 
          "type": "text", 
          "id": "question", 
          "label": "Question", 
          "default": "Enter your question here" 
        },
        { 
          "type": "richtext", 
          "id": "answer", 
          "label": "Answer", 
          "default": "<p>Enter the detailed answer to the question here.</p>" 
        }
      ]
    }
  ],
  "presets": [
    { 
      "name": "Visual FAQ",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Shipping & Returns"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you ship internationally, and how long does delivery take?",
            "answer": "<p>Yes, we offer worldwide shipping. Domestic orders typically arrive within 3 to 5 business days, while international shipping can take anywhere from 7 to 14 business days depending on your location and local customs processing. Once your order ships, you will receive a confirmation email with a tracking link. For full delivery timelines and regional rates, please visit our Shipping and Return page.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is your return and exchange policy?",
            "answer": "<p>We want you to be completely satisfied with your purchase. If your book arrives damaged or you simply change your mind, we accept returns and exchanges within 14 days of delivery. Items must be in their original, unopened condition. Please note that return shipping costs are the responsibility of the customer unless the item arrived defective. For step-by-step instructions on how to initiate a return, please review our Shipping and Return page.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Orders & Support"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I change or cancel my order after placing it?",
            "answer": "<p>We process orders very quickly to ensure prompt delivery. If you need to make a change or cancel your order, you can cancel it provided that our team has not yet started working on it. Once our team has begun processing and preparing your order, we are unable to modify or cancel it.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact customer support?",
            "answer": "<p><strong>WhatsApp Fast Line:</strong> For the fastest response to urgent inquiries, please message us on WhatsApp at [Insert Number].<br><br><strong>Live Chat:</strong> For normal response times during business hours, simply click the chat bubble in the bottom right corner of your screen to use our Shopify Inbox.<br><br><strong>Email:</strong> You can also email us anytime at [Insert Email].</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}