<section class="w-full bg-[#fafafa] py-32 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#737373] mb-4">{{ section.settings.subheading }}</p>
      <h2 class="text-4xl md:text-5xl font-serif text-[#181615]">{{ section.settings.title }}</h2>
    </div>
    
    <div class="space-y-0">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <h3 class="text-[11px] font-bold uppercase tracking-widest text-[#181615] mt-14 mb-2 pb-2 border-b border-[#e5e5e5]" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </h3>
          
        {% elsif block.type == 'faq' %}
          <details class="group border-b border-[#e5e5e5] [&_summary::-webkit-details-marker]:hidden" {{ block.shopify_attributes }}>
            <summary class="flex justify-between items-center cursor-pointer list-none py-6 text-base md:text-lg font-medium text-[#181615] hover:text-[#B8A892] transition duration-300">
              <span>{{ block.settings.question }}</span>
              <span class="relative h-4 w-4 flex-shrink-0 text-[#737373]">
                <svg class="absolute inset-0 h-4 w-4 opacity-100 group-open:opacity-0 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <svg class="absolute inset-0 h-4 w-4 opacity-0 group-open:opacity-100 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
              </span>
            </summary>
            <div class="text-[#737373] font-light pb-8 leading-relaxed pr-8 text-sm md:text-base">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_contact %}
      <div class="text-center mt-32 pt-10 border-t border-[#e5e5e5]">
        <h3 class="text-2xl md:text-3xl font-serif text-[#181615] mb-6">{{ section.settings.contact_heading }}</h3>
        <p class="text-[#737373] font-light text-sm md:text-base max-w-lg mx-auto mb-10 leading-relaxed">
          {{ section.settings.contact_text }}
        </p>
        {% if section.settings.contact_link != blank and section.settings.contact_button_text != blank %}
          <a href="{{ section.settings.contact_link }}" class="inline-block bg-[#181615] text-white text-[11px] font-semibold uppercase tracking-[0.2em] py-4 px-10 hover:bg-[#B8A892] transition duration-300">
            {{ section.settings.contact_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Visual FAQ",
  "settings": [
    { 
      "type": "text", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "Support" 
    },
    { 
      "type": "text", 
      "id": "title", 
      "label": "Heading", 
      "default": "Frequently Asked Questions" 
    },
    {
      "type": "header",
      "content": "Contact / Assistance Block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show Assistance Block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact Client Services"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact Text",
      "default": "Our dedicated Client Advisors are available to assist you by phone, email, or live chat. We invite you to contact us with any questions regarding your Visual Book, bespoke orders, or general inquiries."
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Header",
      "settings": [
        { 
          "type": "text", 
          "id": "title", 
          "label": "Category Name", 
          "default": "Category Title" 
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { 
          "type": "text", 
          "id": "question", 
          "label": "Question", 
          "default": "Enter your question here" 
        },
        { 
          "type": "richtext", 
          "id": "answer", 
          "label": "Answer", 
          "default": "<p>Enter the detailed answer to the question here.</p>" 
        }
      ]
    }
  ],
  "presets": [
    { 
      "name": "Visual FAQ",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "About Digital Video Books & Audio Cards"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is a Digital Video Book?",
            "answer": "<p><strong>The Visual Book</strong> is a luxury, hybrid memory album featuring a built-in HD IPS display. Crafted with premium vegan leather or linen and 24k gold foil stamping, it bridges the gap between digital media and physical photo albums. Each digital video book contains 8GB of storage, capable of playing up to 6 hours of high-definition video and photo slideshows instantly.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does the memory album require Wi-Fi or an app to play?",
            "answer": "<p>No! Our electronic video books feature a zero-setup, \"open-and-play\" design. They require absolutely no Wi-Fi, internet connection, or third-party apps. Simply open the cover, and your cherished memories will play instantly through the integrated screen and crystal-clear speakers.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do Recordable Audio Greeting Cards work?",
            "answer": "<p>Our <strong>Recordable Audio Greeting Cards</strong> elevate traditional gifting by allowing you to capture a 60-second personal voice message, holiday carol, or group cheer. Featuring a high-fidelity acoustic system hidden inside foil-stamped, premium textured cardstock, your recipient will hear your exact voice the moment they open it.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Uploading & Tech Support"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I upload photos and videos to my Visual Book?",
            "answer": "<p>It's incredibly easy! If you choose not to pre-load your media during checkout, we will ship you a blank video book along with an easy-to-use micro-USB cable. Simply plug the book into your Mac or PC, open it like a standard flash drive, and drag-and-drop your video and photo files directly into the folder.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I edit or change the videos on my book later?",
            "answer": "<p>Yes. You have total creative control. Using the provided micro-USB cable, you can connect the video book to your computer at any time to add, delete, or reorganize your media files, just as you would with a standard hard drive.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Processing, Shipping & Returns"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does it take to process and pre-load my media?",
            "answer": "<p>If you upload files during checkout, our processing times are as follows:</p><ul><li><strong>Pre-edited or single videos:</strong> 48 hours maximum.</li><li><strong>Unedited bulk videos:</strong> 2 to 3 days to process.</li><li><strong>Professional Video Editing Service:</strong> Please allow 1 additional day.</li></ul><p>Once processing is complete, standard dispatch takes 1 business day.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer UK Next Day Delivery?",
            "answer": "<p>Yes! We offer a Next Day Delivery option for UK orders with the following conditions:</p><ul><li>The cut-off time is <strong>1:00 PM</strong> for blank books (no file attachments) or orders with fewer than 3 files.</li><li>Orders requiring us to pre-load 1 or more files must be placed before <strong>7:00 AM</strong> to qualify.</li></ul><p>Orders that do not meet these specific cut-offs will be processed within our standard timeframes.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we offer worldwide shipping. After processing and our 1-day dispatch window, international delivery typically takes between 2 to 10 days depending on your country and regional customs processing.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Gifting & Corporate Orders"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do The Visual Book Digital Gift Cards work?",
            "answer": "<p>Our Digital Gift Cards offer the ultimate gifting flexibility with instant inbox delivery. The recipient can redeem their gift card on our website to customize their own premium digital video book—choosing their preferred cover design (such as linen or vegan leather), screen size, and personal media uploads.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I commission custom video books for corporate gifting?",
            "answer": "<p>Absolutely. We provide bespoke Personalized Custom Digital Video Books perfect for VIP corporate gifting, real estate portfolios, and high-end presentations. With custom foil-stamped covers and offline playback, it is a striking physical presentation that bypasses digital email filters entirely. Please contact us for bulk ordering.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Contact & Customer Service"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I change or cancel my order after placing it?",
            "answer": "<p>We process orders very quickly to ensure prompt delivery. If you need to make a change or cancel your order, you can cancel it provided that our team has not yet started working on it. Once processing has begun, we are unable to modify or cancel it.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact customer support?",
            "answer": "<p>Our concierge team is available to assist you via multiple channels:</p><p><strong>WhatsApp Fast Line:</strong> For the fastest response to urgent inquiries, message us at <strong>07459553149</strong>.</p><p><strong>Email:</strong> Reach out to us anytime at <strong>info@thevisualbook.com</strong>.</p><p><strong>Live Chat:</strong> Click the chat bubble in the bottom right corner of your screen during business hours.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}