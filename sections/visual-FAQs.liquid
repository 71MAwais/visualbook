<section class="w-full bg-[#fafafa] py-32 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#737373] mb-4">{{ section.settings.subheading }}</p>
      <h2 class="text-4xl md:text-5xl font-serif text-[#1a1a1a]">{{ section.settings.title }}</h2>
    </div>
    
    <div class="space-y-0 border-t border-[#e5e5e5]">
      {% for block in section.blocks %}
        <details class="group border-b border-[#e5e5e5] [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center cursor-pointer list-none py-8 text-base md:text-lg font-light text-[#1a1a1a] hover:text-[#c4b09e] transition duration-300">
            <span>{{ block.settings.question }}</span>
            <span class="relative h-4 w-4 flex-shrink-0 text-[#737373]">
              <svg class="absolute inset-0 h-4 w-4 opacity-100 group-open:opacity-0 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              <svg class="absolute inset-0 h-4 w-4 opacity-0 group-open:opacity-100 transition-opacity duration-300 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" /></svg>
            </span>
          </summary>
          <div class="text-[#737373] font-light pb-8 leading-relaxed pr-8 text-sm md:text-base">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>

    {% if section.settings.show_contact %}
      <div class="text-center mt-32 pt-10">
        <h3 class="text-2xl md:text-3xl font-serif text-[#1a1a1a] mb-6">{{ section.settings.contact_heading }}</h3>
        <p class="text-[#737373] font-light text-sm md:text-base max-w-lg mx-auto mb-10 leading-relaxed">
          {{ section.settings.contact_text }}
        </p>
        {% if section.settings.contact_link != blank and section.settings.contact_button_text != blank %}
          <a href="{{ section.settings.contact_link }}" class="inline-block bg-[#1a1a1a] text-white text-[11px] font-semibold uppercase tracking-[0.2em] py-4 px-10 hover:bg-[#333333] transition duration-300">
            {{ section.settings.contact_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Visual FAQ",
  "settings": [
    { 
      "type": "text", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "Support" 
    },
    { 
      "type": "text", 
      "id": "title", 
      "label": "Heading", 
      "default": "Common Questions" 
    },
    {
      "type": "header",
      "content": "Contact / Assistance Block"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show Assistance Block",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Require assistance?"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact Text",
      "default": "Our dedicated concierge team is available to ensure your Visual Book is perfectly curated and configured for your special moments."
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "Button Label",
      "default": "Contact Concierge"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Standard bespoke orders take 5-7 business days to craft and assemble. Once shipped, delivery typically takes 2-3 days within the UK and US, and 5-10 days internationally.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Visual FAQ" }]
}
{% endschema %}