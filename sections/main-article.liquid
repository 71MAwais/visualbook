<style>
  /* Custom Editorial Styling for Shopify's Rich Text Editor (.rte) */
  .visual-article-content p { 
    margin-bottom: 2rem; 
  }
  
  /* Hides accidental empty spaces from the Shopify editor */
  .visual-article-content p:empty {
    display: none !important;
  }

  /* Magazine-style Drop Cap for the very first letter */
  .visual-article-content > p:first-of-type::first-letter {
    float: left;
    font-family: 'Cormorant Garamond', serif;
    font-size: 5rem;
    line-height: 0.8;
    padding-top: 8px;
    padding-right: 12px;
    padding-left: 2px;
    color: #111111;
  }

  .visual-article-content h2 { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 2.25rem; 
    color: #111111; 
    margin-top: 4rem; 
    margin-bottom: 1.5rem; 
    line-height: 1.2; 
    font-weight: 400; 
  }
  .visual-article-content h3 { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.5rem; 
    color: #111111; 
    margin-top: 3rem; 
    margin-bottom: 1rem; 
  }
  .visual-article-content blockquote { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 1.75rem; 
    font-style: italic; 
    color: #111111; 
    text-align: center; 
    margin: 4rem auto; 
    padding: 0 2rem;
    max-width: 90%;
  }
  .visual-article-content a { 
    color: #111111; 
    border-bottom: 1px solid #111111; 
    text-decoration: none; 
    padding-bottom: 1px; 
    transition: all 0.2s ease; 
  }
  .visual-article-content a:hover { 
    color: #888888; 
    border-bottom-color: #888888; 
  }
  
  /* LUXURY FIXED-RATIO IMAGES (PURE CSS FIX) */
  .visual-article-content img { 
    width: 100% !important; 
    height: auto !important; 
    aspect-ratio: 3 / 2 !important; /* Enforces 35mm photography ratio */
    object-fit: cover !important; 
    object-position: center !important;
    margin: 4rem 0 !important; 
    background-color: #F5F3F0 !important; 
    border-radius: 2px !important;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08) !important; 
    transition: transform 0.5s ease, box-shadow 0.5s ease !important;
    display: block !important;
  }
  .visual-article-content img:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 15px 50px -10px rgba(0,0,0,0.12) !important; 
  }

  .visual-article-content ul, .visual-article-content ol { 
    margin-bottom: 2rem; 
    padding-left: 1.5rem; 
  }
  .visual-article-content li { 
    margin-bottom: 0.5rem; 
  }

  /* Pure CSS Cinematic Hero Image */
  .luxury-hero-container {
    width: 100%;
    overflow: hidden;
    background-color: #F5F3F0;
    aspect-ratio: 16 / 9; 
  }
  @media (min-width: 768px) {
    .luxury-hero-container {
      aspect-ratio: 21 / 9; /* Ultra-wide on desktop */
    }
  }
  .luxury-hero-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<article class="w-full bg-[#fafafa] py-16 md:py-24 px-6" itemscope itemtype="http://schema.org/BlogPosting">
  
  <div class="max-w-5xl mx-auto mb-12 md:mb-16">
    <a href="{{ blog.url }}" class="inline-flex items-center text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-[#888888] hover:text-[#111111] transition-colors group">
      <svg class="w-3 h-3 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to {{ blog.title }}
    </a>
  </div>

  <header class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
    
    <div class="flex items-center justify-center gap-3 mb-6 text-[10px] font-sans font-semibold uppercase tracking-[0.2em] text-[#888888]">
      <span itemprop="datePublished">{{ article.published_at | date: "%B %d, %Y" }}</span>
      {% if article.tags.size > 0 %}
        <span class="w-1 h-1 bg-[#d4d4d4] rounded-full"></span>
        <span>{{ article.tags.first }}</span>
      {% endif %}
    </div>
    
    <h1 class="text-4xl md:text-5xl lg:text-[64px] font-serif text-[#111111] leading-[1.1] tracking-tight mb-8" itemprop="headline">
      {{ article.title | escape }}
    </h1>
    
    {% if section.settings.show_author %}
      <p class="text-[10px] font-sans font-medium uppercase tracking-[0.2em] text-[#888888]" itemprop="author">
        Words by {{ article.author }}
      </p>
    {% endif %}
  </header>

  {%- if article.image -%}
    <div class="max-w-6xl mx-auto mb-16 md:mb-24">
      <div class="w-full bg-white p-3 md:p-6 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.05)] rounded-sm">
        <div class="luxury-hero-container">
          {{ article.image | image_url: width: 2000 | image_tag: class: 'w-full h-full object-cover', loading: 'eager', alt: article.image.alt | default: article.title | escape }}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="max-w-[720px] mx-auto">
    <div class="visual-article-content text-[#555555] font-sans font-light leading-[1.8] text-[15px] md:text-[17px]" itemprop="articleBody">
      {{ article.content }}
    </div>
  </div>

  <div class="max-w-[720px] mx-auto mt-16 flex items-center justify-center gap-4">
    <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-[#888888]">Share:</span>
    <a href="https://twitter.com/intent/tweet?text={{ article.title | url_param_escape }}&url={{ shop.url | append: article.url }}" target="_blank" class="text-[#888888] hover:text-[#111111] transition-colors" aria-label="Share on X">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.005 4.15H5.059z"/></svg>
    </a>
    <a href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url }}" target="_blank" class="text-[#888888] hover:text-[#111111] transition-colors" aria-label="Share on Facebook">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    <a href="mailto:?subject={{ article.title | url_param_escape }}&body=Read this article: {{ shop.url | append: article.url }}" class="text-[#888888] hover:text-[#111111] transition-colors" aria-label="Share via Email">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 4 10 8 10-8"/></svg>
    </a>
  </div>

  <div class="max-w-[720px] mx-auto mt-16 pt-10 border-t border-[#e5e5e5]">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-8">
      
      <div class="w-full sm:w-1/2 text-left">
        {% if blog.previous_article %}
          <p class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-[#888888] mb-2">Previous</p>
          <a href="{{ blog.previous_article.url }}" class="text-lg font-serif text-[#111111] hover:text-[#888888] transition-colors line-clamp-2">
            {{ blog.previous_article.title }}
          </a>
        {% endif %}
      </div>
      
      <div class="w-full sm:w-1/2 text-left sm:text-right">
        {% if blog.next_article %}
          <p class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-[#888888] mb-2">Next</p>
          <a href="{{ blog.next_article.url }}" class="text-lg font-serif text-[#111111] hover:text-[#888888] transition-colors line-clamp-2">
            {{ blog.next_article.title }}
          </a>
        {% endif %}
      </div>
      
    </div>
  </div>

</article>

{% schema %}
{
  "name": "Visual Blog Post",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author name",
      "default": true
    }
  ]
}
{% endschema %}