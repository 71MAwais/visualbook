{% comment %}
  Landing Feature Grid - optimized for luxury branding.
  Mobile: Classic 2-1-2 Diamond layout.
  Desktop: Modern, inline single row with elegant hover states.
  Bottom padding removed.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .landing-features {
    background-color: {{ section.settings.bg_color | default: '#FCFCFC' }};
    /* Padding: Top Right Bottom Left (Bottom is 0) */
    padding: 5rem 1.5rem 0 1.5rem; 
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    user-select: none;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .landing-features {
      padding: 7rem 2rem 0 2rem;
    }
  }

  .feature-grid-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  /* --- MOBILE: Classic 2-1-2 Layout --- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    row-gap: 3.5rem;
    column-gap: 1rem;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  /* Force the 3rd item (Fast Delivery) to span full width and center on mobile */
  .feature-grid .feature-item:nth-child(3) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  /* --- TABLET: Flex Wrap --- */
  @media (min-width: 768px) {
    .feature-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 4rem 2rem;
      max-width: 700px;
    }
    .feature-grid .feature-item:nth-child(3) {
      grid-column: auto;
      justify-self: auto;
    }
    .feature-item {
      width: 180px;
    }
  }

  /* --- DESKTOP: Single Elegant Row --- */
  @media (min-width: 1024px) {
    .feature-grid {
      flex-wrap: nowrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      max-width: 100%;
    }
    .feature-item {
      width: calc(20% - 1.5rem);
      min-width: 140px;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem; /* Slightly increased gap for breathing room */
    text-align: center;
    cursor: default;
  }

  /* --- ENHANCED LOGO/ICON WRAPPER --- */
  .feature-icon-wrapper {
    color: {{ section.settings.text_color | default: '#000000' }};
    opacity: 0.75; /* Soften default state */
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px; /* Taller bounding box to prevent jumping */
    width: 60px;
  }

  .custom-feature-icon {
    width: 40px; /* Slightly larger base size for better visibility */
    height: 40px;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .feature-item:hover .feature-icon-wrapper {
    opacity: 1;
    color: {{ section.settings.accent_color | default: '#B8906B' }};
    transform: translateY(-6px); 
  }
  
  .feature-item:hover .custom-feature-icon {
    transform: scale(1.1); /* Subtle zoom on custom images */
  }

  .feature-text {
    font-family: {{ section.settings.font_family.family }}, sans-serif;
    font-size: 11px; /* Slightly bumped up for legibility */
    letter-spacing: 0.25em; 
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#000000' }};
    font-weight: 600; 
    line-height: 1.6; 
    opacity: 0.85;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .feature-item:hover .feature-text {
     color: {{ section.settings.accent_color | default: '#B8906B' }};
     opacity: 1;
  }

  .feature-separator {
    width: 100%; 
    max-width: 1400px;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08); 
    margin-top: 5rem; 
  }

  @media (min-width: 1024px) {
     .feature-separator { margin-top: 7rem; }
  }
</style>

<section class="landing-features">
  <div class="feature-grid-wrapper">
    <div class="feature-grid">
      
      {% comment %} Feature 1: Signature Box {% endcomment %}
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          {% if section.settings.image_1 != blank %}
            <img src="{{ section.settings.image_1 | image_url: width: 80 }}" alt="{{ section.settings.text_1 | escape }}" class="custom-feature-icon" loading="lazy" width="40" height="40">
          {% else %}
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          {% endif %}
        </div>
        <span class="feature-text">{{ section.settings.text_1 }}</span>
      </div>

      {% comment %} Feature 2: Memory Preservation {% endcomment %}
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          {% if section.settings.image_2 != blank %}
            <img src="{{ section.settings.image_2 | image_url: width: 80 }}" alt="{{ section.settings.text_2 | escape }}" class="custom-feature-icon" loading="lazy" width="40" height="40">
          {% else %}
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 20v-1a3 3 0 0 0-3-3H3a3 3 0 0 0-3 3v1" />
              <circle cx="4" cy="12" r="3" />
              <rect x="9" y="8" width="14" height="9" rx="1" />
              <path d="M13 21h6" />
              <path d="M16 17v4" />
              <polygon points="14.5,10.5 17.5,12.5 14.5,14.5" />
            </svg>
          {% endif %}
        </div>
        <span class="feature-text">{{ section.settings.text_2 }}</span>
      </div>

      {% comment %} Feature 3: Fast Delivery (Spans full width on mobile) {% endcomment %}
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          {% if section.settings.image_3 != blank %}
            <img src="{{ section.settings.image_3 | image_url: width: 80 }}" alt="{{ section.settings.text_3 | escape }}" class="custom-feature-icon" loading="lazy" width="40" height="40">
          {% else %}
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
              <polyline points="3.29 7 12 12 20.71 7"></polyline>
              <line x1="12" y1="22" x2="12" y2="12"></line>
            </svg>
          {% endif %}
        </div>
        <span class="feature-text">{{ section.settings.text_3 }}</span>
      </div>

      {% comment %} Feature 4: Exceptional Craft {% endcomment %}
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          {% if section.settings.image_4 != blank %}
            <img src="{{ section.settings.image_4 | image_url: width: 80 }}" alt="{{ section.settings.text_4 | escape }}" class="custom-feature-icon" loading="lazy" width="40" height="40">
          {% else %}
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 11L12 5L17 11L12 21L7 11z" />
              <path d="M4 11h16" />
              <path d="M7 11L12 5" />
              <path d="M17 11L12 5" />
              <path d="M12 11v10" />
              <path d="M4 6L2.5 4.5M2.5 7.5L4 6l1.5 1.5M4 6l-1.5 1.5" />
            </svg>
          {% endif %}
        </div>
        <span class="feature-text">{{ section.settings.text_4 }}</span>
      </div>

      {% comment %} Feature 5: Eco-Friendly {% endcomment %}
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          {% if section.settings.image_5 != blank %}
            <img src="{{ section.settings.image_5 | image_url: width: 80 }}" alt="{{ section.settings.text_5 | escape }}" class="custom-feature-icon" loading="lazy" width="40" height="40">
          {% else %}
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C10.3 14.52 12 11.97 13 9"></path>
            </svg>
          {% endif %}
        </div>
        <span class="feature-text">{{ section.settings.text_5 }}</span>
      </div>

    </div>
  </div>

  {% if section.settings.show_separator %}
    <div class="feature-separator"></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Landing Feature Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FCFCFC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Icon Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#B8906B"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font Family",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Feature Labels & Custom Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Custom Image 1 (Optional)"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Feature 1",
      "default": "Signature Box"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Custom Image 2 (Optional)"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Feature 2",
      "default": "Memory Preservation"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Custom Image 3 (Optional)"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Feature 3",
      "default": "Fast Delivery"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Custom Image 4 (Optional)"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Feature 4",
      "default": "Exceptional Craft"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Custom Image 5 (Optional)"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Feature 5",
      "default": "Eco-Friendly"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show Bottom Separator Line",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Landing Feature Grid"
    }
  ]
}
{% endschema %}