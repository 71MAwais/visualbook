{% comment %} Left Side: Video/Images Area {% endcomment %}
            <div class="w-full md:w-1/2 aspect-video md:aspect-auto bg-black relative flex items-center justify-center">
                
                {% comment %} TAB 1: Features (Now Active by Default) {% endcomment %}
                <div id="tab-content-1-{{ block.id }}" class="cine-tab-content active absolute inset-0 w-full h-full p-8 flex flex-col justify-center">
                    {% if block.settings.cover_image != blank %}<img src="{{ block.settings.cover_image | image_url: width: 800 }}" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="lazy">{% endif %}
                    <div class="relative z-10">
                        <h4 style="font-family: 'Playfair Display', serif;" class="text-[32px] text-white mb-6">{{ section.settings.tab_1_title }}</h4>
                        <div class="text-[16px] text-white/80 space-y-4 leading-relaxed">{{ section.settings.tab_2_text }}</div>
                    </div>
                </div>

                {% comment %} TAB 2: Craftsmanship {% endcomment %}
                <div id="tab-content-2-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-8 flex flex-col justify-center">
                    {% if block.settings.cover_image != blank %}<img src="{{ block.settings.cover_image | image_url: width: 800 }}" class="absolute inset-0 w-full h-full object-cover opacity-20" loading="lazy">{% endif %}
                    <div class="relative z-10">
                        <h4 style="font-family: 'Playfair Display', serif;" class="text-[32px] text-white mb-6">{{ section.settings.tab_2_title }}</h4>
                        <div class="text-[16px] text-white/80 space-y-4 leading-relaxed">{{ section.settings.tab_3_text }}</div>
                    </div>
                </div>

                {% comment %} TAB 3: The Video Player {% endcomment %}
                <div id="tab-content-3-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full">
                    {% if block.settings.video != blank %}
                        {{ block.settings.video | video_tag: autoplay: false, loop: true, muted: false, controls: true, class: 'w-full h-full object-contain bg-black cine-video-player' }}
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-white/50 text-sm">No video uploaded</div>
                    {% endif %}
                </div>
            </div>