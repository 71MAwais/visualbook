{% comment %} sections/cinematic-experience.liquid {% endcomment %}
<style>
    #cinematic-grid-{{ section.id }} { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
    }
    #cinematic-grid-{{ section.id }} .font-serif { 
        font-family: 'Playfair Display', serif; 
    }

    /* Custom Scrollbar for Modal content */
    .modal-scroll::-webkit-scrollbar { width: 6px; }
    .modal-scroll::-webkit-scrollbar-track { background: transparent; }
    .modal-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

    /* Tab active state transitions */
    .cine-tab-btn.active {
        color: #B8906B;
        border-bottom-color: #B8906B;
    }
    .cine-tab-content {
        display: none;
        animation: fadeIn 0.4s ease forwards;
    }
    .cine-tab-content.active {
        display: flex; 
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<section id="cinematic-grid-{{ section.id }}" class="w-full py-16 md:py-24 bg-[#FAFAFA] relative">
    
    {% comment %} SECTION HEADER {% endcomment %}
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="max-w-4xl mx-auto px-6 text-center mb-12 md:mb-16">
            {% if section.settings.heading != blank %}
                <h2 class="font-serif text-[36px] md:text-[48px] text-[#111] leading-tight mb-4">
                    {{ section.settings.heading | escape }}
                </h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <p class="font-sans text-[16px] md:text-[18px] text-gray-600 leading-relaxed max-w-2xl mx-auto">
                    {{ section.settings.subheading | escape }}
                </p>
            {% endif %}
        </div>
    {% endif %}

    {% comment %} THE 6-ITEM GRID {% endcomment %}
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {% for block in section.blocks limit: 6 %}
            {%- assign title = block.settings.title | escape -%}
            
            <button type="button" 
                 class="group relative aspect-[4/5] rounded-2xl overflow-hidden cursor-pointer bg-[#111] text-left block w-full cine-modal-trigger transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(184,144,107,0.4)] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#B8906B] focus-visible:ring-offset-4 focus-visible:ring-offset-[#FAFAFA]" 
                 data-modal-target="cine-modal-{{ block.id }}" 
                 aria-label="Experience the unboxing: {{ title }}"
                 {{ block.shopify_attributes }}>
                
                {% comment %} Thumbnail Image {% endcomment %}
                {% if block.settings.cover_image != blank %}
                    {{ block.settings.cover_image | image_url: width: 800 | image_tag: 
                        class: 'absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-60',
                        loading: 'lazy',
                        alt: title 
                    }}
                {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-60 transition-opacity' }}
                {% endif %}

                {% comment %} Duration Pill (Top Right) {% endcomment %}
                {% if block.settings.video_duration != blank %}
                    <div class="absolute top-4 right-4 z-20 pointer-events-none">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-black/60 backdrop-blur-md rounded-md text-[11px] font-bold tracking-wider text-white border border-white/10 shadow-sm">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            {{ block.settings.video_duration | escape }}
                        </span>
                    </div>
                {% endif %}

                {% comment %} Overlays: Global Dim + Bottom Text Protection {% endcomment %}
                <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors duration-500 pointer-events-none z-10"></div>
                <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/95 via-black/40 to-transparent pointer-events-none z-10"></div>
                
                {% comment %} Frosted Glass Play Button {% endcomment %}
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                    <div class="w-16 h-16 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center border border-white/30 group-hover:bg-[#B8906B] group-hover:border-[#B8906B] group-hover:scale-110 transition-all duration-500 shadow-[0_0_30px_rgba(0,0,0,0.3)]">
                        <svg class="w-6 h-6 text-white ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                </div>

                {% comment %} Card Text {% endcomment %}
                <div class="absolute bottom-6 left-6 right-6 pointer-events-none transform group-hover:-translate-y-2 transition-transform duration-500 z-20">
                    <span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-[10px] uppercase tracking-widest text-[#B8906B] font-bold mb-3 border border-white/10 shadow-sm">
                        {{ block.settings.tag | escape }}
                    </span>
                    <h3 class="text-white font-serif text-[26px] md:text-[28px] leading-tight drop-shadow-lg">{{ title }}</h3>
                </div>
            </button>
        {% endfor %}
    </div>

</section>

{% comment %} MODALS (Generated for each block) {% endcomment %}
{% for block in section.blocks limit: 6 %}
    <div id="cine-modal-{{ block.id }}" 
         class="cine-modal fixed inset-0 z-50 hidden items-center justify-center p-4 md:p-8 bg-black/95 backdrop-blur-md opacity-0 transition-opacity duration-300"
         role="dialog" 
         aria-modal="true" 
         aria-labelledby="modal-title-{{ block.id }}">
        
        {% comment %} Modal Box Template Container {% endcomment %}
        <div class="relative w-full max-w-6xl max-h-[90vh] bg-[#0A0A0A] border border-white/10 rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-2xl scale-95 transition-transform duration-300 cine-modal-inner">
            
            {% comment %} Close Button {% endcomment %}
            <button type="button" 
                    class="cine-modal-close absolute top-4 right-4 z-50 w-10 h-10 bg-black/50 hover:bg-[#B8906B] rounded-full flex items-center justify-center text-white transition-colors border border-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white"
                    aria-label="Close modal">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>

            {% comment %} Left Side: The 3 Tabs Content Area {% endcomment %}
            <div class="w-full md:w-1/2 aspect-video md:aspect-auto bg-black relative flex items-center justify-center group/video">
                
                {% comment %} TAB 1 CONTENT: RAW HTML5 VIDEO {% endcomment %}
                <div id="tab-content-1-{{ block.id }}" class="cine-tab-content active absolute inset-0 w-full h-full relative">
                    {% if block.settings.video != blank %}
                        <video id="video-{{ block.id }}" class="w-full h-full object-contain bg-black" controls playsinline preload="metadata">
                            {% for source in block.settings.video.sources %}
                                <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>

                        {% comment %} Timestamps / Chapters Overlay {% endcomment %}
                        {% if block.settings.chapter_1_label != blank or block.settings.chapter_2_label != blank or block.settings.chapter_3_label != blank %}
                            <div class="absolute bottom-16 left-0 right-0 flex flex-wrap justify-center gap-2 px-4 z-20 opacity-0 group-hover/video:opacity-100 transition-opacity duration-300 pointer-events-none">
                                {% if block.settings.chapter_1_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_1_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[11px] uppercase tracking-wider font-bold px-4 py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_1_label | escape }}
                                    </button>
                                {% endif %}
                                {% if block.settings.chapter_2_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_2_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[11px] uppercase tracking-wider font-bold px-4 py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_2_label | escape }}
                                    </button>
                                {% endif %}
                                {% if block.settings.chapter_3_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_3_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[11px] uppercase tracking-wider font-bold px-4 py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_3_label | escape }}
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}

                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-white/50 text-sm absolute inset-0">No video uploaded</div>
                    {% endif %}
                </div>

                {% comment %} TAB 2 CONTENT: FEATURES IMAGE {% endcomment %}
                <div id="tab-content-2-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-8 md:p-12 flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                        {{ block.settings.cover_image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-10', loading: 'lazy' }}
                    {% endif %}
                    <div class="relative z-10 w-full max-w-md mx-auto">
                        <h5 class="text-[#B8906B] uppercase tracking-[0.2em] text-xs font-bold mb-4">{{ section.settings.tab_2_title | escape }}</h5>
                        <div class="font-sans text-[15px] text-white/80 space-y-4 leading-relaxed">
                            {{ section.settings.tab_2_text }}
                        </div>
                    </div>
                </div>

                {% comment %} TAB 3 CONTENT: CRAFTSMANSHIP {% endcomment %}
                <div id="tab-content-3-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-8 md:p-12 flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                        {{ block.settings.cover_image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-10', loading: 'lazy' }}
                    {% endif %}
                    <div class="relative z-10 w-full max-w-md mx-auto">
                        <h5 class="text-[#B8906B] uppercase tracking-[0.2em] text-xs font-bold mb-4">{{ section.settings.tab_3_title | escape }}</h5>
                        <div class="font-sans text-[15px] text-white/80 space-y-4 leading-relaxed">
                            {{ section.settings.tab_3_text }}
                        </div>
                    </div>
                </div>

            </div>

            {% comment %} Right Side: Title & Tab Navigation {% endcomment %}
            <div class="w-full md:w-1/2 p-8 md:p-12 lg:p-16 flex flex-col bg-[#0A0A0A] modal-scroll overflow-y-auto z-10">
                <span class="text-[11px] uppercase tracking-[0.2em] text-[#B8906B] font-bold mb-2">{{ block.settings.tag | escape }}</span>
                <h3 id="modal-title-{{ block.id }}" class="font-serif text-[36px] md:text-[48px] text-white leading-tight mb-10">{{ block.settings.title | escape }}</h3>

                {% comment %} The 3 Tabs Buttons {% endcomment %}
                <div class="flex gap-6 border-b border-white/10 mb-8" role="tablist">
                    <button type="button" data-block="{{ block.id }}" data-tab="1" class="cine-tab-btn active pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none" role="tab">
                        {{ section.settings.tab_1_title | escape }}
                    </button>
                    <button type="button" data-block="{{ block.id }}" data-tab="2" class="cine-tab-btn pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none" role="tab">
                        {{ section.settings.tab_2_title | escape }}
                    </button>
                    <button type="button" data-block="{{ block.id }}" data-tab="3" class="cine-tab-btn pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none" role="tab">
                        {{ section.settings.tab_3_title | escape }}
                    </button>
                </div>

                {% comment %} Dynamic Text area below tabs {% endcomment %}
                <div class="mt-auto pt-8">
                    <a href="{{ section.settings.button_link }}" class="inline-flex w-full items-center justify-center px-8 py-4 bg-white text-black font-sans text-[13px] font-bold tracking-widest uppercase hover:bg-[#B8906B] hover:text-white transition-colors duration-300 rounded-full focus:outline-none focus:ring-2 focus:ring-[#B8906B] focus:ring-offset-2 focus:ring-offset-[#0A0A0A]">
                        {{ section.settings.button_label | default: "Create Your Book" | escape }}
                    </a>
                </div>
            </div>

        </div>
    </div>
{% endfor %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('cinematic-grid-{{ section.id }}');
    if (!sectionContainer) return;

    const modalTriggers = document.querySelectorAll('.cine-modal-trigger');
    modalTriggers.forEach(trigger => {
        trigger.addEventListener('click', function() {
            const modalId = this.getAttribute('data-modal-target');
            const modal = document.getElementById(modalId);
            if (!modal) return;
            
            const modalBox = modal.querySelector('.cine-modal-inner');
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                if (modalBox) {
                    modalBox.classList.remove('scale-95');
                    modalBox.classList.add('scale-100');
                }
            }, 10);

            const blockId = modalId.replace('cine-modal-', '');
            const video = document.getElementById(`video-${blockId}`);
            if (video) {
                video.currentTime = 0;
                let playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => console.warn("Browser auto-play rules delayed execution.", error));
                }
            }

            document.body.style.overflow = 'hidden';
        });
    });

    const closeButtons = document.querySelectorAll('.cine-modal-close');
    closeButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const modal = this.closest('.cine-modal');
            if (!modal) return;

            const modalBox = modal.querySelector('.cine-modal-inner');
            
            modal.classList.add('opacity-0');
            if (modalBox) {
                modalBox.classList.remove('scale-100');
                modalBox.classList.add('scale-95');
            }

            const blockId = modal.id.replace('cine-modal-', '');
            const video = document.getElementById(`video-${blockId}`);
            if (video) video.pause();

            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                switchCineTab(blockId, '1', modal);
            }, 300);

            document.body.style.overflow = '';
        });
    });

    const tabButtons = document.querySelectorAll('.cine-tab-btn');
    tabButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const blockId = this.getAttribute('data-block');
            const tabNumber = this.getAttribute('data-tab');
            const modal = this.closest('.cine-modal');
            switchCineTab(blockId, tabNumber, modal);
        });
    });

    function switchCineTab(blockId, tabNumber, modalContext) {
        if (!modalContext) return;
        
        const allBtns = modalContext.querySelectorAll('.cine-tab-btn');
        const allContents = modalContext.querySelectorAll('.cine-tab-content');
        
        allBtns.forEach(b => b.classList.remove('active'));
        allContents.forEach(c => c.classList.remove('active'));

        const activeBtn = modalContext.querySelector(`.cine-tab-btn[data-tab="${tabNumber}"]`);
        const activeContent = document.getElementById(`tab-content-${tabNumber}-${blockId}`);
        
        if (activeBtn) activeBtn.classList.add('active');
        if (activeContent) activeContent.classList.add('active');

        const video = document.getElementById(`video-${blockId}`);
        if (video) {
            if (tabNumber !== '1') {
                video.pause();
            } else {
                let playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => console.warn("Interface activation requested user trigger.", error));
                }
            }
        }
    }

    const chapterBtns = document.querySelectorAll('.chapter-btn');
    chapterBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation(); 
            const blockId = this.getAttribute('data-block');
            const time = parseInt(this.getAttribute('data-time'), 10);
            const video = document.getElementById(`video-${blockId}`);
            
            if (video && !isNaN(time)) {
                video.currentTime = time;
                video.play();
            }
        });
    });
});
</script>

{% schema %}
{
  "name": "The Unboxing Experience",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Titles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience the Unboxing"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See what it feels like to hold your memories in your hands for the first time."
    },
    {
      "type": "header",
      "content": "Global Tabs Configuration",
      "info": "Tab 1 automatically renders the video file assigned to each individual block."
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Tab 1 Name",
      "default": "The Video"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Tab 2 Name",
      "default": "Features"
    },
    {
      "type": "richtext",
      "id": "tab_2_text",
      "label": "Tab 2 Content",
      "default": "<p><strong>Instant Playback:</strong> Open the cover and the video begins automatically.</p><p><strong>Vivid Display:</strong> Gorgeous 8-inch glare-free screen.</p>"
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Tab 3 Name",
      "default": "Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "tab_3_text",
      "label": "Tab 3 Content",
      "default": "<p>Bound in premium artisan linen, designed to last lifetimes and be passed down as a true modern heirloom.</p>"
    },
    {
      "type": "header",
      "content": "Call To Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Create Your Book"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "experience",
      "name": "Experience Video",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag",
          "default": "Wedding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Big Day"
        },
        {
          "type": "text",
          "id": "video_duration",
          "label": "Video Duration Badge",
          "placeholder": "e.g. 01:45",
          "info": "Displays a small timestamp pill on the top right of the grid card."
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Video Thumbnail / Cover",
          "info": "Displays on the grid and maps inside modal backgrounds."
        },
        {
          "type": "video",
          "id": "video",
          "label": "The Video",
          "info": "Plays natively inside Tab 1 content slots."
        },
        {
          "type": "header",
          "content": "Video Chapters (Optional)",
          "info": "Add buttons over the video that skip to specific timestamps. Leave blank to hide."
        },
        {
          "type": "text",
          "id": "chapter_1_label",
          "label": "Chapter 1 Label",
          "placeholder": "e.g., The Box"
        },
        {
          "type": "number",
          "id": "chapter_1_time",
          "label": "Chapter 1 Timestamp (Seconds)",
          "default": 0
        },
        {
          "type": "text",
          "id": "chapter_2_label",
          "label": "Chapter 2 Label",
          "placeholder": "e.g., Opening"
        },
        {
          "type": "number",
          "id": "chapter_2_time",
          "label": "Chapter 2 Timestamp (Seconds)",
          "default": 15
        },
        {
          "type": "text",
          "id": "chapter_3_label",
          "label": "Chapter 3 Label",
          "placeholder": "e.g., The Screen"
        },
        {
          "type": "number",
          "id": "chapter_3_time",
          "label": "Chapter 3 Timestamp (Seconds)",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Unboxing Experience",
      "blocks": [
        { "type": "experience" },
        { "type": "experience" },
        { "type": "experience" }
      ]
    }
  ]
}
{% endschema %}