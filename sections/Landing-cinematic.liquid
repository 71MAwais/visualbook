      "label": "Heading",
      "default": "A Story For Every Occasion"
    },
    {
      "type": "header",
      "content": "Global Tabs Configuration",
      "info": "Tab 1 is automatically set to play the Video uploaded in each block."
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Tab 1 Name",
      "default": "The Video"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Tab 2 Name",
      "default": "Features"
    },
    {
      "type": "richtext",
      "id": "tab_2_text",
      "label": "Tab 2 Content",
      "default": "<p><strong>Instant Playback:</strong> Open the cover and the video begins automatically.</p><p><strong>Vivid Display:</strong> Gorgeous 8-inch glare-free screen.</p>"
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Tab 3 Name",
      "default": "Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "tab_3_text",
      "label": "Tab 3 Content",
      "default": "<p>Bound in premium artisan linen, designed to last lifetimes and be passed down as a true modern heirloom.</p>"
    },
    {
      "type": "header",
      "content": "Call To Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Create Your Book"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "memory",
      "name": "Memory Card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag",
          "default": "Wedding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Big Day"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Grid Cover Image",
          "info": "Displays on the grid and as a background in Tabs 2 and 3."
        },
        {
          "type": "video",
          "id": "video",
          "label": "The Video",
          "info": "Plays when the user clicks 'The Video' tab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Reviews & Tabs",
      "blocks": [
        { "type": "memory" },
        { "type": "memory" },
        { "type": "memory" }
      ]
    }
  ]
}
{% endschema %}