{% comment %} sections/cinematic-experience.liquid {% endcomment %}
<style>
    #cinematic-grid-{{ section.id }} { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
    }
    #cinematic-grid-{{ section.id }} .font-serif { 
        font-family: 'Playfair Display', serif; 
    }

    /* Custom Scrollbar for Modal content */
    .modal-scroll::-webkit-scrollbar { width: 4px; md:width: 6px; }
    .modal-scroll::-webkit-scrollbar-track { background: transparent; }
    .modal-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

    /* Tab active state transitions */
    .cine-tab-btn.active {
        color: #B8906B;
        border-bottom-color: #B8906B;
    }
    .cine-tab-content {
        display: none;
        animation: fadeIn 0.4s ease forwards;
    }
    .cine-tab-content.active {
        display: flex; 
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    /* Lock body scroll when modal is open on mobile */
    body.modal-open {
        overflow: hidden;
    }
</style>

<section id="cinematic-grid-{{ section.id }}" class="w-full py-12 md:py-24 bg-[#FAFAFA] relative px-4 md:px-6">
    
    {% comment %} SECTION HEADER {% endcomment %}
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="max-w-4xl mx-auto text-center mb-10 md:mb-16">
            {% if section.settings.heading != blank %}
                <h2 class="font-serif text-[32px] md:text-[48px] text-[#111] leading-tight mb-4">
                    {{ section.settings.heading | escape }}
                </h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <p class="font-sans text-[15px] md:text-[18px] text-gray-600 leading-relaxed max-w-2xl mx-auto">
                    {{ section.settings.subheading | escape }}
                </p>
            {% endif %}
        </div>
    {% endif %}

    {% comment %} THE DYNAMIC GRID {% endcomment %}
    <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 justify-center">
        {% for block in section.blocks limit: 6 %}
            {%- assign title = block.settings.title | escape -%}
            
            <button type="button" 
                 class="group relative w-full bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-[#2a2623] via-[#111111] to-[#050505] border border-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] rounded-xl p-6 md:p-8 text-left cursor-pointer transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_20px_40px_-15px_rgba(184,144,107,0.3)] hover:border-[#B8906B]/40 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#B8906B] cine-modal-trigger overflow-hidden flex flex-col justify-between min-h-[220px] md:min-h-[240px]" 
                 data-modal-target="cine-modal-{{ block.id }}" 
                 aria-label="Experience the unboxing: {{ title }}"
                 {{ block.shopify_attributes }}>
                
                {% comment %} Top Hover Gradient Border {% endcomment %}
                <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#B8906B] to-[#e0c4a8] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

                <div>
                    <div class="flex items-center justify-between mb-4">
                        {% if block.settings.tag != blank %}
                            <span class="inline-block px-3 py-1 bg-white/5 rounded-full text-[10px] uppercase tracking-widest text-[#B8906B] font-bold border border-white/5 shadow-sm">
                                {{ block.settings.tag | escape }}
                            </span>
                        {% endif %}
                        {% if block.settings.video_duration != blank %}
                            <span class="text-white/40 text-[11px] font-bold tracking-wider font-sans bg-black/20 px-2 py-0.5 rounded">
                                {{ block.settings.video_duration | escape }}
                            </span>
                        {% endif %}
                    </div>
                    <h3 class="text-white font-serif text-[22px] md:text-[24px] leading-tight group-hover:text-[#B8906B] transition-colors duration-300">
                        {{ title }}
                    </h3>
                    {% if block.settings.description != blank %}
                        <p class="text-gray-400 font-sans text-[13px] mt-2 line-clamp-2 leading-relaxed">
                            {{ block.settings.description | escape }}
                        </p>
                    {% endif %}
                </div>
                
                <div class="flex items-center gap-3 text-white/70 group-hover:text-white transition-colors mt-6 pt-4 border-t border-white/10">
                    <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-[#B8906B] transition-colors duration-300">
                        <svg class="w-3.5 h-3.5 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                    <span class="text-[10px] md:text-[11px] uppercase tracking-widest font-bold">Watch Unboxing</span>
                </div>
            </button>
        {% endfor %}
    </div>

</section>

{% comment %} MODALS (Generated for each block) {% endcomment %}
{% for block in section.blocks limit: 6 %}
    <div id="cine-modal-{{ block.id }}" 
         class="cine-modal fixed inset-0 z-50 hidden items-center justify-center p-0 sm:p-4 md:p-8 bg-black/95 backdrop-blur-md opacity-0 transition-opacity duration-300"
         role="dialog" 
         aria-modal="true" 
         aria-labelledby="modal-title-{{ block.id }}">
        
        <div class="relative w-full h-full sm:h-auto max-w-6xl sm:max-h-[90vh] bg-[#0A0A0A] sm:border border-white/10 sm:rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-2xl scale-95 transition-transform duration-300 cine-modal-inner">
            
            {% comment %} Close Button {% endcomment %}
            <button type="button" 
                    class="cine-modal-close absolute top-4 right-4 z-50 w-10 h-10 bg-black/60 backdrop-blur hover:bg-[#B8906B] rounded-full flex items-center justify-center text-white transition-colors border border-white/20 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-white"
                    aria-label="Close modal">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>

            {% comment %} Left Side: The 3 Tabs Content Area {% endcomment %}
            <div class="w-full md:w-1/2 aspect-video md:aspect-auto bg-black relative flex items-center justify-center group/video shrink-0">
                
                {% comment %} TAB 1 CONTENT: RAW HTML5 VIDEO {% endcomment %}
                <div id="tab-content-1-{{ block.id }}" class="cine-tab-content active absolute inset-0 w-full h-full relative">
                    {% if block.settings.video != blank %}
                        <video id="video-{{ block.id }}" class="w-full h-full object-contain bg-black" controls playsinline preload="metadata">
                            {% for source in block.settings.video.sources %}
                                <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>

                        {% comment %} Timestamps / Chapters Overlay {% endcomment %}
                        {% if block.settings.chapter_1_label != blank or block.settings.chapter_2_label != blank or block.settings.chapter_3_label != blank %}
                            <div class="absolute bottom-12 md:bottom-16 left-0 right-0 flex flex-wrap justify-center gap-2 px-2 z-20 opacity-0 group-hover/video:opacity-100 transition-opacity duration-300 pointer-events-none">
                                {% if block.settings.chapter_1_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_1_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[10px] md:text-[11px] uppercase tracking-wider font-bold px-3 py-1.5 md:px-4 md:py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_1_label | escape }}
                                    </button>
                                {% endif %}
                                {% if block.settings.chapter_2_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_2_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[10px] md:text-[11px] uppercase tracking-wider font-bold px-3 py-1.5 md:px-4 md:py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_2_label | escape }}
                                    </button>
                                {% endif %}
                                {% if block.settings.chapter_3_label != blank %}
                                    <button type="button" data-block="{{ block.id }}" data-time="{{ block.settings.chapter_3_time }}" class="chapter-btn pointer-events-auto bg-black/70 backdrop-blur-md text-white text-[10px] md:text-[11px] uppercase tracking-wider font-bold px-3 py-1.5 md:px-4 md:py-2 rounded-full hover:bg-[#B8906B] transition-colors border border-white/20">
                                        {{ block.settings.chapter_3_label | escape }}
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}

                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-white/50 text-sm absolute inset-0">No video uploaded</div>
                    {% endif %}
                </div>

                {% comment %} TAB 2 CONTENT: FEATURES IMAGE {% endcomment %}
                <div id="tab-content-2-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-6 md:p-12 flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                        {{ block.settings.cover_image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-10', loading: 'lazy' }}
                    {% endif %}
                    <div class="relative z-10 w-full max-w-md mx-auto">
                        <h5 class="text-[#B8906B] uppercase tracking-[0.2em] text-[10px] md:text-xs font-bold mb-3 md:mb-4">{{ section.settings.tab_2_title | escape }}</h5>
                        <div class="font-sans text-[14px] md:text-[15px] text-white/80 space-y-3 md:space-y-4 leading-relaxed">
                            {{ section.settings.tab_2_text }}
                        </div>
                    </div>
                </div>

                {% comment %} TAB 3 CONTENT: CRAFTSMANSHIP {% endcomment %}
                <div id="tab-content-3-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-6 md:p-12 flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                        {{ block.settings.cover_image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover opacity-10', loading: 'lazy' }}
                    {% endif %}
                    <div class="relative z-10 w-full max-w-md mx-auto">
                        <h5 class="text-[#B8906B] uppercase tracking-[0.2em] text-[10px] md:text-xs font-bold mb-3 md:mb-4">{{ section.settings.tab_3_title | escape }}</h5>
                        <div class="font-sans text-[14px] md:text-[15px] text-white/80 space-y-3 md:space-y-4 leading-relaxed">
                            {{ section.settings.tab_3_text }}
                        </div>
                    </div>
                </div>

            </div>

            {% comment %} Right Side: Title & Tab Navigation {% endcomment %}
            <div class="w-full md:w-1/2 p-6 sm:p-8 md:p-12 lg:p-16 flex flex-col bg-[#0A0A0A] modal-scroll flex-1 overflow-y-auto z-10">
                <span class="text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-[#B8906B] font-bold mb-2">{{ block.settings.tag | escape }}</span>
                <h3 id="modal-title-{{ block.id }}" class="font-serif text-[28px] md:text-[36px] lg:text-[48px] text-white leading-tight mb-8 md:mb-10">{{ block.settings.title | escape }}</h3>

                {% comment %} The 3 Tabs Buttons {% endcomment %}
                <div class="flex gap-4 md:gap-6 border-b border-white/10 mb-6 md:mb-8 overflow-x-auto whitespace-nowrap modal-scroll" role="tablist">
                    <button type="button" data-block="{{ block.id }}" data-tab="1" class="cine-tab-btn active pb-3 md:pb-4 text-[12px] md:text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none shrink-0" role="tab">
                        {{ section.settings.tab_1_title | escape }}
                    </button>
                    <button type="button" data-block="{{ block.id }}" data-tab="2" class="cine-tab-btn pb-3 md:pb-4 text-[12px] md:text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none shrink-0" role="tab">
                        {{ section.settings.tab_2_title | escape }}
                    </button>
                    <button type="button" data-block="{{ block.id }}" data-tab="3" class="cine-tab-btn pb-3 md:pb-4 text-[12px] md:text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none shrink-0" role="tab">
                        {{ section.settings.tab_3_title | escape }}
                    </button>
                </div>

                {% comment %} Dynamic Text area below tabs {% endcomment %}
                <div class="mt-auto pt-6 md:pt-8 pb-4 sm:pb-0">
                    <a href="{{ section.settings.button_link }}" class="inline-flex w-full items-center justify-center px-6 md:px-8 py-4 bg-white text-black font-sans text-[12px] md:text-[13px] font-bold tracking-widest uppercase hover:bg-[#B8906B] hover:text-white transition-colors duration-300 rounded-full focus:outline-none focus:ring-2 focus:ring-[#B8906B] focus:ring-offset-2 focus:ring-offset-[#0A0A0A]">
                        {{ section.settings.button_label | default: "Create Your Book" | escape }}
                    </a>
                </div>
            </div>

        </div>
    </div>
{% endfor %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('cinematic-grid-{{ section.id }}');
    if (!sectionContainer) return;

    const modalTriggers = document.querySelectorAll('.cine-modal-trigger');
    modalTriggers.forEach(trigger => {
        trigger.addEventListener('click', function() {
            const modalId = this.getAttribute('data-modal-target');
            const modal = document.getElementById(modalId);
            if (!modal) return;
            
            const modalBox = modal.querySelector('.cine-modal-inner');
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                if (modalBox) {
                    modalBox.classList.remove('scale-95');
                    modalBox.classList.add('scale-100');
                }
            }, 10);

            const blockId = modalId.replace('cine-modal-', '');
            const video = document.getElementById(`video-${blockId}`);
            if (video) {
                video.currentTime = 0;
                let playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => console.warn("Browser auto-play rules delayed execution.", error));
                }
            }

            document.body.classList.add('modal-open');
        });
    });

    const closeButtons = document.querySelectorAll('.cine-modal-close');
    closeButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const modal = this.closest('.cine-modal');
            if (!modal) return;

            const modalBox = modal.querySelector('.cine-modal-inner');
            
            modal.classList.add('opacity-0');
            if (modalBox) {
                modalBox.classList.remove('scale-100');
                modalBox.classList.add('scale-95');
            }

            const blockId = modal.id.replace('cine-modal-', '');
            const video = document.getElementById(`video-${blockId}`);
            if (video) video.pause();

            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                switchCineTab(blockId, '1', modal);
            }, 300);

            document.body.classList.remove('modal-open');
        });
    });

    const tabButtons = document.querySelectorAll('.cine-tab-btn');
    tabButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const blockId = this.getAttribute('data-block');
            const tabNumber = this.getAttribute('data-tab');
            const modal = this.closest('.cine-modal');
            switchCineTab(blockId, tabNumber, modal);
        });
    });

    function switchCineTab(blockId, tabNumber, modalContext) {
        if (!modalContext) return;
        
        const allBtns = modalContext.querySelectorAll('.cine-tab-btn');
        const allContents = modalContext.querySelectorAll('.cine-tab-content');
        
        allBtns.forEach(b => b.classList.remove('active'));
        allContents.forEach(c => c.classList.remove('active'));

        const activeBtn = modalContext.querySelector(`.cine-tab-btn[data-tab="${tabNumber}"]`);
        const activeContent = document.getElementById(`tab-content-${tabNumber}-${blockId}`);
        
        if (activeBtn) activeBtn.classList.add('active');
        if (activeContent) activeContent.classList.add('active');

        const video = document.getElementById(`video-${blockId}`);
        if (video) {
            if (tabNumber !== '1') {
                video.pause();
            } else {
                let playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => console.warn("Interface activation requested user trigger.", error));
                }
            }
        }
    }

    const chapterBtns = document.querySelectorAll('.chapter-btn');
    chapterBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation(); 
            const blockId = this.getAttribute('data-block');
            const time = parseInt(this.getAttribute('data-time'), 10);
            const video = document.getElementById(`video-${blockId}`);
            
            if (video && !isNaN(time)) {
                video.currentTime = time;
                video.play();
            }
        });
    });
});
</script>

{% schema %}
{
  "name": "The Unboxing Experience",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Titles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience the Unboxing"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See what it feels like to hold your memories in your hands for the first time."
    },
    {
      "type": "header",
      "content": "Global Tabs Configuration",
      "info": "Tab 1 automatically renders the video file assigned to each individual block."
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Tab 1 Name",
      "default": "The Video"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Tab 2 Name",
      "default": "Features"
    },
    {
      "type": "richtext",
      "id": "tab_2_text",
      "label": "Tab 2 Content",
      "default": "<p><strong>Instant Playback:</strong> Open the cover and the video begins automatically.</p><p><strong>Vivid Display:</strong> Gorgeous 8-inch glare-free screen.</p>"
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Tab 3 Name",
      "default": "Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "tab_3_text",
      "label": "Tab 3 Content",
      "default": "<p>Bound in premium artisan linen, designed to last lifetimes and be passed down as a true modern heirloom.</p>"
    },
    {
      "type": "header",
      "content": "Call To Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Create Your Book"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "experience",
      "name": "Experience Video",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Category Tag",
          "default": "Linen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Classic Linen"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "The timeless, heirloom-quality videobook wrapped in artisan linen."
        },
        {
          "type": "text",
          "id": "video_duration",
          "label": "Video Duration Badge",
          "placeholder": "e.g. 01:45",
          "info": "Displays a small timestamp pill on the top right of the grid card."
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Modal Background Image",
          "info": "Fills the background of Tab 2 and Tab 3 inside the modal."
        },
        {
          "type": "video",
          "id": "video",
          "label": "The Video",
          "info": "Plays natively inside Tab 1 content slots."
        },
        {
          "type": "header",
          "content": "Video Chapters (Optional)",
          "info": "Add buttons over the video that skip to specific timestamps. Leave blank to hide."
        },
        {
          "type": "text",
          "id": "chapter_1_label",
          "label": "Chapter 1 Label",
          "placeholder": "e.g., The Box"
        },
        {
          "type": "number",
          "id": "chapter_1_time",
          "label": "Chapter 1 Timestamp (Seconds)",
          "default": 0
        },
        {
          "type": "text",
          "id": "chapter_2_label",
          "label": "Chapter 2 Label",
          "placeholder": "e.g., Opening"
        },
        {
          "type": "number",
          "id": "chapter_2_time",
          "label": "Chapter 2 Timestamp (Seconds)",
          "default": 15
        },
        {
          "type": "text",
          "id": "chapter_3_label",
          "label": "Chapter 3 Label",
          "placeholder": "e.g., The Screen"
        },
        {
          "type": "number",
          "id": "chapter_3_time",
          "label": "Chapter 3 Timestamp (Seconds)",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Unboxing Experience",
      "blocks": [
        { "type": "experience" },
        { "type": "experience" },
        { "type": "experience" }
      ]
    }
  ]
}
{% endschema %}