{% comment %} sections/cinematic-grid-reviews.liquid {% endcomment %}
<style>
    #cinematic-grid-{{ section.id }} { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
    }
    #cinematic-grid-{{ section.id }} .font-serif { 
        font-family: 'Playfair Display', serif; 
    }

    /* Custom Scrollbar for Modal content if it gets too long */
    .modal-scroll::-webkit-scrollbar { width: 6px; }
    .modal-scroll::-webkit-scrollbar-track { background: transparent; }
    .modal-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

    /* Tab active state transitions */
    .cine-tab-btn.active {
        color: #B8906B;
        border-bottom-color: #B8906B;
    }
    .cine-tab-content {
        display: none;
        animation: fadeIn 0.4s ease forwards;
    }
    .cine-tab-content.active {
        display: block;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<section id="cinematic-grid-{{ section.id }}" class="w-full py-20 md:py-32 bg-[#FAFAFA] relative">
    
    {% comment %} SECTION HEADER {% endcomment %}
    <div class="max-w-7xl mx-auto px-6 mb-16 text-center">
        {% if section.settings.subtitle != blank %}
            <span class="block font-sans text-[12px] md:text-[14px] text-[#B8906B] font-bold tracking-[0.3em] uppercase mb-4">{{ section.settings.subtitle }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
            <h2 class="font-serif text-[36px] md:text-[52px] lg:text-[64px] text-black leading-[1.1] tracking-tight">{{ section.settings.heading }}</h2>
        {% endif %}
    </div>

    {% comment %} THE 6-ITEM GRID {% endcomment %}
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {% for block in section.blocks limit: 6 %}
            <div class="group relative aspect-[4/5] rounded-2xl overflow-hidden cursor-pointer shadow-lg hover:shadow-2xl transition-all duration-500 bg-[#111]" 
                 onclick="openCineModal('cine-modal-{{ block.id }}')" 
                 {{ block.shopify_attributes }}>
                
                {% comment %} Thumbnail Image {% endcomment %}
                {% if block.settings.cover_image != blank %}
                    <img src="{{ block.settings.cover_image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-60" loading="lazy">
                {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-60 transition-opacity' }}
                {% endif %}

                {% comment %} Overlays & Play Button {% endcomment %}
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/40 group-hover:bg-[#B8906B] group-hover:border-[#B8906B] transition-colors duration-300">
                        <svg class="w-6 h-6 text-white ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                </div>

                {% comment %} Card Text {% endcomment %}
                <div class="absolute bottom-6 left-6 right-6">
                    <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] uppercase tracking-widest text-white mb-3">{{ block.settings.tag }}</span>
                    <h3 class="text-white font-serif text-[28px] leading-tight">{{ block.settings.title }}</h3>
                </div>
            </div>
        {% endfor %}
    </div>

</section>

{% comment %} MODALS (Generated for each block) {% endcomment %}
{% for block in section.blocks limit: 6 %}
    <div id="cine-modal-{{ block.id }}" class="fixed inset-0 z-50 hidden items-center justify-center p-4 md:p-8 bg-black/90 backdrop-blur-sm opacity-0 transition-opacity duration-300">
        
        {% comment %} Modal Container {% endcomment %}
        <div class="relative w-full max-w-6xl max-h-[90vh] bg-[#0A0A0A] border border-white/10 rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-2xl scale-95 transition-transform duration-300" id="cine-modal-inner-{{ block.id }}">
            
            {% comment %} Close Button {% endcomment %}
            <button onclick="closeCineModal('cine-modal-{{ block.id }}')" class="absolute top-4 right-4 z-50 w-10 h-10 bg-black/50 hover:bg-[#B8906B] rounded-full flex items-center justify-center text-white transition-colors border border-white/20">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>

            {% comment %} Left Side: The 3 Tabs Content Area {% endcomment %}
            <div class="w-full md:w-1/2 aspect-video md:aspect-auto bg-black relative flex items-center justify-center">
                
                {% comment %} TAB 1 CONTENT: RAW HTML5 VIDEO {% endcomment %}
                <div id="tab-content-1-{{ block.id }}" class="cine-tab-content active absolute inset-0 w-full h-full">
                    {% if block.settings.video != blank %}
                        <video id="video-{{ block.id }}" class="w-full h-full object-contain bg-black" controls playsinline preload="metadata">
                            {% for source in block.settings.video.sources %}
                                <source src="{{ source.url }}" type="{{ source.mime_type }}">
                            {% endfor %}
                            Your browser does not support the video tag.
                        </video>
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-white/50 text-sm">No video uploaded</div>
                    {% endif %}
                </div>

                {% comment %} TAB 2 CONTENT: FEATURES IMAGE {% endcomment %}
                <div id="tab-content-2-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-8 md:p-16 flex flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                         <img src="{{ block.settings.cover_image | image_url: width: 800 }}" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="lazy">
                    {% endif %}
                    <div class="relative z-10">
                        <h4 class="font-serif text-[32px] text-white mb-6">{{ section.settings.tab_2_title }}</h4>
                        <div class="font-sans text-[16px] text-white/80 space-y-4 leading-relaxed">
                            {{ section.settings.tab_2_text }}
                        </div>
                    </div>
                </div>

                {% comment %} TAB 3 CONTENT: CRAFTSMANSHIP {% endcomment %}
                <div id="tab-content-3-{{ block.id }}" class="cine-tab-content absolute inset-0 w-full h-full p-8 md:p-16 flex flex-col justify-center">
                    {% if block.settings.cover_image != blank %}
                         <img src="{{ block.settings.cover_image | image_url: width: 800 }}" class="absolute inset-0 w-full h-full object-cover opacity-30" loading="lazy">
                    {% endif %}
                    <div class="relative z-10">
                        <h4 class="font-serif text-[32px] text-white mb-6">{{ section.settings.tab_3_title }}</h4>
                        <div class="font-sans text-[16px] text-white/80 space-y-4 leading-relaxed">
                            {{ section.settings.tab_3_text }}
                        </div>
                    </div>
                </div>

            </div>

            {% comment %} Right Side: Title & Tab Navigation {% endcomment %}
            <div class="w-full md:w-1/2 p-8 md:p-12 lg:p-16 flex flex-col bg-[#0A0A0A] modal-scroll overflow-y-auto">
                <span class="text-[11px] uppercase tracking-[0.2em] text-[#B8906B] font-bold mb-2">{{ block.settings.tag }}</span>
                <h3 class="font-serif text-[36px] md:text-[48px] text-white leading-tight mb-10">{{ block.settings.title }}</h3>

                {% comment %} The 3 Tabs Buttons {% endcomment %}
                <div class="flex gap-6 border-b border-white/10 mb-8">
                    <button onclick="switchCineTab('{{ block.id }}', 1)" id="tab-btn-1-{{ block.id }}" class="cine-tab-btn active pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors">
                        {{ section.settings.tab_1_title }}
                    </button>
                    <button onclick="switchCineTab('{{ block.id }}', 2)" id="tab-btn-2-{{ block.id }}" class="cine-tab-btn pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors">
                        {{ section.settings.tab_2_title }}
                    </button>
                    <button onclick="switchCineTab('{{ block.id }}', 3)" id="tab-btn-3-{{ block.id }}" class="cine-tab-btn pb-4 text-[13px] uppercase tracking-widest font-bold text-white/50 hover:text-white border-b-2 border-transparent transition-colors">
                        {{ section.settings.tab_3_title }}
                    </button>
                </div>

                {% comment %} Dynamic Text area below tabs (optional call to action) {% endcomment %}
                <div class="mt-auto pt-8">
                    <a href="{{ section.settings.button_link }}" class="inline-flex w-full items-center justify-center px-8 py-4 bg-white text-black font-sans text-[13px] font-bold tracking-widest uppercase hover:bg-[#B8906B] hover:text-white transition-colors duration-300 rounded-full">
                        {{ section.settings.button_label | default: "Create Your Book" }}
                    </a>
                </div>
            </div>

        </div>
    </div>
{% endfor %}

<script>
    // OPEN MODAL
    function openCineModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        
        const modalBox = modal.firstElementChild;
        
        // Show modal and trigger fade in
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        // Slight delay for animation classes to apply
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalBox.classList.remove('scale-95');
            modalBox.classList.add('scale-100');
        }, 10);

        // SAFELY FIND AND PLAY THE VIDEO
        const blockId = modalId.replace('cine-modal-', '');
        const video = document.getElementById(`video-${blockId}`);
        if (video) {
            video.currentTime = 0;
            let playPromise = video.play();
            if (playPromise !== undefined) {
                playPromise.catch(error => {
                    console.warn("Browser blocked autoplay. User must click play.", error);
                });
            }
        }

        // Lock background scroll
        document.body.style.overflow = 'hidden';
    }

    // CLOSE MODAL
    function closeCineModal(modalId) {
        const modal = document.getElementById(modalId);
        if (!modal) return;
        
        const modalBox = modal.firstElementChild;
        
        // Trigger fade out
        modal.classList.add('opacity-0');
        modalBox.classList.remove('scale-100');
        modalBox.classList.add('scale-95');

        // SAFELY PAUSE VIDEO
        const blockId = modalId.replace('cine-modal-', '');
        const video = document.getElementById(`video-${blockId}`);
        if (video) video.pause();

        // Hide modal after animation
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            
            // Reset to Tab 1 automatically on close
            switchCineTab(blockId, 1);
        }, 300);

        // Unlock background scroll
        document.body.style.overflow = '';
    }

    // TAB SWITCHING LOGIC
    function switchCineTab(blockId, tabNumber) {
        // 1. Reset all tabs for this specific modal
        for (let i = 1; i <= 3; i++) {
            const btn = document.getElementById(`tab-btn-${i}-${blockId}`);
            const content = document.getElementById(`tab-content-${i}-${blockId}`);
            if (btn) btn.classList.remove('active');
            if (content) content.classList.remove('active');
        }

        // 2. Activate the clicked tab
        const activeBtn = document.getElementById(`tab-btn-${tabNumber}-${blockId}`);
        const activeContent = document.getElementById(`tab-content-${tabNumber}-${blockId}`);
        if (activeBtn) activeBtn.classList.add('active');
        if (activeContent) activeContent.classList.add('active');

        // 3. Pause video if switching AWAY from Tab 1
        const video = document.getElementById(`video-${blockId}`);
        if (video) {
            if (tabNumber !== 1) {
                video.pause();
            } else {
                let playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => {
                        console.warn("Browser blocked play on tab switch.", error);
                    });
                }
            }
        }
    }
</script>

{% schema %}
{
  "name": "Grid Reviews & Tabs",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
