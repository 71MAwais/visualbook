{% comment %} sections/single-immersive-video.liquid {% endcomment %}
<style>
    #immersive-section-{{ section.id }} { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
    }
    #immersive-section-{{ section.id }} .font-serif { 
        font-family: 'Playfair Display', serif; 
    }
    
    /* Hardware acceleration for the zoom effect */
    .immersive-zoom-container {
        will-change: transform, border-radius; 
        transform: translateZ(0);
    }

    /* Interactive Exit Button */
    .immersive-exit-btn {
        transition: all 0.3s ease; 
        cursor: pointer;
    }
    .immersive-exit-btn:hover {
        color: #B8906B !important; 
        transform: translateY(5px); 
    }
</style>

<section id="immersive-section-{{ section.id }}" class="w-full h-[150vh] relative bg-[#FAFAFA]" aria-label="Immersive Video Showcase">
    
    {% comment %} Sticky wrapper - z-index changes dynamically to cover header {% endcomment %}
    <div id="immersive-sticky-{{ section.id }}" class="sticky top-0 w-full h-[100dvh] flex items-center justify-center overflow-hidden z-40 transition-all duration-300">
        
        {% comment %} The Zooming Container {% endcomment %}
        <div id="immersive-bg-{{ section.id }}" class="immersive-zoom-container relative w-full h-full bg-[#050505] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.2)] flex items-center justify-center origin-center transition-all duration-700 ease-in-out" style="transform: scale(0.85); border-radius: 32px;">
            
            {% comment %} Background Video / Image Fallback {% endcomment %}
            <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden">
                {% if section.settings.background_video != blank %}
                    {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'absolute inset-0 w-full h-full object-cover opacity-70', draggable: false }}
                {% elsif section.settings.image != blank %}
                    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading | escape }}" class="absolute inset-0 w-full h-full object-cover opacity-70" draggable="false" loading="lazy"/>
                {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover opacity-70 bg-[#222]' }}
                {% endif %}
               
                {% comment %} Overlays for text legibility {% endcomment %}
                <div class="absolute inset-0 bg-gradient-to-t from-[#050505]/90 via-[#050505]/30 to-transparent"></div>
            </div>
            
            {% comment %} Text Content (Fades in on full screen) {% endcomment %}
            <div id="immersive-content-{{ section.id }}" class="relative z-10 w-full max-w-4xl px-8 md:px-12 flex flex-col items-center justify-center text-center opacity-0 transition-opacity duration-1000 delay-300 pointer-events-none">
                
                {% if section.settings.subtitle != blank %}
                    <span class="font-sans text-[12px] md:text-[14px] text-[#B8906B] font-bold tracking-[0.3em] uppercase mb-4 drop-shadow-md">
                        {{ section.settings.subtitle }}
                    </span>
                {% endif %}
                
                {% if section.settings.heading != blank %}
                    <h2 class="font-serif text-[42px] sm:text-[56px] md:text-[72px] lg:text-[96px] text-white leading-[1.05] tracking-tight mb-6 drop-shadow-xl">
                        {{ section.settings.heading }}
                    </h2>
                {% endif %}
                
                {% if section.settings.text != blank %}
                    <p class="font-sans text-[16px] md:text-[20px] text-white/80 font-light max-w-2xl leading-relaxed mb-10">
                        {{ section.settings.text }}
                    </p>
                {% endif %}

                {% if section.settings.button_label != blank %}
                    <a href="{{ section.settings.button_link }}" class="pointer-events-auto inline-flex items-center justify-center px-10 py-4 bg-white text-black font-sans text-[13px] font-bold tracking-widest uppercase hover:bg-[#B8906B] hover:text-white transition-colors duration-300 rounded-full">
                        {{ section.settings.button_label }}
                    </a>
                {% endif %}
            </div>

            {% comment %} Continue Scrolling Indicator {% endcomment %}
            <div id="immersive-scroll-indicator-{{ section.id }}" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 opacity-0 transition-opacity duration-700 delay-500 flex flex-col items-center gap-2 pointer-events-auto">
                <button id="immersive-exit-down-{{ section.id }}" aria-label="Continue Scrolling" class="immersive-exit-btn font-sans text-[10px] font-bold tracking-[0.2em] uppercase text-white/60 flex flex-col items-center gap-3 focus:outline-none">
                    <span>Keep Scrolling</span>
                    <svg class="w-4 h-4 animate-bounce text-[#B8906B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                </button>
            </div>
            
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(`immersive-section-${sectionId}`);
    const stickyWrapper = document.getElementById(`immersive-sticky-${sectionId}`);
    const bgContainer = document.getElementById(`immersive-bg-${sectionId}`);
    const content = document.getElementById(`immersive-content-${sectionId}`);
    const scrollIndicator = document.getElementById(`immersive-scroll-indicator-${sectionId}`);
    const exitBtn = document.getElementById(`immersive-exit-down-${sectionId}`);
    
    if (!section || !bgContainer) return;

    let isFullScreen = false;

    // Smooth scroll down button
    if(exitBtn) {
        exitBtn.addEventListener('click', () => {
            window.scrollTo({ top: section.offsetTop + section.offsetHeight, behavior: 'smooth' });
        });
    }

    // Scroll Logic for Zoom & Z-index overlay
    window.addEventListener('scroll', () => {
        const rect = section.getBoundingClientRect();
        const wh = window.innerHeight;

        // When the sticky container is fixed at the top of the viewport
        if (rect.top <= 0 && rect.bottom >= wh) {
            if (!isFullScreen) {
                isFullScreen = true;
                
                // Expand to full screen
                bgContainer.style.transform = `scale(1)`;
                bgContainer.style.borderRadius = `0px`;
                
                // Elevate z-index to 9999 to cover site headers
                stickyWrapper.style.zIndex = '9999';
                
                // Fade in content
                if(content) content.style.opacity = '1';
                if(content) content.style.pointerEvents = 'auto';
                if(scrollIndicator) scrollIndicator.style.opacity = '1';
            }
        } else {
            // Shrink back down when scrolling away
            if (isFullScreen) {
                isFullScreen = false;
                
                bgContainer.style.transform = `scale(0.85)`;
                bgContainer.style.borderRadius = `32px`;
                
                // Drop z-index back down so header reappears
                stickyWrapper.style.zIndex = '40';
                
                // Fade out content
                if(content) content.style.opacity = '0';
                if(content) content.style.pointerEvents = 'none';
                if(scrollIndicator) scrollIndicator.style.opacity = '0';
            }
        }
    }, { passive: true });
});
</script>

{% schema %}
{
  "name": "Immersive Video Hero",
  "settings": [
    {
      "type": "video",
      "id": "background_video",
      "label": "Background Video",
      "info": "Use a high-quality, looping MP4. This will cover the entire screen."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image",
      "info": "Displays if the video fails to load."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Relive The Magic"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Open the cover and instantly transport back to your most cherished moments. No apps, no loading, just pure emotion."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover The Book"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Immersive Video Hero"
    }
  ]
}
{% endschema %}