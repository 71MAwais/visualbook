{% comment %} sections/cinematic-scroll-grid.liquid {% endcomment %}

<style>
#cinematic-scroll-{{ section.id }} {
    font-family: 'Plus Jakarta Sans', sans-serif;
}

#cinematic-scroll-{{ section.id }} .font-serif {
    font-family: 'Playfair Display', serif;
}

.will-change-transform {
    will-change: transform, opacity, border-radius;
    transform: translateZ(0);
}

/* Modal Scrollbar */
.modal-scroll::-webkit-scrollbar {
    width: 6px;
}

.modal-scroll::-webkit-scrollbar-track {
    background: transparent;
}

.modal-scroll::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 10px;
}

/* Tabs */
.cine-tab-btn.active {
    color: #B8906B;
    border-bottom-color: #B8906B;
}

.cine-tab-content {
    display: none;
    animation: fadeIn .35s ease forwards;
}

.cine-tab-content.active {
    display: flex;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

<section id="cinematic-scroll-{{ section.id }}" class="w-full h-[250vh] relative bg-[#FAFAFA]">

    <div id="cinematic-sticky-{{ section.id }}"
         class="sticky top-0 w-full h-[100dvh] overflow-hidden flex items-center justify-center z-40">

        <!-- Background -->
        <div id="cinematic-bg-{{ section.id }}"
             class="absolute inset-0 bg-black overflow-hidden flex items-center justify-center"
             style="transform: scale(.85); border-radius:32px;">

            {% if section.settings.background_video != blank %}
                <video autoplay muted loop playsinline
                       class="absolute inset-0 w-full h-full object-cover opacity-80">
                    {% for source in section.settings.background_video.sources %}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                </video>
            {% elsif section.settings.image != blank %}
                <img src="{{ section.settings.image | image_url: width: 2400 }}"
                     class="absolute inset-0 w-full h-full object-cover opacity-80">
            {% endif %}

            <div id="cinematic-overlay-{{ section.id }}"
                 class="absolute inset-0 bg-black/30"></div>
        </div>

        <!-- Slide 1 -->
        <div id="cinematic-slide-1-{{ section.id }}"
             class="absolute inset-0 z-10 flex flex-col items-center justify-center text-center px-6 opacity-0">

            <span class="text-[#B8906B] uppercase tracking-[0.3em] text-xs font-bold mb-5">
                {{ section.settings.subtitle }}
            </span>

            <h2 class="font-serif text-white text-[44px] md:text-[90px] leading-none mb-6">
                {{ section.settings.heading }}
            </h2>

            <p class="text-white/80 text-[16px] md:text-[20px] max-w-2xl">
                {{ section.settings.text }}
            </p>
        </div>

        <!-- Slide 2 -->
        <div id="cinematic-slide-2-{{ section.id }}"
             class="absolute inset-0 z-20 flex flex-col items-center justify-center opacity-0 pointer-events-none px-4">

            <h3 class="font-serif text-white text-[30px] md:text-[48px] mb-10 text-center">
                {{ section.settings.grid_heading }}
            </h3>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 w-full max-w-6xl">

                {% for block in section.blocks limit: 6 %}

                    <div class="group relative aspect-square md:aspect-[4/5] rounded-2xl overflow-hidden cursor-pointer bg-[#111]"
                         onclick="openCineModal('cine-modal-{{ block.id }}')">

                        {% if block.settings.cover_image != blank %}
                            <img src="{{ block.settings.cover_image | image_url: width: 800 }}"
                                 class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:scale-105 group-hover:opacity-50 transition duration-700">
                        {% endif %}

                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

                        <div class="absolute inset-0 flex items-center justify-center">

                            <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center group-hover:bg-[#B8906B] transition">

                                <svg class="w-6 h-6 text-white ml-1"
                                     fill="currentColor"
                                     viewBox="0 0 24 24">
                                    <path d="M8 5v14l11-7z"/>
                                </svg>

                            </div>

                        </div>

                        <div class="absolute bottom-5 left-5 right-5">

                            <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[10px] uppercase tracking-widest text-white mb-3">
                                {{ block.settings.tag }}
                            </span>

                            <h4 class="text-white text-[20px] md:text-[28px] font-serif leading-tight">
                                {{ block.settings.title }}
                            </h4>

                        </div>

                    </div>

                {% endfor %}

            </div>

        </div>

    </div>

</section>

<!-- MODALS -->
{% for block in section.blocks limit: 6 %}

<div id="cine-modal-{{ block.id }}"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 backdrop-blur-md p-4 opacity-0 transition-opacity duration-300">

    <div class="relative w-full max-w-7xl max-h-[92vh] bg-[#0A0A0A] border border-white/10 rounded-3xl overflow-hidden flex flex-col md:flex-row scale-95 transition-transform duration-300">

        <!-- Close -->
        <button onclick="closeCineModal('cine-modal-{{ block.id }}')"
                class="absolute top-5 right-5 z-50 w-11 h-11 rounded-full bg-black/50 border border-white/20 flex items-center justify-center hover:bg-[#B8906B] transition">

            <svg class="w-5 h-5 text-white"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 viewBox="0 0 24 24">
                <path d="M18 6L6 18M6 6l12 12"/>
            </svg>

        </button>

        <!-- LEFT -->
        <div class="w-full md:w-1/2 bg-black relative aspect-video md:aspect-auto">

            <!-- TAB 1 -->
            <div id="tab-content-1-{{ block.id }}"
                 class="cine-tab-content active absolute inset-0 items-center justify-center">

                {% if block.settings.video != blank %}

                    <video id="video-{{ block.id }}"
                           class="w-full h-full object-contain bg-black"
                           controls
                           playsinline
                           preload="metadata">

                        {% for source in block.settings.video.sources %}
                            <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}

                    </video>

                {% endif %}

            </div>

            <!-- TAB 2 -->
            <div id="tab-content-2-{{ block.id }}"
                 class="cine-tab-content absolute inset-0 p-8 md:p-12 flex-col justify-center">

                <h4 class="text-[#B8906B] uppercase tracking-[0.2em] text-xs font-bold mb-8">
                    Features & Reviews
                </h4>

                <ul class="space-y-4 text-white/80 text-[15px]">

                    <li>✓ Premium cinematic playback</li>
                    <li>✓ Instant auto-play experience</li>
                    <li>✓ Emotional memory storytelling</li>
                    <li>✓ Luxury handcrafted presentation</li>

                </ul>

                <div class="mt-10 p-6 rounded-2xl bg-white/5 border border-white/10">

                    <p class="text-white/90 italic mb-4">
                        "{{ block.settings.review_text }}"
                    </p>

                    <span class="text-white/50 uppercase tracking-widest text-xs">
                        — {{ block.settings.author }}
                    </span>

                </div>

            </div>

            <!-- TAB 3 -->
            <div id="tab-content-3-{{ block.id }}"
                 class="cine-tab-content absolute inset-0 p-8 md:p-12 flex-col justify-center text-center">

                <div class="max-w-md mx-auto">

                    <h4 class="font-serif text-white text-[34px] mb-6">
                        The Perfect Gift
                    </h4>

                    <p class="text-white/80 text-[16px] leading-relaxed">
                        {{ block.settings.usecase_text }}
                    </p>

                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="w-full md:w-1/2 bg-[#0A0A0A] p-8 md:p-14 flex flex-col overflow-y-auto modal-scroll">

            <span class="text-[#B8906B] uppercase tracking-[0.2em] text-xs font-bold mb-3">
                {{ block.settings.tag }}
            </span>

            <h3 class="font-serif text-white text-[40px] md:text-[56px] leading-none mb-10">
                {{ block.settings.title }}
            </h3>

            <!-- Tabs -->
            <div class="flex gap-6 border-b border-white/10 mb-10">

                <button id="tab-btn-1-{{ block.id }}"
                        onclick="switchCineTab('{{ block.id }}',1)"
                        class="cine-tab-btn active pb-4 text-white/50 uppercase tracking-widest text-xs border-b-2 border-transparent transition">
                    {{ section.settings.tab_1_title }}
                </button>

                <button id="tab-btn-2-{{ block.id }}"
                        onclick="switchCineTab('{{ block.id }}',2)"
                        class="cine-tab-btn pb-4 text-white/50 uppercase tracking-widest text-xs border-b-2 border-transparent transition">
                    {{ section.settings.tab_2_title }}
                </button>

                <button id="tab-btn-3-{{ block.id }}"
                        onclick="switchCineTab('{{ block.id }}',3)"
                        class="cine-tab-btn pb-4 text-white/50 uppercase tracking-widest text-xs border-b-2 border-transparent transition">
                    {{ section.settings.tab_3_title }}
                </button>

            </div>

            <div class="mt-auto pt-10">

                <a href="{{ section.settings.button_link }}"
                   class="w-full inline-flex items-center justify-center px-8 py-4 rounded-full bg-white text-black uppercase tracking-widest text-xs font-bold hover:bg-[#B8906B] hover:text-white transition">

                    {{ section.settings.button_label }}

                </a>

            </div>

        </div>

    </div>

</div>

{% endfor %}

<script>
document.addEventListener('DOMContentLoaded', () => {

    const sectionId = '{{ section.id }}';

    const section = document.getElementById(`cinematic-scroll-${sectionId}`);
    const sticky = document.getElementById(`cinematic-sticky-${sectionId}`);
    const bg = document.getElementById(`cinematic-bg-${sectionId}`);
    const overlay = document.getElementById(`cinematic-overlay-${sectionId}`);
    const slide1 = document.getElementById(`cinematic-slide-1-${sectionId}`);
    const slide2 = document.getElementById(`cinematic-slide-2-${sectionId}`);

    if (!section) return;

    window.addEventListener('scroll', () => {

        const rect = section.getBoundingClientRect();
        const wh = window.innerHeight;
        const total = rect.height - wh;

        let progress = Math.min(Math.max(-rect.top / total, 0), 1);

        if (rect.top <= 0 && rect.bottom >= wh) {

            sticky.style.zIndex = '999999';

            let zoom = Math.min(progress / .3, 1);

            bg.style.transform = `scale(${0.85 + (0.15 * zoom)})`;
            bg.style.borderRadius = `${32 - (32 * zoom)}px`;

            if (progress < .5) {

                let fadeIn = Math.min(progress / .15, 1);
                let fadeOut = 1 - Math.max((progress - .35) / .15, 0);

                slide1.style.opacity = Math.min(fadeIn, fadeOut);

            } else {

                slide1.style.opacity = 0;

            }

            if (progress >= .45) {

                let gridFade = Math.min((progress - .45) / .2, 1);

                slide2.style.opacity = gridFade;
                slide2.style.pointerEvents = 'auto';

                overlay.style.opacity = 0.6;

            } else {

                slide2.style.opacity = 0;
                slide2.style.pointerEvents = 'none';

            }

        } else {

            sticky.style.zIndex = '40';

        }

    }, { passive: true });

});

function openCineModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) return;

    const modalBox = modal.firstElementChild;

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    setTimeout(() => {

        modal.classList.remove('opacity-0');

        modalBox.classList.remove('scale-95');
        modalBox.classList.add('scale-100');

    }, 10);

    const blockId = modalId.replace('cine-modal-', '');
    const video = document.getElementById(`video-${blockId}`);

    if (video) {

        video.currentTime = 0;

        video.play().catch(() => {});

    }

    document.body.style.overflow = 'hidden';

}

function closeCineModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) return;

    const modalBox = modal.firstElementChild;

    modal.classList.add('opacity-0');

    modalBox.classList.remove('scale-100');
    modalBox.classList.add('scale-95');

    const blockId = modalId.replace('cine-modal-', '');
    const video = document.getElementById(`video-${blockId}`);

    if (video) {

        video.pause();

    }

    setTimeout(() => {

        modal.classList.add('hidden');
        modal.classList.remove('flex');

        switchCineTab(blockId, 1);

    }, 300);

    document.body.style.overflow = '';

}

function switchCineTab(blockId, tabNumber) {

    for (let i = 1; i <= 3; i++) {

        const btn = document.getElementById(`tab-btn-${i}-${blockId}`);
        const content = document.getElementById(`tab-content-${i}-${blockId}`);

        if (btn) btn.classList.remove('active');
        if (content) content.classList.remove('active');

    }

    const activeBtn = document.getElementById(`tab-btn-${tabNumber}-${blockId}`);
    const activeContent = document.getElementById(`tab-content-${tabNumber}-${blockId}`);

    if (activeBtn) activeBtn.classList.add('active');
    if (activeContent) activeContent.classList.add('active');

    const video = document.getElementById(`video-${blockId}`);

    if (video) {

        if (tabNumber !== 1) {

            video.pause();

        } else {

            video.play().catch(() => {});

        }

    }

}
</script>