<style>
    /* Hide scrollbars but allow scrolling */
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Drag to scroll interactive logic */
    .drag-scroll {
        overflow-x: auto;
        scroll-behavior: auto;
        -webkit-overflow-scrolling: touch;
        cursor: grab;
    }
    .drag-scroll:active {
        cursor: grabbing !important;
    }
    .drag-scroll.is-dragging {
        user-select: none;
    }
    .drag-scroll.is-dragging * {
        pointer-events: none; /* Prevents text selection while dragging */
    }
</style>

<section class="py-10 md:py-14 border-y border-stone-100/50 overflow-hidden" id="instore-{{ section.id }}" style="background-color: {{ section.settings.bg_color | default: '#FCFBF9' }};">
    {% if section.settings.title != blank %}
        <div class="flex flex-col items-center mb-10 md:mb-12 text-center px-4">
            <h3 class="font-serif text-[22px] md:text-[26px] tracking-wide text-[#111111]">
                {{ section.settings.title }}
            </h3>
        </div>
    {% endif %}
    
    <div class="relative w-full max-w-[1800px] mx-auto" aria-hidden="true">
        <!-- Fade Edges that match the background color -->
        <div class="absolute top-0 left-0 w-12 md:w-24 h-full z-10 pointer-events-none" style="background: linear-gradient(to right, {{ section.settings.bg_color | default: '#FCFBF9' }}, transparent);"></div>
        <div class="absolute top-0 right-0 w-12 md:w-24 h-full z-10 pointer-events-none" style="background: linear-gradient(to left, {{ section.settings.bg_color | default: '#FCFBF9' }}, transparent);"></div>
        
        <div id="instore-scroll-{{ section.id }}" class="drag-scroll hide-scrollbar w-full" style="overscroll-behavior-x: none;">
            
            <div class="flex shrink-0 pb-4 pt-2 items-center">
                
                <!-- Capture the inner content ONLY, like visual-as-seen -->
                {% capture store_names %}
                    {% for block in section.blocks %}
                        
                        <div class="flex items-center justify-center shrink-0" {{ block.shopify_attributes }}>
                            {% if block.settings.logo != blank %}
                                <img src="{{ block.settings.logo | image_url: height: 120 }}" alt="{{ block.settings.store_name }}" class="h-8 md:h-10 lg:h-12 w-auto object-contain" loading="lazy">
                            {% else %}
                                <span class="font-serif text-[20px] md:text-[24px] uppercase tracking-[0.15em] text-[#111111] whitespace-nowrap">{{ block.settings.store_name }}</span>
                            {% endif %}
                        </div>
                        
                    {% endfor %}
                {% endcapture %}

                <!-- Loop the captured content inside identical wrappers -->
                {% for i in (1..6) %}
                    <div class="instore-group flex shrink-0 items-center justify-around gap-12 md:gap-24 px-6 md:px-12">
                        {{ store_names }}
                    </div>
                {% endfor %}
                
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.getElementById('instore-scroll-{{ section.id }}');
        if (!slider) return;

        const group = slider.querySelector('.instore-group');
        if (!group || group.children.length === 0) return;

        let isDown = false;
        let startX;
        let scrollLeft;
        let isAnimating = true;
        let animationId;
        const speed = {{ section.settings.scroll_speed | default: 1 }};

        // 1. Automatic Infinite Scrolling Logic
        function autoScroll() {
            if (isAnimating && group) {
                slider.scrollLeft += speed;
                const groupWidth = group.offsetWidth;
                
                // Seamlessly jump back/forward when we scroll past a full group's width
                if (slider.scrollLeft >= groupWidth * 2) {
                    slider.scrollLeft -= groupWidth;
                } else if (slider.scrollLeft <= 0) {
                    slider.scrollLeft += groupWidth;
                }
            }
            animationId = requestAnimationFrame(autoScroll);
        }

        // Start the loop
        autoScroll();

        // 2. Desktop Mouse Interaction
        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            isAnimating = false; // Pause auto-scroll on grab
            slider.classList.add('is-dragging');
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });
        
        slider.addEventListener('mouseleave', () => {
            isDown = false;
            isAnimating = true; // Resume auto-scroll when mouse leaves
            slider.classList.remove('is-dragging');
        });
        
        slider.addEventListener('mouseup', () => {
            isDown = false;
            isAnimating = true; // Resume auto-scroll on release
            slider.classList.remove('is-dragging');
        });
        
        slider.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 2; // Multiply by 2 for faster drag scrolling
            slider.scrollLeft = scrollLeft - walk;
        });

        // 3. Mobile Touch Interaction
        slider.addEventListener('touchstart', (e) => {
            isDown = true;
            isAnimating = false; // Pause auto-scroll on touch
            startX = e.touches[0].pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        }, {passive: true});
        
        slider.addEventListener('touchend', () => {
            isDown = false;
            isAnimating = true; // Resume auto-scroll on release
        });
        
        slider.addEventListener('touchmove', (e) => {
            if (!isDown) return;
            const x = e.touches[0].pageX - slider.offsetLeft;
            const walk = (x - startX) * 2;
            slider.scrollLeft = scrollLeft - walk;
        }, {passive: true});
    });
</script>

{% schema %}
{
  "name": "In-Store Marquee",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Available In-Store At" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FCFBF9" },
    { "type": "range", "id": "scroll_speed", "min": 0.5, "max": 3, "step": 0.1, "label": "Scroll Speed", "default": 1.0 }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { 
          "type": "text", 
          "id": "store_name", 
          "label": "Store Name", 
          "default": "Selfridges & Co" 
        },
        { 
          "type": "image_picker", 
          "id": "logo", 
          "label": "Store Logo (Optional)",
          "info": "If an image is uploaded, it will replace the text name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "In-Store Marquee",
      "blocks": [
        { "type": "store", "settings": { "store_name": "Selfridges & Co" } },
        { "type": "store", "settings": { "store_name": "la Rinascente" } },
        { "type": "store", "settings": { "store_name": "KaDeWe" } },
        { "type": "store", "settings": { "store_name": "Le Bon Marché" } },
        { "type": "store", "settings": { "store_name": "Harrods" } }
      ]
    }
  ]
}
{% endschema %}