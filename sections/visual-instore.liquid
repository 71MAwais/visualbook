{% comment %} sections/visual-instore.liquid {% endcomment %}

<section class="py-10 md:py-14 bg-white overflow-hidden" id="instore-{{ section.id }}">
    {% if section.settings.title != blank %}
        <p class="text-center text-[10px] uppercase tracking-[0.25em] text-black/40 font-medium mb-8">{{ section.settings.title }}</p>
    {% endif %}
    
    <div class="w-full relative">
        <div id="instore-scroll-{{ section.id }}" class="flex overflow-x-auto hide-scrollbar w-full cursor-grab active:cursor-grabbing items-center" style="overscroll-behavior-x: none;">
            <div class="instore-group flex shrink-0 items-center justify-around min-w-max gap-12 md:gap-20 px-8 h-12 whitespace-nowrap">
                
                {% for block in section.blocks %}
                    <span class="font-serif text-2xl md:text-3xl text-black/25" {{ block.shopify_attributes }}>{{ block.settings.store_name }}</span>
                    <span class="text-[#B8906B]/40 mx-4">✦</span>
                {% endfor %}
                
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Infinite Marquee Logic ported from main.js
    const container = document.getElementById('instore-scroll-{{ section.id }}');
    if (!container) return;
    
    const group = container.querySelector('.instore-group');
    if(!group || group.children.length === 0) return;

    // Clone group twice for infinite scroll
    container.appendChild(group.cloneNode(true));
    container.appendChild(group.cloneNode(true));

    let scrollPos = group.offsetWidth;
    container.scrollLeft = scrollPos;
    let isInteracting = false;

    const toggleInteract = (state) => () => isInteracting = state;
    container.addEventListener('mouseenter', toggleInteract(true));
    container.addEventListener('mouseleave', toggleInteract(false));
    container.addEventListener('touchstart', toggleInteract(true), {passive:true});
    container.addEventListener('touchend', toggleInteract(false), {passive:true});

    // Speed setting from Customizer
    const speed = {{ section.settings.scroll_speed | default: 1 }};

    function loop() {
        const gw = container.querySelector('.instore-group').offsetWidth;
        if (!isInteracting) {
            scrollPos += speed;
            if (scrollPos >= gw * 2) scrollPos -= gw;
            else if (scrollPos < 0) scrollPos += gw;
            container.scrollLeft = scrollPos;
        } else {
            scrollPos = container.scrollLeft;
            if (scrollPos >= gw * 2) container.scrollLeft = scrollPos = scrollPos - gw;
            else if (scrollPos <= 0) container.scrollLeft = scrollPos = scrollPos + gw;
        }
        requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
});
</script>

{% schema %}
{
  "name": "In-Store Marquee",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Available In-Store At" },
    { "type": "range", "id": "scroll_speed", "min": 0.5, "max": 3, "step": 0.1, "label": "Scroll Speed", "default": 1.0 }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store Name",
      "settings": [
        { "type": "text", "id": "store_name", "label": "Name", "default": "Selfridges & Co" }
      ]
    }
  ],
  "presets": [
    {
      "name": "In-Store Marquee",
      "blocks": [
        { "type": "store", "settings": { "store_name": "Selfridges & Co" } },
        { "type": "store", "settings": { "store_name": "la Rinascente" } },
        { "type": "store", "settings": { "store_name": "KaDeWe" } },
        { "type": "store", "settings": { "store_name": "Le Bon Marché" } },
        { "type": "store", "settings": { "store_name": "Harrods" } }
      ]
    }
  ]
}
{% endschema %}