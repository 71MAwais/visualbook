{%- style -%}
  #hero-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --accent-color: {{ section.settings.accent_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    /* Fluid typography for a seamless editorial look across all screen sizes */
    --fluid-heading: clamp(2.5rem, 5vw + 1rem, 4.5rem); 
    background-color: var(--bg-color);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #hero-{{ section.id }} .fluid-title {
    font-size: var(--fluid-heading);
    line-height: 1.1;
  }

  #hero-{{ section.id }} .reveal { 
    opacity: 0;
    transform: translateY(25px); 
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #hero-{{ section.id }} .reveal.active { 
    opacity: 1; 
    transform: translateY(0);
  }
  #hero-{{ section.id }} .delay-100 { transition-delay: 150ms; }
  #hero-{{ section.id }} .delay-200 { transition-delay: 300ms; }
  #hero-{{ section.id }} .delay-300 { transition-delay: 450ms; }

  /* Minimalist Arrow Scroll Indicator */
  .scroll-arrow {
    width: 28px;
    height: 28px;
    color: var(--accent-color);
    margin-top: 2.5rem;
    opacity: 0.7;
    transition: opacity 0.4s ease;
    animation: arrowFloat 2.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    cursor: pointer;
  }
  .scroll-arrow:hover {
    opacity: 1;
  }
  @keyframes arrowFloat {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(12px); opacity: 1; }
  }
{%- endstyle -%}

<section id="hero-{{ section.id }}" class="section-{{ section.id }}-padding w-full relative overflow-hidden flex flex-col justify-center items-center text-center">
  <div class="max-w-3xl mx-auto w-full relative z-10 px-6 flex flex-col items-center">
    
    {%- if section.settings.badge != blank -%}
      <span class="reveal block text-[10px] md:text-xs font-medium tracking-[0.25em] uppercase mb-6" style="color: var(--accent-color);">
        {{ section.settings.badge }}
      </span>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h1 class="reveal delay-100 font-serif fluid-title font-normal tracking-tight mb-6" style="color: var(--heading-color);">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}
    
    {%- if section.settings.subheading != blank -%}
      <p class="reveal delay-200 text-sm md:text-base font-light max-w-xl mx-auto leading-relaxed" style="color: var(--text-color);">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- if section.settings.show_scroll_icon -%}
      <div class="reveal delay-300 flex justify-center" aria-hidden="true">
        <svg class="scroll-arrow" onclick="window.scrollBy({top: window.innerHeight * 0.75, behavior: 'smooth'})" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v16m0 0l-6-6m6 6l6-6"/>
        </svg>
      </div>
    {%- endif -%}
    
  </div>
</section>

<script>
  (function() {
    function initHero(container) {
      if (!container) return;
      const elements = container.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: "0px 0px -20px 0px" });
      elements.forEach(el => observer.observe(el));
    }
    document.addEventListener('DOMContentLoaded', () => initHero(document.querySelector('#hero-{{ section.id }}')));
    document.addEventListener('shopify:section:load', (e) => { if (e.detail.sectionId === '{{ section.id }}') initHero(e.target); });
  })();
</script>

{% schema %}
{
  "name": "How It Works - Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge Text", "default": "The Experience" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "How The VisualBook <em>Works</em>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover the elegant simplicity of bringing your most cherished memories to life in our signature formats." },
    { "type": "checkbox", "id": "show_scroll_icon", "label": "Show scroll icon", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#c4b09e" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1c1c1c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#595959" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top Padding", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom Padding", "default": 60 }
  ],
  "presets": [{ "name": "How It Works - Hero" }]
}
{% endschema %}