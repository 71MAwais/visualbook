{% comment %} sections/product-interactive-guide.liquid {% endcomment %}
<style>
    #interactive-guide-{{ section.id }} { 
        font-family: var(--font-sans, 'Inter', sans-serif);
        background-color: {{ section.settings.bg_color }};
    }
    #interactive-guide-{{ section.id }} .font-serif { 
        font-family: var(--font-display, 'Cormorant Garamond', serif);
    }

    /* Media Container Styles */
    .guide-media-wrapper {
        position: relative;
        width: 100%;
        border-radius: 20px;
        overflow: hidden;
        background: #f3f3f3;
        box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1);
        aspect-ratio: 4/3;
    }
    
    @media (min-width: 768px) {
        .guide-media-wrapper {
            aspect-ratio: 1/1; /* Square on desktop for a bolder look */
        }
    }

    .guide-media-item {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transform: scale(1.05);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
    }

    .guide-media-item.active {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
        z-index: 2;
    }

    .guide-media-item video, 
    .guide-media-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Interactive Steps (Tabs) Styles */
    .guide-steps-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .guide-step-btn {
        text-align: left;
        background: transparent;
        border: 2px solid transparent;
        border-radius: 16px;
        padding: 24px;
        cursor: pointer;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }
    
    .guide-step-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: #fff;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: -1;
        border-radius: 14px;
    }

    .guide-step-btn:hover::before {
        opacity: 0.5;
    }

    .guide-step-btn.active {
        border-color: rgba(0,0,0,0.1);
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
    }
    
    .guide-step-btn.active::before {
        opacity: 1;
    }

    .step-number {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
        color: #888;
        margin-bottom: 8px;
        display: block;
        transition: color 0.3s ease;
    }

    .guide-step-btn.active .step-number {
        color: #181615;
    }

    .step-title {
        font-size: 24px;
        color: #888;
        transition: color 0.3s ease;
        margin: 0;
    }

    .guide-step-btn.active .step-title {
        color: #181615;
    }

    .step-content {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        color: #555;
        font-size: 16px;
        line-height: 1.6;
    }

    .guide-step-btn.active .step-content {
        max-height: 200px; /* Arbitrary large height to allow content expansion */
        opacity: 1;
        margin-top: 12px;
    }
</style>

<section id="interactive-guide-{{ section.id }}" class="w-full py-16 md:py-24 relative px-4 md:px-6">
    
    {% comment %} SECTION HEADER {% endcomment %}
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16">
            {% if section.settings.heading != blank %}
                <h2 class="font-serif text-[32px] md:text-[42px] lg:text-[48px] text-[#111] leading-tight mb-4">
                    {{ section.settings.heading | escape }}
                </h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <p class="font-sans text-[15px] md:text-[18px] text-gray-500 leading-relaxed max-w-2xl mx-auto">
                    {{ section.settings.subheading | escape }}
                </p>
            {% endif %}
        </div>
    {% endif %}

    {% comment %} SPLIT SCREEN LAYOUT {% endcomment %}
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
        
        {% comment %} LEFT: MEDIA DISPLAY {% endcomment %}
        <div class="w-full lg:w-1/2">
            <div class="guide-media-wrapper">
                {% for block in section.blocks %}
                    <div id="media-{{ block.id }}" class="guide-media-item {% if forloop.first %}active{% endif %}">
                        {% if block.settings.video != blank %}
                            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'guide-video' }}
                        {% elsif block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                        {% else %}
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-30' }}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {% comment %} RIGHT: INTERACTIVE TABS / ACCORDION {% endcomment %}
        <div class="w-full lg:w-1/2">
            <div class="guide-steps-container">
                {% for block in section.blocks %}
                    <button type="button" 
                            class="guide-step-btn {% if forloop.first %}active{% endif %}" 
                            data-target="media-{{ block.id }}"
                            {{ block.shopify_attributes }}>
                        <span class="step-number">Step {{ forloop.index }}</span>
                        <h3 class="step-title font-serif">{{ block.settings.title | escape }}</h3>
                        
                        <div class="step-content">
                            {{ block.settings.text }}
                        </div>
                    </button>
                {% endfor %}
            </div>
        </div>

    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('interactive-guide-{{ section.id }}');
    if (!sectionContainer) return;

    const stepButtons = sectionContainer.querySelectorAll('.guide-step-btn');
    const mediaItems = sectionContainer.querySelectorAll('.guide-media-item');

    stepButtons.forEach(button => {
        button.addEventListener('click', function() {
            // 1. Remove active class from all buttons
            stepButtons.forEach(btn => btn.classList.remove('active'));
            // 2. Add active class to clicked button
            this.classList.add('active');

            // 3. Handle Media Switching
            const targetId = this.getAttribute('data-target');
            
            mediaItems.forEach(item => {
                // Remove active class to hide
                item.classList.remove('active');
                
                // Pause video if it exists inside the inactive item
                const video = item.querySelector('video');
                if (video && item.id !== targetId) {
                    video.pause();
                }

                // Show target item and play its video
                if (item.id === targetId) {
                    item.classList.add('active');
                    if (video) {
                        video.currentTime = 0; // Optional: restart video from beginning
                        let playPromise = video.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(error => console.warn("Browser auto-play prevented.", error));
                        }
                    }
                }
            });
        });
    });
});
</script>

{% schema %}
{
  "name": "Product Walkthrough",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know to get started with your visualbook in seconds."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Instruction Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Unbox & Play"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Simply open the cover and your memories begin playing instantly. No apps, no Wi-Fi, no hassle.</p>"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (Recommended)",
          "info": "Upload a short, silent looping video showing this step."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image",
          "info": "Displays if no video is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Walkthrough Guide",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Unbox and Play Experience",
            "text": "<p>Simply open the elegant linen cover and your video comes to life instantly on the crisp HD screen.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Internal Button Controls",
            "text": "<p>Navigate your memories easily. Use the intuitive buttons below the screen to play, pause, adjust volume, or skip to your favorite chapters.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Plug & Play Data Upload",
            "text": "<p>Connect the included USB cable to your computer. Drag and drop your favorite videos directly into the book's folder—just like a flash drive.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}