{%- comment -%} Determine current search types for tabs {%- endcomment -%}
{%- assign current_type = 'all' -%}
{%- if search.types.size == 1 -%}
  {%- if search.types contains 'product' -%}{%- assign current_type = 'product' -%}{%- endif -%}
  {%- if search.types contains 'article' -%}{%- assign current_type = 'article' -%}{%- endif -%}
  {%- if search.types contains 'page' -%}{%- assign current_type = 'page' -%}{%- endif -%}
{%- endif -%}

<div class="bg-white min-h-[85vh] text-[#1a1a1a] antialiased">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 py-20 md:py-28">
    
    {%- comment -%} Search Header & Input {%- endcomment -%}
    <div class="text-center max-w-4xl mx-auto mb-12">
      <h1 class="text-4xl md:text-5xl font-serif mb-12 text-[#1a1a1a]">
        {%- if search.performed -%}
          Search Results
        {%- else -%}
          What are you looking for?
        {%- endif -%}
      </h1>
      
      <form action="{{ routes.search_url }}" method="get" role="search" id="MainSearchForm" class="relative flex items-center border-b border-[#eaeaea] focus-within:border-[#1a1a1a] transition-colors duration-500 pb-4 group">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="type" id="SearchTypeInput" value="{% if current_type == 'all' %}product,page,article{% else %}{{ current_type }}{% endif %}">
        
        <input
          class="w-full bg-transparent border-none outline-none focus:ring-0 text-xl md:text-3xl font-light placeholder-[#a39d93] text-[#1a1a1a] px-2 [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
          id="SearchInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search products, collections, or articles..."
          autocomplete="off"
        >
        
        <div class="absolute right-2 top-1/2 transform -translate-y-1/2 flex items-center gap-4">
          <button type="button" id="ClearSearchBtn" class="text-[#a39d93] hover:text-[#1a1a1a] transition-colors {% if search.terms == blank %}hidden{% endif %}" aria-label="Clear search">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
          
          <button type="submit" class="text-[#1a1a1a] hover:text-[#c4b09e] transition-colors" aria-label="Submit search">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </div>
      </form>

      {%- comment -%} Pre-Suggestions / Popular Searches {%- endcomment -%}
      {%- if section.settings.popular_searches != blank -%}
        <div id="SearchSuggestions" class="mt-10 transition-opacity duration-300 {% if search.performed and search.results_count > 0 %}hidden{% endif %}">
          <p class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#737373] mb-5">Suggested Searches</p>
          <div class="flex flex-wrap justify-center gap-3">
            {% assign suggestions = section.settings.popular_searches | split: ',' %}
            {% for suggestion in suggestions %}
              <button type="button" class="suggestion-btn px-5 py-2 rounded-full border border-[#eaeaea] text-[13px] text-[#1a1a1a] hover:border-[#1a1a1a] hover:bg-[#fafafa] transition-all duration-300">
                {{ suggestion | strip }}
              </button>
            {% endfor %}
          </div>
        </div>
      {%- endif -%}

      {%- if search.performed -%}
        <p class="text-[11px] text-[#737373] mt-8 tracking-[0.2em] uppercase font-semibold" role="status">
          {%- if search.results_count == 0 -%}
            No results found for "{{ search.terms }}". Try a suggestion above.
          {%- else -%}
            Showing {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} Tabbed Navigation for Object Types {%- endcomment -%}
    {%- if search.performed and search.results_count > 0 or current_type != 'all' -%}
      <div class="flex flex-wrap justify-center gap-6 md:gap-10 border-b border-[#eaeaea] mb-12">
        <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type=product,page,article" class="pb-3 text-sm font-medium tracking-wide uppercase transition-colors {% if current_type == 'all' %}text-[#1a1a1a] border-b-2 border-[#1a1a1a]{% else %}text-[#a39d93] hover:text-[#1a1a1a] border-b-2 border-transparent{% endif %}">
          All Results
        </a>
        <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type=product" class="pb-3 text-sm font-medium tracking-wide uppercase transition-colors {% if current_type == 'product' %}text-[#1a1a1a] border-b-2 border-[#1a1a1a]{% else %}text-[#a39d93] hover:text-[#1a1a1a] border-b-2 border-transparent{% endif %}">
          Products
        </a>
        <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type=article" class="pb-3 text-sm font-medium tracking-wide uppercase transition-colors {% if current_type == 'article' %}text-[#1a1a1a] border-b-2 border-[#1a1a1a]{% else %}text-[#a39d93] hover:text-[#1a1a1a] border-b-2 border-transparent{% endif %}">
          Journal
        </a>
        <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type=page" class="pb-3 text-sm font-medium tracking-wide uppercase transition-colors {% if current_type == 'page' %}text-[#1a1a1a] border-b-2 border-[#1a1a1a]{% else %}text-[#a39d93] hover:text-[#1a1a1a] border-b-2 border-transparent{% endif %}">
          Pages
        </a>
      </div>
    {%- endif -%}

    {%- if search.performed and search.results_count > 0 -%}
      
      {%- comment -%} Filter Bar (Only show if viewing All or Products) {%- endcomment -%}
      {%- if section.settings.enable_filtering and search.filters != empty and current_type != 'article' and current_type != 'page' -%}
        <form id="SearchFiltersForm" class="mb-12 border-b border-[#eaeaea] pb-6 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="type" value="{{ current_type }}">
          <input type="hidden" name="options[prefix]" value="last">

          <div class="flex flex-wrap items-center gap-6">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-[#1a1a1a]">Filter By:</span>
            
            {%- for filter in search.filters -%}
              <details class="group relative z-20 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center gap-2 text-sm text-[#737373] hover:text-[#1a1a1a] cursor-pointer transition-colors list-none">
                  {{ filter.label }}
                  <svg class="w-3 h-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                
                <div class="absolute top-full left-0 mt-4 w-64 bg-white border border-[#eaeaea] shadow-2xl p-6 rounded-sm">
                  <div class="flex justify-between items-center border-b border-[#eaeaea] pb-3 mb-4">
                    <span class="text-xs font-semibold">{{ filter.active_values.size }} selected</span>
                    <a href="{{ filter.url_to_remove }}" class="text-[10px] uppercase tracking-wider text-[#c4b09e] hover:text-[#1a1a1a] underline">Reset</a>
                  </div>

                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      <ul class="space-y-3 max-h-60 overflow-y-auto pr-2">
                        {%- for value in filter.values -%}
                          <li class="flex items-center gap-3">
                            <input type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              id="Filter-{{ filter.label }}-{{ forloop.index }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              class="w-4 h-4 text-[#1a1a1a] border-[#eaeaea] rounded-sm focus:ring-[#1a1a1a] cursor-pointer accent-[#1a1a1a]"
                              onchange="document.getElementById('SearchFiltersForm').submit();"
                            >
                            <label for="Filter-{{ filter.label }}-{{ forloop.index }}" class="text-sm cursor-pointer {% if value.count == 0 and value.active == false %}text-[#d1d1d1]{% else %}text-[#1a1a1a]{% endif %}">
                              {{ value.label | escape }} <span class="text-[11px] text-[#a39d93]">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- when 'price_range' -%}
                      <div class="flex items-center gap-4">
                        <div class="flex flex-col">
                          <label class="text-[10px] uppercase text-[#737373] mb-1">Min ({{ cart.currency.symbol }})</label>
                          <input name="{{ filter.min_value.param_name }}" id="Filter-{{ filter.label }}-min" type="number" placeholder="0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" class="w-full border border-[#eaeaea] p-2 text-sm focus:outline-none focus:border-[#1a1a1a]">
                        </div>
                        <span class="mt-4 text-[#737373]">-</span>
                        <div class="flex flex-col">
                          <label class="text-[10px] uppercase text-[#737373] mb-1">Max ({{ cart.currency.symbol }})</label>
                          <input name="{{ filter.max_value.param_name }}" id="Filter-{{ filter.label }}-max" type="number" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" class="w-full border border-[#eaeaea] p-2 text-sm focus:outline-none focus:border-[#1a1a1a]">
                        </div>
                      </div>
                      <button type="submit" class="mt-6 w-full bg-[#1a1a1a] text-white text-[10px] uppercase tracking-widest py-3 hover:bg-[#333] transition-colors">Apply</button>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
          
          {%- comment -%} Active Filter Pills {%- endcomment -%}
          <div class="flex flex-wrap items-center gap-2">
            {%- for filter in search.filters -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#fafafa] border border-[#eaeaea] text-[11px] font-medium tracking-wide text-[#1a1a1a] hover:border-[#1a1a1a] transition-colors rounded-sm">
                  {{ value.label | escape }}
                  <svg viewBox="0 0 14 14" width="10" height="10" stroke="currentColor" stroke-width="1.5" fill="none"><line x1="10" y1="4" x2="4" y2="10"></line><line x1="4" y1="4" x2="10" y2="10"></line></svg>
                </a>
              {%- endfor -%}
              {%- if filter.type == "price_range" -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  <a href="{{ filter.url_to_remove }}" class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#fafafa] border border-[#eaeaea] text-[11px] font-medium tracking-wide text-[#1a1a1a] hover:border-[#1a1a1a] transition-colors rounded-sm">
                    {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%} - 
                    {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                    <svg viewBox="0 0 14 14" width="10" height="10" stroke="currentColor" stroke-width="1.5" fill="none"><line x1="10" y1="4" x2="4" y2="10"></line><line x1="4" y1="4" x2="10" y2="10"></line></svg>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            
            {%- assign has_active_filters = false -%}
            {%- for filter in search.filters -%}
              {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
                {%- assign has_active_filters = true -%}
              {%- endif -%}
            {%- endfor -%}
            
            {%- if has_active_filters -%}
              <a href="{{ routes.search_url }}?q={{ search.terms | escape }}&type={{ current_type }}&options%5Bprefix%5D=last" class="inline-flex items-center text-[11px] font-semibold tracking-wide uppercase text-[#c4b09e] hover:text-[#1a1a1a] ml-2 py-1 transition-colors">
                Clear filters
              </a>
            {%- endif -%}
          </div>
        </form>
      {%- endif -%}

      {%- comment -%} Results Grid {%- endcomment -%}
      {% paginate search.results by section.settings.results_per_page %}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 lg:gap-12">
          {%- for item in search.results -%}
            
            {%- if item.object_type == 'product' -%}
              <div class="group relative flex flex-col">
                <a href="{{ item.url }}" class="block aspect-[4/5] overflow-hidden bg-[#fafafa] mb-6 relative border border-transparent hover:border-[#eaeaea] transition-colors">
                  {%- if item.featured_media -%}
                    {{ item.featured_media | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105', loading: 'lazy' }}
                  {%- else -%}
                    <div class="w-full h-full flex items-center justify-center text-[#c4b09e] text-xs tracking-widest uppercase">No Image</div>
                  {%- endif -%}
                  
                  {%- if item.compare_at_price > item.price -%}
                    <div class="absolute top-4 left-4 bg-white px-3 py-1.5 text-[9px] font-bold tracking-[0.2em] uppercase border border-[#eaeaea]">Sale</div>
                  {%- endif -%}
                  {%- unless item.available -%}
                    <div class="absolute top-4 left-4 bg-[#1a1a1a] text-white px-3 py-1.5 text-[9px] font-bold tracking-[0.2em] uppercase">Sold Out</div>
                  {%- endunless -%}
                </a>
                <div class="text-center">
                  <h3 class="font-serif text-lg text-[#1a1a1a] mb-2">
                    <a href="{{ item.url }}" class="hover:text-[#c4b09e] transition-colors">{{ item.title }}</a>
                  </h3>
                  <div class="text-[13px] tracking-wide text-[#737373] font-light">
                    {%- if item.price_varies -%}
                      From {{ item.price_min | money }}
                    {%- else -%}
                      {%- if item.compare_at_price > item.price -%}
                        <span class="line-through text-[#a39d93] mr-2">{{ item.compare_at_price | money }}</span>
                      {%- endif -%}
                      {{ item.price | money }}
                    {%- endif -%}
                  </div>
                </div>
              </div>

            {%- else -%}
              <div class="group relative flex flex-col bg-[#fafafa] border border-[#eaeaea] p-8 hover:border-[#c4b09e] transition-colors duration-300">
                <span class="text-[9px] font-bold tracking-[0.2em] uppercase text-[#c4b09e] mb-4">{{ item.object_type }}</span>
                <h3 class="font-serif text-2xl text-[#1a1a1a] mb-4 leading-tight">
                  <a href="{{ item.url }}" class="hover:text-[#c4b09e] transition-colors">{{ item.title }}</a>
                </h3>
                <p class="text-sm text-[#737373] font-light mb-8 leading-relaxed">
                  {{ item.content | strip_html | truncatewords: 22 }}
                </p>
                <a href="{{ item.url }}" class="text-[10px] font-semibold uppercase tracking-[0.2em] border-b border-[#1a1a1a] pb-1 self-start hover:text-[#c4b09e] hover:border-[#c4b09e] transition-colors mt-auto">
                  Read More
                </a>
              </div>
            {%- endif -%}
            
          {%- endfor -%}
        </div>

        {%- comment -%} Pagination {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          <div class="mt-24 flex justify-center items-center gap-8 border-t border-[#eaeaea] pt-12">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="text-[#1a1a1a] hover:text-[#c4b09e] uppercase tracking-[0.2em] text-[11px] font-semibold transition-colors flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Prev
              </a>
            {%- else -%}
              <span class="text-[#d1d1d1] uppercase tracking-[0.2em] text-[11px] font-semibold flex items-center gap-2 cursor-not-allowed">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Prev
              </span>
            {%- endif -%}
            
            <span class="text-[#737373] text-[11px] uppercase tracking-widest font-medium">
              Page {{ paginate.current_page }} of {{ paginate.pages }}
            </span>
            
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="text-[#1a1a1a] hover:text-[#c4b09e] uppercase tracking-[0.2em] text-[11px] font-semibold transition-colors flex items-center gap-2">
                Next
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- else -%}
              <span class="text-[#d1d1d1] uppercase tracking-[0.2em] text-[11px] font-semibold flex items-center gap-2 cursor-not-allowed">
                Next
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        
      {% endpaginate %}
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('SearchInput');
    const clearBtn = document.getElementById('ClearSearchBtn');
    const suggestionBtns = document.querySelectorAll('.suggestion-btn');
    const searchForm = document.getElementById('MainSearchForm');
    const suggestionsDiv = document.getElementById('SearchSuggestions');

    // Toggle clear button visibility based on input
    searchInput.addEventListener('input', function() {
      if (this.value.trim().length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    });

    // Clear search input and drop back to empty state
    clearBtn.addEventListener('click', function(e) {
      e.preventDefault();
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      searchInput.focus();
      
      // If we are currently on a results page, don't auto-submit an empty query, 
      // just let the user type a new one or click a suggestion.
      if(suggestionsDiv) {
        suggestionsDiv.classList.remove('hidden');
      }
    });

    // Handle clicking on a suggestion pill
    suggestionBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        searchInput.value = this.innerText.trim();
        searchForm.submit();
      });
    });
  });
</script>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Results per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering (Products only)",
      "info": "Customize filters in Shopify's 'Search & Discovery' app.",
      "default": true
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Popular Searches (Suggestions)",
      "info": "Comma-separated list of suggested searches.",
      "default": "Classic Visual Book, Audio Greetings Card, Gift Bundles, Personalised Book"
    }
  ]
}
{% endschema %}