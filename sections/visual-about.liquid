{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  #VisualAbout-{{ section.id }} .reveal { opacity: 0; transform: translateY(40px); transition: opacity 1s ease-out, transform 1s ease-out; }
  #VisualAbout-{{ section.id }} .reveal.active { opacity: 1; transform: translateY(0); }
{%- endstyle -%}

<section id="VisualAbout-{{ section.id }}" class="section-{{ section.id }}-padding w-full overflow-hidden bg-white">
  <div class="max-w-screen-xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <div class="relative w-full overflow-hidden reveal">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '1200x' }}" alt="Founder" class="w-full h-auto object-cover" loading="lazy">
        {% else %}
          <div class="w-full bg-[#f4f4f4] aspect-[3/4] flex items-center justify-center">
            <span class="text-gray-400 text-sm tracking-widest uppercase">Founder Image</span>
          </div>
        {% endif %}
      </div>
      
      <div class="space-y-6 lg:pl-4">
        <p class="reveal transition-delay-100 text-[10px] font-semibold uppercase tracking-[0.25em] text-[#1a1a1a]">
          {{ section.settings.subheading }}
        </p>
        <h2 class="reveal transition-delay-200 text-4xl md:text-5xl font-serif text-[#1a1a1a] leading-tight">
          {{ section.settings.heading | replace: 'Forever', '<i class="font-light italic">Forever</i>' }}
        </h2>
        <div class="reveal transition-delay-300 text-base font-light text-[#737373] leading-relaxed space-y-6">
          {{ section.settings.text }}
        </div>
        
        <div class="reveal transition-delay-400 pt-6">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#1a1a1a] mb-1">{{ section.settings.author_name }}</p>
          <p class="text-[10px] tracking-[0.1em] text-[#737373] uppercase">{{ section.settings.author_title }}</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => { if(entry.isIntersecting) { entry.target.classList.add('active'); obs.unobserve(entry.target); }});
    }, { threshold: 0.15 });
    document.querySelectorAll('#VisualAbout-{{ section.id }} .reveal').forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Visual About (Story)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Feature Image" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born from Loss, Designed for Forever" },
    { "type": "richtext", "id": "text", "label": "Body Text", "default": "<p>I grew up in Lagos, Nigeria — a place bursting with colour, sound, and story. But my own story had a gap. I lost my father when I was just three years old. No letters. No recordings. Just a handful of faded photographs I would hold up to the light, trying to memorise the shape of a man I could barely remember...</p>" },
    { "type": "text", "id": "author_name", "label": "Author Name", "default": "AISHA IMAN" },
    { "type": "text", "id": "author_title", "label": "Author Title", "default": "FOUNDER & CEO" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top Padding", "default": 160 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom Padding", "default": 160 }
  ],
  "presets": [{ "name": "Visual About (Story)" }]
}
{% endschema %}