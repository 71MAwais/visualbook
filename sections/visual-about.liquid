<section class="visual-about py-16 px-4 md:px-8 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div class="relative w-full overflow-hidden rounded-sm">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.image.alt | escape }}" class="w-full h-auto object-cover" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full bg-gray-100 text-gray-400 aspect-[4/5]' }}
      {% endif %}
    </div>
    <div class="space-y-6 md:pl-8">
      <h2 class="text-4xl md:text-5xl font-serif text-gray-900">{{ section.settings.heading }}</h2>
      <div class="text-lg text-gray-600 leading-relaxed space-y-4">
        {{ section.settings.text }}
      </div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="inline-block mt-6 px-8 py-3 bg-black text-white text-sm uppercase tracking-widest hover:bg-gray-800 transition">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visual About",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Feature Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Story" },
    { "type": "richtext", "id": "text", "label": "Body Text", "default": "<p>Share the story of how The Visual Book began.</p>" },
    { "type": "text", "id": "button_label", "label": "Button Label" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "Visual About" }]
}
{% endschema %}