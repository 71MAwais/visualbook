{%- comment -%}
  Luxury Editorial About Page - Tighter, Optimized Spacing
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap');
  
  .font-serif { font-family: 'Playfair Display', serif; }
  .font-sans { font-family: 'Inter', sans-serif; }
  
  /* Smooth image reveal for luxury feel */
  .reveal-img {
    transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1), opacity 1.2s ease-out;
  }
  .reveal-img:hover {
    transform: scale(1.03);
  }
</style>

<div class="bg-[#FCFBF9] text-[#181615] antialiased font-sans overflow-hidden">
  
  {%- comment -%} 1. EDITORIAL HERO {%- endcomment -%}
  <section class="text-center pt-10 pb-8 px-6 lg:pt-16 lg:pb-10 max-w-4xl mx-auto">
    <span class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-[#B8906B] font-semibold mb-4 block">
      {{ section.settings.page_subtitle | default: 'Our Heritage' }}
    </span>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight text-[#181615] leading-[1.1] mb-5">
      {{ page.title | default: 'The Art of Preservation' }}
    </h1>
    <p class="font-sans text-sm md:text-base text-stone-500 font-light max-w-2xl mx-auto leading-relaxed">
      We believe that the moments that shape our lives deserve a permanent, beautiful home. Discover the story, the craft, and the heart behind The Visualbook.
    </p>
  </section>

  {%- comment -%} 2. THE ORIGIN (Split Layout) {%- endcomment -%}
  <section class="py-10 lg:py-16 px-6 lg:px-12 max-w-[1400px] mx-auto">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
      
      <div class="w-full lg:w-1/2 relative group overflow-hidden">
        {% if section.settings.story_image != blank %}
          {{ section.settings.story_image | image_url: width: 1200 | image_tag: class: 'w-full aspect-[4/5] object-cover reveal-img', loading: 'lazy' }}
        {% else %}
          <div class="w-full aspect-[4/5] bg-stone-200 flex items-center justify-center text-stone-400 uppercase tracking-widest text-xs">
            Origin Image
          </div>
        {% endif %}
      </div>

      <div class="w-full lg:w-1/2 max-w-xl py-4">
        <span class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold mb-4 block">The Origin</span>
        <h2 class="text-3xl lg:text-4xl font-serif leading-[1.1] mb-6 text-[#181615]">
          {{ section.settings.story_heading | default: 'Born from a longing for permanence.' }}
        </h2>
        <div class="prose text-[15px] text-stone-600 font-light leading-relaxed space-y-5">
          {{ section.settings.story_text }}
        </div>
      </div>

    </div>
  </section>

  {%- comment -%} 3. FOUNDER'S PULL QUOTE {%- endcomment -%}
  <section class="bg-[#181615] text-white py-16 lg:py-20 px-6 my-10 lg:my-16">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <svg class="w-8 h-8 text-[#B8906B] mb-6 opacity-80" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>

      <div class="text-2xl lg:text-4xl font-serif italic leading-[1.4] text-white/95 mb-8">
        {{ section.settings.letter_quote | default: '“In my home, these aren’t just books; they are the physical manifestation of our greatest joys. A tangible way to hold onto the people and moments we love.”' }}
      </div>
      
      <div class="flex flex-col items-center">
        <span class="font-serif text-xl mb-1">{{ section.settings.founder_name | default: 'Aisha Shafii Ndayako' }}</span>
        <span class="text-[10px] uppercase tracking-[0.3em] text-[#B8906B] font-bold">Founder & Creative Director</span>
      </div>

    </div>
  </section>

  {%- comment -%} 4. SUSTAINABILITY (Reverse Split Layout) {%- endcomment -%}
  <section class="py-10 lg:py-16 px-6 lg:px-12 max-w-[1400px] mx-auto">
    <div class="flex flex-col lg:flex-row-reverse items-center gap-10 lg:gap-16">
      
      <div class="w-full lg:w-1/2 relative group overflow-hidden">
        {% if section.settings.sustainability_image != blank %}
          {{ section.settings.sustainability_image | image_url: width: 1200 | image_tag: class: 'w-full aspect-[4/5] object-cover reveal-img', loading: 'lazy' }}
        {% else %}
          <div class="w-full aspect-[4/5] bg-stone-200 flex items-center justify-center text-stone-400 uppercase tracking-widest text-xs">
            Sustainability Image
          </div>
        {% endif %}
      </div>

      <div class="w-full lg:w-1/2 max-w-xl py-4">
        <span class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold mb-4 block">Our Commitment</span>
        <h2 class="text-3xl lg:text-4xl font-serif leading-[1.1] mb-6 text-[#181615]">
          {{ section.settings.sustainability_heading | default: 'Conscious Craftsmanship' }}
        </h2>
        <div class="prose text-[15px] text-stone-600 font-light leading-relaxed space-y-5">
          {{ section.settings.sustainability_text }}
        </div>
        
        {% if section.settings.sustainability_link != blank %}
          <a href="{{ section.settings.sustainability_link }}" class="inline-block mt-8 text-[10px] uppercase tracking-[0.2em] font-bold text-[#181615] border-b border-[#181615] pb-1 hover:text-[#B8906B] hover:border-[#B8906B] transition-colors duration-300">
            {{ section.settings.sustainability_link_text | default: 'Discover Our Materials' }}
          </a>
        {% endif %}
      </div>

    </div>
  </section>

  {%- comment -%} 5. CRAFTSMANSHIP GRID {%- endcomment -%}
  <section class="py-16 lg:py-24 px-6 max-w-[1400px] mx-auto border-t border-stone-200/60">
    <div class="text-center mb-12">
      <span class="text-[10px] uppercase tracking-[0.3em] text-[#B8906B] font-bold mb-3 block">The Details</span>
      <h2 class="text-3xl lg:text-4xl font-serif text-[#181615]">Engineered for Eternity</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
      {% for block in section.blocks %}
        <div class="text-center group flex flex-col items-center" {{ block.shopify_attributes }}>
          
          <div class="w-14 h-14 mb-5 flex items-center justify-center text-[#181615]">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 150 | image_tag: class: 'w-full h-full object-contain transition-transform duration-700 group-hover:scale-110', loading: 'lazy' }}
            {% else %}
              <svg class="w-8 h-8 transition-transform duration-700 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            {% endif %}
          </div>
          
          <h4 class="text-lg font-serif mb-2 text-[#181615]">{{ block.settings.title }}</h4>
          <p class="text-[14px] text-stone-500 font-light leading-relaxed max-w-[260px] mx-auto">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "About Page Content",
  "settings": [
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Page Subtitle",
      "default": "Our Heritage"
    },
    {
      "type": "header",
      "content": "Story Section"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story Heading",
      "default": "Born from a longing for permanence."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>I grew up in Nigeria, holding onto a deep longing for the memories we never had the chance to create together. Losing my father at the age of three left me with fragments—faded photographs my mother would carefully preserve, crafting an imagined past that felt real in my dreams but was physically absent.</p><p>As I grew older amidst the digital revolution, I realized we are taking more photos than ever, yet holding fewer. Thousands of our most precious milestones are trapped behind glass screens and forgotten cloud folders.</p><p>The Visualbook was born from this exact realization. I wanted to bridge the gap between digital convenience and physical permanence. We don't just create books; we create tangible heirlooms designed to ensure your legacy is never lost to a software update.</p>"
    },
    {
      "type": "header",
      "content": "Founder Letter"
    },
    {
      "type": "textarea",
      "id": "letter_quote",
      "label": "Editorial Quote",
      "default": "“In my home, these aren’t just books; they are the physical manifestation of our greatest joys. A tangible way to hold onto the people and moments we love.”"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "Aisha Shafii Ndayako"
    },
    {
      "type": "header",
      "content": "Sustainability Section"
    },
    {
      "type": "image_picker",
      "id": "sustainability_image",
      "label": "Sustainability Image"
    },
    {
      "type": "text",
      "id": "sustainability_heading",
      "label": "Sustainability Heading",
      "default": "Conscious Craftsmanship"
    },
    {
      "type": "richtext",
      "id": "sustainability_text",
      "label": "Sustainability Text",
      "default": "<p>True luxury lies in longevity. We believe that creating an heirloom means creating something that is never thrown away. Sustainability is woven deeply into the fabric of our mission.</p><p>Instead of single-use disposable boxes, we have engineered our packaging to be the product itself. The exquisite artisan linen, the reinforced binding, and the timeless aesthetic mean your Visualbook is designed to sit proudly on your coffee table for generations to come.</p>"
    },
    {
      "type": "text",
      "id": "sustainability_link_text",
      "label": "Button Text",
      "default": "Discover Our Materials"
    },
    {
      "type": "url",
      "id": "sustainability_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Upload an icon or small image (PNG or SVG recommended)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "British Design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Exquisitely conceived in the UK, marrying timeless elegance with cutting-edge technology."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page Content",
      "blocks": [
        { "type": "feature", "settings": { "title": "British Design", "text": "Exquisitely conceived in the UK, marrying timeless elegance with cutting-edge technology." } },
        { "type": "feature", "settings": { "title": "Artisan Linen", "text": "Bound in premium, sustainably sourced linen that feels as beautiful as the memories inside." } },
        { "type": "feature", "settings": { "title": "Timeless Heirloom", "text": "Engineered with precision to be passed down through generations without degrading." } },
        { "type": "feature", "settings": { "title": "Debossed Foil", "text": "Finished with luxurious metallic debossing that elevates your book into a premium work of art." } }
      ]
    }
  ]
}
{% endschema %}