{% comment %} sections/visual-cinematic.liquid {% endcomment %}
<section id="cinematic-section" class="w-full h-[300vh] relative bg-[#FAFAFA]" aria-label="Features Showcase">
    <div class="sticky top-0 w-full h-screen flex items-center justify-center overflow-hidden">
        
        <div id="cinematic-bg" class="relative w-full h-full bg-[#050505] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.2)] flex items-center justify-center origin-center transition-all duration-300 ease-out" style="transform: scale(0.85); border-radius: 32px;">
            
            <div id="cinematic-ui" class="absolute left-4 md:left-10 top-0 bottom-0 z-50 flex flex-col items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300" aria-hidden="true">
                <span class="font-sans text-[8px] md:text-[9px] tracking-[0.3em] uppercase text-white/40 mb-6" style="writing-mode: vertical-rl; transform: rotate(180deg);">Open Book</span>
                <div class="relative w-[1px] h-[150px] md:h-[250px] bg-white/10 my-4 overflow-hidden">
                    <div id="cinematic-vertical-progress" class="absolute top-0 left-0 w-full h-full bg-white origin-top shadow-[0_0_10px_rgba(255,255,255,0.8)]" style="transform: scaleY(0);"></div>
                </div>
                <span class="font-sans text-[8px] md:text-[9px] tracking-[0.3em] uppercase text-white/40 mt-6" style="writing-mode: vertical-rl; transform: rotate(180deg);">Close Book</span>
            </div>

            <div id="cinematic-indicators-ui" class="absolute bottom-8 md:bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center z-50 pointer-events-none opacity-0 transition-opacity duration-300" aria-hidden="true">
                <div class="flex items-center gap-2 md:gap-3" id="cinematic-dots">
                    </div>
                <span class="font-sans text-[8px] md:text-[9px] tracking-[0.3em] uppercase text-white/40 mt-4">Explore Features</span>
            </div>

            <div id="cinematic-gallery" class="flex w-full h-full overflow-x-auto snap-x snap-mandatory hide-scrollbar relative z-10 cursor-grab">
                </div>

            <div id="cinematic-arrows-ui" class="absolute right-6 md:right-12 bottom-12 md:bottom-16 flex gap-3 md:gap-4 z-50 opacity-0 transition-opacity duration-300">
                <button id="cinematic-prev" aria-label="Previous Feature" class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/20 flex items-center justify-center text-white bg-[#111]/40 hover:bg-white hover:text-black transition-all backdrop-blur-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button id="cinematic-next" aria-label="Next Feature" class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/20 flex items-center justify-center text-white bg-[#111]/40 hover:bg-white hover:text-black transition-all backdrop-blur-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
            
        </div>
    </div>
</section>

<div id="cinematic-data" class="hidden">
    {% for block in section.blocks %}
        <div class="cinematic-item-template w-full h-full shrink-0 snap-center relative flex items-center justify-center" data-icon="{{ block.settings.icon | escape }}">
            <div class="absolute inset-0 w-full h-full pointer-events-none">
                <img src="{{ block.settings.image | img_url: '1600x' }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover opacity-[0.40] grayscale-[50%] scale-105" draggable="false" loading="lazy"/>
                <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/40 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-[#050505]/90 via-[#050505]/30 to-transparent"></div>
            </div>
            <div class="relative z-10 w-full max-w-[1300px] px-16 md:px-32 lg:px-48 flex flex-col justify-center h-full pt-12 pointer-events-none transition-opacity duration-700">
                <div class="w-14 h-14 md:w-16 md:h-16 rounded-full border border-white/20 bg-white/5 backdrop-blur-xl flex items-center justify-center text-white mb-6 md:mb-10 shadow-2xl">
                    <i data-lucide="{{ block.settings.icon }}" class="w-6 h-6 stroke-[1.25]"></i>
                </div>
                <div class="flex flex-col gap-2 mb-4 md:mb-6">
                    <span class="font-sans text-[16px] md:text-[20px] text-[#B8906B] font-medium tracking-widest">{{ block.settings.number }}</span>
                    <h3 class="font-serif text-[42px] sm:text-[48px] md:text-[72px] lg:text-[84px] text-white leading-[1.05] tracking-tight max-w-2xl drop-shadow-md">{{ block.settings.title }}</h3>
                </div>
                <p class="font-sans text-[15px] md:text-[18px] text-white/60 font-light max-w-lg leading-relaxed">{{ block.settings.subtitle }}</p>
            </div>
        </div>
    {% endfor %}
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // --- 1. Expand/Collapse Scroll Parallax ---
    const cineSection = document.getElementById('cinematic-section');
    const cineBg = document.getElementById('cinematic-bg');
    const cineUi = document.getElementById('cinematic-ui');
    const cineInd = document.getElementById('cinematic-indicators-ui');
    const cineArr = document.getElementById('cinematic-arrows-ui');
    const cineVProg = document.getElementById('cinematic-vertical-progress');

    if (cineSection && cineBg) {
        window.addEventListener('scroll', () => {
            const rect = cineSection.getBoundingClientRect();
            const wh = window.innerHeight;
            
            let progress = 0;
            if(rect.top <= 0) progress = Math.min(1, Math.max(0, -rect.top / (rect.height - wh)));

            if (rect.top <= 0 && rect.bottom >= wh) {
                // Expanded State
                cineBg.style.transform = `scale(1)`;
                cineBg.style.borderRadius = `0px`;
                if(cineUi) cineUi.style.opacity = 1;
                if(cineInd) cineInd.style.opacity = 1;
                if(cineArr) cineArr.style.opacity = 1;
                if(cineVProg) cineVProg.style.transform = `scaleY(${progress})`;
            } else {
                // Collapsed State
                cineBg.style.transform = `scale(0.85)`;
                cineBg.style.borderRadius = `32px`;
                if(cineUi) cineUi.style.opacity = 0;
                if(cineInd) cineInd.style.opacity = 0;
                if(cineArr) cineArr.style.opacity = 0;
            }
        });
    }

    // --- 2. Infinite Looping Gallery Logic ---
    const cineGallery = document.getElementById('cinematic-gallery');
    const hiddenData = Array.from(document.querySelectorAll('.cinematic-item-template'));
    
    if (cineGallery && hiddenData.length > 0) {
        const totalOriginal = hiddenData.length;
        
        // Clone items for infinite looping (3x)
        for (let i = 0; i < 3; i++) {
            hiddenData.forEach(item => {
                const clone = item.cloneNode(true);
                clone.classList.remove('cinematic-item-template');
                cineGallery.appendChild(clone);
            });
        }
        
        // Re-initialize Lucide icons for the newly injected HTML
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // Update Dots
        const dotsContainer = document.getElementById('cinematic-dots');
        const updateCineDots = (idx) => {
            if(!dotsContainer) return;
            dotsContainer.innerHTML = '';
            for (let i = 0; i < totalOriginal; i++) {
                const isCurrent = i === idx;
                const dot = document.createElement('div');
                dot.className = `h-[2px] rounded-full transition-all duration-500 ease-out ${isCurrent ? 'w-8 md:w-10 bg-[#B8906B] shadow-[0_0_10px_rgba(184,144,107,0.8)]' : 'w-3 md:w-4 bg-white/30'}`;
                dotsContainer.appendChild(dot);
            }
        };

        function instantJumpTo(container, targetLeft) {
            container.style.scrollBehavior = 'auto';
            container.scrollLeft = targetLeft;
            setTimeout(() => container.style.scrollBehavior = 'smooth', 50); 
        }

        function smoothScrollTo(container, targetLeft) {
            container.style.scrollBehavior = 'smooth';
            container.scrollLeft = targetLeft;
        }

        // Infinite Scroll Logic
        let cineTimeout;
        cineGallery.addEventListener('scroll', () => {
            const cardWidth = cineGallery.clientWidth;
            if(cardWidth === 0) return;
            
            const scrollPosition = cineGallery.scrollLeft;
            const currentIndex = Math.round(scrollPosition / cardWidth);
            updateCineDots(currentIndex % totalOriginal);

            clearTimeout(cineTimeout);
            cineTimeout = setTimeout(() => {
                if(currentIndex < totalOriginal || currentIndex >= totalOriginal * 2) {
                    const targetIndex = (currentIndex % totalOriginal) + totalOriginal;
                    instantJumpTo(cineGallery, targetIndex * cardWidth);
                }
            }, 150);
        });

        // Initialize Carousel Position in the middle of the loop
        setTimeout(() => {
            instantJumpTo(cineGallery, cineGallery.clientWidth * totalOriginal);
            updateCineDots(0);
        }, 100);

        // Arrows Control
        const cPrev = document.getElementById('cinematic-prev');
        const cNext = document.getElementById('cinematic-next');
        if(cPrev) cPrev.addEventListener('click', () => {
            const current = Math.round(cineGallery.scrollLeft / cineGallery.clientWidth);
            smoothScrollTo(cineGallery, (current - 1) * cineGallery.clientWidth);
        });
        if(cNext) cNext.addEventListener('click', () => {
            const current = Math.round(cineGallery.scrollLeft / cineGallery.clientWidth);
            smoothScrollTo(cineGallery, (current + 1) * cineGallery.clientWidth);
        });
        
        // Desktop Drag-to-Scroll
        let isDownCine = false;
        let startXCine, scrollLeftCine;
        cineGallery.addEventListener('mousedown', (e) => {
            isDownCine = true;
            cineGallery.classList.add('cursor-grabbing');
            cineGallery.classList.remove('snap-x', 'snap-mandatory'); 
            startXCine = e.pageX - cineGallery.offsetLeft;
            scrollLeftCine = cineGallery.scrollLeft;
        });
        cineGallery.addEventListener('mouseleave', () => {
            isDownCine = false;
            cineGallery.classList.remove('cursor-grabbing');
            cineGallery.classList.add('snap-x', 'snap-mandatory');
        });
        cineGallery.addEventListener('mouseup', () => {
            isDownCine = false;
            cineGallery.classList.remove('cursor-grabbing');
            cineGallery.classList.add('snap-x', 'snap-mandatory');
        });
        cineGallery.addEventListener('mousemove', (e) => {
            if (!isDownCine) return;
            e.preventDefault();
            const x = e.pageX - cineGallery.offsetLeft;
            const walk = (x - startXCine) * 1.5;
            cineGallery.scrollLeft = scrollLeftCine - walk;
        });
    }
});
</script>

{% schema %}
{
  "name": "Cinematic Showcase",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "number", "label": "Step/Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Vivid Memory Display" },
        { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "A stunning 8-inch retina screen that brings your personalized stories to life." },
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "icon", "label": "Lucide Icon Name", "default": "aperture", "info": "Find icons at lucide.dev/icons" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cinematic Showcase",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}