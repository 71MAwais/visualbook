{% comment %} sections/visual-hero.liquid {% endcomment %}

<style>
    #visual-hero-{{ section.id }} .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }
    #visual-hero-{{ section.id }} .font-serif { font-family: 'Playfair Display', serif; }
    
    /* Play/Pause state transitions */
    .video-loaded { opacity: 1 !important; }
    .control-btn svg { transition: transform 0.2s ease; }
    .control-btn:active svg { transform: scale(0.9); }
</style>

<section id="visual-hero-{{ section.id }}" class="w-full relative h-[75vh] lg:h-[85vh] overflow-hidden bg-[#050505]">
    
    {% if section.settings.image != blank %}
        <div id="heroPlaceholder-{{ section.id }}" class="absolute inset-0 w-full h-full z-10 transition-opacity duration-1000">
            <img src="{{ section.settings.image | img_url: 'master' }}" 
                 alt="{{ section.settings.heading | escape }}" 
                 class="w-full h-full object-cover" 
                 fetchpriority="high">
        </div>
    {% endif %}

    {% if section.settings.video_url != blank %}
        <video id="heroVideo-{{ section.id }}" 
               class="absolute inset-0 w-full h-full object-cover z-0 opacity-0 transition-opacity duration-1000 ease-in-out" 
               muted 
               playsinline 
               loop 
               preload="none">
            <source data-src="{{ section.settings.video_url }}" type="video/mp4" />
        </video>
    {% endif %}
    
    <div class="absolute inset-0 bg-black/10 z-20 pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/80 via-black/20 to-transparent z-20 pointer-events-none"></div>
    
    <div class="absolute inset-x-0 bottom-0 z-30 flex items-end justify-between px-6 md:px-12 lg:px-16 pb-10 md:pb-14 w-full pointer-events-none">
        
        <div class="flex flex-col items-start text-left pointer-events-auto max-w-lg">
            {% if section.settings.heading != blank %}
                <h2 class="font-serif text-white text-[32px] md:text-[48px] lg:text-[60px] tracking-tight mb-4 leading-[1.1]">
                    {{ section.settings.heading | newline_to_br }}
                </h2>
            {% endif %}
            
            {% if section.settings.button_link != blank and section.settings.button_label != blank %}
                <a href="{{ section.settings.button_link }}" class="font-sans inline-flex items-center group bg-white text-black px-10 py-4 text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-500 hover:bg-transparent hover:text-white border border-white">
                    {{ section.settings.button_label }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                </a>
            {% endif %}
        </div>

        {% if section.settings.video_url != blank %}
            <div class="flex items-center gap-6 pointer-events-auto pb-2">
                <button id="muteBtn-{{ section.id }}" class="control-btn text-white/80 hover:text-white transition-colors focus:outline-none" aria-label="Toggle Audio">
                    <div class="icon-muted">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                    </div>
                    <div class="icon-unmuted hidden">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                    </div>
                </button>

                <button id="playBtn-{{ section.id }}" class="control-btn text-white/80 hover:text-white transition-colors focus:outline-none" aria-label="Play/Pause Video">
                    <div class="icon-pause">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                    </div>
                    <div class="icon-play hidden">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                </button>
            </div>
        {% endif %}
        
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('heroVideo-{{ section.id }}');
    const placeholder = document.getElementById('heroPlaceholder-{{ section.id }}');
    const playBtn = document.getElementById('playBtn-{{ section.id }}');
    const muteBtn = document.getElementById('muteBtn-{{ section.id }}');

    // 1. Wait for everything (images, styles, scripts) to finish loading
    window.addEventListener('load', () => {
        if(video) {
            const source = video.querySelector('source');
            if(source && source.dataset.src) {
                // 2. Inject video source only now
                source.src = source.dataset.src;
                video.load();
                
                // 3. Start playback
                video.play().then(() => {
                    // 4. Fade in video and fade out placeholder
                    video.classList.add('video-loaded');
                    if(placeholder) placeholder.style.opacity = '0';
                }).catch(err => {
                    console.log("Autoplay prevented by browser.");
                    // Show Play button icon if autoplay fails
                    toggleIcon(playBtn, '.icon-pause', '.icon-play');
                });
            }
        }
    });

    // Toggle utility
    function toggleIcon(parent, hideSelector, showSelector) {
        if(!parent) return;
        parent.querySelector(hideSelector).classList.add('hidden');
        parent.querySelector(showSelector).classList.remove('hidden');
    }

    // Play/Pause Control
    if(playBtn && video) {
        playBtn.addEventListener('click', () => {
            if(video.paused) {
                video.play();
                toggleIcon(playBtn, '.icon-play', '.icon-pause');
            } else {
                video.pause();
                toggleIcon(playBtn, '.icon-pause', '.icon-play');
            }
        });
    }

    // Mute/Unmute Control
    if(muteBtn && video) {
        muteBtn.addEventListener('click', () => {
            video.muted = !video.muted;
            if(video.muted) {
                toggleIcon(muteBtn, '.icon-unmuted', '.icon-muted');
            } else {
                toggleIcon(muteBtn, '.icon-muted', '.icon-unmuted');
            }
        });
    }
});
</script>

{% schema %}
{
  "name": "Visual Hero",
  "settings": [
    { "type": "text", "id": "video_url", "label": "Video URL (MP4)", "info": "The video will load only after the page is ready." },
    { "type": "image_picker", "id": "image", "label": "High-Quality Thumbnail", "info": "Shows instantly while video is loading." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The Signature\nCollection" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Explore" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "Visual Hero" }]
}
{% endschema %}