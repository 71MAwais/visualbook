{%- style -%}
  #support-{{ section.id }} {
    --bg-faq: {{ section.settings.bg_color_faq }};
    --bg-cta: {{ section.settings.bg_color_cta }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --fluid-heading: clamp(2rem, 4vw + 1rem, 3rem);
  }

  /* Structural styles */
  .vb-faq-section { background-color: var(--bg-faq); }
  .vb-cta-section { background-color: var(--bg-cta); }
  
  /* Text styles */
  #support-{{ section.id }} .color-heading { color: var(--heading-color); }
  #support-{{ section.id }} .color-text { color: var(--text-color); }
  #support-{{ section.id }} .color-accent { color: var(--accent-color); }
  
  #support-{{ section.id }} .fluid-title {
    font-size: var(--fluid-heading);
    line-height: 1.2;
  }

  /* Minimalist Borders */
  .faq-container { border-top: 1px solid rgba(0, 0, 0, 0.06); }
  .faq-item { border-bottom: 1px solid rgba(0, 0, 0, 0.06); }

  /* Smooth Accordion Animation using CSS Grid */
  .faq-grid { 
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.16, 1, 0.3, 1); 
  }
  .faq-grid.open { grid-template-rows: 1fr; }
  .faq-inner { overflow: hidden; }

  /* Animated Plus Icon */
  .faq-icon-wrapper { position: relative; width: 14px; height: 14px; }
  .faq-icon-line {
    position: absolute; top: 50%; left: 0; width: 100%; height: 1px;
    background-color: var(--text-color);
    transition: transform 0.4s ease, background-color 0.4s ease;
  }
  .faq-icon-line:first-child { transform: translateY(-50%); }
  .faq-icon-line:last-child { transform: translateY(-50%) rotate(90deg); }
  
  .faq-item.active .faq-icon-line { background-color: var(--accent-color); }
  .faq-item.active .faq-icon-line:last-child { transform: translateY(-50%) rotate(0deg); }

  /* Button Styling */
  .vb-btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid var(--btn-bg);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vb-btn:hover {
    background-color: transparent;
    color: var(--btn-bg);
    transform: translateY(-2px);
  }

  /* Reveal Animations */
  #support-{{ section.id }} .reveal { 
    opacity: 0; 
    transform: translateY(25px);
    transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); 
  }
  #support-{{ section.id }} .reveal.active { opacity: 1; transform: translateY(0); }
  #support-{{ section.id }} .delay-100 { transition-delay: 150ms; }
  #support-{{ section.id }} .delay-200 { transition-delay: 300ms; }
{%- endstyle -%}

<div id="support-{{ section.id }}">
  
  <section class="vb-faq-section py-24 md:py-32">
    <div class="max-w-3xl mx-auto px-6">
      
      <div class="text-center mb-16 md:mb-20">
        <span class="reveal block text-[10px] md:text-xs font-medium tracking-[0.25em] uppercase color-accent mb-4">
          {{ section.settings.faq_badge }}
        </span>
        <h2 class="reveal delay-100 font-serif fluid-title color-heading">
          {{ section.settings.faq_heading }}
        </h2>
      </div>

      <div class="faq-container">
        {%- for block in section.blocks -%}
          <div class="reveal faq-item" style="transition-delay: {{ forloop.index | times: 100 }}ms;">
            <button class="faq-btn w-full flex items-center justify-between py-6 md:py-8 text-left focus:outline-none group">
              <span class="font-serif text-lg md:text-xl color-heading group-hover:text-[color:var(--accent-color)] transition-colors duration-300">
                {{ block.settings.question }}
              </span>
              <div class="faq-icon-wrapper ml-4 flex-shrink-0">
                <span class="faq-icon-line"></span>
                <span class="faq-icon-line"></span>
              </div>
            </button>
            <div class="faq-grid">
              <div class="faq-inner">
                <p class="text-sm md:text-base color-text font-light leading-relaxed pb-8 pr-8 md:pr-12">
                  {{ block.settings.answer | newline_to_br }}
                </p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      
    </div>
  </section>

  <section class="vb-cta-section py-24 text-center px-6">
    <div class="max-w-2xl mx-auto">
      <h2 class="reveal font-serif fluid-title color-heading mb-6">{{ section.settings.cta_heading }}</h2>
      <p class="reveal delay-100 text-sm md:text-base color-text font-light leading-relaxed mb-10 max-w-lg mx-auto">
        {{ section.settings.cta_subheading }}
      </p>
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link }}" class="reveal delay-200 vb-btn inline-block px-10 py-4 text-[10px] md:text-xs font-semibold tracking-[0.2em] uppercase">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </section>

</div>

<script>
  (function() {
    function initSupport(container) {
      if (!container) return;
      
      const reveals = container.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('active');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.1, rootMargin: "0px 0px -20px 0px" });
      reveals.forEach(el => observer.observe(el));

      const faqItems = container.querySelectorAll('.faq-item');
      faqItems.forEach(item => {
        const btn = item.querySelector('.faq-btn');
        const grid = item.querySelector('.faq-grid');

        btn.addEventListener('click', () => {
          const isOpen = grid.classList.contains('open');
          
          faqItems.forEach(otherItem => {
            otherItem.classList.remove('active');
            otherItem.querySelector('.faq-grid').classList.remove('open');
          });

          if (!isOpen) {
            item.classList.add('active');
            grid.classList.add('open');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => initSupport(document.querySelector('#support-{{ section.id }}')));
    document.addEventListener('shopify:section:load', (e) => { if (e.detail.sectionId === '{{ section.id }}') initSupport(e.target); });
  })();
</script>

{% schema %}
{
  "name": "How It Works - Support",
  "settings": [
    { "type": "header", "content": "FAQ Header" },
    { "type": "text", "id": "faq_badge", "label": "Badge", "default": "Client Care" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Common Questions" },
    
    { "type": "header", "content": "Call To Action (Bottom)" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Require Personal Assistance?" },
    { "type": "textarea", "id": "cta_subheading", "label": "Subheading", "default": "Our dedicated concierge team is at your service to ensure your VisualBook is perfectly curated for your special moments." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Contact Concierge" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color_faq", "label": "FAQ Background", "default": "#ffffff" },
    { "type": "color", "id": "bg_color_cta", "label": "CTA Background", "default": "#fafafa" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#1c1c1c" },
    { "type": "color", "id": "text_color", "label": "Body Text", "default": "#595959" },
    { "type": "color", "id": "accent_color", "label": "Accent (Gold)", "default": "#c4b09e" },
    { "type": "color", "id": "btn_bg_color", "label": "Button Background", "default": "#1c1c1c" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What video formats are supported?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "The Classic VisualBook exclusively supports MP4 format with H.264 encoding. For complete peace of mind, our free online converter tool instantly optimizes any video file for flawless playback on your device." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works - Support",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "How long can the Audio Card record?", "answer": "The Audio Greetings Card can capture up to 60 seconds of high-fidelity audio. You have the freedom to re-record your message infinitely—each new recording elegantly replaces the previous one." } },
        { "type": "faq", "settings": { "question": "Does pre-loading delay shipping?", "answer": "Not at all. Our luxury pre-loading service is conducted in-house by our specialists on the day of dispatch. Simply upload your files at checkout and we handle the intricate details." } }
      ]
    }
  ]
}
{% endschema %}