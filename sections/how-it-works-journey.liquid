<script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>

<style>
  .vb-journey .bg-white { background-color: #ffffff; }
  .vb-journey .bg-offWhite { background-color: #fafafa; }
  .vb-journey .bg-stone { background-color: #f4f3f0; }
  .vb-journey .text-black { color: #1a1a1a; }
  .vb-journey .text-muted { color: #737373; }
  .vb-journey .text-gold { color: #c4b09e; }
  .vb-journey .border-custom { border: 1px solid #eaeaea; }
  .vb-journey .border-t-custom { border-top: 1px solid #eaeaea; }
  .vb-journey .line-art { fill: none; stroke: #1a1a1a; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .vb-journey .step-card:hover .line-art-container { background-color: #e8e6e1 !important; }
  .vb-journey .step-card:hover .line-art { transform: translateY(-4px) scale(1.03); }
  .vb-journey .shadow-luxury { box-shadow: 0 10px 40px -10px rgba(0,0,0,0.04); }
  .vb-journey .hover-shadow-luxury:hover { box-shadow: 0 20px 50px -10px rgba(0,0,0,0.08); }
  .vb-journey .reveal { opacity: 0; transform: translateY(30px); transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .vb-journey .reveal.active { opacity: 1; transform: translateY(0); }
  .vb-journey .delay-100 { transition-delay: 100ms; }
  .vb-journey .delay-200 { transition-delay: 200ms; }
  .vb-journey .delay-300 { transition-delay: 300ms; }
</style>

<div class="vb-journey">
  
  {%- comment -%} ================= CLASSIC VISUAL BOOK ================= {%- endcomment -%}
  <section id="classic" class="py-32 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <div class="mb-20 flex flex-col items-center text-center">
        <h2 class="reveal font-serif text-3xl md:text-4xl text-black tracking-wide font-medium mb-4">{{ section.settings.classic_heading }}</h2>
        <div class="h-px w-16 reveal delay-100" style="background-color: #c4b09e;"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
        
        {% for block in section.blocks %}
          {% if block.type == 'classic_step' %}
            <div class="reveal step-card flex flex-col cursor-default" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
              <div class="line-art-container bg-stone rounded-2xl h-56 mb-8 flex items-center justify-center p-6 transition-colors duration-500 overflow-hidden relative">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: class: 'w-full h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105', loading: 'lazy' }}
                {% elsif block.settings.custom_svg != blank %}
                  {{ block.settings.custom_svg }}
                {% endif %}
              </div>
              <span class="text-[10px] tracking-[0.2em] uppercase text-gold font-semibold mb-3 block">{{ block.settings.step_label }}</span>
              <h3 class="font-serif text-xl mb-3 text-black font-medium">{{ block.settings.title }}</h3>
              <p class="text-sm text-muted leading-relaxed font-light {% if block.settings.button_text != blank %}mb-4{% endif %}">{{ block.settings.text }}</p>
              
              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link }}" class="flex items-center gap-2 text-[11px] uppercase tracking-widest text-black font-semibold group mt-auto hover:opacity-70 transition-colors">
                  {{ block.settings.button_text }} <span class="iconify group-hover:translate-x-1 transition-transform" data-icon="mdi:arrow-right"></span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
        
      </div>
    </div>
  </section>

  {%- comment -%} ================= AUDIO GREETINGS CARD ================= {%- endcomment -%}
  <section id="audio" class="py-32 bg-offWhite border-t-custom">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <div class="mb-20 flex flex-col items-center text-center">
        <h2 class="reveal font-serif text-3xl md:text-4xl text-black tracking-wide font-medium mb-4">{{ section.settings.audio_heading }}</h2>
        <div class="h-px w-16 reveal delay-100" style="background-color: #c4b09e;"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        
        {% for block in section.blocks %}
          {% if block.type == 'audio_step' %}
            <div class="reveal step-card flex flex-col cursor-default" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
              <div class="line-art-container bg-white rounded-2xl h-64 mb-8 flex items-end justify-center p-6 border-custom shadow-luxury transition-all duration-500 overflow-hidden relative">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: class: 'w-full h-full object-contain transition-transform duration-500 group-hover:scale-105', loading: 'lazy' }}
                {% elsif block.settings.custom_svg != blank %}
                  {{ block.settings.custom_svg }}
                {% endif %}
              </div>
              <span class="text-[10px] tracking-[0.2em] uppercase text-gold font-semibold mb-3 block text-center">{{ block.settings.step_label }}</span>
              <h3 class="font-serif text-xl mb-3 text-black font-medium text-center">{{ block.settings.title }}</h3>
              <p class="text-sm text-muted leading-relaxed font-light text-center px-4">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

  {%- comment -%} ================= SMART VISUAL BOOK ================= {%- endcomment -%}
  <section id="smart" class="py-32 bg-white border-t-custom">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
      <div class="mb-16 flex flex-col items-center text-center">
        <h2 class="reveal font-serif text-3xl md:text-4xl text-black tracking-wide font-medium mb-4">{{ section.settings.smart_heading }}</h2>
        {% if section.settings.smart_badge != blank %}
          <span class="reveal delay-100 text-[10px] font-semibold tracking-[0.3em] uppercase text-muted block mb-4">{{ section.settings.smart_badge }}</span>
        {% endif %}
        <div class="h-px w-16 reveal delay-200" style="background-color: #c4b09e;"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        {% for block in section.blocks %}
          {% if block.type == 'smart_step' %}
            <div class="reveal step-card bg-offWhite p-12 flex flex-col items-center text-center rounded-2xl border-custom hover-shadow-luxury transition-shadow duration-500" style="transition-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
              <div class="h-40 w-full mb-8 flex items-center justify-center overflow-hidden">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: class: 'w-full h-full object-contain transition-transform duration-500 group-hover:scale-105', loading: 'lazy' }}
                {% elsif block.settings.custom_svg != blank %}
                  {{ block.settings.custom_svg }}
                {% endif %}
              </div>
              <h3 class="font-serif text-2xl mb-4 text-black font-medium">{{ block.settings.title }}</h3>
              <p class="text-sm text-muted leading-relaxed font-light">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

  {%- comment -%} ================= CHOOSE YOUR EXPERIENCE ================= {%- endcomment -%}
  <section class="py-32 bg-stone text-black relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[800px] h-[800px] opacity-10 rounded-full blur-3xl transform translate-x-1/3 -translate-y-1/3 pointer-events-none" style="background-color: #eaddcf;"></div>
    
    <div class="max-w-[1200px] mx-auto px-6 md:px-12 relative z-10">
      <div class="text-center mb-24">
        <span class="reveal block text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-4">{{ section.settings.tiers_subheading }}</span>
        <h2 class="reveal delay-100 font-serif text-5xl md:text-6xl text-black">
          {{ section.settings.tiers_heading_1 }} <span class="italic text-gold font-light">{{ section.settings.tiers_heading_2 }}</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        
        {% for block in section.blocks %}
          {% if block.type == 'experience_card' %}
            
            {%- comment -%} Styling logic based on card_style {%- endcomment -%}
            {% assign card_classes = "bg-white rounded-3xl p-10 border-custom transition-shadow duration-500 relative flex flex-col" %}
            {% assign button_classes = "w-full py-4 rounded text-[10px] font-semibold tracking-[0.2em] uppercase transition-colors text-center block" %}
            
            {% if block.settings.card_style == 'highlight' %}
              {% assign card_classes = card_classes | append: " transform md:-translate-y-6" %}
              {% assign button_classes = button_classes | append: " bg-[#1a1a1a] text-white hover:bg-[#333]" %}
            {% elsif block.settings.card_style == 'disabled' %}
              {% assign card_classes = card_classes | append: " shadow-luxury hover-shadow-luxury" %}
              {% assign button_classes = button_classes | append: " bg-white text-muted border border-[#eaeaea] hover:border-[#1a1a1a] hover:text-[#1a1a1a]" %}
            {% else %}
              {% assign card_classes = card_classes | append: " shadow-luxury hover-shadow-luxury" %}
              {% assign button_classes = button_classes | append: " bg-white text-black border border-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white" %}
            {% endif %}

            <div class="reveal {{ card_classes }}" style="transition-delay: {{ forloop.index0 | times: 100 }}ms; {% if block.settings.card_style == 'highlight' %}box-shadow: 0 20px 50px -10px rgba(0,0,0,0.08);{% endif %}" {{ block.shopify_attributes }}>
              
              {% if block.settings.top_badge != blank %}
                {% if block.settings.card_style == 'highlight' %}
                  <div class="absolute top-8 right-8 text-[9px] font-bold tracking-[0.2em] uppercase px-4 py-1.5 rounded-full text-gold" style="background-color: rgba(196,176,158,0.1); border: 1px solid rgba(196,176,158,0.2);">{{ block.settings.top_badge }}</div>
                {% else %}
                  <div class="absolute top-8 right-8 text-[9px] font-bold tracking-[0.2em] uppercase px-4 py-1.5 rounded-full" style="background-color: #f3f4f6; color: #6b7280;">{{ block.settings.top_badge }}</div>
                {% endif %}
              {% endif %}

              <div class="w-14 h-14 rounded-full bg-offWhite border-custom flex items-center justify-center mb-8">
                <span class="iconify text-gold text-2xl" data-icon="{{ block.settings.icon_name }}"></span>
              </div>
              <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gold mb-2 block">{{ block.settings.subtitle }}</span>
              <h3 class="font-serif text-3xl text-black mb-8">{{ block.settings.title }}</h3>
              
              <ul class="space-y-4 mb-12 flex-1">
                {% assign features = block.settings.features | newline_to_br | split: '<br />' %}
                {% for feature in features %}
                  {% assign clean_feature = feature | strip %}
                  {% if clean_feature != blank %}
                    <li class="flex items-start gap-3 text-[13px] text-muted font-light leading-relaxed">
                      <span class="iconify text-gold text-lg flex-shrink-0 mt-0.5" data-icon="mdi:check"></span> {{ clean_feature }}
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
              
              <a href="{{ block.settings.button_link }}" class="{{ button_classes }}">
                {{ block.settings.button_text }}
              </a>
            </div>

          {% endif %}
        {% endfor %}

      </div>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const revealElements = document.querySelectorAll('.vb-journey .reveal');
    const observerOptions = { root: null, threshold: 0.15, rootMargin: "0px 0px -50px 0px" };
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    revealElements.forEach(el => revealObserver.observe(el));
  });
</script>

