<section id="shop-hero-{{ section.id }}" class="pt-24 pb-16 text-center px-4 bg-[#FAFAFA]">
  <p class="text-xs tracking-[0.2em] text-gray-500 uppercase mb-4">{{ section.settings.badge }}</p>
  <h2 class="text-4xl md:text-5xl font-serif text-black mb-6">{{ section.settings.heading }}</h2>
  <p class="max-w-xl mx-auto text-gray-500 font-light leading-relaxed">
    {{ section.settings.subheading }}
  </p>
</section>

{% schema %}
{
  "name": "Shop Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Curated Essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Timeless pieces crafted with intention, designed to elevate everyday moments and preserve your most cherished memories."
    }
  ],
  "presets": [
    {
      "name": "Shop Hero"
    }
  ]
}
{% endschema %}