{% comment %} sections/visual-howitworks.liquid {% endcomment %}

<style>
    .transition-luxury { 
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); 
    }
    .hiw-tab-active {
        color: #0c0a09 !important; /* stone-950 */
        font-weight: 600 !important;
    }
    #hiw-progress {
        will-change: transform, width;
    }
    
    /* Ensure font matches the premium layout */
    #visual-howitworks-{{ section.id }} {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    #visual-howitworks-{{ section.id }} .font-serif {
        font-family: 'Playfair Display', serif;
    }
</style>

<section id="visual-howitworks-{{ section.id }}" class="w-full bg-[#FCFBF9] py-6 md:py-10 flex flex-col items-center select-none overflow-hidden border-y border-stone-100/50" aria-labelledby="hiw-title-main">
    <div class="w-full max-w-[1400px] px-5 md:px-8 flex flex-col items-center">
        
        <div class="text-center mb-4 md:mb-6">
            <h2 id="hiw-title-main" class="font-serif text-[32px] md:text-[40px] text-stone-950 tracking-tight">{{ section.settings.title }}</h2>
        </div>
        
        <div class="flex gap-6 md:gap-12 border-b border-stone-200 w-full max-w-[800px] justify-center mb-6 md:mb-8" role="tablist" id="hiw-tabs">
            <button role="tab" aria-selected="true" class="tab-btn active hiw-tab-active pb-3 text-[11px] md:text-[12px] font-sans tracking-[0.25em] uppercase transition-all duration-300 relative text-stone-500 hover:text-stone-950" data-target="tab1">
                {{ section.settings.tab_1_label }} 
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-stone-950 origin-left transition-transform duration-500 scale-x-100"></div>
            </button>
            <button role="tab" aria-selected="false" class="tab-btn pb-3 text-[11px] md:text-[12px] font-sans tracking-[0.25em] uppercase transition-all duration-300 relative text-stone-400 hover:text-stone-950" data-target="tab2">
                {{ section.settings.tab_2_label }} 
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-stone-950 origin-left transition-transform duration-500 scale-x-0"></div>
            </button>
        </div>
        
        <div id="hiw-container" class="w-full max-w-[1100px] grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center cursor-grab active:cursor-grabbing">
            
            <div class="relative w-full aspect-[4/3] bg-white overflow-hidden rounded-[2px] shadow-[0_4px_30px_rgba(0,0,0,0.03)] order-1 border border-stone-100/80">
                <img id="hiw-img" src="" loading="eager" class="absolute inset-0 w-full h-full object-cover transition-luxury opacity-0 transform scale-95" alt="Process Step">
                <div class="absolute inset-0 bg-stone-900/5 mix-blend-overlay pointer-events-none"></div>
                <div class="absolute top-5 left-5 bg-white/95 backdrop-blur-md px-3.5 py-2 text-[9px] uppercase tracking-[0.25em] font-bold text-stone-950 shadow-sm">
                    <span id="hiw-tag"></span>
                </div>
            </div>
            
            <div class="flex flex-col justify-center order-2 h-full pointer-events-none">
                <div id="hiw-text-container" class="min-h-[120px] md:min-h-[140px] flex flex-col justify-center transition-luxury opacity-0 transform translate-y-4">
                    <h3 id="hiw-title" class="font-serif text-[26px] md:text-[32px] text-stone-950 leading-[1.1] mb-2 md:mb-4 tracking-tight"></h3>
                    <p id="hiw-desc" class="font-sans text-[14px] md:text-[15px] text-stone-500 font-normal leading-relaxed pr-4 md:pr-8"></p>
                    <a id="hiw-link" href="#" class="hidden pointer-events-auto inline-block mt-4 font-sans text-[11px] font-bold tracking-widest text-stone-950 border-b border-stone-950 pb-1 hover:opacity-50 transition-opacity self-start uppercase"></a>
                </div>
                
                <div class="flex items-center w-full mt-6 md:mt-8 pointer-events-auto">
                    <div class="flex items-baseline gap-1 shrink-0 w-14">
                        <span id="hiw-current" class="font-serif text-[28px] md:text-[32px] text-stone-950 font-medium leading-none">01</span>
                        <span id="hiw-total" class="font-sans text-[11px] md:text-[12px] text-stone-400 font-bold tracking-tighter" aria-label="total steps">/00</span>
                    </div>
                    
                    <div class="flex-1 mx-4 md:mx-6 h-[1.5px] bg-stone-200 relative overflow-hidden" aria-hidden="true">
                        <div id="hiw-progress" class="absolute top-0 left-0 h-full bg-stone-950 transition-all duration-500 ease-out origin-left" style="width: 0%;"></div>
                    </div>
                    
                    <div class="flex gap-2 md:gap-3 shrink-0">
                        <button id="hiw-prev" aria-label="Previous" class="w-10 h-10 rounded-full border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all disabled:opacity-10 disabled:hover:border-stone-200">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button id="hiw-next" aria-label="Next" class="w-10 h-10 rounded-full border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all disabled:opacity-10 disabled:hover:border-stone-200">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const hiwData = { tab1: [], tab2: [] };

    {% for block in section.blocks %}
        hiwData.{{ block.settings.category }}.push({
            img: "{{ block.settings.image | image_url: width: 1000 }}",
            tag: {{ block.settings.tag | json }},
            title: {{ block.settings.title | json }},
            desc: {{ block.settings.description | json }},
            linkText: {{ block.settings.link_text | json }},
            linkUrl: {{ block.settings.link_url | json }}
        });
    {% endfor %}

    const hiwImg = document.getElementById('hiw-img');
    const hiwTextCont = document.getElementById('hiw-text-container');
    const formatNum = (num) => (num < 10 ? `0${num}` : num);
    
    if (hiwImg && hiwTextCont) {
        let hiwTab = 'tab1';
        let hiwStep = 0;

        const updateHiwUI = () => {
            const data = hiwData[hiwTab];
            if (!data || data.length === 0) return;

            const current = data[hiwStep];
            
            // Anim Out
            hiwImg.style.opacity = 0;
            hiwImg.style.transform = 'scale(0.98)';
            hiwTextCont.style.opacity = 0;
            hiwTextCont.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                hiwImg.src = current.img;
                document.getElementById('hiw-tag').textContent = current.tag;
                document.getElementById('hiw-title').textContent = current.title;
                document.getElementById('hiw-desc').textContent = current.desc;
                
                const link = document.getElementById('hiw-link');
                if(current.linkText && current.linkUrl) {
                    link.textContent = current.linkText;
                    link.href = current.linkUrl;
                    link.classList.remove('hidden');
                } else { link.classList.add('hidden'); }
                
                document.getElementById('hiw-current').textContent = formatNum(hiwStep + 1);
                document.getElementById('hiw-total').textContent = `/${formatNum(data.length)}`;
                
                const progressEl = document.getElementById('hiw-progress');
                progressEl.style.width = `${100 / data.length}%`;
                progressEl.style.transform = `translateX(${hiwStep * 100}%)`;

                document.getElementById('hiw-prev').disabled = hiwStep === 0;
                document.getElementById('hiw-next').disabled = hiwStep === data.length - 1;

                // Anim In
                hiwImg.style.opacity = 1;
                hiwImg.style.transform = 'scale(1)';
                hiwTextCont.style.opacity = 1;
                hiwTextCont.style.transform = 'translateY(0)';
            }, 300);
        };

        document.querySelectorAll('#hiw-tabs .tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('#hiw-tabs .tab-btn').forEach(b => {
                    b.classList.remove('hiw-tab-active');
                    b.querySelector('.tab-active-line').classList.replace('scale-x-100', 'scale-x-0');
                });
                const target = e.currentTarget;
                target.classList.add('hiw-tab-active');
                target.querySelector('.tab-active-line').classList.replace('scale-x-0', 'scale-x-100');
                
                hiwTab = target.dataset.target;
                hiwStep = 0; 
                updateHiwUI();
            });
        });

        document.getElementById('hiw-prev').addEventListener('click', () => { if(hiwStep > 0) { hiwStep--; updateHiwUI(); } });
        document.getElementById('hiw-next').addEventListener('click', () => { if(hiwStep < hiwData[hiwTab].length - 1) { hiwStep++; updateHiwUI(); } });

        // Touch Swipe Logic
        const hiwContainer = document.getElementById('hiw-container');
        if (hiwContainer) {
            let hiwTouchStartX = 0;
            let hiwTouchEndX = 0;
            hiwContainer.addEventListener('touchstart', (e) => hiwTouchStartX = e.changedTouches[0].screenX, {passive: true});
            hiwContainer.addEventListener('touchend', (e) => {
                hiwTouchEndX = e.changedTouches[0].screenX;
                const deltaX = hiwTouchStartX - hiwTouchEndX;
                if (deltaX > 50) { 
                    if(hiwStep < hiwData[hiwTab].length - 1) { hiwStep++; updateHiwUI(); } 
                } else if (deltaX < -50) { 
                    if(hiwStep > 0) { hiwStep--; updateHiwUI(); } 
                }
            }, {passive: true});
        }

        updateHiwUI();
    }
});
</script>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 Name", "default": "Classic Visual Book" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 Name", "default": "Audio Greetings Card" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Instruction Step",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Assign to Tab",
          "options": [
            { "value": "tab1", "label": "Tab 1" },
            { "value": "tab2", "label": "Tab 2" }
          ],
          "default": "tab1"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Step 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Connect To Your Computer" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link Text (Optional)" },
        { "type": "url", "id": "link_url", "label": "Link URL (Optional)" }
      ]
    }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}