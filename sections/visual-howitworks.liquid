{% comment %} sections/visual-howitworks.liquid {% endcomment %}
<style>
    .transition-luxury { 
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); 
    }
</style>

<section class="w-full bg-[#FAFAFA] py-12 md:py-20 flex flex-col items-center select-none overflow-hidden" aria-labelledby="hiw-title-main">
    <div class="w-full max-w-[1200px] px-4 md:px-8 flex flex-col items-center">
        
        <div class="text-center mb-8">
            <h2 id="hiw-title-main" class="font-serif text-[36px] md:text-[44px] text-black">{{ section.settings.title }}</h2>
        </div>
        
        <div class="flex gap-5 md:gap-10 border-b border-gray-200 w-full justify-center mb-8 md:mb-12" role="tablist" id="hiw-tabs">
            <button role="tab" aria-selected="true" class="tab-btn active pb-3 text-[11px] md:text-[13px] font-sans tracking-[0.2em] uppercase transition-all duration-300 relative text-black font-bold" data-target="tab1">
                {{ section.settings.tab_1_label }} <div class="tab-active-line transform scale-x-100 absolute bottom-0 left-0 w-full h-[2px] bg-black origin-left transition-transform duration-300"></div>
            </button>
            <button role="tab" aria-selected="false" class="tab-btn pb-3 text-[11px] md:text-[13px] font-sans tracking-[0.2em] uppercase transition-all duration-300 relative text-gray-500 hover:text-black" data-target="tab2">
                {{ section.settings.tab_2_label }} <div class="tab-active-line transform scale-x-0 absolute bottom-0 left-0 w-full h-[2px] bg-black origin-left transition-transform duration-300"></div>
            </button>
        </div>
        
        <div id="hiw-container" class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center cursor-grab touch-pan-y">
            
            <div class="relative w-full aspect-[4/3] md:aspect-square bg-white overflow-hidden rounded-[4px] shadow-[0_4px_20px_rgba(0,0,0,0.03)] order-1 lg:order-1 border border-gray-100/50">
                <img id="hiw-img" src="" class="absolute inset-0 w-full h-full object-cover grayscale-[15%] transition-luxury opacity-0 transform scale-95 pointer-events-none" alt="Process Step Image">
                <div class="absolute inset-0 bg-black/5 mix-blend-overlay pointer-events-none"></div>
                <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-md px-3 py-1.5 text-[9px] uppercase tracking-widest font-semibold text-black shadow-sm rounded-sm">
                    <span id="hiw-tag"></span>
                </div>
            </div>
            
            <div class="flex flex-col justify-center order-2 lg:order-2 h-full pointer-events-none">
                <div id="hiw-text-container" class="min-h-[160px] md:min-h-[200px] flex flex-col justify-center transition-luxury opacity-0 transform translate-y-4">
                    <h3 id="hiw-title" class="font-serif text-[28px] md:text-[36px] text-black leading-tight mb-4 tracking-wide"></h3>
                    <p id="hiw-desc" class="font-sans text-[15px] md:text-[16px] text-gray-500 font-light leading-relaxed whitespace-pre-line pr-4 md:pr-0"></p>
                    <a id="hiw-link" href="#" class="hidden pointer-events-auto inline-block mt-5 font-sans text-[13px] font-medium tracking-wide text-[#B8906B] border-b border-[#B8906B] pb-0.5 hover:opacity-60 transition-opacity self-start"></a>
                </div>
                
                <div class="flex items-center w-full mt-5 md:mt-8 pointer-events-auto">
                    <div class="flex items-baseline gap-2 shrink-0 w-16">
                        <span id="hiw-current" class="font-serif text-[28px] md:text-[34px] text-black font-medium leading-none tracking-wide">01</span>
                        <span id="hiw-total" class="font-sans text-[12px] md:text-[14px] text-gray-400 font-medium tracking-widest pb-1" aria-label="of total steps">/ 00</span>
                    </div>
                    
                    <div class="flex-1 mx-4 md:mx-6 h-[1px] bg-gray-200 relative overflow-hidden" aria-hidden="true">
                        <div id="hiw-progress" class="absolute top-0 left-0 h-full bg-[#B8906B] transition-all duration-500 ease-out origin-left"></div>
                    </div>
                    
                    <div class="flex gap-3 shrink-0">
                        <button id="hiw-prev" aria-label="Previous Step" class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:text-black hover:border-black transition-all duration-300 disabled:opacity-20 disabled:hover:border-gray-200 disabled:hover:text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button id="hiw-next" aria-label="Next Step" class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:text-black hover:border-black transition-all duration-300 disabled:opacity-20 disabled:hover:border-gray-200 disabled:hover:text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Build Data Object from Shopify Liquid Blocks
    const hiwData = {
        tab1: [],
        tab2: []
    };

    {% for block in section.blocks %}
        var blockData = {
            img: "{{ block.settings.image | img_url: '1000x' }}",
            tag: {{ block.settings.tag | json }},
            title: {{ block.settings.title | json }},
            desc: {{ block.settings.description | json }},
            linkText: {{ block.settings.link_text | json }},
            linkUrl: {{ block.settings.link_url | json }}
        };
        {% if block.settings.category == 'tab1' %}
            hiwData.tab1.push(blockData);
        {% elsif block.settings.category == 'tab2' %}
            hiwData.tab2.push(blockData);
        {% endif %}
    {% endfor %}

    // 2. Initialize Logic
    const hiwImg = document.getElementById('hiw-img');
    const hiwTextCont = document.getElementById('hiw-text-container');
    const formatNum = (num) => (num < 10 ? `0${num}` : num);
    
    if (hiwImg && hiwTextCont) {
        let hiwTab = 'tab1';
        let hiwStep = 0;

        const updateHiwUI = () => {
            const data = hiwData[hiwTab];
            
            // Handle empty states gracefully
            if (!data || data.length === 0) {
                hiwImg.style.opacity = 0;
                hiwTextCont.style.opacity = 0;
                document.getElementById('hiw-total').textContent = `/ 00`;
                return;
            }

            const current = data[hiwStep];
            
            // Fade out
            hiwImg.style.opacity = 0;
            hiwImg.style.transform = 'scale(0.98)';
            hiwTextCont.style.opacity = 0;
            hiwTextCont.style.transform = 'translateY(16px)';
            
            setTimeout(() => {
                // Swap content
                hiwImg.src = current.img;
                document.getElementById('hiw-tag').textContent = current.tag;
                document.getElementById('hiw-title').textContent = current.title;
                document.getElementById('hiw-desc').textContent = current.desc;
                
                const link = document.getElementById('hiw-link');
                if(current.linkText && current.linkUrl) {
                    link.textContent = current.linkText;
                    link.href = current.linkUrl;
                    link.classList.remove('hidden');
                } else {
                    link.classList.add('hidden');
                }
                
                // Update Progress and Counters
                document.getElementById('hiw-current').textContent = formatNum(hiwStep + 1);
                document.getElementById('hiw-total').textContent = `/ ${formatNum(data.length)}`;
                
                const progressWidth = 100 / data.length;
                const progressEl = document.getElementById('hiw-progress');
                if(progressEl) {
                    progressEl.style.width = `${progressWidth}%`;
                    progressEl.style.transform = `translateX(${hiwStep * 100}%)`;
                }

                // Update Buttons
                document.getElementById('hiw-prev').disabled = hiwStep === 0;
                document.getElementById('hiw-next').disabled = hiwStep === data.length - 1;

                // Fade in
                hiwImg.style.opacity = 1;
                hiwImg.style.transform = 'scale(1)';
                hiwTextCont.style.opacity = 1;
                hiwTextCont.style.transform = 'translateY(0)';
            }, 400);
        };

        // Tab Switching
        document.querySelectorAll('#hiw-tabs .tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                // UI Reset
                document.querySelectorAll('#hiw-tabs .tab-btn').forEach(b => {
                    b.classList.remove('active', 'text-black', 'font-bold');
                    b.classList.add('text-gray-500', 'hover:text-black');
                    b.setAttribute('aria-selected', 'false');
                    const line = b.querySelector('.tab-active-line');
                    if (line) line.classList.replace('scale-x-100', 'scale-x-0');
                });
                
                // Active UI Set
                const target = e.currentTarget;
                target.classList.add('active', 'text-black', 'font-bold');
                target.classList.remove('text-gray-500', 'hover:text-black');
                target.setAttribute('aria-selected', 'true');
                const line = target.querySelector('.tab-active-line');
                if (line) line.classList.replace('scale-x-0', 'scale-x-100');
                
                // Change Data
                hiwTab = target.dataset.target;
                hiwStep = 0; 
                updateHiwUI();
            });
        });

        // Arrow Controls
        document.getElementById('hiw-prev').addEventListener('click', () => { 
            if(hiwStep > 0) { hiwStep--; updateHiwUI(); } 
        });
        document.getElementById('hiw-next').addEventListener('click', () => { 
            if(hiwStep < hiwData[hiwTab].length - 1) { hiwStep++; updateHiwUI(); } 
        });
        
        // Touch Swipe Logic
        const hiwContainer = document.getElementById('hiw-container');
        if (hiwContainer) {
            let hiwTouchStartX = 0;
            let hiwTouchEndX = 0;
            hiwContainer.addEventListener('touchstart', (e) => hiwTouchStartX = e.changedTouches[0].screenX, {passive: true});
            hiwContainer.addEventListener('touchend', (e) => {
                hiwTouchEndX = e.changedTouches[0].screenX;
                const deltaX = hiwTouchStartX - hiwTouchEndX;
                if (deltaX > 50) { 
                    if(hiwStep < hiwData[hiwTab].length - 1) { hiwStep++; updateHiwUI(); } 
                } else if (deltaX < -50) { 
                    if(hiwStep > 0) { hiwStep--; updateHiwUI(); } 
                }
            }, {passive: true});
        }
        
        // Initial Render
        updateHiwUI();
    }
});
</script>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 Name", "default": "Classic Visual Book" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 Name", "default": "Audio Greetings Card" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Instruction Step",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Assign to Tab",
          "options": [
            { "value": "tab1", "label": "Tab 1" },
            { "value": "tab2", "label": "Tab 2" }
          ],
          "default": "tab1"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Step 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Connect To Your Computer" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link Text (Optional)" },
        { "type": "url", "id": "link_url", "label": "Link URL (Optional)" }
      ]
    }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}