{% comment %} sections/visual-howitworks.liquid {% endcomment %}

<style>
    .transition-luxury { 
        transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1); 
    }
    .hiw-tab-active {
        color: #0c0a09 !important; /* stone-950 */
        font-weight: 600 !important;
    }
    #visual-howitworks-{{ section.id }} .hiw-progress {
        will-change: transform, width;
    }
    
    /* Ensure font matches the premium layout */
    #visual-howitworks-{{ section.id }} {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    #visual-howitworks-{{ section.id }} .font-serif {
        font-family: 'Playfair Display', serif;
    }

    /* SEO Optimization: Hide content visually but expose it to Google Bots and Screen Readers */
    .sr-only-seo {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }
</style>

<section id="visual-howitworks-{{ section.id }}" class="w-full bg-[#FCFBF9] py-6 md:py-10 flex flex-col items-center select-none overflow-hidden border-y border-stone-100/50" aria-labelledby="hiw-title-main">
    
    {%- comment -%} NATIVE DOM RENDER FOR SEO CRAWLERS {%- endcomment -%}
    <div class="sr-only-seo">
        {% for block in section.blocks %}
            <article>
                <h3>{{ block.settings.tag }}: {{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
                {% if block.settings.image %}
                    <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% endif %}
            </article>
        {% endfor %}
    </div>

    <div class="w-full max-w-[1400px] px-5 md:px-8 flex flex-col items-center">
        
        <div class="text-center mb-4 md:mb-6">
            <h2 id="hiw-title-main" class="font-serif text-[32px] md:text-[40px] text-stone-950 tracking-tight">{{ section.settings.title }}</h2>
        </div>
        
        <div class="flex gap-6 md:gap-12 border-b border-stone-200 w-full max-w-[800px] justify-center mb-6 md:mb-8" role="tablist" aria-label="How it works instructions">
            <button role="tab" aria-selected="true" aria-controls="hiw-panel-{{ section.id }}" class="tab-btn active hiw-tab-active pb-3 text-[11px] md:text-[12px] font-sans tracking-[0.25em] uppercase transition-all duration-300 relative text-stone-500 hover:text-stone-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950" data-target="tab1">
                {{ section.settings.tab_1_label }} 
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-stone-950 origin-left transition-transform duration-500 scale-x-100"></div>
            </button>
            <button role="tab" aria-selected="false" aria-controls="hiw-panel-{{ section.id }}" class="tab-btn pb-3 text-[11px] md:text-[12px] font-sans tracking-[0.25em] uppercase transition-all duration-300 relative text-stone-400 hover:text-stone-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950" data-target="tab2">
                {{ section.settings.tab_2_label }} 
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-stone-950 origin-left transition-transform duration-500 scale-x-0"></div>
            </button>
        </div>
        
        <div id="hiw-panel-{{ section.id }}" role="tabpanel" aria-live="polite" class="hiw-container-wrapper w-full max-w-[1100px] grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center cursor-grab active:cursor-grabbing">
            
            <div class="relative w-full aspect-[4/3] bg-[#f5f5f4] overflow-hidden rounded-[4px] shadow-[0_8px_40px_rgba(0,0,0,0.06)] order-1">
                <img src="" fetchpriority="high" class="hiw-img absolute inset-0 w-full h-full object-cover transition-luxury opacity-0 transform scale-105" alt="Process Step">
                <div class="absolute inset-0 bg-stone-900/5 mix-blend-overlay pointer-events-none"></div>
                <div class="absolute top-5 left-5 bg-white/95 backdrop-blur-md px-3.5 py-2 text-[9px] uppercase tracking-[0.25em] font-bold text-stone-950 shadow-sm rounded-sm" aria-hidden="true">
                    <span class="hiw-tag"></span>
                </div>
            </div>
            
            <div class="flex flex-col justify-center order-2 h-full pointer-events-none">
                <div class="hiw-text-container min-h-[120px] md:min-h-[140px] flex flex-col justify-center">
                    <h3 class="hiw-title transition-luxury opacity-0 transform translate-y-4 font-serif text-[26px] md:text-[32px] text-stone-950 leading-[1.1] mb-2 md:mb-4 tracking-tight"></h3>
                    <p class="hiw-desc transition-luxury opacity-0 transform translate-y-4 font-sans text-[14px] md:text-[15px] text-stone-500 font-normal leading-relaxed pr-4 md:pr-8"></p>
                    <a href="#" class="hiw-link transition-luxury opacity-0 transform translate-y-4 pointer-events-auto mt-4 font-sans text-[11px] font-bold tracking-widest text-stone-950 border-b border-stone-950 pb-1 hover:opacity-50 self-start uppercase focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950" style="display: none;"></a>
                </div>
                
                <div class="flex items-center w-full mt-6 md:mt-8 pointer-events-auto">
                    <div class="flex items-baseline gap-1 shrink-0 w-14" aria-hidden="true">
                        <span class="hiw-current font-serif text-[28px] md:text-[32px] text-stone-950 font-medium leading-none">01</span>
                        <span class="hiw-total font-sans text-[11px] md:text-[12px] text-stone-400 font-bold tracking-tighter">/00</span>
                    </div>
                    
                    <div class="flex-1 mx-4 md:mx-6 h-[1.5px] bg-stone-200 relative overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="-1">
                        <div class="hiw-progress absolute top-0 left-0 h-full bg-stone-950 transition-all duration-500 ease-out origin-left" style="width: 0%;"></div>
                    </div>
                    
                    <div class="flex gap-2 md:gap-3 shrink-0">
                        <button aria-label="Previous step" class="hiw-prev w-10 h-10 rounded-full border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all disabled:opacity-30 disabled:hover:border-stone-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <button aria-label="Next step" class="hiw-next w-10 h-10 rounded-full border border-stone-200 flex items-center justify-center text-stone-400 hover:text-stone-950 hover:border-stone-950 transition-all disabled:opacity-30 disabled:hover:border-stone-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-950">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
(function() {
    const section = document.getElementById('visual-howitworks-{{ section.id }}');
    if (!section) return;

    const hiwData = { tab1: [], tab2: [] };

    {% for block in section.blocks %}
        hiwData["{{ block.settings.category }}"].push({
            img: "{{ block.settings.image | image_url: width: 1000 }}",
            tag: {{ block.settings.tag | json }},
            title: {{ block.settings.title | json }},
            desc: {{ block.settings.description | json }},
            linkText: {{ block.settings.link_text | json }},
            linkUrl: {{ block.settings.link_url | json }}
        });
    {% endfor %}

    const hiwImg = section.querySelector('.hiw-img');
    const titleEl = section.querySelector('.hiw-title');
    const descEl = section.querySelector('.hiw-desc');
    const linkEl = section.querySelector('.hiw-link');
    const hiwPrev = section.querySelector('.hiw-prev');
    const hiwNext = section.querySelector('.hiw-next');
    const progressEl = section.querySelector('.hiw-progress');
    const progressBar = progressEl.parentElement;
    const formatNum = (num) => (num < 10 ? `0${num}` : num);
    
    if (hiwImg && titleEl) {
        let hiwTab = 'tab1';
        let hiwStep = 0;
        let isAnimating = false;

        const preloadImages = () => {
            [...hiwData.tab1, ...hiwData.tab2].forEach(step => {
                if(step.img && step.img !== '') {
                    const img = new Image();
                    img.src = step.img;
                }
            });
        };
        preloadImages();

        const updateHiwUI = () => {
            const data = hiwData[hiwTab];
            if (!data || data.length === 0) return;

            isAnimating = true;
            hiwPrev.disabled = true;
            hiwNext.disabled = true;

            const current = data[hiwStep];
            
            // Anim Out
            hiwImg.style.opacity = 0;
            hiwImg.style.transform = 'scale(1.05)';
            
            titleEl.style.opacity = 0; titleEl.style.transform = 'translateY(10px)';
            descEl.style.opacity = 0; descEl.style.transform = 'translateY(10px)';
            linkEl.style.opacity = 0; linkEl.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                // Update Content
                hiwImg.src = current.img;
                hiwImg.alt = current.title; 
                section.querySelector('.hiw-tag').textContent = current.tag;
                titleEl.textContent = current.title;
                descEl.textContent = current.desc;
                
                if (current.linkText && current.linkUrl) {
                    linkEl.textContent = current.linkText;
                    linkEl.href = current.linkUrl;
                    linkEl.style.display = 'inline-block';
                } else {
                    linkEl.textContent = '';
                    linkEl.href = '#';
                    linkEl.style.display = 'none';
                }
                
                section.querySelector('.hiw-current').textContent = formatNum(hiwStep + 1);
                section.querySelector('.hiw-total').textContent = `/${formatNum(data.length)}`;
                
                const progressPercent = ((hiwStep + 1) / data.length) * 100;
                progressEl.style.width = `${100 / data.length}%`;
                progressEl.style.transform = `translateX(${hiwStep * 100}%)`;
                progressBar.setAttribute('aria-valuenow', progressPercent);

                // Anim In (Image)
                hiwImg.style.opacity = 1;
                hiwImg.style.transform = 'scale(1)';

                // Anim In (Staggered Text Reveal)
                setTimeout(() => { titleEl.style.opacity = 1; titleEl.style.transform = 'translateY(0)'; }, 50);
                setTimeout(() => { descEl.style.opacity = 1; descEl.style.transform = 'translateY(0)'; }, 150);
                setTimeout(() => { linkEl.style.opacity = 1; linkEl.style.transform = 'translateY(0)'; }, 250);

                // Re-evaluate button states
                hiwPrev.disabled = hiwStep === 0;
                hiwNext.disabled = hiwStep === data.length - 1;
                
                isAnimating = false;
            }, 300);
        };

        section.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                if (isAnimating) return;
                
                const target = e.currentTarget;
                if(target.classList.contains('hiw-tab-active')) return;

                section.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('hiw-tab-active');
                    b.setAttribute('aria-selected', 'false');
                    b.querySelector('.tab-active-line').classList.replace('scale-x-100', 'scale-x-0');
                });
                
                target.classList.add('hiw-tab-active');
                target.setAttribute('aria-selected', 'true');
                target.querySelector('.tab-active-line').classList.replace('scale-x-0', 'scale-x-100');
                
                hiwTab = target.dataset.target;
                hiwStep = 0; 
                updateHiwUI();
            });
        });

        hiwPrev.addEventListener('click', () => { 
            if(hiwStep > 0 && !isAnimating) { hiwStep--; updateHiwUI(); } 
        });
        
        hiwNext.addEventListener('click', () => { 
            if(hiwStep < hiwData[hiwTab].length - 1 && !isAnimating) { hiwStep++; updateHiwUI(); } 
        });

        const hiwContainer = section.querySelector('.hiw-container-wrapper');
        if (hiwContainer) {
            let hiwTouchStartX = 0;
            let hiwTouchEndX = 0;
            hiwContainer.addEventListener('touchstart', (e) => hiwTouchStartX = e.changedTouches[0].screenX, {passive: true});
            hiwContainer.addEventListener('touchend', (e) => {
                if (isAnimating) return;
                hiwTouchEndX = e.changedTouches[0].screenX;
                const deltaX = hiwTouchStartX - hiwTouchEndX;
                if (deltaX > 50) { 
                    if(hiwStep < hiwData[hiwTab].length - 1) { hiwStep++; updateHiwUI(); } 
                } else if (deltaX < -50) { 
                    if(hiwStep > 0) { hiwStep--; updateHiwUI(); } 
                }
            }, {passive: true});
        }

        updateHiwUI();
    }
})();
</script>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 Name", "default": "Classic Visual Book" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 Name", "default": "Audio Greetings Card" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Instruction Step",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Assign to Tab",
          "options": [
            { "value": "tab1", "label": "Tab 1" },
            { "value": "tab2", "label": "Tab 2" }
          ],
          "default": "tab1"
        },
        { "type": "image_picker", "id": "image", "label": "Image (Use high-quality photos)" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Step 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Connect To Your Computer" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Link Text (Optional)" },
        { "type": "url", "id": "link_url", "label": "Link URL (Optional)" }
      ]
    }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}