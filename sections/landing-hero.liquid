{% comment %} sections/visual-hero.liquid {% endcomment %}

<style>
    #visual-hero-{{ section.id }} .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }
    #visual-hero-{{ section.id }} .font-serif { font-family: 'Playfair Display', serif; }
    
    /* Play/Pause/Mute state transitions */
    .video-loaded { opacity: 1 !important; }
    
    .glass-btn {
        transition: transform 0.2s ease, opacity 0.3s ease, background-color 0.2s ease;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .glass-btn:active {
        transform: scale(0.9);
    }
    .glass-btn:hover {
        background-color: rgba(0, 0, 0, 0.6);
    }
    
    /* Fade out overlay elements smoothly */
    .fade-out {
        opacity: 0 !important;
        pointer-events: none !important;
    }
</style>

<section id="visual-hero-{{ section.id }}" class="w-full relative h-[75vh] lg:h-[85vh] overflow-hidden bg-[#050505]" aria-labelledby="hero-heading-{{ section.id }}">
    
    {% comment %} PRIORITY 1: Thumbnail eager loads immediately for PageSpeed {% endcomment %}
    {% if section.settings.image != blank %}
        <div id="heroPlaceholder-{{ section.id }}" class="absolute inset-0 w-full h-full z-10 transition-opacity duration-700 pointer-events-none">
            <img src="{{ section.settings.image | img_url: 'master' }}" 
                 alt="{{ section.settings.heading | escape }}" 
                 class="w-full h-full object-cover" 
                 fetchpriority="high"
                 loading="eager">
        </div>
    {% endif %}

    {% comment %} PRIORITY 2: Video loads ONLY when within 400px (preload="none") {% endcomment %}
    {% if section.settings.video_url != blank %}
        <video id="heroVideo-{{ section.id }}" 
               class="absolute inset-0 w-full h-full object-cover z-0 opacity-0 transition-opacity duration-1000 ease-in-out" 
               muted 
               playsinline 
               loop 
               preload="none">
            <source data-src="{{ section.settings.video_url }}" type="video/mp4" />
        </video>
    {% endif %}
    
    {% comment %} Text & Overlay Wrapper {% endcomment %}
    <div id="heroOverlay-{{ section.id }}" class="absolute inset-0 z-20 transition-opacity duration-500 ease-in-out flex flex-col justify-end">
        <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none"></div>
        
        <div class="relative z-30 px-6 md:px-12 lg:px-16 pb-12 md:pb-16 w-full pointer-events-none">
            <div class="flex flex-col items-center text-center md:items-start md:text-left max-w-2xl mx-auto md:mx-0 pointer-events-auto">
                {% if section.settings.heading != blank %}
                    <h1 id="hero-heading-{{ section.id }}" class="font-serif text-white text-[32px] md:text-[48px] lg:text-[56px] tracking-tight mb-4 leading-[1.1]">
                        {{ section.settings.heading | newline_to_br }}
                    </h1>
                {% endif %}
                
                {% if section.settings.subheading != blank %}
                    <p class="font-sans text-white/90 text-[15px] md:text-[17px] leading-relaxed mb-8 shadow-sm">
                        {{ section.settings.subheading | escape }}
                    </p>
                {% endif %}
                
                {% if section.settings.button_link != blank and section.settings.button_label != blank %}
                    <a href="{{ section.settings.button_link }}" class="font-sans inline-flex items-center group bg-white text-black px-10 py-4 text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-500 hover:bg-transparent hover:text-white border border-white">
                        {{ section.settings.button_label }}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if section.settings.video_url != blank %}
        {% comment %} Center Play/Pause Control {% endcomment %}
        <div class="absolute inset-0 z-40 flex items-center justify-center pointer-events-none">
            <button id="centerPlayBtn-{{ section.id }}" 
                    class="glass-btn pointer-events-auto w-20 h-20 rounded-full flex items-center justify-center text-white focus:outline-none focus:ring-2 focus:ring-white/50 opacity-0" 
                    aria-label="Pause Video">
                <div class="icon-play ml-1 hidden">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
                <div class="icon-pause">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                </div>
            </button>
        </div>

        {% comment %} Bottom Right Volume/Mute Control {% endcomment %}
        <div class="absolute bottom-6 right-6 md:bottom-10 md:right-10 z-50 pointer-events-auto">
            <button id="muteBtn-{{ section.id }}" 
                    class="glass-btn w-12 h-12 rounded-full flex items-center justify-center text-white focus:outline-none focus:ring-2 focus:ring-white/50" 
                    aria-label="Toggle Volume">
                
                <div class="icon-muted">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                </div>
                <div class="icon-unmuted hidden">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                </div>
            </button>
        </div>
    {% endif %}
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('visual-hero-{{ section.id }}');
    const video = document.getElementById('heroVideo-{{ section.id }}');
    const placeholder = document.getElementById('heroPlaceholder-{{ section.id }}');
    const centerPlayBtn = document.getElementById('centerPlayBtn-{{ section.id }}');
    const muteBtn = document.getElementById('muteBtn-{{ section.id }}');
    const overlay = document.getElementById('heroOverlay-{{ section.id }}');

    if (!video || !section) return;

    // SVG Icon Toggler
    function toggleIcon(parent, hideSelector, showSelector) {
        if(!parent) return;
        parent.querySelector(hideSelector).classList.add('hidden');
        parent.querySelector(showSelector).classList.remove('hidden');
    }

    // Hide thumbnail smoothly when video is ready
    video.addEventListener('canplay', () => {
        video.classList.add('video-loaded');
        if(placeholder) placeholder.style.opacity = '0';
    });

    // Play/Pause UI State Manager
    function updatePlayState() {
        if (video.paused) {
            overlay.classList.remove('fade-out'); // Show text
            toggleIcon(centerPlayBtn, '.icon-pause', '.icon-play');
            centerPlayBtn.style.opacity = '1';
            centerPlayBtn.setAttribute('aria-label', 'Play Video');
        } else {
            overlay.classList.add('fade-out'); // Hide text for cinematic view
            toggleIcon(centerPlayBtn, '.icon-play', '.icon-pause');
            centerPlayBtn.setAttribute('aria-label', 'Pause Video');
            
            // Fade out pause button during playback
            setTimeout(() => { if(!video.paused) centerPlayBtn.style.opacity = '0'; }, 1000);
        }
    }

    // Show center controls on hover
    section.addEventListener('mouseenter', () => centerPlayBtn.style.opacity = '1');
    section.addEventListener('mousemove', () => centerPlayBtn.style.opacity = '1');
    section.addEventListener('mouseleave', () => {
        if (!video.paused) centerPlayBtn.style.opacity = '0';
    });

    // Play/Pause Click Handler
    if (centerPlayBtn) {
        centerPlayBtn.addEventListener('click', () => {
            video.paused ? video.play() : video.pause();
        });
    }
    video.addEventListener('play', updatePlayState);
    video.addEventListener('pause', updatePlayState);

    // Explicit Volume / Mute Handler
    if (muteBtn) {
        muteBtn.addEventListener('click', () => {
            video.muted = !video.muted;
            if (video.muted) {
                toggleIcon(muteBtn, '.icon-unmuted', '.icon-muted');
                muteBtn.setAttribute('aria-label', 'Unmute Video');
            } else {
                toggleIcon(muteBtn, '.icon-muted', '.icon-unmuted');
                muteBtn.setAttribute('aria-label', 'Mute Video');
            }
        });
    }

    // 🚀 400px Stateful/Stateless Observer
    const observerOptions = {
        root: null,
        rootMargin: '400px 0px', // Triggers exactly 400px before the section is visible
        threshold: 0
    };

    const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // WITHIN 400px -> STATEFUL: Load and play video
                const source = video.querySelector('source');
                if (source && source.dataset.src && !source.src) {
                    source.src = source.dataset.src;
                    video.load(); // Fetch video data only now
                }
                if (video.paused) {
                    let playPromise = video.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(e => { console.log("Autoplay blocked by browser policy"); });
                    }
                }
            } else {
                // OUTSIDE 400px -> STATELESS: Pause video and save resources
                if (!video.paused) {
                    video.pause();
                }
            }
        });
    }, observerOptions);
    
    sectionObserver.observe(section);
});
</script>

{% schema %}
{
  "name": "Visual Hero",
  "settings": [
    { 
      "type": "text", 
      "id": "video_url", 
      "label": "Video URL (MP4)", 
      "info": "Video loads as second priority only when scrolled near." 
    },
    { 
      "type": "image_picker", 
      "id": "image", 
      "label": "High-Quality Thumbnail", 
      "info": "Loads immediately as first priority." 
    },
    { 
      "type": "textarea", 
      "id": "heading", 
      "label": "Heading", 
      "default": "Your Memories,\nBrought to Life." 
    },
    { 
      "type": "textarea", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "The timeless elegance of a physical photo book, elevated with a stunning HD video display. No internet or setup required." 
    },
    { 
      "type": "text", 
      "id": "button_label", 
      "label": "Button Label", 
      "default": "Explore" 
    },
    { 
      "type": "url", 
      "id": "button_link", 
      "label": "Button Link" 
    }
  ],
  "presets": [{ "name": "Visual Hero" }]
}
{% endschema %}