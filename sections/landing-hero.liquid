{% comment %} sections/visual-hero.liquid {% endcomment %}

<style>
    #visual-hero-{{ section.id }} .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }
    #visual-hero-{{ section.id }} .font-serif { font-family: 'Playfair Display', serif; }
    
    /* Play/Pause/Mute state transitions */
    .video-loaded { opacity: 1 !important; }
    
    .glass-btn {
        transition: transform 0.2s ease, opacity 0.3s ease, background-color 0.2s ease;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .glass-btn:active {
        transform: scale(0.9);
    }
    .glass-btn:hover {
        background-color: rgba(0, 0, 0, 0.6);
    }
    
    /* Fade out overlay elements smoothly */
    .fade-out {
        opacity: 0 !important;
        pointer-events: none !important;
    }
</style>

{% comment %} RESTORED ORIGINAL HEIGHT: h-[75vh] and lg:h-[85vh] {% endcomment %}
<section id="visual-hero-{{ section.id }}" class="w-full relative h-[75vh] lg:h-[85vh] overflow-hidden bg-[#050505]" aria-labelledby="hero-heading-{{ section.id }}">
    
    {% comment %} PRIORITY 1: Thumbnail eager loads immediately for PageSpeed {% endcomment %}
    {% if section.settings.image != blank %}
        <div id="heroPlaceholder-{{ section.id }}" class="absolute inset-0 w-full h-full z-10 transition-opacity duration-1000 ease-in-out pointer-events-none">
            {{ section.settings.image | image_url: width: 2000 | image_tag: 
                 alt: section.settings.heading, 
                 class: 'w-full h-full object-cover', 
                 fetchpriority: 'high', 
                 loading: 'eager',
                 sizes: '100vw',
                 widths: '375, 550, 750, 1100, 1500, 2000'
            }}
        </div>
    {% endif %}

    {% comment %} PRIORITY 2: Video loads ONLY when within 400px (preload="none") {% endcomment %}
    {% if section.settings.video_url != blank %}
        <video id="heroVideo-{{ section.id }}" 
               class="absolute inset-0 w-full h-full object-cover z-0 opacity-0 transition-opacity duration-1000 ease-in-out" 
               muted 
               playsinline 
               loop 
               preload="none">
            <source data-src="{{ section.settings.video_url }}" type="video/mp4" />
        </video>
    {% endif %}
    
    {% comment %} Text & Overlay Wrapper {% endcomment %}
    <div id="heroOverlay-{{ section.id }}" class="absolute inset-0 z-20 transition-opacity duration-500 ease-in-out flex flex-col justify-end">
        <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>
        
        {% comment %} RESTORED ORIGINAL GRADIENT HEIGHT: h-1/2 {% endcomment %}
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>
        
        <div class="relative z-30 px-6 md:px-12 lg:px-16 pb-10 md:pb-14 w-full pointer-events-none">
            <div class="flex flex-col items-center text-center md:items-start md:text-left max-w-2xl mx-auto md:mx-0 pointer-events-auto">
                {% if section.settings.heading != blank %}
                    <h1 id="hero-heading-{{ section.id }}" class="font-serif text-white text-[32px] md:text-[48px] lg:text-[60px] tracking-tight mb-4 leading-[1.1] drop-shadow-md">
                        {{ section.settings.heading | newline_to_br }}
                    </h1>
                {% endif %}
                
                {% if section.settings.subheading != blank %}
                    <p class="font-sans text-white/90 text-[14px] sm:text-[15px] md:text-[17px] font-light leading-relaxed max-w-lg mb-8 md:mb-10 shadow-sm">
                        {{ section.settings.subheading | escape }}
                    </p>
                {% endif %}
                
                {% if section.settings.button_label != blank %}
                    <a href="{{ section.settings.button_link | default: '#' }}" class="font-sans inline-flex items-center justify-center group bg-white text-black px-10 py-4 text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-500 hover:bg-transparent hover:text-white border border-white shadow-xl">
                        <span>{{ section.settings.button_label }}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2 md:ml-3 transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if section.settings.video_url != blank %}
        {% comment %} Center Play/Pause/Loading Control {% endcomment %}
        <div class="absolute inset-0 z-40 flex items-center justify-center pointer-events-none">
            <button id="centerPlayBtn-{{ section.id }}" 
                    class="glass-btn pointer-events-auto w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center text-white focus:outline-none focus:ring-2 focus:ring-white/50 opacity-0" 
                    aria-label="Play Video">
                
                <div class="icon-play ml-1">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="md:w-8 md:h-8"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
                <div class="icon-pause hidden">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="md:w-7 md:h-7"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                </div>
                <div class="icon-loading hidden">
                    <svg class="animate-spin w-8 h-8 md:w-10 md:h-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </button>
        </div>

        {% comment %} Secondary CTA - Appears when playing {% endcomment %}
        {% if section.settings.button_label != blank %}
            <div id="playingCta-{{ section.id }}" class="absolute bottom-6 left-1/2 -translate-x-1/2 md:bottom-10 z-50 pointer-events-none opacity-0 transition-opacity duration-500">
                <a href="{{ section.settings.button_link | default: '#' }}" class="font-sans inline-flex items-center justify-center bg-black/40 backdrop-blur-md text-white px-6 py-2.5 md:px-8 md:py-3 text-[10px] md:text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-300 hover:bg-white hover:text-black border border-white/30 shadow-xl">
                    <span>{{ section.settings.button_label }}</span>
                </a>
            </div>
        {% endif %}

        {% comment %} Bottom Right Volume/Mute Control {% endcomment %}
        <div class="absolute bottom-6 right-6 md:bottom-10 md:right-10 z-50 pointer-events-auto">
            <button id="muteBtn-{{ section.id }}" 
                    class="glass-btn w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center text-white focus:outline-none focus:ring-2 focus:ring-white/50" 
                    aria-label="Toggle Volume">
                
                <div class="icon-muted">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-5 md:h-5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                </div>
                <div class="icon-unmuted hidden">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-5 md:h-5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                </div>
            </button>
        </div>
    {% endif %}
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('visual-hero-{{ section.id }}');
    const video = document.getElementById('heroVideo-{{ section.id }}');
    const placeholder = document.getElementById('heroPlaceholder-{{ section.id }}');
    const centerPlayBtn = document.getElementById('centerPlayBtn-{{ section.id }}');
    const muteBtn = document.getElementById('muteBtn-{{ section.id }}');
    const overlay = document.getElementById('heroOverlay-{{ section.id }}');
    const playingCta = document.getElementById('playingCta-{{ section.id }}');

    if (!video || !section) return;

    let playTimeout;

    // Updated to accept multiple selectors to hide simultaneously
    function toggleIcon(parent, hideSelectors, showSelector) {
        if(!parent) return;
        parent.querySelectorAll(hideSelectors).forEach(el => el.classList.add('hidden'));
        parent.querySelector(showSelector).classList.remove('hidden');
    }

    section.addEventListener('mouseenter', () => centerPlayBtn.style.opacity = '1');
    section.addEventListener('mousemove', () => centerPlayBtn.style.opacity = '1');
    section.addEventListener('mouseleave', () => {
        if (!video.paused) centerPlayBtn.style.opacity = '0';
    });

    if (centerPlayBtn) {
        centerPlayBtn.addEventListener('click', () => {
            if (video.paused) {
                clearTimeout(playTimeout);
                // Immediately show loading indicator when play is requested
                toggleIcon(centerPlayBtn, '.icon-play, .icon-pause', '.icon-loading');
                video.play();
            } else {
                video.pause();
            }
        });
    }

    // Event: Video is paused
    video.addEventListener('pause', () => {
        overlay.classList.remove('fade-out'); 
        
        if (playingCta) {
            playingCta.classList.add('opacity-0');
            playingCta.classList.add('pointer-events-none');
        }

        toggleIcon(centerPlayBtn, '.icon-pause, .icon-loading', '.icon-play');
        centerPlayBtn.style.opacity = '1';
        centerPlayBtn.setAttribute('aria-label', 'Play Video');
    });

    // Event: Video is actively playing frames (Loading finished)
    video.addEventListener('playing', () => {
        overlay.classList.add('fade-out'); 
        
        if (playingCta) {
            playingCta.classList.remove('opacity-0');
            playingCta.classList.remove('pointer-events-none');
        }

        toggleIcon(centerPlayBtn, '.icon-play, .icon-loading', '.icon-pause');
        centerPlayBtn.setAttribute('aria-label', 'Pause Video');
        
        setTimeout(() => { if(!video.paused) centerPlayBtn.style.opacity = '0'; }, 1000);

        // Safely reveal video and hide placeholder NOW
        video.classList.add('video-loaded');
        if(placeholder) placeholder.style.opacity = '0';
    });

    // Event: Video is buffering/waiting for data due to slow internet
    video.addEventListener('waiting', () => {
        centerPlayBtn.style.opacity = '1';
        toggleIcon(centerPlayBtn, '.icon-play, .icon-pause', '.icon-loading');
        // Do NOT hide placeholder here. The thumbnail will stay visible while buffering.
    });

    if (muteBtn) {
        muteBtn.addEventListener('click', () => {
            video.muted = !video.muted;
            if (video.muted) {
                toggleIcon(muteBtn, '.icon-unmuted', '.icon-muted');
                muteBtn.setAttribute('aria-label', 'Unmute Video');
            } else {
                toggleIcon(muteBtn, '.icon-muted', '.icon-unmuted');
                muteBtn.setAttribute('aria-label', 'Mute Video');
            }
        });
    }

    const observerOptions = {
        root: null,
        rootMargin: '400px 0px',
        threshold: 0
    };

    const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const source = video.querySelector('source');
                if (source && source.dataset.src && !source.src) {
                    source.src = source.dataset.src;
                    video.load(); 
                }

                clearTimeout(playTimeout); 

                playTimeout = setTimeout(() => {
                    if (video.paused) {
                        let playPromise = video.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(e => { console.log("Autoplay blocked by browser policy"); });
                        }
                    }
                }, 2500);

            } else {
                clearTimeout(playTimeout);
                if (!video.paused) {
                    video.pause();
                }
            }
        });
    }, observerOptions);
    
    sectionObserver.observe(section);
});
</script>

{% schema %}
{
  "name": "Visual Hero",
  "settings": [
    { 
      "type": "text", 
      "id": "video_url", 
      "label": "Video URL (MP4)", 
      "info": "Video loads as second priority only when scrolled near." 
    },
    { 
      "type": "image_picker", 
      "id": "image", 
      "label": "High-Quality Thumbnail", 
      "info": "Loads immediately as first priority." 
    },
    { 
      "type": "textarea", 
      "id": "heading", 
      "label": "Heading", 
      "default": "Your Memories,\nBrought to Life." 
    },
    { 
      "type": "textarea", 
      "id": "subheading", 
      "label": "Subheading", 
      "default": "The timeless elegance of a physical photo book, elevated with a stunning HD video display. No internet or setup required." 
    },
    { 
      "type": "text", 
      "id": "button_label", 
      "label": "Button Label", 
      "default": "Shop the Collection" 
    },
    { 
      "type": "url", 
      "id": "button_link", 
      "label": "Button Link",
      "default": "/"
    }
  ],
  "presets": [{ "name": "Visual Hero" }]
}
{% endschema %}