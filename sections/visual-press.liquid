<section class="w-full bg-[#fcfcfc] py-32 px-6 border-y border-[#f0f0f0]">
  <div class="max-w-screen-2xl mx-auto">
    <div class="text-center mb-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-[#737373] mb-4">{{ section.settings.subheading }}</p>
      <h2 class="text-4xl md:text-5xl font-serif text-[#1a1a1a] mb-4">{{ section.settings.title }}</h2>
      <div class="flex items-center justify-center space-x-1 text-black text-sm">
        ★★★★★ <span class="text-[#737373] font-light ml-2">4.9/5 — 2,400+ Reviews</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        <div class="flex flex-col p-10 bg-white border border-[#f0f0f0] shadow-sm">
          <div class="text-black text-xs mb-4">★★★★★</div>
          <h4 class="font-serif text-lg mb-3">{{ block.settings.review_title }}</h4>
          <p class="text-[#737373] font-light leading-relaxed text-sm flex-grow mb-8">
            "{{ block.settings.quote }}"
          </p>
          <div class="mt-auto flex items-center justify-between">
            <div>
              <p class="font-bold text-xs uppercase tracking-wider text-[#1a1a1a]">{{ block.settings.author }}</p>
              <p class="text-[10px] text-gray-400 uppercase tracking-widest mt-1 flex items-center">
                Verified Buyer
                <svg class="w-3 h-3 text-green-600 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              </p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visual Testimonials",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Testimonials" },
    { "type": "text", "id": "title", "label": "Heading", "default": "From our Customers" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "review_title", "label": "Review Title", "default": "Absolutely Beautiful" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The craftsmanship is unmatched. It truly feels like a modern heirloom for our family." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "Sarah M." }
      ]
    }
  ],
  "presets": [{ "name": "Visual Testimonials" }]
}
{% endschema %}