<section class="w-full bg-[#FAF9F6] py-16 md:py-24 px-6">
  <div class="max-w-[1400px] mx-auto">
    
    <div class="text-center mb-16 md:mb-24 flex flex-col items-center">
      {% if section.settings.subheading != blank %}
        <p class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-[#8E8881] mb-4">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
      <h1 class="text-5xl md:text-7xl font-serif text-[#181615] font-light leading-tight tracking-tight mb-6">
        {{ section.settings.title }}
      </h1>
      <div class="w-12 h-[1px] bg-[#EAEAEA] mb-6"></div>
      {% if section.settings.description != blank %}
        <p class="text-[15px] md:text-base text-[#666666] font-sans font-light max-w-xl mx-auto leading-relaxed">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      
      {% for block in section.blocks %}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="_blank" class="bg-white border border-[#EAEAEA] p-10 md:p-12 flex flex-col group cursor-pointer transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="bg-white border border-[#EAEAEA] p-10 md:p-12 flex flex-col group transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]" {{ block.shopify_attributes }}>
        {%- endif -%}

          <div class="h-12 mb-8 flex items-center">
            {% if block.settings.logo != blank %}
              {{ block.settings.logo | image_url: width: 300 | image_tag: class: 'max-h-full w-auto object-contain opacity-80 group-hover:opacity-100 grayscale group-hover:grayscale-0 transition-all duration-500', loading: 'lazy', alt: block.settings.publication_name | escape }}
            {% else %}
              <span class="font-serif italic text-[28px] tracking-wide text-[#181615] opacity-80 group-hover:opacity-100 transition-opacity">
                {{ block.settings.publication_name }}
              </span>
            {% endif %}
          </div>
          
          <span class="block text-4xl text-[#EAEAEA] font-serif leading-none mb-2 transition-colors group-hover:text-[#8E8881]">"</span>
          
          <h3 class="text-2xl md:text-[28px] font-serif text-[#181615] leading-[1.3] mb-6">
            {{ block.settings.article_title }}
          </h3>
          
          <p class="text-[#666666] font-sans font-light leading-relaxed text-[14px] mb-10 flex-grow">
            {{ block.settings.excerpt }}
          </p>
          
          <div class="mt-auto flex items-center justify-between border-t border-[#EAEAEA] pt-6">
            <span class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-[#181615]">
              {{ section.settings.read_more_text }}
            </span>
            <div class="w-8 h-8 rounded-full border border-[#EAEAEA] flex items-center justify-center group-hover:bg-[#181615] group-hover:border-[#181615] group-hover:text-white transition-all duration-300">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {% endfor %}

      {% if section.settings.show_media_card %}
        {%- if section.settings.media_btn_link != blank -%}
          <a href="{{ section.settings.media_btn_link }}" class="bg-[#181615] border border-[#181615] p-10 md:p-12 flex flex-col justify-center items-center text-center group cursor-pointer transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.2)] md:col-span-2 lg:col-span-2">
        {%- else -%}
          <div class="bg-[#181615] border border-[#181615] p-10 md:p-12 flex flex-col justify-center items-center text-center group transition-all duration-500 md:col-span-2 lg:col-span-2">
        {%- endif -%}

          <h3 class="text-3xl md:text-4xl font-serif text-white leading-tight mb-4">
            {{ section.settings.media_title }}
          </h3>
          <p class="text-gray-300 font-sans font-light leading-relaxed text-[15px] mb-8 max-w-md">
            {{ section.settings.media_text }}
          </p>
          <span class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#181615] text-[10px] font-sans font-bold uppercase tracking-[0.2em] group-hover:bg-[#FAF9F6] transition-colors">
            {{ section.settings.media_btn_text }}
          </span>

        {%- if section.settings.media_btn_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visual Press (Elevated)",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Media & Praise"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover the latest features, interviews, and mentions of The Visual Book from leading publications around the world."
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read Article Text",
      "default": "Read Article"
    },
    {
      "type": "header",
      "content": "Media Kit Card (Bottom)"
    },
    {
      "type": "checkbox",
      "id": "show_media_card",
      "label": "Show Media Kit Card",
      "default": true,
      "info": "This card spans 2 columns and sits beautifully at the end of your press grid."
    },
    {
      "type": "text",
      "id": "media_title",
      "label": "Card Title",
      "default": "Press & Media Inquiries"
    },
    {
      "type": "textarea",
      "id": "media_text",
      "label": "Card Text",
      "default": "For press releases, high-resolution imagery, and media kits, please reach out to our communications team."
    },
    {
      "type": "text",
      "id": "media_btn_text",
      "label": "Button Text",
      "default": "Download Media Kit"
    },
    {
      "type": "url",
      "id": "media_btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "press_article",
      "name": "Press Article",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication Logo",
          "info": "Upload a transparent PNG logo. If left blank, the text name below will be used."
        },
        {
          "type": "text",
          "id": "publication_name",
          "label": "Publication Name",
          "default": "Vogue"
        },
        {
          "type": "text",
          "id": "article_title",
          "label": "Article Title / Quote",
          "default": "Meet the generation side hustle"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "Today's 20-somethings know how to spin plates. Charlotte Vossen meets savvy Gen Zs making their projects pay, highlighting the stunning craftsmanship of The Visual Book."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visual Press (Elevated)"
    }
  ]
}
{% endschema %}