<section class="visual-family py-20 px-4 sm:px-6 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <h2 class="text-4xl font-serif text-gray-900">{{ section.settings.title }}</h2>
    <p class="mt-4 text-gray-600 max-w-2xl mx-auto">{{ section.settings.text }}</p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {% for block in section.blocks %}
      <div class="relative group overflow-hidden bg-gray-100 aspect-square">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: '600x600', crop: 'center' }}" class="w-full h-full object-cover transition duration-500 group-hover:scale-105" alt="{{ block.settings.name }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'w-full h-full text-gray-300' }}
        {% endif %}
        
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition duration-300 flex flex-col items-center justify-center text-center p-4">
          <p class="text-white font-serif text-xl mb-1">{{ block.settings.name }}</p>
          <p class="text-gray-200 text-sm italic">{{ block.settings.role }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Visual Book Family",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "The Visual Book Family" },
    { "type": "textarea", "id": "text", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Community Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role / Subtext" }
      ]
    }
  ],
  "presets": [{ "name": "Visual Book Family" }]
}
{% endschema %}