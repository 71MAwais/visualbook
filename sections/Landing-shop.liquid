<script>
document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('shop-scroll');
    const cardContainer = document.getElementById('card-container');
    const progressBar = document.getElementById('shop-progress');
    const progressContainer = document.getElementById('shop-progress-container');
    const currentEl = document.getElementById('card-current');
    const totalEl = document.getElementById('card-total');
    const prevBtn = document.getElementById('shop-prev-btn');
    const nextBtn = document.getElementById('shop-next-btn');
    const tabBtns = document.querySelectorAll('.tab-btn');
    
    const tpl1 = document.getElementById('shop-data-1');
    const tpl2 = document.getElementById('shop-data-2');
    
    let totalOriginal = 0;
    let isJumping = false;
    let scrollTimeout = null;
    
    // --- SMART AUTO SCROLL LOGIC ---
    let autoScrollTimer = null;
    let isInteracting = false;
    const AUTO_SCROLL_DELAY = 3000;

    function queueNextAutoScroll() {
        clearTimeout(autoScrollTimer);
        if (isInteracting || totalOriginal === 0 || isJumping || isDown) return;
        
        autoScrollTimer = setTimeout(() => {
            if (isInteracting || isJumping || isDown) return;
            const active = document.querySelector('.product-card.active-card');
            if (active) {
                scrollToCard(parseInt(active.dataset.index) + 1);
            }
        }, AUTO_SCROLL_DELAY);
    }
    // ----------------------------
    
    function renderTab(tabIndex) {
        clearTimeout(autoScrollTimer);
        const sourceTemplate = tabIndex === 1 ? tpl1 : tpl2;
        const originalCards = Array.from(sourceTemplate.content.children);
        totalOriginal = originalCards.length;
        cardContainer.innerHTML = '';
        
        if (totalOriginal === 0) {
            cardContainer.innerHTML = '<div class="w-full text-center py-10 px-8 text-gray-500 font-sans tracking-widest uppercase text-[10px]">Select a collection in the customizer.</div>';
            if (totalEl) totalEl.textContent = '00';
            if (progressContainer) progressContainer.setAttribute('aria-valuenow', '0');
            return;
        }
        
        if (totalEl) totalEl.textContent = String(totalOriginal).padStart(2, '0');
        
        for (let i = 0; i < 3; i++) {
            originalCards.forEach((cardTemplate, idx) => {
                const clone = cardTemplate.cloneNode(true);
                clone.dataset.index = (i * totalOriginal) + idx;
                clone.dataset.realIndex = idx;
                
                clone.addEventListener('click', (e) => {
                    if (e.target.closest('a') || e.target.closest('button')) return;
                    const index = parseInt(clone.dataset.index);
                    const active = document.querySelector('.product-card.active-card');
                    if (active && parseInt(active.dataset.index) === index) return;
                    scrollToCard(index);
                });
                cardContainer.appendChild(clone);
            });
        }
        
        adjustSpacers();
        // Setup initial position instantly
        isJumping = true;
        scrollContainer.style.scrollSnapType = 'none';
        const cards = Array.from(cardContainer.children);
        const scrollPos = cards[totalOriginal].offsetLeft + (cards[totalOriginal].offsetWidth / 2) - (scrollContainer.clientWidth / 2);
        scrollContainer.scrollLeft = scrollPos;
        cards[totalOriginal].classList.add('active-card');
        updateUI(0);
        
        requestAnimationFrame(() => {
            scrollContainer.style.scrollSnapType = '';
            isJumping = false;
            queueNextAutoScroll();
        });
    }

    function adjustSpacers() {
        if (!cardContainer.children.length) return;
        const cardWidth = cardContainer.children.offsetWidth || 220;
        const space = (scrollContainer.clientWidth / 2) - (cardWidth / 2);
        document.getElementById('start-spacer').style.width = `${space}px`;
        document.getElementById('end-spacer').style.width = `${space}px`;
    }

    window.addEventListener('resize', () => {
        adjustSpacers();
        const activeCard = document.querySelector('.product-card.active-card');
        if (activeCard) {
            const index = parseInt(activeCard.dataset.index);
            const cards = Array.from(cardContainer.children);
            const scrollPos = cards[index].offsetLeft + (cards[index].offsetWidth / 2) - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = scrollPos;
        }
    });

    function scrollToCard(index) {
        const cards = Array.from(cardContainer.children);
        if (!cards[index]) return;
        const scrollPos = cards[index].offsetLeft + (cards[index].offsetWidth / 2) - (scrollContainer.clientWidth / 2);
        scrollContainer.scrollTo({ left: scrollPos, behavior: 'smooth' });
    }

    // THE MAGIC HAPPENS HERE:
    function jumpToIndexSilently(index) {
        isJumping = true;
        
        // 1. Disable snap to prevent the browser from animating the instant jump
        scrollContainer.style.scrollSnapType = 'none';
        
        const cards = Array.from(cardContainer.children);
        
        // 2. Disable CSS transitions so the newly active card doesn't visually "grow" from 0.85 scale
        cards.forEach(c => c.style.transition = 'none');
        
        if (cards[index]) {
            const scrollPos = cards[index].offsetLeft + (cards[index].offsetWidth / 2) - (scrollContainer.clientWidth / 2);
            scrollContainer.scrollLeft = scrollPos;
            
            cards.forEach(c => c.classList.remove('active-card'));
            cards[index].classList.add('active-card');
            updateUI(parseInt(cards[index].dataset.realIndex));
        }
        
        // 3. Force the browser to register the layout changes instantly before turning transitions back on
        void scrollContainer.offsetWidth; 
        
        requestAnimationFrame(() => {
            // 4. Turn transitions and snap back on
            cards.forEach(c => c.style.transition = '');
            scrollContainer.style.scrollSnapType = '';
            
            // Allow a tiny buffer before allowing new auto-scroll queues
            setTimeout(() => {
                isJumping = false;
                queueNextAutoScroll();
            }, 50);
        });
    }

    function updateUI(realIndex) {
        if (currentEl) currentEl.textContent = String(realIndex + 1).padStart(2, '0');
        if (progressBar && totalOriginal > 0) {
            const progressPercent = Math.round(((realIndex + 1) / totalOriginal) * 100);
            const progressWidth = 100 / totalOriginal;
            progressBar.style.width = `${progressWidth}%`;
            progressBar.style.transform = `translateX(${realIndex * 100}%)`;
            if (progressContainer) progressContainer.setAttribute('aria-valuenow', progressPercent);
        }
    }

    function handleScroll() {
        if (isJumping || totalOriginal === 0) return;
        const cards = Array.from(cardContainer.children);
        const containerCenter = scrollContainer.scrollLeft + (scrollContainer.clientWidth / 2);
        
        let minDiff = Infinity, closestIndex = 0;
        cards.forEach((card, i) => {
            const diff = Math.abs(containerCenter - (card.offsetLeft + (card.offsetWidth / 2)));
            if (diff < minDiff) { minDiff = diff; closestIndex = i; }
        });

        cards.forEach((card, i) => card.classList.toggle('active-card', i === closestIndex));
        updateUI(parseInt(cards[closestIndex].dataset.realIndex));

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
            if (closestIndex < totalOriginal || closestIndex >= totalOriginal * 2) {
                jumpToIndexSilently((closestIndex % totalOriginal) + totalOriginal);
            } else {
                queueNextAutoScroll();
            }
        }, 250); // Increased from 150 to 250 to ensure native smooth scroll is 100% finished before jumping
    }

    scrollContainer.addEventListener('scroll', handleScroll, { passive: true });

    // --- PAUSE AUTO SCROLL ON INTERACTION ---
    scrollContainer.addEventListener('mouseenter', () => { isInteracting = true; clearTimeout(autoScrollTimer); });
    scrollContainer.addEventListener('mouseleave', () => { isInteracting = false; if (!isDown) queueNextAutoScroll(); });
    scrollContainer.addEventListener('touchstart', () => { isInteracting = true; clearTimeout(autoScrollTimer); }, { passive: true });
    scrollContainer.addEventListener('touchend', () => { isInteracting = false; queueNextAutoScroll(); });

    if (prevBtn) prevBtn.addEventListener('click', () => {
        clearTimeout(autoScrollTimer);
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', () => {
        clearTimeout(autoScrollTimer);
        const active = document.querySelector('.product-card.active-card');
        if (active) scrollToCard(parseInt(active.dataset.index) + 1);
    });

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(t => {
                t.classList.remove('active', 'text-[#181615]', 'font-bold');
                t.classList.add('text-[#181615]/70');
                t.setAttribute('aria-selected', 'false');
                t.querySelector('.tab-active-line').classList.replace('scale-x-100', 'scale-x-0');
            });
            btn.classList.add('active', 'text-[#181615]', 'font-bold');
            btn.classList.remove('text-[#181615]/70');
            btn.setAttribute('aria-selected', 'true');
            btn.querySelector('.tab-active-line').classList.replace('scale-x-0', 'scale-x-100');
            renderTab(parseInt(btn.dataset.tab));
        });
    });

    let isDown = false, startX, scrollLeft;
    scrollContainer.addEventListener('mousedown', (e) => {
        if (e.target.closest('button') || e.target.closest('a')) return;
        isDown = true;
        isInteracting = true;
        clearTimeout(autoScrollTimer); 
        scrollContainer.classList.add('dragging');
        startX = e.pageX - scrollContainer.offsetLeft;
        scrollLeft = scrollContainer.scrollLeft;
    });
    const stopDrag = () => { 
        if(isDown) { 
            isDown = false; 
            isInteracting = false;
            scrollContainer.classList.remove('dragging'); 
            handleScroll(); // Triggers the debounce which ultimately queues the next auto-scroll
        }
    };
    scrollContainer.addEventListener('mouseleave', stopDrag);
    scrollContainer.addEventListener('mouseup', stopDrag);
    scrollContainer.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        scrollContainer.scrollLeft = scrollLeft - ((e.pageX - scrollContainer.offsetLeft) - startX) * 2;
    });

    window.showToast = function(productName) {
        const toast = document.getElementById('toast');
        const msg = document.getElementById('toast-message');
        if(toast && msg) {
            msg.textContent = `${productName} added to cart`;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
    };

    renderTab(1);
});
</script>

