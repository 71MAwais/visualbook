{% comment %} sections/Landing-shop.liquid - UPDATED FOR V2.1 BRAND ARCHITECTURE & PERFORMANCE {% endcomment %}
<style>
    /* UPDATED: V2.1 Brand Architecture Fonts */
    #shop .font-sans { font-family: var(--font-sans, 'Inter', sans-serif); }
    #shop .font-serif { font-family: var(--font-display, 'Cormorant Garamond', serif); }

    .product-card {
        transition: all 400ms cubic-bezier(0.25, 1, 0.5, 1);
        transform-origin: center center;
        opacity: 0.4;
        transform: scale(0.85);
    }
    .product-card.active-card {
        opacity: 1;
        transform: scale(1);
        z-index: 10;
    }
    #shop-scroll {
        -webkit-user-select: none;
        user-select: none;
    }
    #shop-scroll.dragging {
        cursor: grabbing;
        scroll-snap-type: none !important; 
    }
    .toast {
        transform: translateY(100px);
        opacity: 0;
        transition: all 400ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .toast.show {
        transform: translateY(0);
        opacity: 1;
    }
    .shop-arrow:active { transform: translateY(-50%) scale(0.95); }
</style>

<div id="toast" class="toast fixed left-1/2 -translate-x-1/2 z-50 bg-[#181615] text-white px-6 py-3.5 rounded-full shadow-2xl flex items-center gap-3 text-sm font-medium pointer-events-none bottom-[calc(1.5rem+env(safe-area-inset-bottom))]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B8A892" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <span id="toast-message" aria-live="polite">Added to cart</span>
</div>

<section id="shop" class="w-full bg-[#F5F3F0] py-12 flex flex-col items-center select-none overflow-x-hidden border-t border-gray-100" aria-labelledby="shop-title">

    <noscript>
        <h2>{{ section.settings.title }}</h2>
        <ul>
            {% for product in section.settings.collection_1.products %}<li><a href="{{ product.url }}">{{ product.title }}</a></li>{% endfor %}
            {% for product in section.settings.collection_2.products %}<li><a href="{{ product.url }}">{{ product.title }}</a></li>{% endfor %}
        </ul>
    </noscript>

    <div class="w-full text-center pb-2 px-5 flex-shrink-0 z-10">
        <p class="text-[10px] font-sans font-semibold tracking-[0.3em] uppercase text-[#181615] mb-1">{{ section.settings.subtitle }}</p>
        <h2 id="shop-title" class="font-serif text-[28px] md:text-[34px] lg:text-[40px] text-stone-950 tracking-tight leading-none">{{ section.settings.title }}</h2>
        <p class="mt-2 text-stone-600 text-xs md:text-[14px] font-light max-w-md mx-auto leading-relaxed">{{ section.settings.text }}</p>
    </div>

    <div class="w-full max-w-xl px-5 pb-2 flex-shrink-0 z-10 mx-auto">
        <div class="flex flex-nowrap justify-center items-center w-full gap-5 border-b border-gray-300 relative" role="tablist">
            <button role="tab" aria-selected="true" class="tab-btn active pb-1.5 text-[10px] sm:text-[11px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-[#181615] font-bold focus:outline-none" data-tab="1">
                {{ section.settings.tab_1_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-[#181615] transform scale-x-100 origin-left transition-transform duration-500"></div>
            </button>
            <button role="tab" aria-selected="false" class="tab-btn pb-1.5 text-[10px] sm:text-[11px] font-sans tracking-[0.2em] uppercase whitespace-nowrap transition-all duration-300 relative text-[#181615]/70 hover:text-[#181615] focus:outline-none" data-tab="2">
                {{ section.settings.tab_2_label }}
                <div class="tab-active-line absolute bottom-0 left-0 w-full h-[1.5px] bg-[#181615] transform scale-x-0 origin-left transition-transform duration-500"></div>
            </button>
        </div>
    </div>

    <div class="w-full flex-1 min-h-0 relative transition-opacity duration-300 ease-out flex flex-col group/carousel" id="shop-content">
        <div class="absolute top-0 left-0 w-[10vw] h-full bg-gradient-to-r from-[#F5F3F0] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-[10vw] h-full bg-gradient-to-l from-[#F5F3F0] to-transparent z-10 pointer-events-none"></div>
        
        <button aria-label="Previous Product" id="shop-prev-btn" class="shop-arrow absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/80 backdrop-blur-sm shadow border border-stone-200 flex items-center justify-center text-stone-600 hover:text-black hover:border-black transition-all duration-300 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button aria-label="Next Product" id="shop-next-btn" class="shop-arrow absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/80 backdrop-blur-sm shadow border border-stone-200 flex items-center justify-center text-stone-600 hover:text-black hover:border-black transition-all duration-300 focus:outline-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        <div id="shop-scroll" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full cursor-grab items-center py-2 relative">
            <div id="start-spacer" class="shrink-0 w-[50vw]"></div>
            <div id="card-container" class="flex gap-3 md:gap-4 items-center shrink-0"></div>
            <div id="end-spacer" class="shrink-0 w-[50vw]"></div>
        </div>
    </div>

    {%- comment -%} ARIA FIXED PROGRESS BAR {%- endcomment -%}
    <div class="w-full flex-shrink-0 pt-2 px-5 md:px-10 z-10 pb-2">
        <div class="max-w-[800px] mx-auto flex items-center justify-between w-full pointer-events-auto">
            <div class="flex items-start shrink-0 w-12" aria-hidden="true">
                <span id="card-current" class="font-serif text-[24px] text-black font-medium leading-none">01</span>
                <div class="flex flex-col ml-1 mt-0.5">
                    <span class="text-[9px] text-[#181615]/70 font-sans leading-none">/</span>
                    <span id="card-total" class="text-[9px] text-[#181615]/70 font-sans leading-none mt-0.5">00</span>
                </div>
            </div>
            
            <div id="shop-progress-container" class="flex-1 mx-4 h-[1.5px] bg-gray-300 relative overflow-hidden" role="progressbar" aria-label="Carousel Progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="shop-progress" class="absolute top-0 left-0 h-full bg-[#B8A892] transition-all duration-500 ease-out" style="width: 0%;"></div>
            </div>
            
            <div class="flex shrink-0 w-12"></div>
        </div>
    </div>
</section>

{%- comment -%} ==========================================
    1. PRE-COMPUTE LOWEST & 2ND LOWEST STOCK FOR COLLECTION 1 
========================================== {%- endcomment -%}
{% assign lowest_stock_id_1 = null %}
{% assign lowest_stock_qty_1 = 999999 %}
{% for product in section.settings.collection_1.products %}
  {% if product.available %}
    {% assign current_qty = 0 %}
    {% for variant in product.variants %}
      {% if variant.inventory_management %}
        {% assign current_qty = current_qty | plus: variant.inventory_quantity %}
      {% endif %}
    {% endfor %}
    {% if current_qty > 0 and current_qty < lowest_stock_qty_1 %}
      {% assign lowest_stock_qty_1 = current_qty %}
      {% assign lowest_stock_id_1 = product.id %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign second_lowest_id_1 = null %}
{% assign second_lowest_qty_1 = 999999 %}
{% for product in section.settings.collection_1.products %}
  {% if product.available and product.id != lowest_stock_id_1 %}
    {% assign current_qty = 0 %}
    {% for variant in product.variants %}
      {% if variant.inventory_management %}
        {% assign current_qty = current_qty | plus: variant.inventory_quantity %}
      {% endif %}
    {% endfor %}
    {% if current_qty > 0 and current_qty < second_lowest_qty_1 %}
      {% assign second_lowest_qty_1 = current_qty %}
      {% assign second_lowest_id_1 = product.id %}
    {% endif %}
  {% endif %}
{% endfor %}

