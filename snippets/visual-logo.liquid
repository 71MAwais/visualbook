{% comment %} snippets/visual-logo.liquid {% endcomment %}
<div class="logo-svg-wrapper" style="width: {{ width | default: '220' }}px; max-width: 100%;">
  <svg viewBox="0 0 400 80" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    
    <text x="50%" y="42" text-anchor="middle" font-family="'Playfair Display', serif" font-size="26" font-weight="400" letter-spacing="0.25em" fill="currentColor" style="text-transform: uppercase;">
      THE VISUAL BOOK
    </text>
    
    <text x="51%" y="70" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="9.5" font-weight="500" letter-spacing="0.7em" fill="#78716c" style="text-transform: uppercase;">
      LONDON
    </text>
    
  </svg>
</div>

<style>
  .logo-svg-wrapper {
    color: #0c0a09; /* stone-950 */
    transition: opacity 0.3s ease;
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }
  .logo-svg-wrapper:hover {
    opacity: 0.7;
  }
</style>