<div class="step-block flex-shrink-0 w-[85vw] lg:w-auto min-h-auto lg:min-h-[60vh] flex flex-col justify-center p-8 lg:p-0 bg-[#FAFAFA] lg:bg-transparent border border-gray-200 lg:border-none snap-center lg:opacity-30 transition-opacity duration-500 ease-in-out" 
     data-img="{{ block.settings.image | img_url: '800x' }}" 
     data-target="{{ target_id }}"
     {{ block.shopify_attributes }}>
  
  <span class="step-pill inline-block self-start font-serif text-[32px] md:text-[40px] text-stone-300 mb-2 transition-colors duration-300">
    {{ block.settings.step_label }}
  </span>
  
  <h3 class="font-serif text-[24px] md:text-[32px] mb-4 text-[#111111] tracking-tight leading-tight">
    {{ block.settings.title }}
  </h3>
  
  <p class="font-sans text-sm md:text-base leading-relaxed text-gray-500 max-w-md">
    {{ block.settings.text }}
  </p>

  {% if block.settings.link_text != blank %}
    <a href="{{ block.settings.link_url }}" class="inline-block mt-4 text-sm font-semibold underline text-stone-800 hover:text-black">
      {{ block.settings.link_text }}
    </a>
  {% endif %}
  
  {% if block.settings.image != blank %}
    <div class="lg:hidden mt-6 w-full aspect-[4/3] bg-[#F0F0F0] shadow-sm border border-stone-100/50 rounded-[4px] overflow-hidden">
       <img src="{{ block.settings.image | img_url: '600x' }}" class="w-full h-full object-cover mix-blend-multiply" loading="lazy">
    </div>
  {% endif %}
</div>